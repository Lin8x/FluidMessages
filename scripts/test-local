def new_conversations_test():
    """Starting something new: a chat with a new Matrix address actually sends, and typed addresses are read the same
    way as on the phone. Fictional addresses only."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import accounts
    import protocol_gateway

    with tempfile.TemporaryDirectory(prefix="fluid-new-chat-") as directory:
        database = Path(directory) / "gateway.sqlite"
        connect = lambda: sqlite3.connect(database, timeout=10)
        with closing(connect()) as db, db:
            db.executescript(protocol_gateway.SCHEMA)
        store_path = Path(directory) / "protocol-accounts.json"
        store_path.write_text(json.dumps({"matrix": {"homeserver": "https://alpha.test", "user_id": "@alice:alpha.test",
                                                     "access_token": "fixture-alpha-token"}}))
        gateway = protocol_gateway.Gateway(connect, {}, Path(directory) / "files", accounts.AccountStore(store_path, environ={}))
        gateway.refresh_clients = lambda: None
        calls = []

        def fake_matrix(path, body=None, allow_missing=False, method=None):
            calls.append((path, body, method))
            if path == "createRoom":
                return {"room_id": "!new-friend:alpha.test"}
            if "/send/" in path:
                return {"event_id": "$sent"}
            return None if allow_missing else {}
        gateway.matrix_request = fake_matrix
        # New chat → @newfriend:beta.test → Start chat: the web app's own request (companion.js startInternetChat).
        with closing(connect()) as db, db:
            route = gateway.add_route(db, {"address": "web-0123456789abcdef", "protocol": "matrix", "target": "@newfriend:beta.test",
                                           "title": "@newfriend:beta.test", "group": False})["route"]
        check(route["target"] == "!new-friend:alpha.test" and route["title"] == "@newfriend:beta.test",
              "A new Matrix address didn't become a direct chat: " + json.dumps(route))
        invite = next((body for path, body, _ in calls if path == "createRoom"), None)
        check(invite and invite["invite"] == ["@newfriend:beta.test"] and invite["is_direct"], "The new chat didn't invite them")
        check(any(path.endswith("account_data/m.direct") and method == "PUT" for path, _, method in calls), "The new chat isn't marked direct")
        # Then the first message sends.
        with closing(connect()) as db, db:
            queued = gateway.enqueue(db, {"address": route["address"], "protocol": "matrix", "body": "Hi, it's Alice from the garden club",
                                          "request": secrets.token_hex(8)})["message"]
        gateway.deliver_job(gateway.claim())
        sent = json.loads(connect().execute("SELECT payload FROM protocol_messages WHERE id=?", (queued["id"],)).fetchone()[0])
        check(sent["status"] == "Sent" and any("/send/" in path and "new-friend" in path for path, _, _ in calls),
              "The first message to a new Matrix address didn't send: " + sent["status"])
        # Starting it again opens the same chat instead of making a second one.
        with closing(connect()) as db, db:
            again = gateway.add_route(db, {"address": "web-fedcba9876543210", "protocol": "matrix", "target": "@newfriend:beta.test"})
        check(again["route"]["address"] == route["address"] and again.get("existing") and len(gateway.routes) == 1,
              "The same Matrix person got a second chat")
        # Email and IRC people, and an IRC channel, are new chats too.
        for target, protocol in (("leah.morgan@example.org", "email"), ("riley", "irc"), ("#radio", "irc")):
            with closing(connect()) as db, db:
                made = gateway.add_route(db, {"address": "web-" + secrets.token_hex(8), "protocol": protocol, "target": target})["route"]
            check(made["target"] == target and made["group"] == target.startswith("#"), "Couldn't start a chat with " + target)

    people_js = (ROOT / "server/people.js").read_text()
    companion_js = (ROOT / "server/companion.js").read_text()
    check("detailsPage(prefill ? 'Forward to' : 'New chat'" in companion_js and "dialog('New chat')" not in companion_js,
          "New chat isn't a full page")
    check("function startInternetChat" in companion_js and "protocols/join" in companion_js, "New chat can't start a person's chat or join a room")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("Skipped running address detection: node isn't installed (set NODE to its path)")
    else:
        block = re.search(r"// address-detect:start\n(.*?)// address-detect:end", people_js, re.S)
        check(block, "people.js has no address detection")
        script = block.group(1) + """
const cases = JSON.parse(process.argv[1]);
const wrong = cases.filter(([text, expected]) => JSON.stringify(detectAddress(text).map((item) => [item.service, item.target])) !== JSON.stringify(expected))
  .map(([text]) => [text, detectAddress(text)]);
if (detectAddress('riley@irc.libera.chat')[0].network !== 'irc.libera.chat') wrong.push('network');
if (!detectAddress('riley')[0].guess || detectAddress('#radio')[0].group !== true) wrong.push('flags');
process.stdout.write(JSON.stringify(wrong));
"""
        result = subprocess.run([node, "-e", script, json.dumps(NEW_ADDRESSES)], capture_output=True, text=True, timeout=30)
        check(result.returncode == 0 and result.stdout == "[]", "Address detection is wrong: " + (result.stdout or result.stderr)[:400])
    kotlin = (ROOT / "app/src/test/kotlin/org/fluidmessages/NewAddressTest.kt").read_text()
    for text, expected in NEW_ADDRESSES:
        check(json.dumps(text) in kotlin, "The phone's NewAddressTest.kt leaves out " + json.dumps(text))
    print("PASS  new chats: a new Matrix address makes a direct chat and sends; email, IRC, channels; address detection matches the phone")


def web_contacts_test():
    """New contact and Edit on the web: kept on the server, checked, shown in every list, fetched by the phone on
    its own endpoint, and never part of the settings merge. Fictional people only."""
    token = secrets.token_hex(24)
    with companion(free_port(), token) as (origin, request, _):
        opener = build_opener(ProxyHandler({}))

        def call(path, body=None, cookie=None, bearer=False):
            sent = {"Authorization": "Bearer " + token} if bearer else {"X-Fluid-Request": "1", "Origin": origin}
            sent["Content-Type"] = "application/json"
            if cookie:
                sent["Cookie"] = cookie
            data = json.dumps(body).encode() if body is not None else None
            try:
                with opener.open(Request(origin + path, data=data, headers=sent), timeout=15) as response:
                    return response.status, json.loads(response.read() or b"{}"), response.headers
            except HTTPError as error:
                return error.code, json.loads(error.read() or b"{}"), error.headers

        status, _, headers = call("/api/auth/local", {})
        check(status == 200, "This computer couldn't open FluidMessages Web for the contacts test")
        cookie = headers.get_all("Set-Cookie")[0].split(";")[0]
        check(call("/api/contacts")[0] == 401, "Contacts answered without signing in")
        state = call("/api/contacts", bearer=True)[1]
        check(state["supported"] == 1 and state["contacts"] == [], "A new server has contacts")
        empty_revision = state["revision"]

        # New contact
        draft = {"name": "  Rowan   Hale ", "numbers": ["+1 202 555 0177", "+1 202 555 0177"],
                 "addresses": [{"service": "matrix", "address": "@rowan:example.org"}, {"service": "xmpp", "address": "Rowan@Example.org"},
                               {"service": "irc", "address": "rowan@irc.libera.chat"}, {"service": "sip", "address": "rowan@sip.example.org"}]}
        status, made, _ = call("/api/contacts", draft, cookie=cookie)
        check(status == 200, "Couldn't make a contact: " + json.dumps(made))
        contact = made["contact"]
        check(re.fullmatch(r"wc-[0-9a-f]{16}", contact["id"]) and contact["name"] == "Rowan Hale" and contact["numbers"] == ["+1 202 555 0177"]
              and contact["addresses"][1] == {"service": "xmpp", "address": "rowan@example.org"} and contact["created"] == contact["updated"],
              "The contact wasn't cleaned: " + json.dumps(contact))
        check(made["web_contacts"] == [contact], "Saving doesn't answer with every contact")
        # Checked, with what to fix
        for bad, why in (({"name": " "}, "Enter a name"), ({"name": "x" * 101}, "up to 100"), ({"name": "Line\nbreak"}, "up to 100"),
                         ({"name": "Rowan", "numbers": ["call me"]}, "digits"), ({"name": "Rowan", "numbers": ["+1"]}, "digits"),
                         ({"name": "Rowan", "numbers": ["+1 202 555 0100"] * 11}, "10 phone"),
                         ({"name": "Rowan", "addresses": [{"service": "matrix", "address": "rowan"}]}, "@maya:example.org"),
                         ({"name": "Rowan", "addresses": [{"service": "email", "address": "rowan@example"}]}, "maya@example.org"),
                         ({"name": "Rowan", "addresses": [{"service": "fax", "address": "rowan"}]}, "Choose a service"),
                         ({"name": "Rowan", "addresses": "@rowan:example.org"}, "20 chat"), ([], "Expected an object")):
            status, answer, _ = call("/api/contacts", bad, cookie=cookie)
            check(status == 400 and why in answer.get("error", ""), "A bad contact wasn't refused (" + why + "): " + json.dumps(answer))
        check(len(call("/api/contacts", cookie=cookie)[1]["contacts"]) == 1, "A refused contact was kept")

        # Shown everywhere people.js lists people
        check(call("/api/settings", cookie=cookie)[1]["web_contacts"] == [contact], "Settings don't carry web contacts")
        check(call("/api/inbox", cookie=cookie)[1]["web_contacts"] == [contact], "The inbox doesn't carry web contacts")
        people_js = (ROOT / "server/people.js").read_text()
        for expected in ("function openContactEditor", "'+ New contact'", "'Edit contact'", "'Save as contact'", "webContactList()",
                         "api('contacts'", "api('contacts/delete'", "'Add to contacts'", "function addressDialView"):
            check(expected in people_js, "people.js is missing " + expected)

        # The phone's fetch: on its own endpoint, with a revision, nothing secret.
        phone = call("/api/contacts", bearer=True)[1]
        check(phone["contacts"] == [contact] and phone["revision"] != empty_revision, "The phone doesn't see the new contact")
        check(token not in json.dumps(phone) and "password" not in json.dumps(phone), "Something secret went to the phone with contacts")

        # Edit
        status, edited, _ = call("/api/contacts", {"id": contact["id"], "name": "Rowan Hale-Ortiz", "numbers": ["+1 202 555 0177", "+44 20 7946 0958"],
                                                    "addresses": [{"service": "matrix", "address": "@rowan:example.org"}]}, cookie=cookie)
        check(status == 200 and edited["contact"]["id"] == contact["id"] and edited["contact"]["name"] == "Rowan Hale-Ortiz"
              and len(edited["contact"]["numbers"]) == 2 and len(edited["contact"]["addresses"]) == 1
              and edited["contact"]["updated"] > contact["updated"] and edited["contact"]["created"] == contact["created"], "Edit didn't save")
        after = call("/api/contacts", bearer=True)[1]
        check(after["revision"] != phone["revision"] and after["contacts"][0]["name"] == "Rowan Hale-Ortiz", "The phone doesn't see the edit")
        check(call("/api/contacts", {"id": "wc-0000000000000000", "name": "Nobody"}, cookie=cookie)[0] == 400, "Editing a missing contact worked")

        # Never a merge item: older phones would read an unknown item as a deletion. The merge still works around them.
        merge = call("/api/merge", bearer=True)[1]
        check(not any(key.split(":", 1)[0] not in ("look", "fun", "folder", "muted", "sender", "timer", "wallpaper", "gif", "gifoff",
                                                     "pay", "sticker", "account", "protocol") for key in merge["web"]),
              "Contacts leaked into the merge items: " + json.dumps(merge["web"]))
        status, merged, _ = call("/api/merge", {"revision": merge["revision"], "apply_web": {}, "baseline": merge["web"], "conflicts": []}, bearer=True)
        check(status == 200 and merged["pair"], "A merge failed next to web contacts")
        check(call("/api/contacts", bearer=True)[1]["contacts"] == after["contacts"], "A merge changed web contacts")
        # An older server answers 404, which the phone treats as "no web contacts here" (WebContacts.kt).
        check(call("/api/contacts/list", bearer=True)[0] in (400, 404), "Unknown contact endpoints answered")

        # The phone's sync still sends contact names with its texts, as before.
        named = [{"address": "+12025550177", "body": "Fictional hello", "type": 1, "date": int(time.time() * 1000), "title": "Rowan Hale"}]
        check(call("/api/sync", {"messages": named}, bearer=True)[0] == 200, "The phone's sync failed")
        check(call("/api/inbox", cookie=cookie)[1]["messages"][0].get("title") == "Rowan Hale", "Phone contact names stopped reaching the web")

        # Delete
        status, gone, _ = call("/api/contacts/delete", {"id": contact["id"]}, cookie=cookie)
        check(status == 200 and gone["web_contacts"] == [], "Delete didn't work")
        check(call("/api/contacts/delete", {"id": contact["id"]}, cookie=cookie)[0] == 400, "Deleting twice worked")
        check(call("/api/contacts", bearer=True)[1]["contacts"] == [], "The phone still sees a deleted contact")
    print("PASS  web contacts: new, edit, delete, checks, shown in lists, phone fetch with revision, kept out of the merge, phone names still sync")


# The first-run guide's steps, in order: the same titles as the phone's where the content matches.
WELCOME_STEPS = ("Welcome", "Two tabs", "One inbox", "Stay organized", "Who can read it?", "Keep chats private",
                 "Disappearing messages", "More than text", "Quick moves", "Pick your colors", "Sounds and notifications",
                 "Connect your phone", "Chat services", "Calls", "You’re ready")


def onboarding_followups_test():
    """A new user's notes: Communities starts Add server while no IRC, Matrix, or XMPP server is added, instead of in setup,
    battery is explained where services are turned on, Ways to reach is near the top of a person's details, and the
    first setup page is an ordinary chat. Phone and web, with fictional words only."""
    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        check(request("/api/settings")["prefs"]["communitiesIntroSeen"] is False, "The Communities page starts as already seen")
        check(request("/api/settings", {"prefs": {"communitiesIntroSeen": True}})["prefs"]["communitiesIntroSeen"] is True,
              "Seeing the Communities page wasn't saved")
        welcome_js, settings_js, companion_js = (request(path, authorized=False).decode()
                                                 for path in ("/welcome.js", "/settings.js", "/companion.js"))
    steps = welcome_js.split("const steps = [", 1)[1].split("\n  ];", 1)[0]
    check("communitiesShowcase" not in steps, "Communities is still a first-run step")
    intro = welcome_js.split("function showCommunitiesIntro", 1)[1].split("\n}\n", 1)[0]
    check("communitiesShowcase(flow)" in intro and "['Continue', close]" in intro,
          "The Communities page lost its showcase or Continue")
    check("showCommunitiesIntro" not in companion_js and "communitiesIntroDue" not in companion_js,
          "Saving a new account still leads to the Communities page")
    servers_js = (ROOT / "server/servers.js").read_text()
    setup_js = (ROOT / "server/account-setup.js").read_text()
    add = servers_js.split("function openAddServer()", 1)[1].split("\n}\n", 1)[0]
    check("addServerIntroDue(addedServices())" in add and "showCommunitiesIntro({then: () => openChooseService()})" in add,
          "Add server doesn't start with the Communities page while no server is added")
    check("addServerGuideDue(protocol, addedServices()) ? openServerGuide(protocol) : showServerList(protocol)" in servers_js,
          "Choose a service doesn't skip the help page for a service that has an account")
    guide = servers_js.split("function openServerGuide(protocol)", 1)[1].split("\n}\n", 1)[0]
    check("pickServer: () => showServerList(protocol, {guided: true})" in guide and "guideExample(protocol).entry" in guide
          and "expert: () => showServerForm(protocol, null, {}, {back})" in guide and "() => openChooseService()" in guide,
          "The Add server help page lacks Pick a server, the example, the skip, or Back")
    check("pickServer ? 'Pick a server' : 'Get started'" in setup_js and "See other public servers" not in setup_js,
          "The help page's main button isn't Pick a server in Add server")
    listing = servers_js.split("function showServerList(", 1)[1].split("\n}\n", 1)[0]
    check("showServerForm(protocol, entry, {}, {back: again})" in listing and "showServerForm(protocol, null, {}, {back: again})" in listing
          and "'Read the guide'" in listing and "addServerListBack(guided) === 'guide'" in listing,
          "The server list's picks, Other server…, Read the guide, or Back are wrong")
    phone_main = (ROOT / "app/src/main/java/org/fluidmessages/MainActivity.java").read_text()
    check("AddServerFlow.introDue(addedServices())" in phone_main and "AddServerFlow.guideDue(protocol, addedServices())" in phone_main
          and "CommunitiesIntro.due" not in (ROOT / "app/src/main/kotlin/org/fluidmessages/AccountsScreen.kt").read_text(),
          "The phone's Add server doesn't follow the same order")
    check("title: 'Communities'" in settings_js.split("['Help', [", 1)[1].split("]]", 1)[0] and "showCommunitiesIntro()" in settings_js,
          "Settings → Help has no Communities page")
    # Battery: the same words on the phone and the web, where services are turned on.
    kotlin_battery = (ROOT / "app/src/main/kotlin/org/fluidmessages/ServiceBattery.kt").read_text()
    for line in ("Turning a service on uses no battery by itself. Only an account you sign in to connects.",
                 "To get new messages, a chat service needs a connection that stays open. On your phone, that keeps it awake.",
                 "Then your phone only checks in now and then."):
        check(line in settings_js and line in kotlin_battery, f"The battery words differ between phone and web: {line}")
    check("serviceBatteryCard(paired)" in settings_js.split("function waysPage", 1)[1] and "serviceBatteryCard(phonePaired())" in steps,
          "Chat services doesn't explain battery on the web")
    check("ServiceBatteryCard(" in (ROOT / "app/src/main/kotlin/org/fluidmessages/ProtocolUi.kt").read_text()
          and "ServiceBatteryCard(paired)" in (ROOT / "app/src/main/kotlin/org/fluidmessages/OnboardingScreen.kt").read_text(),
          "Chat services doesn't explain battery on the phone")
    check("For the best battery life, pair" not in (ROOT / "app/src/main/kotlin/org/fluidmessages/OnboardingScreen.kt").read_text(),
          "Setup still suggests turning services on costs battery")
    # Ways to reach: right after Message and Call, one person only, with the same words on both.
    details = companion_js.split("async function openDetails", 1)[1].split("\n}\n", 1)[0]
    check(details.index("reachTiles(key)") < details.index("linkedSection(") < details.index("'Contact info'"),
          "Ways to reach isn't near the top of a chat's details")
    check("if (!group) nodes.push(linkedSection(" in details, "Ways to reach shows in groups or channels")
    profile_kt = (ROOT / "app/src/main/kotlin/org/fluidmessages/ProfileEditor.kt").read_text()
    for words in ("+ Add another way to reach ", "Your past chats are searched to help you find them.", "Ways to reach them"):
        check(words in companion_js and words in profile_kt, f"Ways to reach words differ between phone and web: {words}")
    check("Link an address', 'Reach '" not in companion_js, "The old Link an address row is still there")
    # The first page: an ordinary chat and plain tips, no service names.
    first = steps.split("{title: 'Two tabs'", 1)[0]
    check("welcomeConversation()" in first and "sampleConversation()" not in first, "The first page still shows the color preview")
    messages = welcome_js.split("const WELCOME_MESSAGES = ", 1)[1].split(";\n", 1)[0]
    tips = welcome_js.split("const WELCOME_TIPS = ", 1)[1].split("];\n", 1)[0]
    for name in ("RCS", "Matrix", "XMPP", "IRC", "Email", "preview", "Automated"):
        check(name.lower() not in (messages + tips).lower(), f"The first page names {name}")
    for title in ("Chat right from your browser", "Reach friends on other chat apps too", "Practice with pretend chats first"):
        check(title in tips, f"The first page is missing the tip {title}")
    check("sampleConversation()" in steps.split("{title: 'Pick your colors'", 1)[1], "Pick your colors lost the color preview")
    check("CHAT_SERVICES_ARE" in steps.split("{title: 'Two tabs'", 1)[1].split("{title: 'One inbox'", 1)[0],
          "The first page naming a chat service doesn't say what one is")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("SKIP  Add server step rules in Node: node is missing")
        return
    rules = re.search(r"// add-server-steps:start[^\n]*\n(.*?)// add-server-steps:end", servers_js, re.S)
    check(rules, "servers.js has no Add server step rules")
    script = rules.group(1) + r"""
const wrong = [];
const same = (a, b, why) => { if (JSON.stringify(a) !== JSON.stringify(b)) wrong.push(why + ': ' + JSON.stringify(a)); };
same(addServerIntroDue([]), true, 'no servers yet');
same(addServerIntroDue(['email']), true, 'only email');
same(['irc', 'matrix', 'xmpp'].map((p) => addServerIntroDue(['email', p])), [false, false, false], 'one community server');
same(['irc', 'matrix', 'xmpp'].map((p) => addServerGuideDue(p, [])), [true, true, true], 'first account on a service');
same(['irc', 'matrix', 'xmpp'].map((p) => addServerGuideDue(p, ['irc'])), [false, true, true], 'one IRC network already');
same(addServerGuideDue('matrix', ['irc', 'matrix']), false, 'a second Matrix account');
same([addServerListBack(true), addServerListBack(false)], ['guide', 'services'], 'Back from the list');
if (wrong.length) { console.log(wrong.join('\n')); process.exit(1); }
"""
    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0, "Add server step rules failed in Node: " + (result.stdout + result.stderr).strip()[:600])
    print("PASS  onboarding follow-ups: Communities at the start of Add server with no server yet and in Help, the help page only "
          "for a service with no account, battery explained, "
          "Ways to reach near the top for one person, and a plain first page, on the phone and the web")


def sample_onboarding_test():
    """The sample inbox's servers, favorites, and mutes stay on the page, and the first-run guide's steps are served."""
    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        welcome_js = request("/welcome.js", authorized=False).decode()
        steps = welcome_js.split("const steps = [", 1)[1].split("\n  ];", 1)[0]
        titles = re.findall(r"^    \{title: '([^']+)'", steps, re.M)
        check(tuple(titles) == WELCOME_STEPS, "The first-run guide's steps differ: " + " | ".join(titles))
        for name in ("tabsShowcase(flow)", "communitiesShowcase(flow)", "filtersShowcase(flow)", "disappearingShowcase(flow)",
                     "notifyGuideCard()", "phoneShowcase(flow)", "'Allow notifications'", "Choose what to keep", "muteMark(", "timerNoticeText("):
            check(name in welcome_js, f"The first-run guide is missing {name}")
        # Notification permission is asked only from a click in the guide too.
        asks = list(re.finditer(r"await askNotifyPermission\(\)", welcome_js))
        check(asks and all("addEventListener('click'" in welcome_js[max(0, m.start() - 300):m.start()] for m in asks),
              "The guide asks for notification permission outside a click")
        # Nothing in the guide's steps claims what only the phone can do here.
        for phone_only in ("vibrat", "haptic", "default SMS app", "Keep a backup"):
            check(phone_only not in steps, f"The guide's steps mention {phone_only}, which this browser can't do")
        photo = request("/samples/lakeside.webp", authorized=False)
        check(photo == (ROOT / "app/src/main/res/drawable-nodpi/sample_lakeside.webp").read_bytes(), "The sample photo differs from the phone's")
        check("'/samples/lakeside.webp'" in request("/sw.js", authorized=False).decode(), "The offline cache leaves out the sample photo")
        people_js = request("/people.js", authorized=False).decode()
        badges = people_js.split("function updateTabBadges", 1)[1]
        check(badges.index("if (sampleOn) return;") < badges.index("document.title"), "The sample's counts reach the title or the app icon")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("SKIP  sample servers, favorites, and mutes in Node: node is missing")
        return
    server = ROOT / "server"
    chats_js, people_js = ((server / name).read_text() for name in ("chats.js", "people.js"))
    muting = re.search(r"// Muting, for a while.*?// End of muting\.", chats_js, re.S).group(0)
    state = re.search(r"const NO_CHATS = .*?(?=/\*\* Folders)", chats_js, re.S).group(0)
    sample = re.search(r"let sampleOn = false;.*?(?=function sampleBanner)", chats_js, re.S).group(0)
    favorites = re.search(r"const SAMPLE_STARRED = .*?\n", people_js).group(0) + re.search(
        r"let webFavorites = \[\];\nlet sampleStarred = null;", people_js).group(0) + "\n" + re.search(
        r"const digitsOf = .*?\n", people_js).group(0) + re.search(r"const sameText = .*?(?=const keyOf)", people_js, re.S).group(0) + re.search(
        r"function starredList\(\).*?(?=function starButton)", people_js, re.S).group(0)
    script = r"""
const calls = [], stored = [];
globalThis.localStorage = {getItem: () => null, setItem: (key) => stored.push(key)};
const api = async (path, body) => { calls.push(path + ' ' + JSON.stringify(body || {}).slice(0, 80)); return {}; };
// A stand-in page: any element takes any call, so the pages can be drawn without a browser.
const fake = () => new Proxy(function () {}, {get: (target, key) => key in target ? target[key] : key === Symbol.iterator ? function* () {}
  : key === Symbol.toPrimitive ? () => '' : key === 'value' ? '' : typeof key === 'symbol' || key === 'then' ? undefined : (target[key] = fake()),
  apply: () => fake(), set: (target, key, value) => { target[key] = value; return true; }});
const element = () => fake(), field = () => fake(), confirmButton = () => fake(), checkbox = () => fake();
const document = fake(), get = () => fake(), labels = {irc: 'IRC', matrix: 'Matrix', xmpp: 'XMPP'};
let pages = [], shown = 0, selected = '', said = [];
const detailsPage = (title) => pages.push(title), closeDetailsPage = () => {}, showThreads = () => { shown++; }, showError = (e) => { throw e; };
const say = (text) => said.push(text), select = (key) => { selected = key; }, rebuildThreads = () => {};
const threadKey = (message) => message.address + '\u001f' + message.protocol, clock = (time) => String(time);
let chatAccounts = [{id: 'irc:me@irc.example.test', protocol: 'irc', name: 'me@irc.example.test', fields: {}}];
let routes = [], inbox = [], prefs = {}, phoneLook = {}, companionSettings = null;
const SERVER_DIRECTORY = {irc: []};
""" + state + muting + "\n" + sample + favorites + (server / "servers.js").read_text() + r"""
const wrong = [];
const same = (label, got, want) => { if (JSON.stringify(got) !== JSON.stringify(want)) wrong.push(label + ': ' + JSON.stringify(got)); };
// The sample inbox: its servers, routes, and every server action stay on the page.
sampleOn = true;
routes = sampleServerRoutes();
inbox = sampleMessages();
same('sample servers', serverAccounts().map((account) => serverName(account)), ['Starlight IRC', 'Garden Commons']);
same('sample rooms', routes.map((route) => route.title).sort(), ['#astronomy', '#meteor-watch', '#telescopes', 'Allotment News', 'Compost Corner', 'Seed Swap']);
for (const account of serverAccounts()) {
  openBrowse(account); openJoin(account); openServerDetails(account); loadSpaces(account.id, true);
}
openAddServer();
joinTarget(serverAccounts()[0], '#beginners', '', fake());
joinTarget(serverAccounts()[1], 'Tool Library', '', fake());
same('joined on the page', routes.filter((route) => /beginners|tools/.test(route.address)).map((route) => route.account), ['sample:irc', 'sample:matrix']);
same('opened the joined room', selected, 'sample-mx-tools\u001fmatrix');
setInboxView('communities'); toggleServer('sample:irc');
same('sample view and collapse stay on the page', [stored, inboxViewMode(), communitySort()], [[], 'communities', 'recent']);
// Sample mutes and favorites change only the sample's own lists.
sampleChats = {...NO_CHATS(), muted: [SAMPLE_LEAH, SERVER_MUTE + 'sample:matrix'], mute_until: {[SAMPLE_LEAH]: Date.now() + 3600000}};
saveChats(muteKeys(['sample-irc-astronomy'], 86400000));
saveChats(unmuteKeys([SERVER_MUTE + 'sample:matrix']));
same('sample mutes', sampleChats.muted, [SAMPLE_LEAH, 'sample-irc-astronomy']);
const maya = {name: 'Maya Chen', numbers: ['+12025550123'], accounts: []}, nora = {name: 'Nora Patel', numbers: ['+12025550107'], accounts: []};
same('sample favorites', [isFavorite(maya), toggleFavorite(nora), toggleFavorite(maya)], [true, true, false]);
same('nothing reached the server', calls, []);
same('real lists untouched', [webChats.muted, webFavorites], [[], []]);
// Everything in the sample is fictional: 555-01xx numbers, example addresses, and sample rooms.
const strange = inbox.filter((row) => !/^(\+120255501\d\d|55123|mms:\+120255501\d\d(,\+120255501\d\d)*|sample-[a-z0-9-]+|[^@\s]+@example\.org|@[a-z]+:example\.org)$/.test(row.address));
same('fictional addresses', strange.map((row) => row.address), []);
const kinds = {link: inbox.some((row) => row.body.includes(SAMPLE_LINK)), timed: inbox.some((row) => row.expires > Date.now()),
  voice: inbox.some((row) => row.attachment?.kind === 'voice'), photo: inbox.some((row) => row.attachment?.kind === 'photo'),
  poll: inbox.some((row) => row.body.startsWith('📊 Poll:')), edited: inbox.some((row) => row.body.startsWith('✏️ Edited')),
  unread: inbox.filter((row) => row.read === 0).length >= 3, automated: inbox.some((row) => row.title === 'Trail Alerts')};
same('sample contents', Object.values(kinds).every(Boolean), true);
// Out of the sample, the same actions reach your own server, and the sample's servers are gone.
sampleOn = false;
routes = [];
same('real servers after exit', serverAccounts().map((account) => account.id), ['irc:me@irc.example.test']);
toggleFavorite(nora);
saveChats(muteKeys(['+12025550107'], 3600000));
same('real changes are saved', calls.map((call) => call.split(' ')[0]), ['settings', 'settings']);
process.stdout.write(JSON.stringify(wrong));
"""
    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0 and result.stdout == "[]", "The sample inbox reached real data: " + (result.stdout or result.stderr)[:900])
    print("PASS  sample inbox and first-run guide: sample servers, joins, mutes, and favorites stay on the page; fictional fixtures; "
          "the guide's " + str(len(WELCOME_STEPS)) + " steps are served, ask for notifications only from a click, and claim nothing phone-only")


def web_gaps_test():
    """Phone features FluidMessages Web gained: Tap to load preview for people you don't know, several numbers in New chat
    sent as separate texts, notifications that can hide names too, and Resync in the filter menu. Fictional numbers only."""
    server = ROOT / "server"
    cards_js, companion_js, notify_js, privacy_js = ((server / name).read_text() for name in ("cards.js", "companion.js", "notify.js", "privacy.js"))
    check("Show names and message text in notifications" in notify_js and "!notifyPreview()) ? 'FluidMessages'" in notify_js,
          "Turning off notification text doesn't hide the sender's name")
    check("RESYNC" in privacy_js and "resyncInbox()" in privacy_js, "The inbox filter menu has no Resync")
    check("TAP_PREVIEW = 'Tap to load preview'" in cards_js and "linkLoads(message)" in cards_js, "Links from strangers load by themselves")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("SKIP  web gap rules in Node: node is missing")
        return
    loads = re.search(r"function linkLoadsByItself\(.*?\n}\n", cards_js, re.S).group(0)
    split = re.search(r"function splitRecipients\(.*?\n}\n", companion_js, re.S).group(0)
    script = loads + split + r"""
const wrong = [];
const say = (ok, what) => { if (!ok) wrong.push(what); };
say(linkLoadsByItself({outgoing: true}) && linkLoadsByItself({senderSaved: true}) && linkLoadsByItself({sample: true}), 'loads');
say(!linkLoadsByItself({outgoing: false, senderSaved: false, sample: false}), 'stranger waits');
say(JSON.stringify(splitRecipients('+1 202 555 0123, (202) 555-0146; 202-555-0188')) === '["+1 202 555 0123","(202) 555-0146","202-555-0188"]', 'three');
say(JSON.stringify(splitRecipients('202 555 0123, 2025550123, 202-555-0146')) === '["202 555 0123","202-555-0146"]', 'repeats once');
say(splitRecipients('+12025550123') === null && splitRecipients('maya@example.org, +12025550123') === null && splitRecipients('12, 34') === null, 'not several');
process.stdout.write(JSON.stringify(wrong));
"""
    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0 and result.stdout == "[]", "Web gap rules are wrong: " + (result.stdout or result.stderr)[:600])
    print("PASS  web gaps: Tap to load preview for strangers, several numbers as separate texts, private notifications, Resync")


def web_parity_test():
    """The phone features FluidMessages Web gained: Try again on a failed message, the web-only switches for sending
    GIFs and stickers and for ways to call, palette contrast and tints, each chat's own theme, locks for every chat of
    one kind, hiding whole services in the private folder, asking for its passcode to close it, real chats that stay
    visible in decoy mode, and a GIF API address. Fictional people, codes, and addresses only."""
    import sqlite3
    sys.path.insert(0, str(ROOT / "server"))
    import link_fetch
    # GIF API address: https and a host name, an optional path, nothing else.
    for good, base in (("https://gifs.example.org", "https://gifs.example.org"), ("https://gifs.example.org/tenor/", "https://gifs.example.org/tenor"),
                       ("https://proxy.example.org:443/v1", "https://proxy.example.org:443/v1")):
        check(link_fetch.gif_api_base(good) == base, "A GIF API address was refused: " + good)
    for bad in ("http://gifs.example.org", "https://user@gifs.example.org", "https://gifs.example.org/?key=1", "https://gifs.example.org#x",
                "https://localhost", "https://gifs.example.org:8443", "javascript:alert(1)", "https://gifs.example.org/a b"):
        check(link_fetch.gif_api_base(bad) == "", "A GIF API address was allowed: " + bad)
    password, decoy, code = "harbor maple lantern", "willow candle orbit", "4821"
    opener = build_opener(ProxyHandler({}))
    with companion(free_port(), "") as (origin, request, _):
        def call(path, body=None, cookie=None):
            sent = {"X-Fluid-Request": "1", "Content-Type": "application/json", "Origin": origin}
            if cookie:
                sent["Cookie"] = cookie
            data = json.dumps(body).encode() if body is not None else None
            try:
                with opener.open(Request(origin + path, data=data, headers=sent), timeout=30) as response:
                    return response.status, json.loads(response.read() or b"{}"), response.headers
            except HTTPError as error:
                return error.code, json.loads(error.read() or b"{}"), error.headers

        def sign_in(secret):
            status, _, headers = call("/api/auth/login", {"password": secret, "remember": True})
            check(status == 200, "Couldn't sign in")
            return headers.get_all("Set-Cookie")[0].split(";")[0]

        status, _, headers = call("/api/auth/local", {})
        here = headers.get("Set-Cookie").split(";")[0]
        check(call("/api/auth/password", {"password": password}, cookie=here)[0] == 200, "Couldn't set the web password")
        bearer = {"Authorization": "Bearer " + call("/api/auth/pairing", {}, cookie=here)[1]["token"]}
        request("/api/sync", {"messages": sample_messages()}, authorized=False, extra_headers=bearer)
        real = sign_in(password)
        now = int(time.time() * 1000)
        with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db, db:
            route = {"address": "web-rowan", "protocol": "email", "target": "rowan@example.org", "via": "email", "group": False,
                     "title": "Rowan Hale", "members": [], "account": ""}
            db.execute("INSERT INTO protocol_routes (address, protocol, payload) VALUES (?, ?, ?)", ("web-rowan", "email", json.dumps(route)))
            for key, body, status_text in (("web-failed", "Fictional note that didn't send", "Couldn’t send · The server didn’t answer"),
                                           ("web-sent", "Fictional note that went", "Sent")):
                db.execute("INSERT INTO protocol_messages VALUES (?, ?, ?)", (key, now, json.dumps(
                    {"id": key, "address": "web-rowan", "protocol": "email", "title": "Rowan Hale", "body": body, "date": now, "type": 2,
                     "read": 1, "status": status_text})))
                db.execute("INSERT INTO protocol_jobs VALUES (?, 'email', 'rowan@example.org', ?, ?)",
                           (key, now - 60_000, "failed" if key == "web-failed" else "sent"))
        # Try again: the failed message's own job goes back in the queue; anything else is refused.
        status, result, _ = call("/api/protocols/retry", {"id": "web-failed"}, cookie=real)
        check(status == 200 and result["message"]["status"] == "Queued" and result["message"]["body"] == "Fictional note that didn't send",
              "Try again didn't queue the failed message: " + json.dumps(result))
        for bad in ({"id": "web-sent"}, {"id": "missing"}, {"id": "../x"}, {"id": 4}):
            check(call("/api/protocols/retry", bad, cookie=real)[0] == 400, "Try again accepted " + json.dumps(bad))
        for _ in range(100):
            with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db:
                state = db.execute("SELECT state FROM protocol_jobs WHERE id='web-failed'").fetchone()[0]
            if state == "failed":
                break
            time.sleep(.05)
        # It went out again (and, with no account here, failed again), so it can be tried again; still one copy.
        check(state == "failed", "The retried message didn't go through the sender: " + state)
        check(call("/api/protocols/retry", {"id": "web-failed"}, cookie=real)[0] == 200, "A message that failed twice can't be tried again")
        rows = [row for row in call("/api/inbox", cookie=real)[1]["messages"] if row.get("id") == "web-failed"]
        check(len(rows) == 1, "Try again made a second copy")
        # Web-only switches: on by default, and kept when turned off; anything but true or false is refused.
        defaults = call("/api/settings", cookie=real)[1]["prefs"]
        check(all(defaults[key] is True for key in ("sendGifs", "sendStickers", "callMatrix", "callMeetings")), "The new switches aren't on by default")
        changed = call("/api/settings", {"prefs": {"sendStickers": False, "callMeetings": False}}, cookie=real)[1]["prefs"]
        check(changed["sendStickers"] is False and changed["callMeetings"] is False and changed["sendGifs"] is True, "The switches weren't saved")
        check(call("/api/settings", {"prefs": {"callMatrix": "off"}}, cookie=real)[0] == 400, "A switch accepted a string")
        # Palette contrast, the background, buttons, and toolbar tints, a palette's contrast, and each chat's own theme.
        look = {"theme": "ember", "mode": "dark", "contrast": True, "sendSound": "pop",
                "colors": {"sms": "#ffd60a", "canvas": "#101820", "controls": "#ff9500", "chrome": "#22303c", "nearby": "#40e0d0"},
                "palettes": {"Sunny": {"theme": "fluid", "colors": {"sms": "#ffd60a", "nearby": "#40e0d0"}, "contrast": True}},
                "chatThemes": {"+12025550146": {"theme": "love", "outgoing": "#ffd60a"}, "web-rowan": {"background": "#fff4f8"}}}
        noisy = {**look, "colors": {**look["colors"], "chrome": "url(x)"},
                 "chatThemes": {**look["chatThemes"], "x": {"theme": "neon", "incoming": "red"}, "y": "love", "": {"theme": "love"}},
                 "palettes": {"Sunny": {**look["palettes"]["Sunny"], "contrast": "yes"}}}
        saved = call("/api/settings", {"web_appearance": noisy}, cookie=real)[1]["web_appearance"]
        expected = {**look, "colors": {key: value for key, value in look["colors"].items() if key != "chrome"},
                    "palettes": {"Sunny": {"theme": "fluid", "colors": {"sms": "#ffd60a", "nearby": "#40e0d0"}}}}
        check(saved == expected, "Contrast, tints, or chat themes weren't cleaned: " + json.dumps(saved))
        check(call("/api/settings", {"web_appearance": look}, cookie=real)[1]["web_appearance"] == look, "Contrast, tints, or chat themes weren't saved")
        check(call("/api/settings", {"web_appearance": {**look, "contrast": "yes"}}, cookie=real)[1]["web_appearance"].get("contrast") is None,
              "Palette contrast accepted a string")
        # Lock every chat of one kind: kept with the chat codes, as a hash.
        locks = {"service:email": {"salt": "ab" * 16, "hash": "cd" * 32}, "+12025550146": {"salt": "ef" * 16, "hash": "01" * 32}}
        chats = {"pinned": [], "archived": [], "blocked": [], "muted": [], "locks": locks}
        check(call("/api/settings", {"web_chats": chats}, cookie=real)[1]["web_chats"]["locks"] == locks, "Kind locks weren't saved")
        # Private folder: hide whole services, and the passcode to close it.
        check(call("/api/privacy/private/services", {"services": ["email"]}, cookie=real)[0] == 409, "Services hid without a private folder")
        status, result, _ = call("/api/privacy/private/setup", {"code": code, "again": code}, cookie=real)
        check(status == 200 and result["private"]["services"] == [] and result["private"]["close_code"] is True, "Couldn't set up the private folder")
        for body in ({"services": ["fax"]}, {"services": "email"}):
            check(call("/api/privacy/private/services", body, cookie=real)[0] == 400, "Hide whole services accepted " + json.dumps(body))
        status, result, _ = call("/api/privacy/private/services", {"services": ["email", "sms"]}, cookie=real)
        check(status == 200 and result["private"]["services"] == ["sms", "email"], "Hide whole services wasn't saved")
        opened = call("/api/inbox", cookie=real)[1]
        check({"web-rowan", "+12025550123", "+12025550146"} <= set(opened["private_chats"]), "Hidden services' chats aren't in the open folder")
        check(call("/api/privacy/private/close-code", {"on": "no"}, cookie=real)[0] == 400, "The close passcode switch accepted a string")
        check(call("/api/privacy/private/close-code", {"on": False}, cookie=real)[1]["private"]["close_code"] is False, "The close passcode stayed on")
        other = sign_in(password)
        closed = json.dumps(call("/api/inbox", cookie=other)[1]) + json.dumps(call("/api/settings", cookie=other)[1]) \
            + json.dumps(call("/api/privacy", cookie=other)[1])
        check("Rowan" not in closed and "rowan@example.org" not in closed and "5550146" not in closed and "Coffee at ten?" not in closed,
              "A hidden service shows to a session that didn't open the folder")
        check(call("/api/privacy", cookie=other)[1]["private"]["services"] is None, "A closed folder tells which services it hides")
        check(call("/api/privacy/private/services", {"services": []}, cookie=other)[0] == 403, "A closed folder's services were changed")
        check(call("/api/privacy/private/close-code", {"on": True}, cookie=other)[0] == 403, "A closed folder's close passcode was changed")
        # Decoy mode → Real chats that stay visible: shown there as they are; never a private one; sends stay there.
        call("/api/privacy/private/services", {"services": []}, cookie=real)
        check(call("/api/privacy/private/move", {"address": "+12025550123", "private": True}, cookie=real)[0] == 200, "Couldn't move a chat")
        check(call("/api/privacy/decoy", {"password": decoy, "again": decoy, "current": password}, cookie=real)[0] == 200, "Couldn't set decoy mode")
        check(call("/api/privacy/decoy/allowed", {"addresses": "web-rowan"}, cookie=real)[0] == 400, "Real decoy chats accepted a string")
        status, result, _ = call("/api/privacy/decoy/allowed", {"addresses": ["web-rowan", "+12025550123", "+12025550146"]}, cookie=real)
        check(status == 200 and result["decoy"]["allowed"] == ["web-rowan", "+12025550146"], "A private chat stays visible in decoy mode: "
              + json.dumps(result["decoy"].get("allowed")))
        fake = sign_in(decoy)
        pretend = call("/api/inbox", cookie=fake)[1]
        text = json.dumps(pretend)
        check("I sent the route for Saturday." in text and "Fictional note that went" in text and "Mom" in text,
              "The real chats that stay visible don't show in decoy mode")
        check("Coffee at ten?" not in text and "5550123" not in text, "A private chat showed in decoy mode")
        check(call("/api/protocols/send", {"address": "web-rowan", "protocol": "email", "body": "Fictional decoy email", "text": "x",
                                           "request": "r1"}, cookie=fake)[0] == 200, "Sending in a real chat in decoy mode wasn't sandboxed")
        check(call("/api/protocols/send", {"address": "web-other", "protocol": "email", "body": "Fictional", "request": "r2"}, cookie=fake)[0] == 503,
              "Decoy mode sent to a chat that isn't shown there")
        check("Fictional decoy email" in json.dumps(call("/api/inbox", cookie=fake)[1]), "The sandboxed email didn't show in decoy mode")
        check("Fictional decoy email" not in json.dumps(call("/api/inbox", cookie=real)[1]), "A decoy email reached the real inbox")
        check(call("/api/protocols/retry", {"id": "web-failed"}, cookie=fake)[0] == 503, "A decoy session reached Try again")
    sys.path.remove(str(ROOT / "server"))
    web_parity_node_test()
    print("PASS  web parity: Try again re-queues only failed messages, GIF and sticker and call switches, palette contrast and tints, "
          "chat themes, kind locks, hidden services and the close passcode, real chats in decoy mode, and the GIF API address")


def meeting_links_test():
    """Meeting links on the web: Zoom first and the default, Zoom and Jitsi on at first, your own saved links checked
    by the server, the last one used picked next time, and the message that carries the link read back as a call card."""
    zoom, meet = "https://zoom.us/j/1234567890?pwd=Fictional1", "https://meet.google.com/abc-defg-hij"
    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        index, shell = request("/", authorized=False).decode(), request("/sw.js", authorized=False).decode()
        check("/meetings.js" in index and "'/meetings.js'" in shell, "The page or the offline cache leaves out meetings.js")
        check(index.index("/companion.js") < index.index("/meetings.js"), "meetings.js loads before companion.js")
        meetings_js = request("/meetings.js", authorized=False).decode()
        check(meetings_js == (ROOT / "server/meetings.js").read_text(), "The served meetings.js differs from the file")
        check("showModal" not in meetings_js and "<dialog" not in meetings_js and "detailsPage(" in meetings_js,
              "Picking a meeting service isn't a full page")
        welcome_js, settings_js = (request(path, authorized=False).decode() for path in ("/welcome.js", "/settings.js"))
        check("A Jitsi Meet link anyone" not in welcome_js + settings_js and "Pick Zoom, Jitsi Meet, Google Meet, or Teams" in welcome_js,
              "The Calls page still says meeting links are only Jitsi")
        check("discord" not in (meetings_js + welcome_js).lower(), "Meeting links mention a service FluidMessages doesn't name")
        # A server from before there was a choice has no meeting settings: all four on, Jitsi on meet.jit.si.
        fresh = request("/api/settings")["prefs"]
        check(fresh["meetings"] == {"version": 2, "on": {"zoom": True, "meet": True, "teams": True, "jitsi": True}, "links": {}, "custom": [], "last": "",
                                    "jitsiServer": "meet.jit.si"} and fresh["callMeetings"] is True, "Meeting links don't start with all four on")
        # Settings saved before Google Meet and Teams were on at first: those two come on, and the rest stays as chosen.
        older = request("/api/settings", {"prefs": {"meetings": {"on": {"zoom": True, "meet": False, "teams": False, "jitsi": False}, "links": {},
                                                                 "last": "zoom", "jitsiServer": "meet.jit.si"}}})["prefs"]["meetings"]
        check(older["version"] == 2 and older["on"] == {"zoom": True, "meet": True, "teams": True, "jitsi": False} and older["last"] == "zoom",
              "Older meeting settings didn't turn on Google Meet and Teams: " + json.dumps(older))
        work = {"id": "c0a1b2c3d", "name": "Work video", "link": "https://video.example.org/rooms/team?pin=1234", "host": "video.example.org"}
        club = {"id": "c99887766", "name": "Book club 📚", "link": "https://club.example.net/r/1", "host": ""}
        saved = request("/api/settings", {"prefs": {"meetings": {"version": 2, "on": {"teams": False, "c99887766": False}, "links": {"zoom": zoom, "meet": meet},
                                                                 "custom": [work, club], "last": "c0a1b2c3d", "jitsiServer": "meet.example.org"}}})["prefs"]["meetings"]
        check(saved == {"version": 2, "on": {"zoom": True, "meet": True, "teams": False, "jitsi": True, "c0a1b2c3d": True, "c99887766": False},
                        "links": {"zoom": zoom, "meet": meet}, "custom": [work, club], "last": "c0a1b2c3d", "jitsiServer": "meet.example.org"},
              "Meeting links weren't saved: " + json.dumps(saved))
        check(request("/api/settings")["prefs"]["meetings"] == saved, "Meeting links weren't kept")
        # Other settings saved afterwards leave them alone, and a choice made from version 2 on stays.
        check(request("/api/settings", {"prefs": {"callMeetings": False}})["prefs"]["meetings"] == saved, "Another setting reset meeting links")
        custom = lambda **change: {"version": 2, "custom": [{**work, **change}]}
        for bad in ({"links": {"zoom": meet}}, {"links": {"zoom": "https://zoom.us.example.org/j/1234567890"}}, {"links": {"jitsi": "https://meet.jit.si/Room"}},
                    {"links": {"meet": "https://meet.google.com/"}}, {"links": {"teams": "javascript:alert(1)"}}, {"on": {"zoom": "yes"}},
                    {"on": {"other": True}}, {"version": 2, "on": {"zoom": False, "jitsi": False, "meet": False, "teams": False}}, {"last": "other"},
                    {"jitsiServer": "meet example"}, {"jitsiServer": "https://meet.example.org/"}, {"extra": 1}, [], "zoom", {"version": 3}, {"version": True},
                    {"custom": {}}, custom(name=""), custom(name="A" * 33), custom(name="Zoom"), custom(name="teams"), custom(name=" Work video"),
                    custom(name="Work‮video"), custom(name=5), custom(link="http://video.example.org/x"), custom(link="https://vidoe.example.org/x"),
                    custom(link="https://video.example.org.example.net/x"), custom(link="javascript:alert(1)"), custom(link="https://video.example.org/a b"),
                    custom(host="video example"), custom(id="../x"), custom(extra=1), {"custom": [work, {**work, "name": "Other"}]},
                    {"custom": [work, {**club, "name": "work VIDEO"}]}, {"custom": [{**work, "id": "c%08x" % n, "name": f"Room {n}"} for n in range(11)]},
                    {"on": {"c12345678": True}}, {"last": "c12345678"}):
            try:
                request("/api/settings", {"prefs": {"meetings": bad}})
                raise RuntimeError("Invalid meeting links were accepted: " + json.dumps(bad))
            except HTTPError as error:
                check(error.code == 400, f"Expected HTTP 400 for invalid meeting links, got {error.code}")
        check(request("/api/settings")["prefs"]["meetings"] == saved, "A refused change still changed meeting links")
