#!/usr/bin/env python3
"""Exercise FluidMessages locally without touching a real inbox."""
import argparse
from concurrent.futures import ThreadPoolExecutor
from contextlib import closing, contextmanager
import json
import os
import re
from pathlib import Path
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from urllib.error import HTTPError, URLError
from urllib.request import ProxyHandler, Request, build_opener
import webbrowser
import zipfile

ROOT = Path(__file__).resolve().parents[1]
PACKAGE = "org.fluidmessages"
GRADLE_APK = ROOT / "app/build/outputs/apk/debug/app-debug.apk"
CLOUD_TARGETS = ("onedrive", "drive", "s3")


def check(condition, message):
    if not condition:
        raise RuntimeError(message)


@contextmanager
def companion(port, token, cloud_fixtures=False, extra_env=None):
    with tempfile.TemporaryDirectory(prefix="fluid-test-") as directory:
        env = dict(os.environ, FLUID_DB=str(Path(directory) / "demo.sqlite"),
                   FLUID_TOKEN=token, FLUID_BIND="127.0.0.1", FLUID_PORT=str(port),
                   RCLONE_CONFIG=str(Path(directory) / "rclone.conf"))
        env.update({"FLUID_LOCAL_ONLY": "", **(extra_env or {})})
        # FLUID_TOKEN is optional: an empty one means browsers sign in with a password only.
        for key in CLOUD_TARGETS:
            folder = Path(directory) / key
            if cloud_fixtures:
                folder.mkdir()
            env["FLUID_BACKUP_" + key.upper()] = str(folder) if cloud_fixtures else ""
        process = subprocess.Popen(
            [sys.executable, str(ROOT / "server/main.py")],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        origin = f"http://127.0.0.1:{port}"
        opener = build_opener(ProxyHandler({}))

        def request(path, body=None, authorized=True, method=None, extra_headers=None):
            headers = {"Authorization": "Bearer " + token} if authorized else {}
            headers.update(extra_headers or {})
            data = body if isinstance(body, bytes) else json.dumps(body).encode() if body is not None else None
            with opener.open(Request(origin + path, data=data, headers=headers, method=method), timeout=5) as response:
                content = response.read()
                return json.loads(content) if response.headers.get_content_type() == "application/json" else content

        try:
            for _ in range(50):
                check(process.poll() is None, "Companion failed to start. The port may already be in use.")
                try:
                    request("/", authorized=False)
                    break
                except URLError:
                    time.sleep(0.05)
            else:
                raise RuntimeError("Timed out starting the companion")
            request.directory, request.env = Path(directory), env
            yield origin, request, process
        finally:
            process.terminate()
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


def free_port():
    try:
        with socket.socket() as listener:
            listener.bind(("127.0.0.1", 0))
            return listener.getsockname()[1]
    except PermissionError as error:
        raise RuntimeError("Loopback networking is blocked. Run this command from a regular terminal.") from error


def sample_messages():
    now = int(time.time() * 1000)
    return [
        {"address": "+12025550123", "body": "See you there!", "type": 2, "date": now - 60_000},
        {"address": "+12025550123", "body": "Coffee at ten?", "type": 1, "date": now - 90_000},
        {"address": "+12025550146", "body": "I sent the route for Saturday.", "type": 1, "date": now - 150_000},
    ]


def smoke_test():
    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        for path, expected in (("/", b"FluidMessages"), ("/app.js", b"schedule"), ("/style.css", b"--canvas")):
            check(expected in request(path, authorized=False), f"Missing browser asset at {path}")
        try:
            request("/api/inbox", authorized=False)
        except HTTPError as error:
            check(error.code == 401, f"Expected HTTP 401, got {error.code}")
        else:
            raise RuntimeError("Inbox accepted an unauthenticated request")
        messages = sample_messages()
        request("/api/sync", {"messages": messages})
        check(request("/api/inbox")["messages"] == messages, "Synced inbox differs from the phone snapshot")
        appearance = {"dark": True, "exactTimes": True, "radius": 19, "folders": {"archived": [messages[0]["address"]]},
                      "colors": {"sms": "#457abc", "surface": "#172e26", "raised": "#1b372d", "action": "#8bdabb",
                                 "ink": "#ffffff", "muted": "#bfccc7", "line": "#3a4d45", "outline": "#697b73"}}
        request("/api/sync", {"messages": messages, "appearance": {**appearance, "size": 900,
                "colors": {**appearance["colors"], "accent": "url(invalid)"}}})
        snapshot = request("/api/inbox")
        check(snapshot["messages"] == messages and snapshot["appearance"] == appearance,
              "Inbox and appearance snapshot were not saved together")
        request("/api/sync", {"messages": messages})
        check(request("/api/inbox")["appearance"] == {}, "Older Android sync should use the companion theme")
        now = int(time.time() * 1000)
        draft = {"address": messages[0]["address"], "body": "Test only", "due": now + 60_000}
        cancelled = request("/api/schedule", draft)["id"]
        request("/api/cancel", {"id": cancelled})
        due = request("/api/schedule", {**draft, "due": now})["id"]
        with ThreadPoolExecutor(max_workers=4) as pool:
            claims = list(pool.map(lambda _: request("/api/claim", {})["job"], range(4)))
        check([job["id"] for job in claims if job] == [due], "Due message was lost or claimed more than once")
        request("/api/result", {"id": due, "state": "submitted"})
        check({job["id"]: job["state"] for job in request("/api/jobs")} ==
              {cancelled: "cancelled", due: "submitted"}, "Queue state did not persist")
        call = request("/api/call", {"address": messages[0]["address"]})["id"]
        claimed = request("/api/claim", {})["job"]
        check(claimed and claimed["id"] == call and claimed["protocol"] == "call", "Call request was not handed to the phone")
        request("/api/result", {"id": call, "state": "submitted"})
        try:
            request("/api/call", {"address": "not a number"})
            raise RuntimeError("Companion accepted a call to a non-number")
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for an invalid call, got {error.code}")
        upload = request("/api/protocols/upload", b"fixture", extra_headers={"Content-Type": "text/plain",
                         "X-Fluid-Name": "notes%20one.txt"})
        check(re.fullmatch(r"[0-9a-f]{40}", upload.get("upload", "")) is not None, "Attachment upload did not return an id")
        try:
            request("/api/protocols/file?id=missing", authorized=True)
            raise RuntimeError("Companion served an unknown attachment")
        except HTTPError as error:
            check(error.code == 404, f"Expected HTTP 404 for a missing attachment, got {error.code}")
        web_features_test(request)
    print("PASS  Companion assets, authentication, sync, scheduling, cancellation, claiming, click-to-call and attachment uploads")
    print("PASS  web phone features: scripts served, delete for me, pinned/archived/muted chats and chat codes, appearance extras")
    print("PASS  web details and effects: conversation details and members, call icons, floating message menu, capped effects")
    print("PASS  web Calls tab: favorites, recents, contacts, keypad, contact pages, saved favorites, sample portraits, and tab counts")
    print("PASS  web Unread filter, Sounds and notifications (volume, muted chats, service worker notifications), New chat → Channels")
    print("PASS  web mutes: 1 hour to forever, older lists forever, chats, people, and servers, no notifications or chimes, ends on its own")


def web_features_test(request):
    """FluidMessages Web's phone features: their scripts, Delete for me, chat folders and codes, and appearance extras."""
    import sqlite3
    for path, expected in (("/editor.js", b"findBackground"), ("/media.js", b"startVoiceNote"), ("/chats.js", b"chatLockGate"),
                           ("/look.js", b"applyLookExtras"), ("/features.css", b".editor-stage"), ("/settings.js", b"erasePage")):
        check(expected in request(path, authorized=False), f"Missing browser asset at {path}")
    index = request("/", authorized=False)
    check(all(name in index for name in (b"/editor.js", b"/media.js", b"/chats.js", b"/look.js", b"/features.css", b"/settings.js")),
          "The page doesn't load the phone-feature scripts")
    # Delete for me removes the web copy (and cancels it if it's still queued); other messages stay.
    now = int(time.time() * 1000)
    with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db, db:
        for key, body in (("web-delete-me", "Fictional message to delete"), ("web-keep-me", "Fictional message to keep")):
            db.execute("INSERT INTO protocol_messages VALUES (?, ?, ?)", (key, now, json.dumps(
                {"id": key, "address": "web-fixture", "protocol": "matrix", "title": "Fixture", "body": body, "date": now, "type": 2, "read": 1})))
        db.execute("INSERT INTO protocol_jobs VALUES ('web-delete-me', 'matrix', '!fixture:example.test', ?, 'queued')", (now + 3_600_000,))
    check(request("/api/protocols/delete", {"id": "web-delete-me"}) == {"deleted": "web-delete-me"}, "Delete for me failed")
    ids = {message.get("id") for message in request("/api/inbox")["messages"]}
    check("web-delete-me" not in ids and "web-keep-me" in ids, "Delete for me removed the wrong message")
    with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db:
        check(db.execute("SELECT state FROM protocol_jobs WHERE id='web-delete-me'").fetchone()[0] == "cancelled",
              "A deleted message stayed in the send queue")
    for bad in ({"id": "web-delete-me"}, {"id": "../etc"}, {"id": 5}):
        try:
            request("/api/protocols/delete", bad)
            raise RuntimeError("Delete for me accepted " + json.dumps(bad))
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for a bad delete, got {error.code}")
    # Pinned, archived, blocked, and muted chats and chat codes are kept for every browser; only hashes of codes.
    chats = {"pinned": ["web-fixture"], "archived": ["+12025550188"], "blocked": [], "muted": ["web-fixture"],
             "locks": {"web-fixture": {"salt": "ab" * 16, "hash": "cd" * 32}}}
    check(request("/api/settings", {"web_chats": chats})["web_chats"] == chats, "Chat folders and codes weren't saved")
    check(request("/api/inbox")["web_chats"] == chats, "The inbox doesn't carry chat folders and codes")
    for bad in ({"pinned": "web-fixture"}, {"locks": {"web-fixture": {"salt": "x", "hash": "plain code"}}}, {"muted": [1]}):
        try:
            request("/api/settings", {"web_chats": bad})
            raise RuntimeError("Invalid chat settings were accepted: " + json.dumps(bad))
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for invalid chat settings, got {error.code}")
    # Wallpaper, layout, motion, sounds, haptics, per-chat wallpapers, and saved palettes are cleaned like the phone's choices.
    look = {"theme": "love", "mode": "dark", "wallpaper": "aurora", "searchPosition": "top", "toolbarFinish": "floating", "chromeOpacity": 60,
            "density": "compact", "tails": True, "speed": 0, "sendSound": "silent", "receiveSound": "fluid", "haptics": "confirm",
            "chatWallpapers": {"web-fixture": "orchard"}, "palettes": {"Sunny": {"theme": "ember", "colors": {"sms": "#ffd60a"}}},
            "activePalette": "Sunny"}
    noisy = {**look, "wallpaper": "url(x)", "chromeOpacity": 5, "speed": 9000, "haptics": "buzz", "tails": "yes",
             "chatWallpapers": {"web-fixture": "orchard", "other": "javascript:"}, "activePalette": "Missing",
             "palettes": {"Sunny": {"theme": "ember", "colors": {"sms": "#ffd60a", "ink": "url(x)"}}, "": {"theme": "fluid"}}}
    saved = request("/api/settings", {"web_appearance": noisy})["web_appearance"]
    dropped = ("wallpaper", "chromeOpacity", "speed", "haptics", "tails", "activePalette")
    check(saved == {key: value for key, value in look.items() if key not in dropped}, "Appearance extras weren't cleaned: " + json.dumps(saved))
    check(request("/api/settings", {"web_appearance": look})["web_appearance"] == look, "Appearance extras weren't saved")
    web_mute_test(request)
    web_details_effects_test(request)


def web_mute_test(request):
    """Muting for a while or for good, on FluidMessages Web: stored with when it ends, older lists still forever, chats
    and whole servers, nothing notifies or chimes while muted, and a mute whose time is up simply stops."""
    now = int(time.time() * 1000)
    server = "server:irc:fixture@irc.example.test"
    chats = {"pinned": [], "archived": [], "blocked": [], "locks": {},
             "muted": ["web-fixture", "+12025550177", "+12025550178", server],
             "mute_until": {"web-fixture": now + 3_600_000, "+12025550177": now - 1_000}}
    saved = request("/api/settings", {"web_chats": chats})["web_chats"]
    # The one whose time is up is gone; the server and the entry without an end stay muted forever.
    check(saved["muted"] == ["web-fixture", "+12025550178", server] and saved["mute_until"] == {"web-fixture": now + 3_600_000},
          "A timed mute wasn't kept with its end: " + json.dumps(saved))
    check(request("/api/inbox")["web_chats"]["mute_until"] == {"web-fixture": now + 3_600_000}, "The inbox doesn't carry when mutes end")
    older = {"pinned": [], "archived": [], "blocked": [], "muted": ["web-fixture"], "locks": {}}
    check(request("/api/settings", {"web_chats": older})["web_chats"] == older, "An older muted list didn't stay as it was")
    for bad in ({"muted": ["a"], "mute_until": {"a": "soon"}}, {"muted": ["a"], "mute_until": {"a": -5}}, {"muted": ["a"], "mute_until": []}):
        try:
            request("/api/settings", {"web_chats": bad})
            raise RuntimeError("Invalid mute times were accepted: " + json.dumps(bad))
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for invalid mute times, got {error.code}")
    request("/api/settings", {"web_chats": {"pinned": [], "archived": [], "blocked": [], "muted": [], "locks": {}}})
    chats_js, look_js, notify_js, people_js, app_js, servers_js = (request(path, authorized=False).decode() for path in (
        "/chats.js", "/look.js", "/notify.js", "/people.js", "/app.js", "/servers.js"))
    check("personMuteSection(person, chats)" in people_js and "serverMuteControls(account.id" in servers_js
          and "updateMuteMark()" in app_js, "The contact page, server bar, or chat header doesn't offer muting")
    check("chatMuted(message.address)) continue" in notify_js, "Notifications don't check for muted chats")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("Skipped running the mute rules: node isn't installed (set NODE to its path)")
        return
    block = re.search(r"// Muting, for a while.*?// End of muting\.", chats_js, re.S).group(0)
    muted_rule = re.search(r"function chatMuted\(address\).*?\n", chats_js).group(0)
    notice = re.search(r"const heard = new Set\(\);.*?(?=// Settings → Themes and appearance)", look_js, re.S).group(0)
    notifier = re.search(r"function notifyIncoming\(.*?(?=\nlet notifiedChat)", notify_js, re.S).group(0)
    rule = re.search(r"/\*\* Chats that never count.*?(?=function countTabs)", people_js, re.S).group(0)
    script = """
let sampleOn = false, sampleChats = {}, webChats = {muted: [], locks: {}}, appearance = {folders: {}}, inbox = [], webLook = {};
const chatState = () => webChats;
let routes = [{address: '#radio', protocol: 'irc', account: 'irc:fixture@irc.example.test'},
  {address: 'kestrel', protocol: 'irc', account: 'irc:fixture@irc.example.test'}];
const inFolder = (address, key) => key === 'blocked' && address === 'blocked-one';
const clock = (time) => new Date(time).toISOString().slice(11, 16);
const element = () => ({});
const threadKey = (message) => message.address;
const notifyOn = () => true, notifyPermission = () => 'granted', watchingChat = () => false;
const shown = [];
let tones = 0;
const showChatNotification = async (note) => { shown.push(note); };
const notificationFor = (message) => message.address;
const playTone = () => { tones++; return true; };
globalThis.setTimeout = (run) => run();
""" + "\n".join((block, muted_rule, notice, notifier, rule)) + """
let now = Date.UTC(2026, 10, 24, 21, 0);
muteClock = () => now;
const wrong = [];
const same = (label, got, want) => { if (JSON.stringify(got) !== JSON.stringify(want)) wrong.push(label + ': ' + JSON.stringify(got)); };
// Older lists: an entry without an end is muted forever.
webChats = {muted: ['sam'], locks: {}};
same('older entry is forever', muteEnds('sam'), 0);
same('forever label', muteLabel(0), 'Muted');
// Timed, chat and server, and the labels.
webChats = muteKeys(['maya'], 6 * 3600000);
same('timed end', muteEnds('maya'), now + 6 * 3600000);
same('six hours', muteLabel(muteEnds('maya')), 'Muted for 6 hours');
same('later today', muteLabel(Date.UTC(2026, 10, 24, 22, 40)), 'Muted until 22:40');
same('a day', muteLabel(now + 86400000), 'Muted for 1 day');
same('a week', muteLabel(now + 7 * 86400000), 'Muted for 1 week');
webChats = muteKeys([SERVER_MUTE + 'irc:fixture@irc.example.test'], 3600000);
same('server covers its channel', chatMuteEnds('#radio'), now + 3600000);
same('server covers its DMs', chatMuteEnds('kestrel'), now + 3600000);
same('other chats are not muted', chatMuteEnds('ana'), null);
webChats = muteKeys(['#radio'], 0);
same('forever beats the server', chatMuteEnds('#radio'), 0);
// A person: all of their addresses, muted when every one is.
webChats = muteKeys(['leo', '+12025550166'], 86400000);
same('person', keysMuteEnds(['leo', '+12025550166']), now + 86400000);
same('person partly', keysMuteEnds(['leo', '+12025550199']), null);
// Nothing notifies or chimes while muted; the tab count leaves them out; unread rows stay unread.
const arrive = (...addresses) => lookNoticeIncoming(addresses.map((address, index) => ({id: address + now + index, address, type: 1, read: 0, date: Date.now()})));
lookNoticeIncoming([]);
arrive('maya', '#radio', 'kestrel', 'leo', 'blocked-one');
same('muted stay quiet', [shown.length, tones], [0, 0]);
inbox = ['maya', '#radio', 'kestrel', 'ana'].map((address) => ({address, type: 1, read: 0, body: 'Fictional'}));
same('muted are not counted', [...unreadChats()], ['ana']);
arrive('ana');
same('others notify', [shown.slice(), tones], [['ana'], 1]);
// Time passes: the six-hour and server mutes end on their own; forever and the person's day stay.
now += 7 * 3600000;
arrive('maya', 'kestrel', '#radio', 'leo');
same('after the time is up', shown.slice(1), ['maya', 'kestrel']);
same('counted again', [...unreadChats()], ['maya', 'kestrel', 'ana']);
const tidy = pruneMutes(webChats);
same('expired ones are tidied', [tidy.muted.includes('maya'), tidy.muted.includes(SERVER_MUTE + 'irc:fixture@irc.example.test'), tidy.muted.includes('#radio')], [false, false, true]);
webChats = unmuteKeys(['#radio']);
same('unmute', chatMuteEnds('#radio'), null);
process.stdout.write(JSON.stringify(wrong));
"""
    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30, env={**os.environ, "TZ": "UTC"})
    check(result.returncode == 0 and result.stdout == "[]", "The mute rules are wrong: " + (result.stdout or result.stderr)[:600])


def web_details_effects_test(request):
    """Conversation details and members, call icons, the floating ⋯ menu, capped effects, and the sample inbox's fixtures."""
    import sqlite3
    for path, expected in (("/chats.js", b"function threadMembers"), ("/chats.js", b"function detailsPage"), ("/companion.js", b"function reachTiles"),
                           ("/app.js", b"function placeMessageMenu"), ("/cards.js", b"EFFECT_WAITING"), ("/cards.js", b"function stopEffects"),
                           ("/welcome.js", b"root.guideFlow?.stop()"), ("/features.css", b".details-page"), ("/style.css", b".message-tools.floats")):
        check(expected in request(path, authorized=False), f"Missing {expected.decode()} in {path}")
    check(b'id="head-info"' in request("/", authorized=False), "The chat's name doesn't open its details")
    companion_js, cards_js, chats_js = (request(path, authorized=False) for path in ("/companion.js", "/cards.js", "/chats.js"))
    # Video calls use a camera, never the people icon; canvases never take the raw device pixel ratio.
    check(b"headButton('meeting'" not in companion_js and b"meeting: 'M16 11a3" not in companion_js, "A video call button uses the people icon")
    check(b"canvas.width = innerWidth * scale" not in cards_js, "Effects draw full-window canvases at the device pixel ratio")
    # The sample like is Maya's on your message, so it must not say "(my message)", which would mean her own.
    check("Liked “See you there!” (my message)".encode() not in chats_js, "The sample reaction can't fold onto its message")
    chat_notice_test(cards_js, request("/app.js", authorized=False), request("/style.css", authorized=False))
    # IRC channels' members reach the browser for a group's details.
    with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db, db:
        db.execute("INSERT OR REPLACE INTO protocol_state VALUES ('channel:irc-fixture', ?)",
                   (json.dumps({"name": "#fixture", "topic": "Fictional topic", "members": ["mosaic", "kestrel"]}),))
    channels = request("/api/inbox").get("channels", {})
    check(channels.get("irc-fixture", {}).get("members") == ["mosaic", "kestrel"], "Channel members aren't in the inbox snapshot")
    web_people_test(request)


# The phone's chat setting notices (ChatNoticeTest.kt) and lookalikes that must stay ordinary messages.
CHAT_NOTICES = (("⏱️ Disappearing messages are on. New messages disappear after 1 day.", {"kind": "timer", "seconds": 86400}),
                ("⏱️ Disappearing messages are on. New messages disappear after 30 seconds.", {"kind": "timer", "seconds": 30}),
                ("⏱️ Disappearing messages are on. New messages disappear after 4 weeks.", {"kind": "timer", "seconds": 28 * 86400}),
                ("⏱ Disappearing messages are on. New messages disappear after 1 hour.\n", {"kind": "timer", "seconds": 3600}),
                ("⏱️ Disappearing messages are off.", {"kind": "timer", "seconds": 0}),
                ("🔒 Messages in this chat are now encrypted with FluidMessages.", {"kind": "encryption", "on": True}),
                ("🔓 Messages in this chat are no longer encrypted with FluidMessages.", {"kind": "encryption", "on": False}),
                ("Disappearing messages are off.", None), ("⏱️ Disappearing messages are off. Just kidding", None),
                ("⏱️ Disappearing messages are on. New messages disappear after 0 days.", None))


def chat_notice_test(cards_js, app_js, style_css):
    """The browser recognizes the phone's chat setting notices and draws them as outlined notes, not bubbles."""
    block = re.search(rb"// chat-notice:start[^\n]*\n(.*?)// chat-notice:end", cards_js, re.S)
    check(block, "cards.js has no chat setting notice parser")
    check(b"parseChatNotice" in app_js and re.search(rb"#conversation > \.event\.notice \{[^}]*border: 1px solid", style_css),
          "Chat setting notices aren't drawn as outlined notes")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("Skipped running the chat notice parser: node isn't installed (set NODE to its path)")
        return
    script = block.group(1).decode() + """
const cases = JSON.parse(process.argv[1]);
const wrong = cases.filter(([text, expected]) => JSON.stringify(parseChatNotice(text)) !== JSON.stringify(expected));
for (const seconds of [0, 30, 300, 3600, 28800, 86400, 604800, 2419200]) {
  const back = parseChatNotice(timerNoticeText(seconds));
  if (!back || back.seconds !== seconds) wrong.push(['timer', seconds]);
}
if (parseChatNotice(encryptionNoticeText(true))?.on !== true || parseChatNotice(encryptionNoticeText(false))?.on !== false) wrong.push(['encryption']);
process.stdout.write(JSON.stringify(wrong));
"""
    result = subprocess.run([node, "-e", script, json.dumps(CHAT_NOTICES, ensure_ascii=False)], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0 and result.stdout == "[]", "The browser's chat notice parser disagrees with the phone's: "
          + (result.stdout or result.stderr)[:400])


def web_people_test(request):
    """The Calls tab like the phone's Phone tab, the contacts list and contact pages, favorites, and sample photos."""
    people_js = request("/people.js", authorized=False)
    for expected in (b"function showPhoneTab", b"function knownPeople", b"function openPersonPage", b"function keypadView",
                     b"function openMemberContact", b"'Favorites'", b"'Recents'", b"'Contacts'", b"Text instead"):
        check(expected in people_js, f"Missing {expected.decode()} in /people.js")
    check(b"/people.js" in request("/", authorized=False), "The page doesn't load people.js")
    check(b"showPhoneTab" in request("/companion.js", authorized=False), "The Calls tab doesn't draw the phone-style sections")
    check(b"openMemberContact" in request("/chats.js", authorized=False), "A group member doesn't open their contact page")
    shell = request("/sw.js", authorized=False)
    for path in ("/people.js", "/samples/maya.webp", "/samples/jordan.webp"):
        check(path.encode() in shell, f"The offline cache leaves out {path}")
        if path.endswith(".webp"):
            picture = request(path, authorized=False)
            check(picture[:4] == b"RIFF" and picture[8:12] == b"WEBP", f"{path} isn't the sample WebP portrait")
            check(picture == (ROOT / "app/src/main/res/drawable-nodpi" / ("sample_" + Path(path).name)).read_bytes(),
                  f"{path} differs from the phone's sample portrait")
    check(b"COPY samples/" in (ROOT / "server/Dockerfile").read_bytes(), "The Docker image leaves out the sample portraits")
    # Favorites are kept for every browser, by number or chat address, and only as short plain text.
    favorites = ["+12025550123", "web-fixture"]
    check(request("/api/settings", {"web_favorites": favorites + ["+12025550123"]})["web_favorites"] == favorites, "Favorites weren't saved")
    check(request("/api/inbox")["web_favorites"] == favorites, "The inbox doesn't carry favorites")
    for bad in ("+12025550123", [5], ["x" * 301], ["line\nbreak"], [""]):
        try:
            request("/api/settings", {"web_favorites": bad})
            raise RuntimeError("Invalid favorites were accepted: " + json.dumps(bad))
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for invalid favorites, got {error.code}")
    check(request("/api/settings", {"web_favorites": []})["web_favorites"] == [], "Favorites couldn't be cleared")
    # Counts on the tabs: on by default, a server preference, and drawn white on red on both tab bars.
    for expected in (b"function updateTabBadges", b"setAppBadge", b"clearAppBadge", b"function tabCountsCard", b"markCallsSeen"):
        check(expected in people_js, f"Missing {expected.decode()} in /people.js")
    check(b"tabCountsCard" in request("/settings.js", authorized=False), "Settings → Messaging has no Show counts on tabs")
    check(re.search(rb"\.tab-badge \{[^}]*color: #fff", request("/features.css", authorized=False)), "Tab counts aren't white on their fill")
    check(request("/api/inbox")["prefs"].get("tabCounts") is True, "Counts on tabs aren't on by default")
    check(request("/api/settings", {"prefs": {"tabCounts": False}})["prefs"]["tabCounts"] is False, "Counts on tabs couldn't be turned off")
    check(request("/api/settings", {"prefs": {"tabCounts": True}})["prefs"]["tabCounts"] is True, "Counts on tabs couldn't be turned back on")
    web_inbox_sounds_test(request)


def web_inbox_sounds_test(request):
    """The inbox filter's Unread, Settings → Sounds and notifications, notifications through the service worker,
    and New chat's People and Channels."""
    index = request("/", authorized=False).decode()
    options = re.search(r'<select id="folder"[^>]*>(.*?)</select>', index, re.S)
    check(options and re.findall(r"<option>([^<]+)</option>", options.group(1)) == ["Inbox", "Unread", "Archived", "Blocked"],
          "The inbox filter doesn't offer Inbox, Unread, Archived, and Blocked in that order")
    check(index.index('class="folder-filter"') > index.index('id="inbox-title"') and index.index('class="folder-filter"') < index.index('id="threads"'),
          "The inbox filter left the top of the inbox")
    check("/notify.js" in index, "The page doesn't load notify.js")
    people_js, app_js, chats_js = (request(path, authorized=False).decode() for path in ("/people.js", "/app.js", "/chats.js"))
    check("function unreadIncoming" in people_js and "unreadIncoming(message, quiet, now)" in people_js.split("function countTabs", 1)[1],
          "The Chats tab count and Unread don't share one rule")
    check("unreadChats()" in app_js and "unread.has(address)" in app_js
          and "case 'unread': return !!chat.unread" in request("/inbox-filters.js", authorized=False).decode(),
          "The inbox filter's Unread isn't drawn from the unread rule")
    check(len(re.findall(r"'(?:Leo Park|Kestrel)', 0\)", chats_js)) == 2, "The sample inbox has no unread chats to try Unread with")
    notify_js = request("/notify.js", authorized=False).decode()
    for expected in ("registration.showNotification", "Notification.requestPermission", "isSecureContext", "Send a test notification",
                     "Show message text in notifications", "Sounds for muted chats", "decoyLike", "sampleOn", "watchingChat",
                     "fluid-open-chat", "push notifications", "Allowed", "Blocked", "Not asked"):
        check(expected in notify_js, f"Missing {expected} in /notify.js")
    # Permission is asked only from a click: every requestPermission is inside askNotifyPermission, which only buttons call.
    check(notify_js.count("Notification.requestPermission") == 2 and notify_js.count("await askNotifyPermission()") == 2
          and all("addEventListener('click'" in notify_js[max(0, m.start() - 400):m.start()]
                  for m in re.finditer(r"await askNotifyPermission\(\)", notify_js)),
          "Notification permission is asked outside a click")
    shell = request("/sw.js", authorized=False).decode()
    check("'/notify.js'" in shell and "notificationclick" in shell and "postMessage" in shell and "openWindow" in shell,
          "The service worker doesn't cache notify.js or open the chat from a notification")
    check("?chat=" not in shell and "#chat=" not in shell, "The notification puts the chat in the address")
    settings_js = request("/settings.js", authorized=False).decode()
    look_group = settings_js.split("['Look and feel', [", 1)[1].split("]],", 1)[0]
    check("title: 'Sounds and notifications'" in look_group and "id: 'sounds'" in look_group,
          "Sounds and notifications isn't in Look and feel")
    look_js = request("/look.js", authorized=False).decode()
    check("out.gain.value = .16 * volume / 100" in look_js, "The volume doesn't scale the Web Audio gain")
    check("lookChoice('Outgoing sound'" not in look_js and "Motion and haptics" in look_js, "Sounds are still on the appearance page")
    check("notifyIncoming(loud, played)" in look_js, "New messages don't reach the notifications")
    servers_js, companion_js = (request(path, authorized=False).decode() for path in ("/servers.js", "/companion.js"))
    check("function newChatChannels" in servers_js and "Join or browse…" in servers_js and "openAddServer()" in servers_js
          and "No servers yet" in servers_js, "New chat has no Channels list")
    check("[[form, 'People'], [channels, 'Channels']]" in companion_js, "New chat has no People and Channels switch")
    # Sound choices, volume, and muted-chat sounds are saved and cleaned; old keys keep working.
    sounds = {"theme": "fluid", "mode": "system", "sendSound": "pop", "receiveSound": "ding", "soundVolume": 40, "mutedSounds": True}
    check(request("/api/settings", {"web_appearance": sounds})["web_appearance"] == sounds, "Sound choices weren't saved")
    noisy = {**sounds, "sendSound": "airhorn", "soundVolume": 150, "mutedSounds": "yes"}
    check(request("/api/settings", {"web_appearance": noisy})["web_appearance"] == {"theme": "fluid", "mode": "system", "receiveSound": "ding"},
          "Invalid sound choices were kept")
    old = {"theme": "fluid", "mode": "system", "sendSound": "silent", "receiveSound": "fluid"}
    check(request("/api/settings", {"web_appearance": old})["web_appearance"] == old, "The older sound choices stopped working")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("Skipped running the unread rule and theme switching: node isn't installed (set NODE to its path)")
        return
    # Switching or resetting a theme keeps the sound choices (look.js themeLook), and the unread rule leaves out
    # muted, archived, blocked, private, expired, and call rows (people.js).
    theme = re.search(r"const THEME_KEYS = .*?\n(?=/\*\* The look settings)", look_js, re.S).group(0)
    rule = re.search(r"/\*\* Chats that never count.*?(?=function countTabs)", people_js, re.S).group(0)
    script = theme + rule + """
let sampleOn = false, sampleChats = {}, webChats = {muted: ['m'], archived: ['a'], blocked: ['b']}, appearance = {folders: {archived: ['pa']}};
const privateFolderHas = (address) => address === 'p';
const threadKey = (message) => message.address;
const row = (address, extra = {}) => ({address, type: 1, read: 0, body: 'Fictional', ...extra});
let inbox = [row('u'), row('m'), row('a'), row('b'), row('pa'), row('p'), row('r', {read: 1}), row('o', {type: 2}),
  row('x', {expires: 1}), row('c', {event: 'call', body: 'Voice call · missed'})];
const wrong = [];
if (JSON.stringify([...unreadChats()]) !== '["u"]') wrong.push('unread ' + JSON.stringify([...unreadChats()]));
sampleOn = true; sampleChats = {muted: ['u']};
if (unreadChats().size !== 4) wrong.push('sample ' + JSON.stringify([...unreadChats()]));
const look = {theme: 'ember', colors: {sms: '#123456'}, sendSound: 'pop', receiveSound: 'bubble', soundVolume: 30, mutedSounds: true, speed: 0, haptics: 'soft'};
const next = themeLook(look, 'midnight');
for (const key of ['sendSound', 'receiveSound', 'soundVolume', 'mutedSounds', 'speed', 'haptics']) if (next[key] !== look[key]) wrong.push(key);
if (next.colors || next.theme !== 'midnight') wrong.push('theme colors');
process.stdout.write(JSON.stringify(wrong));
"""
    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0 and result.stdout == "[]", "Unread or theme switching is wrong: " + (result.stdout or result.stderr)[:400])


def cloud_smoke_test():
    if not shutil.which("rclone"):
        print("SKIP  Cloud backup fixture test (rclone is not installed)")
        return
    with companion(free_port(), secrets.token_hex(32), cloud_fixtures=True) as (_, request, _):
        check(request("/api/backups")["targets"] == list(CLOUD_TARGETS), "Cloud target discovery failed")
        try:
            request("/api/backups/drive", b"not a backup", method="PUT")
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for an invalid backup, got {error.code}")
        else:
            raise RuntimeError("The server accepted an invalid archive")
        older = b"FMB1\x01older fixture"
        newest = b"FMB1\x01newest fixture"
        for target in CLOUD_TARGETS:
            path = "/api/backups/" + target
            dated = request(path, older, method="PUT")["name"]
            check(re.fullmatch(r"FluidMessages_\d{4}-\d{2}-\d{2}_.+\.fmb", dated), "Missing readable backup date")
            time.sleep(.005)
            request(path, newest, method="PUT")
            check(request(path + "/latest") == newest, f"The latest {target} backup did not round-trip")
            fixed = {"X-Fluid-Backup-Name": "My current backup.fmb"}
            request(path, newest, method="PUT", extra_headers=fixed)
            response = request(path, older, method="PUT", extra_headers=fixed)
            check(response["name"] == fixed["X-Fluid-Backup-Name"], "Fixed name was lost")
            check(request(path + "/latest") == older, "The fixed backup did not get replaced")
        try:
            request("/api/backups/drive", older, method="PUT", extra_headers={"X-Fluid-Backup-Name": "../outside.fmb"})
        except HTTPError as error:
            check(error.code == 400, "Invalid backup name produced the wrong response")
        else:
            raise RuntimeError("The server accepted a backup path instead of a filename")
    print("PASS  Cloud target discovery, dated names, fixed-name replacement, and newest restore across three isolated destinations")


def gateway_relations_test():
    """Replies and reactions use native Matrix and RFC 9078 email features with fictional fixtures."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    from email import policy
    from email.parser import BytesParser
    import protocol_gateway

    with tempfile.TemporaryDirectory(prefix="fluid-gateway-") as directory:
        database = str(Path(directory) / "gateway.sqlite")

        def connect():
            return sqlite3.connect(database)

        with connect() as db:
            db.executescript(protocol_gateway.SCHEMA)
        config = {"matrix": {"homeserver": "https://matrix.example.test", "access_token": "fixture",
                             "user_id": "@me:example.test"},
                  "email": {"address": "me@example.test", "smtp_host": "smtp.example.test", "smtp_password": "x",
                            "imap_host": "imap.example.test", "imap_password": "x"},
                  "routes": [{"address": "maya", "protocol": "matrix", "target": "!room:example.test", "title": "Maya"},
                             {"address": "maya", "protocol": "email", "target": "maya@example.test", "title": "Maya"}]}
        gateway = protocol_gateway.Gateway(connect, config, Path(directory) / "files")
        route = gateway.route("maya", "matrix")
        sent = []

        def fake_matrix(path, body=None, allow_missing=False, method=None):
            if allow_missing:
                return None
            sent.append((path, body))
            return {"event_id": "$out" + str(len(sent))}

        gateway.matrix_request = fake_matrix

        def deliver(message, send):
            # Same bookkeeping as Gateway.sender after a successful send.
            message.update(send(gateway.route("maya", message["protocol"]), message) or {})
            with connect() as db:
                db.execute("UPDATE protocol_messages SET payload=? WHERE id=?", (json.dumps(message), message["id"]))
        gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in1", "sender": "@maya:example.test",
                                      "origin_server_ts": 1, "content": {"msgtype": "m.text", "body": "Coffee at ten?"}})
        incoming = gateway.find("maya", "matrix", "event_id", "$in1")
        check(incoming is not None, "Matrix message did not keep its event ID")

        def enqueue(relation, body, text=""):
            with connect() as db:
                return gateway.enqueue(db, {"address": "maya", "protocol": "matrix", "body": body, "text": text,
                                            "request": secrets.token_hex(8), "relation": relation})["message"]

        reaction = enqueue({"kind": "reaction", "target": incoming["id"], "emoji": "👍"}, "Liked “Coffee at ten?”")
        check(reaction.get("reaction_target") == incoming["id"], "Reaction lost its target")
        deliver(reaction, gateway.send_matrix)
        check(sent[-1][0].startswith("rooms/") and "/send/m.reaction/" in sent[-1][0]
              and sent[-1][1]["m.relates_to"] == {"rel_type": "m.annotation", "event_id": "$in1", "key": "👍"},
              "Matrix reaction was not sent as an annotation")
        reply = enqueue({"kind": "reply", "target": incoming["id"]}, "Reply to “Coffee at ten?”\n\nSure", "Sure")
        deliver(reply, gateway.send_matrix)
        check(sent[-1][1] == {"msgtype": "m.text", "body": "Sure", "m.relates_to": {"m.in_reply_to": {"event_id": "$in1"}}},
              "Matrix reply was not linked natively")
        try:
            enqueue({"kind": "reaction", "target": incoming["id"], "emoji": "hello"}, "Reacted hello")
            raise RuntimeError("Gateway accepted a text reaction")
        except ValueError:
            pass

        gateway.accept_matrix(route, {"type": "m.reaction", "event_id": "$in2", "sender": "@maya:example.test",
                                      "origin_server_ts": 2, "content": {"m.relates_to": {
                                          "rel_type": "m.annotation", "event_id": "$out2", "key": "❤️"}}})
        folded = gateway.find("maya", "matrix", "event_id", "$in2")
        check(folded and folded["reaction_target"] == reply["id"] and folded["body"].startswith("Loved “"),
              "Incoming Matrix reaction did not fold onto the sent reply")
        gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in3", "sender": "@maya:example.test",
                                      "origin_server_ts": 3, "content": {"msgtype": "m.text",
                                      "body": "> <@me:example.test> Sure\n\nGreat",
                                      "m.relates_to": {"m.in_reply_to": {"event_id": "$out2"}}}})
        quoted = gateway.find("maya", "matrix", "event_id", "$in3")
        check(quoted["body"].endswith("\n\nGreat") and quoted["body"].startswith("Reply to “")
              and quoted["reply_target"] == reply["id"], "Incoming Matrix reply kept its legacy fallback")

        mail_route = gateway.route("maya", "email")
        gateway.accept_mail(mail_route, "1", 1, b"From: Maya <maya@example.test>\r\nMessage-ID: <m1@example.test>\r\n"
                            b"Subject: Plans\r\nDate: Mon, 1 Jan 2024 10:00:00 +0000\r\n\r\nSee you there\r\n")
        first = gateway.find("maya", "email", "mail_id", "<m1@example.test>")
        outgoing = []

        class FakeSmtp:
            def __init__(self, *args, **kwargs): pass
            def __enter__(self): return self
            def __exit__(self, *args): return False
            def login(self, *args): pass
            def send_message(self, envelope, **kwargs): outgoing.append(envelope)

        protocol_gateway.smtplib.SMTP_SSL = FakeSmtp
        with connect() as db:
            mail = gateway.enqueue(db, {"address": "maya", "protocol": "email", "body": "Liked “See you there”",
                                        "request": secrets.token_hex(8),
                                        "relation": {"kind": "reaction", "target": first["id"], "emoji": "👍"}})["message"]
        deliver(mail, gateway.send_mail)
        envelope = outgoing[-1]
        check(envelope["In-Reply-To"] == "<m1@example.test>" and envelope.get_content_disposition() == "reaction"
              and envelope.get_content().strip() == "👍" and "FluidMessages" not in envelope.get_content(),
              "Email reaction does not follow RFC 9078")
        gateway.accept_mail(mail_route, "1", 2, b"From: maya@example.test\r\nMessage-ID: <m2@example.test>\r\n"
                            b"In-Reply-To: <m1@example.test>\r\nContent-Type: text/plain; charset=utf-8\r\n"
                            b"Content-Disposition: reaction\r\n\r\n" + "😆".encode() + b"\r\n")
        laughed = gateway.find("maya", "email", "mail_id", "<m2@example.test>")
        check(laughed and laughed["reaction_target"] == first["id"] and laughed["body"].startswith("Laughed at “"),
              "Incoming email reaction did not fold")
        # Attachments: upload, attach, send as Matrix media and an email attachment, and receive both.
        import io
        pdf = b"%PDF-1.4 fixture"
        with connect() as db:
            upload = gateway.store_upload(db, io.BytesIO(pdf), len(pdf), "application/pdf", "plan.pdf")["upload"]
            try:
                gateway.store_upload(db, io.BytesIO(b"x"), protocol_gateway.MAX_FILE + 1, "text/plain", "big.txt")
                raise RuntimeError("Gateway accepted an oversized upload")
            except ValueError:
                pass
            filed = gateway.enqueue(db, {"address": "maya", "protocol": "matrix", "body": "plan.pdf", "text": "",
                                         "request": secrets.token_hex(8),
                                         "attachment": {"upload": upload, "kind": "file"}})["message"]
        check(filed["attachment"]["name"] == "plan.pdf" and gateway.file_path(filed["id"]).read_bytes() == pdf,
              "Uploaded attachment was not moved onto its message")
        uploads = []

        def fake_raw(url, data=None, headers=None, method=None, limit=0):
            uploads.append((url, data, headers))
            return json.dumps({"content_uri": "mxc://example.test/abc"}).encode()

        gateway.matrix_raw = fake_raw
        deliver(filed, gateway.send_matrix)
        check(uploads[-1][1] == pdf and sent[-1][1]["msgtype"] == "m.file" and sent[-1][1]["url"] == "mxc://example.test/abc"
              and sent[-1][1]["filename"] == "plan.pdf", "Matrix file was not sent through the media repository")
        with connect() as db:
            voice_upload = gateway.store_upload(db, io.BytesIO(b"aac"), 3, "audio/mp4", "Voice message")["upload"]
            voice = gateway.enqueue(db, {"address": "maya", "protocol": "matrix", "body": "Voice message", "text": "",
                                         "request": secrets.token_hex(8),
                                         "attachment": {"upload": voice_upload, "kind": "voice", "duration": 4200}})["message"]
        deliver(voice, gateway.send_matrix)
        check(sent[-1][1]["msgtype"] == "m.audio" and "org.matrix.msc3245.voice" in sent[-1][1]
              and sent[-1][1]["info"]["duration"] == 4200, "Voice message was not marked as a Matrix voice note")
        gateway.matrix_download = lambda mxc: b"\x89PNG fixture"
        gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in4", "sender": "@maya:example.test",
                                      "origin_server_ts": 4, "content": {"msgtype": "m.image", "body": "lake.png",
                                      "url": "mxc://example.test/lake", "info": {"mimetype": "image/png", "size": 12}}})
        photo = gateway.find("maya", "matrix", "event_id", "$in4")
        check(photo and photo["attachment"]["kind"] == "photo" and gateway.file_path(photo["id"]).read_bytes() == b"\x89PNG fixture",
              "Incoming Matrix image was not stored")
        with connect() as db:
            mail_upload = gateway.store_upload(db, io.BytesIO(pdf), len(pdf), "application/pdf", "plan.pdf")["upload"]
            mailed = gateway.enqueue(db, {"address": "maya", "protocol": "email", "body": "Here it is", "text": "Here it is",
                                          "request": secrets.token_hex(8), "attachment": {"upload": mail_upload}})["message"]
        deliver(mailed, gateway.send_mail)
        parts = list(outgoing[-1].iter_attachments())
        check(len(parts) == 1 and parts[0].get_filename() == "plan.pdf" and parts[0].get_content() == pdf
              and "Sent with FluidMessages" in outgoing[-1].get_body(("plain",)).get_content(), "Email attachment was not sent")
        raw = (b"From: maya@example.test\r\nMessage-ID: <m3@example.test>\r\nMIME-Version: 1.0\r\n"
               b"Content-Type: multipart/mixed; boundary=b\r\n\r\n--b\r\nContent-Type: text/plain\r\n\r\nMenu attached\r\n"
               b"--b\r\nContent-Type: application/pdf\r\nContent-Disposition: attachment; filename=menu.pdf\r\n"
               b"Content-Transfer-Encoding: base64\r\n\r\nJVBERi0xLjQ=\r\n--b--\r\n")
        gateway.accept_mail(mail_route, "1", 3, raw)
        menu = gateway.find("maya", "email", "mail_id", "<m3@example.test>")
        check(menu and menu["attachment"]["name"] == "menu.pdf" and menu["body"] == "Menu attached"
              and gateway.file_path(menu["id"]).read_bytes() == b"%PDF-1.4", "Incoming email attachment was not stored")
        import matrix_e2ee
        if matrix_e2ee.available():
            # An encrypted image: the companion downloads the ciphertext and decrypts it with the event's key.
            from nio.crypto.attachments import encrypt_attachment
            ciphertext, keys = encrypt_attachment(b"\x89PNG secret fixture")
            gateway.matrix_download = lambda mxc: ciphertext
            gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in5", "sender": "@maya:example.test",
                                          "origin_server_ts": 5, "content": {"msgtype": "m.image", "body": "lake.png",
                                          "file": {**keys, "url": "mxc://example.test/secret"}, "info": {"mimetype": "image/png"}}})
            secret = gateway.find("maya", "matrix", "event_id", "$in5")
            check(secret and gateway.file_path(secret["id"]).read_bytes() == b"\x89PNG secret fixture",
                  "Encrypted Matrix attachment was not decrypted")
            print("PASS  encrypted Matrix attachments decrypt on the companion")
        else:
            print("SKIP  Matrix encryption checks (matrix-nio[e2e] is not installed)")
    print("PASS  companion replies, reactions, and attachments use native Matrix and email features")


def reaction_revisions_test():
    """Removing or changing a reaction is native on Matrix and XMPP, with fictional fixtures."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import protocol_gateway

    with tempfile.TemporaryDirectory(prefix="fluid-revisions-") as directory:
        database = str(Path(directory) / "gateway.sqlite")

        def connect():
            return sqlite3.connect(database)

        with connect() as db:
            db.executescript(protocol_gateway.SCHEMA)
        config = {"matrix": {"homeserver": "https://matrix.example.test", "access_token": "fixture",
                             "user_id": "@me:example.test"},
                  "routes": [{"address": "maya", "protocol": "matrix", "target": "!room:example.test", "title": "Maya"},
                             {"address": "leo", "protocol": "xmpp", "target": "leo@example.test", "title": "Leo"}]}
        gateway = protocol_gateway.Gateway(connect, config, Path(directory) / "files")
        sent, stanzas = [], []

        def fake_matrix(path, body=None, allow_missing=False, method=None):
            if allow_missing:
                return None
            sent.append((path, body))
            return {"event_id": "$out" + str(len(sent))}

        class FakeXmpp:
            def send(self, to, text, group=False, reply=None, reply_author=None, react=None, file=None):
                stanzas.append({"to": to, "text": text, "reply": reply, "react": react})
                return "xout" + str(len(stanzas))

        gateway.matrix_request = fake_matrix
        gateway.client = lambda protocol: FakeXmpp()

        def send(address, protocol, relation, body):
            with connect() as db:
                message = gateway.enqueue(db, {"address": address, "protocol": protocol, "body": body, "text": "",
                                               "request": secrets.token_hex(8), "relation": relation})["message"]
            route = gateway.route(address, protocol)
            message.update({"matrix": gateway.send_matrix, "xmpp": gateway.send_xmpp}[protocol](route, message) or {})
            message["status"] = "Sent"
            with connect() as db:
                db.execute("UPDATE protocol_messages SET payload=? WHERE id=?", (json.dumps(message), message["id"]))
            return message

        route = gateway.route("maya", "matrix")
        gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in1", "sender": "@maya:example.test",
                                      "origin_server_ts": 1, "content": {"msgtype": "m.text", "body": "Coffee at ten?"}})
        coffee = gateway.find("maya", "matrix", "event_id", "$in1")
        send("maya", "matrix", {"kind": "reaction", "target": coffee["id"], "emoji": "👍"}, "Liked “Coffee at ten?”")
        first = sent[-1]
        send("maya", "matrix", {"kind": "reaction", "target": coffee["id"], "emoji": "❤️", "previous": "👍"},
             "Changed reaction from 👍 to ❤️ on “Coffee at ten?”")
        check(sent[-2][0].startswith("rooms/") and "/redact/%24out1/" in sent[-2][0] and sent[-2][1] == {}
              and sent[-1][1]["m.relates_to"]["key"] == "❤️" and first[1]["m.relates_to"]["key"] == "👍",
              "Changing a Matrix reaction did not redact the old one and send the new one")
        changed_event = "$out" + str(len(sent))
        count = len(sent)
        removal = send("maya", "matrix", {"kind": "reaction", "target": coffee["id"], "emoji": "❤️", "removed": True},
                       "Removed a heart from “Coffee at ten?”")
        check(len(sent) == count + 1 and "/redact/" + changed_event.replace("$", "%24") + "/" in sent[-1][0]
              and removal.get("reaction_target") == coffee["id"], "Removing a Matrix reaction did not redact it")
        try:
            with connect() as db:
                gateway.enqueue(db, {"address": "maya", "protocol": "matrix", "body": "x", "request": secrets.token_hex(8),
                                     "relation": {"kind": "reaction", "target": coffee["id"], "emoji": "👍",
                                                  "previous": "hello"}})
            raise RuntimeError("Gateway accepted a text previous reaction")
        except ValueError:
            pass
        gateway.accept_matrix(route, {"type": "m.reaction", "event_id": "$in2", "sender": "@maya:example.test",
                                      "origin_server_ts": 2, "content": {"m.relates_to": {
                                          "rel_type": "m.annotation", "event_id": "$in1", "key": "😆"}}})
        gateway.accept_matrix(route, {"type": "m.room.redaction", "event_id": "$in3", "sender": "@maya:example.test",
                                      "origin_server_ts": 3, "redacts": "$in2", "content": {}})
        taken = gateway.find("maya", "matrix", "event_id", "$in3")
        check(taken and taken["body"] == "Removed a laugh from “Coffee at ten?”" and taken["reaction_target"] == coffee["id"],
              "A redacted Matrix reaction was not recorded as a removal")

        gateway.accept_xmpp("leo@example.test", "leo@example.test", "Lunch?", "x1", 1, False, {})
        lunch = gateway.find("leo", "xmpp", "xmpp_id", "x1")
        gateway.accept_xmpp("leo@example.test", "leo@example.test", "", "x2", 2, False, {"reaction": "👍", "reaction_to": "x1"})
        gateway.accept_xmpp("leo@example.test", "leo@example.test", "", "x3", 3, False, {"reaction": "", "reaction_to": "x1"})
        taken = gateway.find("leo", "xmpp", "xmpp_id", "x3")
        check(taken and taken["body"] == "Removed a like from “Lunch?”" and taken["reaction_target"] == lunch["id"],
              "An empty XMPP reaction set was not recorded as a removal")
        send("leo", "xmpp", {"kind": "reaction", "target": lunch["id"], "emoji": "❤️", "previous": "👍"},
             "Changed reaction from 👍 to ❤️ on “Lunch?”")
        check(stanzas[-1]["react"] == ["❤️"] and stanzas[-1]["reply"] == "x1", "Changing an XMPP reaction did not send the new set")
        send("leo", "xmpp", {"kind": "reaction", "target": lunch["id"], "emoji": "❤️", "removed": True},
             "Removed a heart from “Lunch?”")
        check(stanzas[-1]["react"] == [], "Removing an XMPP reaction did not send an empty set")
    print("PASS  removing and changing reactions is native on Matrix and XMPP and recorded from others")


def email_quotes_test():
    """Incoming email replies lose the quoted history, with fictional fixtures."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import protocol_gateway

    with tempfile.TemporaryDirectory(prefix="fluid-mail-") as directory:
        database = str(Path(directory) / "gateway.sqlite")

        def connect():
            return sqlite3.connect(database)

        with connect() as db:
            db.executescript(protocol_gateway.SCHEMA)
        config = {"email": {"address": "me@example.test", "smtp_host": "smtp.example.test", "smtp_password": "x",
                            "imap_host": "imap.example.test", "imap_password": "x"},
                  "routes": [{"address": "maya", "protocol": "email", "target": "maya@example.test", "title": "Maya"}]}
        gateway = protocol_gateway.Gateway(connect, config, Path(directory) / "files")
        route = gateway.route("maya", "email")

        def mail(uid, message_id, body, reply_to=""):
            headers = (f"From: Maya <maya@example.test>\r\nMessage-ID: {message_id}\r\nSubject: Plans\r\n"
                       f"Date: Mon, 1 Jan 2024 10:0{uid}:00 +0000\r\n")
            if reply_to:
                headers += f"In-Reply-To: {reply_to}\r\n"
            gateway.accept_mail(route, "1", uid, (headers + "\r\n" + body).encode())
            return gateway.find("maya", "email", "mail_id", message_id)

        first = mail(1, "<m1@example.test>", "Lunch on Friday?")
        check(first["read"] == 0, "A new email arrived already read")
        with connect() as db, db:
            check(gateway.mark_read(db, {"ids": [first["id"]]}) == {"read": 1}, "Reading an email did not mark it read")
        check(gateway.find("maya", "email", "id", first["id"])["read"] == 1, "The read email still shows as unread")
        try:
            with connect() as db:
                gateway.mark_read(db, {"ids": "everything"})
            raise RuntimeError("Gateway accepted an invalid read request")
        except ValueError:
            pass
        second = mail(2, "<m2@example.test>", "hello there\r\n\r\nOn Sun, Nov 22, 2026 at 11:47 PM\r\n"
                      "<me@example.test> wrote:\r\n\r\n> hello\r\n>\r\n> Sent with FluidMessages\r\n>\r\n",
                      "<m1@example.test>")
        check(second["body"] == "hello there" and "reply_target" not in second,
              "An email reply to the latest message kept its quoted history")
        third = mail(3, "<m3@example.test>", "Yes, Friday works\r\n\r\nOn Mon, Maya <maya@example.test> wrote:\r\n> Lunch on Friday?\r\n",
                     "<m1@example.test>")
        check(third["body"] == "Reply to “Lunch on Friday?”\n\nYes, Friday works" and third["reply_target"] == first["id"],
              "An email reply to an older message did not become a reply card")
        with connect() as db, db:
            old = dict(first, id="mail-old", body="Old reply\n\nOn Sun, Maya wrote:\n> earlier", mail_id="<old@example.test>")
            db.execute("INSERT INTO protocol_messages VALUES (?, ?, ?)", ("mail-old", 0, json.dumps(old)))
        gateway.strip_stored_quotes()
        check(gateway.find("maya", "email", "id", "mail-old")["body"] == "Old reply", "Stored emails kept their quoted history")
    print("PASS  incoming email replies drop the quoted history, and reading a message clears it everywhere")


def privacy_calls_test():
    """Hidden chats, disappearing messages, group members, and call relay on the companion, with fictional fixtures."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import protocol_gateway

    with tempfile.TemporaryDirectory(prefix="fluid-privacy-") as directory:
        database = str(Path(directory) / "gateway.sqlite")

        def connect():
            return sqlite3.connect(database)

        with connect() as db:
            db.executescript(protocol_gateway.SCHEMA)
        config = {"matrix": {"homeserver": "https://matrix.example.test", "user_id": "@me:example.test", "access_token": "x"},
                  "routes": [{"address": "maya", "protocol": "matrix", "target": "!maya:example.test", "title": "Maya"},
                             {"address": "club", "protocol": "matrix", "target": "!club:example.test", "title": "Club",
                              "group": True},
                             {"address": "jordan", "protocol": "email", "target": "jordan@example.test", "title": "Jordan"}]}
        gateway = protocol_gateway.Gateway(connect, config, Path(directory) / "files")
        sent = []
        gateway.matrix_request = lambda path, body=None, allow_missing=False, method=None: (
            sent.append((path, body, method)) or {"event_id": "$sent" + str(len(sent))})
        now = gateway.time()
        maya, jordan = gateway.route("maya", "matrix"), gateway.route("jordan", "email")
        gateway.add_incoming(gateway.message(maya, "m-old", "Old news", False, now - 7200_000))
        gateway.add_incoming(gateway.message(maya, "m-new", "Fresh", False, now))
        mine = gateway.message(maya, "m-mine", "Mine", True, now - 7200_000, "Sent")
        mine["event_id"] = "$mine"
        gateway.add_incoming(mine)
        gateway.add_incoming(gateway.message(jordan, "j-1", "Quarterly plans", False, now))
        gateway.add_incoming(gateway.message(maya, "m-before", "From before the timer", False, now - 5 * 3600_000))

        with connect() as db, db:
            gateway.save_settings(db, {"hidden_protocols": ["EMAIL"], "disappearing": {"default": 0, "chats": {"maya": 3600},
                                                                         "since": {"maya": now - 3 * 3600_000}}},
                                  from_phone=True)
            shown = {message["id"] for message in gateway.snapshot(db)["messages"]}
        check("j-1" not in shown, "A protocol hidden on the phone still showed on the companion")
        check("m-old" not in shown and "m-new" in shown, "An expired message still showed, or a fresh one was hidden")
        check(gateway.sweep_expired() == 2, "Expired messages were not deleted")
        check(any(path.startswith("rooms/%21maya%3Aexample.test/redact/%24mine/") for path, _, _ in sent),
              "Your own expired Matrix message was not redacted")
        check(gateway.find("maya", "matrix", "id", "m-new") is not None, "A message within its timer was deleted")
        check(gateway.find("maya", "matrix", "id", "m-before") is not None, "Turning on a timer deleted earlier messages")
        with connect() as db, db:
            gateway.save_settings(db, {"disappearing": {"default": 0, "chats": {"jordan": 60}}})
        check(gateway.sweep_expired() == 0, "A timer set in the browser deleted earlier messages")

        with connect() as db, db:
            gateway.save_settings(db, {"follow_phone": False, "disappearing": {"default": 60, "chats": {}}})
            gateway.save_settings(db, {"disappearing": {"default": 0, "chats": {}}, "hidden_protocols": []}, from_phone=True)
            settings = gateway.settings(db)
        check(settings["disappearing"]["default"] == 60 and settings["hidden_protocols"] == [],
              "Companion settings did not stay its own when not following the phone")
        with connect() as db, db:
            gateway.save_settings(db, {"fluid_encryption": {"protocols": ["sms"], "chats": {"maya": "on"}}}, from_phone=True)
            reset = gateway.save_settings(db, {"reset": True})
        check(reset["disappearing"]["default"] == 0 and reset["follow_phone"] and reset["fluid_encryption"]["chats"] == {"maya": "on"},
              "Resetting companion settings lost the phone's encryption info or kept old timers")
        try:
            with connect() as db:
                gateway.save_settings(db, {"disappearing": {"default": -5, "chats": {}}})
            raise RuntimeError("Companion accepted a negative timer")
        except ValueError:
            pass

        with connect() as db:
            gateway.change_member(db, {"address": "club", "protocol": "matrix", "action": "add", "member": "@sam:example.test"})
            gateway.change_member(db, {"address": "club", "protocol": "matrix", "action": "remove", "member": "@sam:example.test"})
        check(sent[-2][0].endswith("/invite") and sent[-1][0].endswith("/kick") and sent[-1][1]["user_id"] == "@sam:example.test",
              "Inviting or removing a Matrix member did not reach the room")
        for bad in ({"address": "club", "protocol": "matrix", "action": "add", "member": "sam"},
                    {"address": "jordan", "protocol": "email", "action": "add", "member": "x@example.test"},
                    {"address": "club", "protocol": "matrix", "action": "ban", "member": "@sam:example.test"}):
            try:
                with connect() as db:
                    gateway.change_member(db, bad)
                raise RuntimeError("Companion accepted an invalid member change")
            except ValueError:
                pass

        invite = {"type": "m.call.invite", "event_id": "$call", "sender": "@maya:example.test", "origin_server_ts": gateway.time(),
                  "content": {"call_id": "c1", "party_id": "p1", "version": "1", "lifetime": 60000,
                              "offer": {"type": "offer", "sdp": "v=0\r\nm=audio 9 UDP/TLS/RTP/SAVPF 111\r\n"}}}
        gateway.accept_matrix(maya, invite)
        events = gateway.call_events(0)
        check(events["events"][0]["type"] == "m.call.invite" and events["events"][0]["live"], "An incoming call did not ring")
        check(gateway.call_events(events["next"])["events"] == [], "Call events repeated after they were read")
        check(gateway.find("maya", "matrix", "event_id", "$call") is None
              and any(m.get("event") and m["body"].startswith("Voice call") for m in gateway.snapshot(connect())["messages"]),
              "The call was not noted in the conversation")
        gateway.send_call({"address": "maya", "protocol": "matrix", "type": "m.call.answer",
                           "content": {"call_id": "c1", "party_id": "p2", "version": "1", "answer": {"type": "answer", "sdp": "v=0"}}})
        check("/send/m.call.answer/" in sent[-1][0], "Answering a call did not send the Matrix answer event")
        try:
            gateway.send_call({"address": "jordan", "protocol": "email", "type": "m.call.invite", "content": {}})
            raise RuntimeError("Companion relayed a call outside Matrix")
        except ValueError:
            pass
    print("PASS  hidden protocols, disappearing timers, group members, and call signaling on the companion")


def protocol_accounts_test():
    """Account storage, Compose accounts, links, and the IRC client, with fictional fixtures and no network."""
    sys.path.insert(0, str(ROOT / "server"))
    import socket
    import threading
    import accounts
    import irc_client

    with tempfile.TemporaryDirectory(prefix="fluid-accounts-") as directory:
        store = accounts.AccountStore(Path(directory) / "accounts.json", environ={
            "FLUID_IRC_SERVER": "irc.example.test", "FLUID_IRC_NICK": "fluidtest", "FLUID_IRC_CHANNELS": "#radio-club,#garden",
            "FLUID_XMPP_JID": "broken"})
        saved = store.save("email", {"address": "me@example.test", "imap_host": "imap.example.test",
                                     "smtp_host": "smtp.example.test", "imap_password": "fixture-secret"})
        check(saved["smtp_password"] == "fixture-secret", "SMTP password should default to the IMAP password")
        store.save("email", {"address": "me@example.test", "imap_host": "imap.example.test", "smtp_host": "smtp.example.test"})
        check(store.current()["email"]["imap_password"] == "fixture-secret", "A blank password should keep the saved one")
        listed = json.dumps(store.redacted())
        check("fixture-secret" not in listed and '"set": true' in listed, "Account secrets must never be listed")
        check(oct(Path(directory, "accounts.json").stat().st_mode & 0o777) == "0o600", "Account file must be private")
        irc = store.current()["irc"]
        check(irc["port"] == 6697 and irc["channels"] == ["#radio-club", "#garden"], "Compose IRC account was not read")
        check(any(item.get("error", "").startswith("Docker Compose") for item in store.redacted()),
              "An invalid Compose account should be reported")
        for bad in ({"server": "irc.example.test", "nick": "x", "port": 6667},
                    {"server": "irc.example.test", "nick": "x", "channels": ["radio"]}):
            try:
                accounts.validate("irc", bad)
                raise RuntimeError("Accepted an unsafe IRC account")
            except ValueError:
                pass
        try:
            store.save("irc", {"server": "x.test", "nick": "y"})
            raise RuntimeError("Phone changed a Compose account")
        except ValueError:
            pass

    # IRC: CAP negotiation, SASL, joins, member list, a tagged message, and a reply, over a local socket pair.
    server, phone = socket.socketpair()
    server.settimeout(5)
    received, states = [], {}
    client = irc_client.IrcClient({"server": "irc.example.test", "nick": "fluidtest", "sasl_password": "pw",
                                   "channels": ["#radio-club"]},
                                  lambda *args: received.append(args), lambda name, state: states.__setitem__(name, state),
                                  connect=lambda: phone)
    def session():
        # The test closes the fake server at the end, which ends the session; that's expected, not an error.
        try:
            client.session()
        except (ConnectionError, OSError):
            pass

    worker = threading.Thread(target=session, daemon=True)
    worker.start()
    lines = b""

    def expect(fragment):
        nonlocal lines
        deadline = time.time() + 5
        while fragment not in lines:
            check(time.time() < deadline, f"IRC client never sent {fragment!r}")
            lines += server.recv(4096)

    def say(text):
        server.sendall(text.encode() + b"\r\n")

    expect(b"CAP LS 302")
    say(":irc.example.test CAP * LS * :sasl message-tags")
    say(":irc.example.test CAP * LS :server-time echo-message")
    expect(b"CAP REQ :sasl message-tags server-time echo-message")
    say(":irc.example.test CAP * ACK :sasl message-tags server-time echo-message")
    expect(b"AUTHENTICATE PLAIN")
    say("AUTHENTICATE +")
    expect(b"AUTHENTICATE ")
    say(":irc.example.test 903 fluidtest :SASL authentication successful")
    expect(b"CAP END")
    say(":irc.example.test 001 fluidtest :Welcome")
    expect(b"JOIN #radio-club")
    say(":irc.example.test 332 fluidtest #radio-club :Antenna night")
    say(":irc.example.test 353 fluidtest = #radio-club :@mosaic +kestrel fluidtest")
    say(":irc.example.test 366 fluidtest #radio-club :End of NAMES")
    say("@msgid=abc;time=2026-01-01T10:00:00.000Z :mosaic!m@host PRIVMSG #radio-club :Bring the analyzer")
    say(":kestrel!k@host PRIVMSG #radio-club :\x01ACTION waves\x01")
    say("PING :keepalive")
    expect(b"PONG :keepalive")
    deadline = time.time() + 5
    while len(received) < 2 and time.time() < deadline:
        time.sleep(0.05)
    check(states.get("#radio-club") == {"topic": "Antenna night", "members": ["fluidtest", "kestrel", "mosaic"]},
          "IRC channel topic and members were not tracked")
    check(received[0][:4] == ("#radio-club", "mosaic", "Bring the analyzer", {"msgid": "abc", "time": "2026-01-01T10:00:00.000Z"})
          and received[0][4] == 1767261600000, "Tagged IRC message was not parsed")
    check(received[1][2] == "/me waves", "CTCP ACTION was not shown as /me")
    client.send("#radio-club", "", reply="abc", react="👍")
    expect("@+draft/reply=abc;+draft/react=👍 TAGMSG #radio-club".encode())
    client.send("#radio-club", "x" * 900)
    expect(b"PRIVMSG #radio-club :" + b"x" * 400 + b"\r\nPRIVMSG")
    client.stopped.set()
    server.close()
    print("PASS  protocol accounts stay private, Compose accounts are read-only, and IRC speaks CAP, SASL, and IRCv3 tags")


def multi_account_test():
    """Several accounts per service, joining and leaving servers' channels and rooms, with fictional fixtures only."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import threading
    import accounts
    import irc_client
    import protocol_gateway
    import sync_merge

    with tempfile.TemporaryDirectory(prefix="fluid-multi-") as directory:
        database = Path(directory) / "gateway.sqlite"

        def connect():
            db = sqlite3.connect(database, timeout=10)
            return db

        with closing(connect()) as db, db:
            db.executescript(protocol_gateway.SCHEMA)
            # A chat and a message from before multiple accounts: no account named anywhere.
            db.execute("INSERT INTO protocol_routes VALUES ('maya', 'matrix', ?)", (json.dumps(
                {"address": "maya", "protocol": "matrix", "target": "!maya:alpha.test", "via": "matrix", "group": False,
                 "title": "Maya", "members": []}),))
            db.execute("INSERT INTO protocol_messages VALUES ('matrix-old', 1, ?)", (json.dumps(
                {"id": "matrix-old", "address": "maya", "protocol": "matrix", "title": "Maya", "body": "From before",
                 "date": 1, "type": 1, "read": 1, "status": "", "author": "@maya:alpha.test"}),))
        # The one-account-per-service file from before.
        store_path = Path(directory) / "protocol-accounts.json"
        store_path.write_text(json.dumps({"matrix": {"homeserver": "https://alpha.test", "user_id": "@alice:alpha.test",
                                                     "access_token": "fixture-alpha-token"}}))
        store = accounts.AccountStore(store_path, environ={})
        gateway = protocol_gateway.Gateway(connect, {}, Path(directory) / "files", store)
        gateway.refresh_clients = lambda: None  # No real connections in this test.
        alice, bob = "matrix:@alice:alpha.test", "matrix:@bob:beta.test"
        check(gateway.route("maya", "matrix")["account"] == alice, "An old chat didn't stay with the first account")
        store.save("matrix", {"homeserver": "https://beta.test", "user_id": "@bob:beta.test",
                              "access_token": "fixture-beta-token"}, add=True)
        saved = json.loads(store_path.read_text())
        check(saved["version"] == 2 and [entry["id"] for entry in saved["accounts"]] == [alice, bob],
              "The account file wasn't migrated in order")
        check(gateway.route("maya", "matrix")["account"] == alice, "Adding an account moved an old chat")
        try:
            store.save("matrix", {"homeserver": "https://beta.test", "user_id": "@bob:beta.test", "access_token": "x"}, add=True)
            raise RuntimeError("The same account was added twice")
        except ValueError:
            pass
        listed = json.dumps(store.redacted())
        check("fixture-alpha-token" not in listed and "fixture-beta-token" not in listed, "Account secrets were listed")

        calls = []

        def fake_matrix(path, body=None, allow_missing=False, method=None):
            me = gateway.matrix["user_id"]
            calls.append((me, path, body))
            if path.startswith("sync?"):
                room = "!maya:alpha.test" if me.endswith("alpha.test") else "!maya:beta.test"
                return {"next_batch": "batch-" + me, "rooms": {"join": {room: {"timeline": {"events": [
                    {"type": "m.room.message", "event_id": "$same", "sender": "@maya:x.test", "origin_server_ts": 5,
                     "content": {"msgtype": "m.text", "body": "Hello " + me}}]}}}}}
            if path.startswith("join/"):
                return {"room_id": "!garden:beta.test"}
            if path == "publicRooms":
                return {"chunk": [{"room_id": "!garden:beta.test", "name": "Garden club", "num_joined_members": 12},
                                  {"room_id": "!chess:beta.test", "name": "Chess", "num_joined_members": 4}]}
            if "/send/" in path:
                return {"event_id": "$sent-" + me}
            return None if allow_missing else {}
        gateway.matrix_request = fake_matrix

        # The same contact through the second account is a chat of its own; the first keeps its address.
        with closing(connect()) as db, db:
            added = gateway.add_route(db, {"address": "maya", "protocol": "matrix", "target": "!maya:beta.test",
                                           "title": "Maya", "account": bob})["route"]
        second = "maya~" + accounts.tag(bob)
        check(added["address"] == second and added["account"] == bob, "The second account's chat wasn't kept apart")
        gateway.receive_matrix(alice)
        gateway.receive_matrix(bob)
        first_in = gateway.find("maya", "matrix", "body", "Hello @alice:alpha.test")
        second_in = gateway.find(second, "matrix", "body", "Hello @bob:beta.test")
        check(first_in and second_in and first_in["id"] != second_in["id"] and first_in["account"] == alice
              and second_in["account"] == bob, "The two Matrix accounts didn't receive independently")
        check(gateway.state("matrix:since") == "batch-@alice:alpha.test"
              and gateway.state("matrix:since:" + accounts.tag(bob)) == "batch-@bob:beta.test",
              "Matrix sync positions were mixed between accounts")
        for address in ("maya", second):
            with closing(connect()) as db, db:
                gateway.enqueue(db, {"address": address, "protocol": "matrix", "body": "Reply to " + address,
                                     "request": secrets.token_hex(8)})
            gateway.deliver_job(gateway.claim())
        failed = [json.loads(row[0])["status"] for row in connect().execute("SELECT payload FROM protocol_messages")
                  if json.loads(row[0]).get("type") == 2 and json.loads(row[0])["status"] != "Sent"]
        check(not failed, "A reply wasn't sent: " + ", ".join(failed))
        sends = [(me, path) for me, path, body in calls if "/send/" in path]
        check(len(sends) == 2 and sends[0][0] == "@alice:alpha.test" and "!maya:alpha.test" in sends[0][1].replace("%21", "!").replace("%3A", ":")
              and sends[1][0] == "@bob:beta.test" and "!maya:beta.test" in sends[1][1].replace("%21", "!").replace("%3A", ":"),
              "Replies didn't go through each chat's own account")
        with closing(connect()) as db:
            snapshot = gateway.snapshot(db)
        check(any(m["id"] == "matrix-old" for m in snapshot["messages"]), "The old message was lost")
        check({a["id"] for a in snapshot["accounts"]} == {alice, bob}
              and any(r["address"] == second and r["account_name"] == "@bob:beta.test" for r in snapshot["routes"]),
              "The snapshot doesn't name each chat's account")
        # A new chat without a choice uses the account that was active most recently (bob replied last).
        with closing(connect()) as db, db:
            fresh = gateway.add_route(db, {"address": "web-new", "protocol": "matrix", "target": "!new:beta.test", "title": "New"})
        check(fresh["route"]["account"] == bob, "A new chat didn't default to the most recent account")

        # Browsing and joining a room on the second homeserver, then leaving it.
        found = gateway.browse({"account": bob, "search": "garden", "limit": 10})["rooms"]
        check(found[0]["name"] == "Garden club" and not found[0]["joined"]
              and any(path == "publicRooms" and body.get("filter") == {"generic_search_term": "garden"} for _, path, body in calls),
              "The Matrix room directory wasn't searched")
        with closing(connect()) as db, db:
            joined = gateway.join(db, {"account": bob, "target": "#garden:beta.test"})["route"]
        check(joined["target"] == "!garden:beta.test" and joined["account"] == bob and joined["group"], "Joining a room failed")
        check(gateway.browse({"account": bob, "search": "", "limit": 10})["rooms"][0]["joined"], "A joined room isn't marked")
        servers = {server["id"]: server for server in gateway.servers()}
        check(joined["address"] in servers[bob]["channels"] and second in servers[bob]["direct"]
              and "maya" in servers[alice]["direct"], "Servers don't group their rooms and direct messages")
        with closing(connect()) as db, db:
            gateway.leave(db, {"address": joined["address"], "protocol": "matrix"})
        check(any(me == "@bob:beta.test" and path.endswith("/leave") for me, path, _ in calls)
              and gateway.route(joined["address"], "matrix") is None, "Leaving a room failed")

        # Phone and web merge: the old item for older phones, and one per account.
        hooks = {"appearance": lambda db: {}, "prefs": lambda db: {}, "chats": lambda db: {}}
        with closing(connect()) as db:
            items = sync_merge.Merge(gateway, hooks).web_items(db)
        check(items.get("account:matrix") == "@alice:alpha.test" and items.get("account:matrix:@alice:alpha.test") == "web"
              and items.get("account:matrix:@bob:beta.test") == "web", "Merge items aren't per account")

        # IRC: two networks; a channel joined on one only appears and connects there.
        store.save("irc", {"server": "irc.alpha.test", "nick": "fluidtest", "channels": "#radio-club"}, add=True)
        store.save("irc", {"server": "irc.beta.test", "nick": "fluidtest"}, add=True)
        one, two = "irc:fluidtest@irc.alpha.test", "irc:fluidtest@irc.beta.test"
        with closing(connect()) as db, db:
            channel = gateway.join(db, {"account": two, "target": "garden"})["route"]
        check(channel["target"] == "#garden" and channel["account"] == two, "Joining an IRC channel failed")
        wanted = gateway.wanted_clients()
        check(wanted[one][2] == ["#radio-club"] and wanted[two][2] == ["#garden"], "IRC channels went to the wrong network")
        gateway.accept_irc("#garden", "kestrel", "Seeds?", {"msgid": "g1"}, 7, False, account=two)
        gateway.accept_irc("#garden", "kestrel", "Wrong network", {"msgid": "g2"}, 8, False, account=one)
        check(gateway.find(channel["address"], "irc", "irc_msgid", "g1") and not gateway.find(channel["address"], "irc", "irc_msgid", "g2"),
              "An IRC message reached the wrong network's channel")
        radio = next(r for r in gateway.routes if r["account"] == one and r["target"] == "#radio-club")
        with closing(connect()) as db, db:
            gateway.leave(db, {"address": radio["address"], "protocol": "irc"})
            gateway.leave(db, {"address": channel["address"], "protocol": "irc"})
        check(not store.get(one).get("channels") and gateway.route(channel["address"], "irc") is None,
              "Leaving IRC channels failed")

    # IRC LIST with a search and a limit, and live JOIN/PART, on a recorded connection.
    class Recorder:
        def __init__(self):
            self.lines = []

        def sendall(self, data):
            self.lines.append(data.decode().strip())

    client = irc_client.IrcClient({"server": "irc.example.test", "nick": "fluidtest", "channels": ["#a", "#c"]},
                                  lambda *args: None, lambda *args: None)
    client.sock = Recorder()
    client.ready.set()
    result = {}
    worker = threading.Thread(target=lambda: result.update(rows=client.list_channels("radio", 2)), daemon=True)
    worker.start()
    deadline = time.time() + 5
    while not client.sock.lines and time.time() < deadline:
        time.sleep(0.02)
    check(client.sock.lines[-1] == "LIST *radio*", "IRC LIST didn't ask for matching channels")
    for line in (":irc.example.test 321 fluidtest Channel :Users Name",
                 ":irc.example.test 322 fluidtest #radio-club 40 :Antenna night",
                 ":irc.example.test 322 fluidtest #garden 9 :Seeds",
                 ":irc.example.test 322 fluidtest #radio-help 3 :Questions",
                 ":irc.example.test 322 fluidtest #radio-more 90 :Over the limit",
                 ":irc.example.test 323 fluidtest :End of /LIST"):
        client.handle(irc_client.parse(line))
    worker.join(5)
    check([row["target"] for row in result.get("rows", [])] == ["#radio-club", "#radio-help"], "IRC LIST filtering or limit failed")
    client.sync_channels(["#a", "#b"])
    check(client.sock.lines[-2:] == ["JOIN #b", "PART #c :Left in FluidMessages"], "IRC didn't join and part live")
    print("PASS  several accounts per service: migration keeps old chats, two Matrix accounts and two IRC networks send and "
          "receive apart, per-account merge items, and joining, browsing, and leaving channels and rooms")


def communities_test():
    """Messages → Chats | Communities and the inbox filter menu: served, sorted, filtered, and their prefs round trip."""
    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        index = request("/", authorized=False).decode()
        check('id="inbox-view"' in index and index.index('id="inbox-view"') < index.index('id="threads"'),
              "Messages has no Chats | Communities switch under the title")
        check(index.index("/servers.js") < index.index("/inbox-filters.js"), "The page doesn't load inbox-filters.js after servers.js")
        check("'/inbox-filters.js'" in request("/sw.js", authorized=False).decode(), "The service worker doesn't cache inbox-filters.js")
        servers_js = request("/servers.js", authorized=False).decode()
        filters_js = request("/inbox-filters.js", authorized=False).decode()
        app_js = request("/app.js", authorized=False).decode()
        settings_js = request("/settings.js", authorized=False).decode()
        css = request("/features.css", authorized=False).decode()
        check(all(name in servers_js for name in ("function drawInboxSwitch", "'Communities'", "function drawCommunities", "function communityGroups",
                                                   "No communities yet", "Add server", "Server details", "function communityChatsSwitch"))
              and "function serverStrip" not in servers_js and "server-strip" not in css + servers_js + app_js,
              "Communities isn't served, or the old server strip is still there")
        check("function threadButton" in app_js and "drawCommunities(list, rows" in app_js, "Communities doesn't draw chat rows the way Chats does")
        check(all(name in filters_js for name in ("function inboxFiltersPage", "'Move up'", "'Move down'", "In the private folder", "inboxDecoy()"))
              and "communityChatsSwitch" in settings_js and "inbox-filters" in filters_js, "Settings → Messaging has no Inbox filters or community switch")
        # The prefs: defaults, a round trip, and bad values refused.
        prefs = request("/api/inbox")["prefs"]
        check(prefs["showCommunityChats"] is True and prefs["communitySort"] == "recent" and prefs["inboxFilters"][:3] == ["inbox", "unread", "favorites"],
              "Communities or inbox filter prefs have the wrong defaults")
        check(request("/api/settings", {"prefs": {"communitySort": "name"}})["prefs"]["communitySort"] == "name", "The community sort wasn't kept")
        check(request("/api/settings", {"prefs": {"showCommunityChats": False}})["prefs"]["showCommunityChats"] is False,
              "Show community chats in Chats couldn't be turned off")
        order = ["groups", "inbox", "-unread", "irc"]
        saved = request("/api/settings", {"prefs": {"inboxFilters": order}})["prefs"]["inboxFilters"]
        check(saved[:4] == order and len(saved) == 12 and request("/api/inbox")["prefs"]["inboxFilters"] == saved, "Inbox filters didn't round trip")
        for bad in ({"communitySort": "newest"}, {"inboxFilters": ["-inbox"]}, {"inboxFilters": ["inbox", "inbox"]}, {"inboxFilters": ["spam"]},
                    {"inboxFilters": "inbox"}, {"showCommunityChats": "yes"}):
            try:
                request("/api/settings", {"prefs": bad})
                raise RuntimeError("Invalid prefs were accepted: " + json.dumps(bad))
            except HTTPError as error:
                check(error.code == 400, f"Expected HTTP 400 for {json.dumps(bad)}, got {error.code}")
        # The phone's choices reach the browser, which follows them while it follows the phone.
        request("/api/sync", {"messages": sample_messages(), "appearance": {"showCommunityChats": False, "communitySort": "joined",
                                                                             "inboxFilters": ["direct", "inbox"]}})
        phone = request("/api/inbox")["appearance"]
        check(phone["showCommunityChats"] is False and phone["communitySort"] == "joined" and phone["inboxFilters"][:2] == ["direct", "inbox"],
              "The phone's Communities and inbox filter choices didn't reach the browser")
        request("/api/sync", {"messages": sample_messages(), "appearance": {"communitySort": "sideways", "inboxFilters": ["-inbox"]}})
        check("communitySort" not in request("/api/inbox")["appearance"] and "inboxFilters" not in request("/api/inbox")["appearance"],
              "The phone's invalid choices were kept")
        request("/api/settings", {"prefs": {"communitySort": "recent", "showCommunityChats": True, "inboxFilters": []}})

    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("SKIP  Communities sorting and inbox filter rules in Node: node is missing")
        return
    script = "globalThis.localStorage = {getItem: () => null, setItem() {}};\n" + "\n".join(
        (ROOT / "server" / name).read_text() for name in ("servers.js", "inbox-filters.js")).replace(
        "SETTINGS_SUBPAGES.push(", "[].push(") + r"""
const wrong = [];
const same = (a, b, why) => { if (JSON.stringify(a) !== JSON.stringify(b)) wrong.push(why + ': ' + JSON.stringify(a)); };
const servers = [{id: 'irc:k@alpha', name: 'Alpha Net', order: 0}, {id: 'matrix:@k:beta.test', name: 'beta.test', order: 1},
  {id: 'xmpp:k@gamma.test', name: 'gamma.test', order: 2}];
const channels = [
  {account: 'irc:k@alpha', name: '#radio-club', last: 500, joined: 1}, {account: 'irc:k@alpha', name: '#antennas', last: 900, joined: 3, unread: true},
  {account: 'matrix:@k:beta.test', name: 'Seed swap', last: 700, joined: 5}, {account: 'matrix:@k:beta.test', name: 'Allotments', last: 100, joined: 4}];
const shape = (sort) => communityGroups(servers, channels, sort).map((group) => [group.server.name, group.channels.map((c) => c.name), group.unread]);
same(shape('recent'), [['Alpha Net', ['#antennas', '#radio-club'], 1], ['beta.test', ['Seed swap', 'Allotments'], 0], ['gamma.test', [], 0]], 'recent');
same(shape('name'), [['Alpha Net', ['#antennas', '#radio-club'], 1], ['beta.test', ['Allotments', 'Seed swap'], 0], ['gamma.test', [], 0]], 'name');
same(shape('joined'), [['gamma.test', [], 0], ['beta.test', ['Seed swap', 'Allotments'], 0], ['Alpha Net', ['#antennas', '#radio-club'], 1]], 'joined');
same(shape('sideways'), shape('recent'), 'unknown sort');
// Inbox filters: the stored order, the menu, and the rules in each scope.
const order = inboxFilterOrder(['groups', '-unread', 'inbox', '-inbox', 'spam', 'groups']);
same(order.slice(0, 3), [{id: 'groups', shown: true}, {id: 'unread', shown: false}, {id: 'inbox', shown: true}], 'order');
same(order.length, INBOX_FILTERS.length, 'every filter');
same(encodeInboxFilters(order).slice(0, 3), ['groups', '-unread', 'inbox'], 'encode');
same(inboxFilterMenu(inboxFilterOrder(['inbox', 'irc', 'matrix']), new Set(['sms', 'irc'])).slice(0, 3), ['inbox', 'irc', 'unread'], 'menu');
const chat = (facts) => ({group: false, favorite: false, unread: false, services: new Set(['sms']), ...facts});
same(['groups', 'direct', 'favorites', 'texts', 'matrix', 'unread'].map((id) => inboxFilterMatches(id, chat({group: true, services: new Set(['matrix'])}))),
  [true, false, false, false, true, false], 'group room');
same(['groups', 'direct', 'favorites', 'texts'].map((id) => inboxFilterMatches(id, chat({favorite: true}))), [false, true, true, true], 'favorite text');
const place = (facts) => ({hidden: false, archived: false, blocked: false, ...facts});
same(['inbox', 'groups', 'archived', 'blocked'].map((id) => inboxFilterPlaces('', id, place({hidden: true}))), [false, false, false, false],
  'the private folder leaks');
same(['inbox', 'groups', 'archived'].map((id) => inboxFilterPlaces('private', id, place({hidden: true}))), [true, true, false], 'inside the private folder');
same(inboxFilterPlaces('', 'archived', place({archived: true})), true, 'archived');
same(inboxFilterPlaces('', 'favorites', place({archived: true})), false, 'archived favorite');
// A decoy session never matches real favorites, even if they were somehow known.
var privacyStatus = {private: null}, sampleOn = false;
globalThis.decoyLike = () => true;
globalThis.starredList = () => ['+12025550123'];
globalThis.threadAddress = (key) => key.split('\u001f')[0];
globalThis.sameText = (a, b) => a === b;
globalThis.sameNumber = (a, b) => a === b;
same(favoriteChat('+12025550123\u001fsms'), false, 'decoy favorite');
globalThis.decoyLike = () => false;
same(favoriteChat('+12025550123\u001fsms'), true, 'real favorite');
if (wrong.length) { console.log(wrong.join('\n')); process.exit(1); }
"""
    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0, "Communities or inbox filter rules failed in Node: " + (result.stdout + result.stderr).strip()[:600])
    print("PASS  Chats | Communities and inbox filters: the switch is served, servers and channels sort by recent activity, name, "
          "and date joined, filters keep to the inbox, private folder, and decoy scopes, and their prefs round trip")


def server_directory_test():
    """Add server's public server list and Browse search, with fictional fixtures only, and no "Discord" anywhere served."""
    sys.path.insert(0, str(ROOT / "server"))
    import asyncio
    import sqlite3
    import accounts
    import protocol_gateway
    import xmpp_client

    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        index = request("/", authorized=False).decode()
        scripts = re.findall(r'(?:src|href)="(/[^"#?]+)"', index)
        check(scripts.index("/server-directory.js") < scripts.index("/servers.js"), "The page doesn't load the server list before servers.js")
        shell = request("/sw.js", authorized=False).decode()
        check("'/server-directory.js'" in shell, "The service worker doesn't cache the server list")
        served = {"/": index, "/sw.js": shell}
        for path in scripts + re.findall(r"'(/[^']+\.(?:js|css|html|webmanifest))'", shell):
            if path not in served and not path.endswith((".png", ".ico", ".webp")):
                served[path] = request(path, authorized=False).decode()
        mentions = [path for path, text in served.items() if "discord" in text.lower()]
        check(not mentions, "Discord is mentioned in " + ", ".join(mentions))
        directory = served["/server-directory.js"]
        check("const SERVER_DIRECTORY" in directory and "function directorySearch" in directory, "The server list isn't served")
        servers_js = served["/servers.js"]
        check(all(name in servers_js for name in ("function showServerList", "Other server…", "function emptyServerRows", "roomSearch(found"))
              and "prompt(" not in servers_js and "confirm(" not in servers_js and "alert(" not in servers_js,
              "Add server or Browse isn't a full page with search")

    node = os.environ.get("NODE") or shutil.which("node")
    if node:
        # The list itself: valid TLS hosts and ports, no duplicates, and search by name, address, or description.
        script = (ROOT / "server/server-directory.js").read_text() + r"""
const wrong = [];
const host = /^(?=.{1,253}$)([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/;
for (const [service, list] of Object.entries(SERVER_DIRECTORY)) {
  const names = new Set(list.map((entry) => entry.name.toLowerCase())), addresses = new Set(list.map(directoryAddress));
  if (names.size !== list.length || addresses.size !== list.length) wrong.push(service + ' duplicates');
  for (const entry of list) {
    const address = directoryAddress(entry).replace(/^https:\/\//, '');
    if (!host.test(address) || !entry.about) wrong.push(entry.name);
    if (service === 'irc' && entry.tls !== false && entry.port !== 6697) wrong.push(entry.name + ' port');
    if (service === 'matrix' && !entry.homeserver.startsWith('https://')) wrong.push(entry.name + ' https');
  }
}
for (const name of ['Libera.Chat', 'OFTC', 'EFnet', 'IRCnet', 'Undernet', 'DALnet', 'QuakeNet', 'Rizon', 'hackint', 'Snoonet', 'GIMPNet', 'EsperNet'])
  if (!SERVER_DIRECTORY.irc.some((entry) => entry.name === name)) wrong.push('missing ' + name);
const names = (list) => list.map((entry) => entry.name).join();
if (names(directorySearch(SERVER_DIRECTORY.irc, ' debian TOR ')) !== 'OFTC') wrong.push('search words');
if (names(directorySearch(SERVER_DIRECTORY.matrix, 'Mozílla')) !== 'mozilla.org') wrong.push('search accents');
if (directorySearch(SERVER_DIRECTORY.xmpp, '').length !== SERVER_DIRECTORY.xmpp.length) wrong.push('empty search');
if (!/paid/.test(SERVER_DIRECTORY.xmpp.find((entry) => entry.name === 'conversations.im').about)) wrong.push('paid');
const rooms = [{target: '#gardening', name: '#gardening', topic: 'Seeds and soil'}, {target: '!c:example.test', name: 'Chess club', alias: '#chess:example.test'}];
if (roomSearch(rooms, 'soil').map((room) => room.target).join() !== '#gardening') wrong.push('room topic');
if (roomSearch(rooms, '#chess').map((room) => room.target).join() !== '!c:example.test') wrong.push('room alias');
if (roomSearch(rooms, '').length !== 2) wrong.push('room empty');
process.stdout.write(JSON.stringify(wrong));
"""
        result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
        check(result.returncode == 0 and result.stdout == "[]", "The server list or its search is wrong: " + (result.stdout or result.stderr)[:400])
    else:
        print("Skipped running the server list's search: node isn't installed (set NODE to its path)")

    # Browse asks each server to search where it can (IRC LIST mask, Matrix filter) and XMPP is filtered here.
    with tempfile.TemporaryDirectory(prefix="fluid-browse-") as directory:
        database = Path(directory) / "gateway.sqlite"
        connect = lambda: sqlite3.connect(database, timeout=10)
        with closing(connect()) as db, db:
            db.executescript(protocol_gateway.SCHEMA)
        store = accounts.AccountStore(Path(directory) / "protocol-accounts.json", environ={})
        store.save("irc", {"server": "irc.example.test", "nick": "fluidtest"}, add=True)
        store.save("xmpp", {"jid": "sam@example.test", "password": "fixture-password"}, add=True)
        gateway = protocol_gateway.Gateway(connect, {}, Path(directory) / "files", store)
        gateway.refresh_clients = lambda: None
        asked = []

        class FakeIrc:
            def list_channels(self, search, limit):
                asked.append(search)
                rows = [{"target": "#gardening", "name": "#gardening", "members": 12, "topic": "Seeds"},
                        {"target": "#radio", "name": "#radio", "members": 4, "topic": "Antennas"}]
                return [row for row in rows if search in row["target"]][:limit]

        class FakeDisco:
            async def get_items(self, jid, timeout):
                return {"disco_items": {"items": [("garden@conference.example.test", None, "Garden club"),
                                                  ("radio@conference.example.test", None, "Ham radio")]}}

        class FakeXmpp:
            client = type("Client", (), {"plugin": {"xep_0030": FakeDisco()}})()
            call = staticmethod(asyncio.run)
            browse = xmpp_client.XmppClient.browse
            muc_services = lambda self: ["conference.example.test"]

        clients = {"irc": FakeIrc(), "xmpp": FakeXmpp()}
        gateway.client = lambda protocol: clients[protocol]
        irc, xmpp = "irc:fluidtest@irc.example.test", "xmpp:sam@example.test"
        found = gateway.browse({"account": irc, "search": "garden", "limit": 50})["rooms"]
        check(asked == ["garden"] and [room["target"] for room in found] == ["#gardening"] and found[0]["members"] == 12
              and not found[0]["joined"], "IRC Browse didn't search the network")
        with closing(connect()) as db, db:
            channel = gateway.join(db, {"account": irc, "target": "#gardening"})["route"]
        check(channel["title"] == "#gardening", "A joined IRC channel isn't named #name")
        check(gateway.browse({"account": irc, "search": "", "limit": 50})["rooms"][0]["joined"], "A joined channel isn't marked Joined")
        check(gateway.browse({"account": xmpp, "search": ""})["services"] == ["conference.example.test"], "XMPP services weren't listed")
        rooms = gateway.browse({"account": xmpp, "search": "HAM", "service": "conference.example.test", "limit": 50})["rooms"]
        check([room["name"] for room in rooms] == ["Ham radio"], "XMPP Browse didn't filter group chats")
        with closing(connect()) as db, db:
            room = gateway.join(db, {"account": xmpp, "target": "radio@conference.example.test"})["route"]
        check(room["title"] == "radio" and room["group"], "A group chat joined by address isn't named after the room")
        servers = {server["id"]: server for server in gateway.servers()}
        check(channel["address"] in servers[irc]["channels"] and room["address"] in servers[xmpp]["channels"],
              "Joined channels and rooms aren't listed under their server")
    print("PASS  Add server: public server list served and searchable (no Discord anywhere served); Browse searches IRC by "
          "mask and filters XMPP group chats; joined channels and rooms are named and listed under their server")


def sign_in_test():
    """Opening the web app without a token: first-run setup code, password, session cookie, CSRF, and rate limits."""
    import sqlite3
    password, changed = "maple lantern harbor", "quiet river morning"
    with companion(free_port(), "") as (origin, request, _):
        opener = build_opener(ProxyHandler({}))

        def call(path, body=None, cookie=None, headers=None, method=None):
            sent = {"X-Fluid-Request": "1", "Content-Type": "application/json", **(headers or {})}
            sent = {key: value for key, value in sent.items() if value is not None}
            if cookie:
                sent["Cookie"] = cookie
            data = json.dumps(body).encode() if body is not None else None
            try:
                with opener.open(Request(origin + path, data=data, headers=sent, method=method), timeout=15) as response:
                    return response.status, json.loads(response.read() or b"{}"), response.headers.get_all("Set-Cookie") or []
            except HTTPError as error:
                return error.code, json.loads(error.read() or b"{}"), error.headers.get_all("Set-Cookie") or []

        check(call("/api/auth")[1] == {"owner": False, "signed_in": False, "local": True}, "A new server should open on this computer")
        check(call("/api/auth", headers={"X-Forwarded-For": "198.51.100.77"})[1] == {"owner": False, "signed_in": False, "local": False},
              "A proxied request should be asked to set up, not opened as this computer")
        check(call("/api/inbox")[0] == 401, "The inbox answered before anyone signed in")
        code_file = request.directory / "setup-code"
        check(code_file.is_file() and oct(code_file.stat().st_mode & 0o777) == "0o600", "The setup code file must exist and be private")
        code = code_file.read_text().strip()
        check(re.fullmatch(r"[2-9A-Z]{4}-[2-9A-Z]{4}-[2-9A-Z]{4}", code) is not None, "Unexpected setup code format")
        setup = {"code": code, "password": password, "remember": True}
        # A stranger reaching a public server can't claim it: setup needs the code, from anywhere.
        stranger = {"X-Forwarded-For": "198.51.100.77"}
        check(call("/api/auth/setup", {"password": password, "remember": True}, headers=stranger)[0] == 403,
              "Setup without the code worked from a non-local address")
        check(call("/api/auth/setup", {"code": "", "password": password}, headers=stranger)[0] == 403, "An empty setup code worked")
        check(call("/api/auth/setup", {"code": 5, "password": password}, headers=stranger)[0] == 403, "A non-text setup code wasn't refused cleanly")
        check(call("/api/auth/setup", {**setup, "code": "AAAA-BBBB-CCCC"})[0] == 403, "A wrong setup code claimed the server")
        check(call("/api/auth")[1]["owner"] is False, "A refused setup still made a password")
        check(call("/api/auth/setup", setup, headers={"X-Fluid-Request": None})[0] == 403, "Setup worked without the page's own header")
        check(call("/api/auth/setup", setup, headers={"Sec-Fetch-Site": "cross-site"})[0] == 403, "Another site could run setup")
        check(call("/api/auth/setup", {**setup, "password": "short"})[0] == 400, "A too-short password was accepted")
        status, _, cookies = call("/api/auth/setup", setup)
        check(status == 200 and len(cookies) == 1, "Setup with the code failed")
        flags = cookies[0].split("; ")
        check(flags[0].startswith("fluid-session=") and {"HttpOnly", "SameSite=Strict", "Path=/"} <= set(flags)
              and any(flag.startswith("Max-Age=") for flag in flags) and "Secure" not in flags, "Session cookie flags are wrong: " + cookies[0])
        cookie = flags[0]
        check(not code_file.exists(), "The setup code should stop existing once a password is set")
        check(call("/api/auth/setup", setup)[0] == 409, "Setup ran twice")
        # Set up with a password before this computer ever opened it: like an install from before local access,
        # it keeps asking for the password everywhere until the owner turns local access on.
        check(call("/api/auth", cookie=cookie)[1] == {"owner": True, "signed_in": True, "local": False}, "The new session isn't signed in")
        check(call("/api/auth/local", {}, headers={"Origin": origin})[0] == 403, "A password install opened without its password")
        check(call("/api/inbox", cookie=cookie)[0] == 200, "The session cookie didn't open the inbox")
        with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db:
            stored = json.dumps(db.execute("SELECT * FROM auth_state").fetchall() + db.execute("SELECT * FROM auth_sessions").fetchall())
        check(password not in stored and cookie.split("=", 1)[1] not in stored and "scrypt" in stored,
              "The password and session must only be stored as hashes")

        change = {"follow_phone": False, "web_appearance": {"theme": "ember", "mode": "dark", "radius": 99,
                                                            "colors": {"sms": "#123456", "ink": "url(x)"}}}
        check(call("/api/settings", change, cookie=cookie, headers={"X-Fluid-Request": None})[0] == 403, "CSRF: missing header accepted")
        check(call("/api/settings", change, cookie=cookie, headers={"Sec-Fetch-Site": "same-site"})[0] == 403, "CSRF: same-site accepted")
        check(call("/api/settings", change, cookie=cookie, headers={"Origin": "https://evil.example"})[0] == 403, "CSRF: other origin accepted")
        status, settings, _ = call("/api/settings", change, cookie=cookie, headers={"Origin": origin, "Sec-Fetch-Site": "same-origin"})
        check(status == 200 and settings["follow_phone"] is False
              and settings["web_appearance"] == {"theme": "ember", "mode": "dark", "colors": {"sms": "#123456"}},
              "The web app's own appearance wasn't saved and cleaned")
        snapshot = call("/api/inbox", cookie=cookie)[1]
        check(snapshot["follow_phone"] is False and snapshot["web_appearance"]["theme"] == "ember", "The inbox doesn't say which settings to use")
        call("/api/settings", {"follow_phone": True}, cookie=cookie)

        status, pairing, _ = call("/api/auth/pairing", {}, cookie=cookie)
        token = pairing.get("token", "")
        check(status == 200 and len(token) == 64 and pairing["pairing"]["web"], "No pairing token was made")
        check(request("/api/inbox", authorized=False, extra_headers={"Authorization": "Bearer " + token})["messages"] == [],
              "The phone couldn't use its pairing token")
        with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db:
            check(token not in json.dumps(db.execute("SELECT * FROM auth_state").fetchall()), "The pairing token must only be stored as a hash")
        call("/api/auth/pairing/delete", {}, cookie=cookie)
        try:
            request("/api/inbox", authorized=False, extra_headers={"Authorization": "Bearer " + token})
            raise RuntimeError("A removed pairing token still worked")
        except HTTPError as error:
            check(error.code == 401, "A removed pairing token should get 401")

        # Over HTTPS (a reverse proxy says so) the cookie is Secure and uses the __Host- prefix.
        status, _, cookies = call("/api/auth/login", {"password": password}, headers={"X-Forwarded-Proto": "https", "X-Forwarded-For": "198.51.100.20"})
        check(status == 200 and cookies[0].startswith("__Host-fluid-session=") and "; Secure" in cookies[0]
              and "Max-Age" not in cookies[0], "HTTPS sign-in should set a Secure session cookie: " + cookies[0])
        other = cookies[0].split(";")[0]
        check(call("/api/inbox", cookie=other)[0] == 200, "The second browser isn't signed in")
        check(call("/api/auth/password", {"current": "wrong guess here", "password": changed}, cookie=cookie)[0] == 403,
              "The password changed without the current one")
        check(call("/api/auth/password", {"current": password, "password": changed}, cookie=cookie)[0] == 200, "Changing the password failed")
        check(call("/api/inbox", cookie=other)[0] == 401, "Changing the password should sign out other browsers")
        check(call("/api/inbox", cookie=cookie)[0] == 200, "Changing the password signed out this browser")

        # Guessing slows down: five misses from one address, then it waits.
        guesser = {"X-Forwarded-For": "203.0.113.7"}
        for _ in range(5):
            check(call("/api/auth/login", {"password": "not it at all"}, headers=guesser)[0] == 403, "A wrong password signed in")
        check(call("/api/auth/login", {"password": changed}, headers=guesser)[0] == 429, "Repeated wrong passwords weren't slowed down")
        check(call("/api/auth/login", {"password": changed}, headers={"X-Forwarded-For": "203.0.113.8"})[0] == 200,
              "One address's guesses locked out everyone")

        check(call("/api/auth/logout", {}, cookie=cookie, headers={"Sec-Fetch-Site": "cross-site"})[0] == 403,
              "Another site could sign you out")
        check(call("/api/inbox", cookie=cookie)[0] == 200, "A refused sign-out still ended the session")
        status, _, cookies = call("/api/auth/logout", None, cookie=cookie, headers={"Content-Length": "0"}, method="POST")
        check(status == 200 and any("Max-Age=0" in item for item in cookies), "Signing out didn't clear the cookie")
        check(call("/api/inbox", cookie=cookie)[0] == 401, "The session still worked after signing out")

        # A forgotten password: reset on the server, which prints a fresh setup code.
        result = subprocess.run([sys.executable, str(ROOT / "server/main.py"), "reset-password"], env=request.env,
                                capture_output=True, text=True, timeout=30)
        check(result.returncode == 0 and re.search(r"[2-9A-Z]{4}-[2-9A-Z]{4}-[2-9A-Z]{4}", result.stdout), "reset-password didn't print a code")
        check(call("/api/auth")[1]["owner"] is False, "reset-password didn't remove the password")

    # Existing installs: FLUID_TOKEN still works as a bearer token and signs a browser in (the desktop app does this).
    secret = secrets.token_hex(32)
    with companion(free_port(), secret) as (origin, request, _):
        opener = build_opener(ProxyHandler({}))
        login = Request(origin + "/api/auth/token", data=json.dumps({"token": secret, "remember": True}).encode(),
                        headers={"X-Fluid-Request": "1", "Content-Type": "application/json"})
        with opener.open(login, timeout=10) as response:
            cookie = response.headers.get("Set-Cookie").split(";")[0]
        with opener.open(Request(origin + "/api/inbox", headers={"Cookie": cookie}), timeout=10) as response:
            check(response.status == 200, "FLUID_TOKEN didn't sign the browser in")
        check(request("/api/inbox")["messages"] == [], "FLUID_TOKEN stopped working as a bearer token")
        check(request("/api/schedule", {"address": "+15555550123", "body": "Fictional test", "due": int(time.time() * 1000)})["id"],
              "FLUID_TOKEN couldn't queue a text without the browser's CSRF header")
        try:
            request("/api/inbox", authorized=False, extra_headers={"Authorization": "Bearer " + "0" * 64})
            raise RuntimeError("A wrong bearer token was accepted")
        except HTTPError as error:
            check(error.code == 401, "A wrong bearer token should get 401")
        # On an existing install, the token also works as the first-run setup code.
        setup = Request(origin + "/api/auth/setup", data=json.dumps({"code": secret, "password": "copper meadow lantern"}).encode(),
                        headers={"X-Fluid-Request": "1", "Content-Type": "application/json", "X-Forwarded-For": "198.51.100.9"})
        with opener.open(setup, timeout=30) as response:
            check(response.status == 200 and "HttpOnly" in response.headers.get("Set-Cookie"), "FLUID_TOKEN didn't work as the setup code")
    print("PASS  sign-in without a token: setup code, hashed password and sessions, cookie flags, CSRF, rate limits, pairing tokens, and FLUID_TOKEN")


def local_access_test():
    """On the computer it runs on, the web app opens without a password. Anything else signs in."""
    sys.path.insert(0, str(ROOT / "server"))
    import auth
    import sqlite3
    # Who counts as this computer, as auth.from_this_computer decides it.
    here = {"Host": "localhost:8080", "Origin": "http://localhost:8080"}
    check(auth.from_this_computer("127.0.0.1", here, need_origin=True), "Loopback with a localhost origin should count")
    check(auth.from_this_computer("::1", {"Host": "[::1]:8080", "Origin": "http://[::1]:8080"}, need_origin=True), "IPv6 loopback should count")
    check(auth.from_this_computer("::ffff:127.0.0.1", here), "IPv4-mapped loopback should count")
    check(auth.from_this_computer("127.0.0.1", {"Host": "app.localhost:8080"}), "A .localhost name should count")
    check(not auth.from_this_computer("127.0.0.1", {"Host": "localhost:8080"}, need_origin=True), "A request with no origin was opened")
    for name in ("X-Forwarded-For", "Forwarded", "X-Real-IP", "X-Forwarded-Host", "X-Forwarded-Proto", "Via", "CF-Connecting-IP"):
        check(not auth.from_this_computer("127.0.0.1", {**here, name: "198.51.100.4"}), f"A request through a proxy ({name}) was opened")
    check(not auth.from_this_computer("127.0.0.1", {"Host": "evil.example:8080", "Origin": "http://evil.example:8080"}),
          "A DNS-rebinding host name was opened")
    check(not auth.from_this_computer("127.0.0.1", {**here, "Origin": "http://evil.example"}), "Another site's origin was opened")
    check(not auth.from_this_computer("127.0.0.1", {**here, "Origin": "null"}), "An opaque origin was opened")
    check(not auth.from_this_computer("192.168.1.20", here), "A LAN address counted as this computer")
    # Docker: the default Compose file publishes 127.0.0.1:8080 only and sets FLUID_LOCAL_ONLY=1, so the gateway counts.
    check(not auth.from_this_computer("172.18.0.1", here), "The Docker gateway counted without FLUID_LOCAL_ONLY")
    check(auth.from_this_computer("172.18.0.1", here, local_only=True), "The Docker gateway didn't count with FLUID_LOCAL_ONLY")
    check(auth.from_this_computer("fd00::1", here, local_only=True), "A private IPv6 gateway didn't count with FLUID_LOCAL_ONLY")
    check(not auth.from_this_computer("203.0.113.9", here, local_only=True), "A public address counted with FLUID_LOCAL_ONLY")
    check(not auth.from_this_computer("172.18.0.1", {**here, "X-Forwarded-For": "203.0.113.9"}, local_only=True),
          "A proxy in front of a local-only container was opened")
    check(not auth.from_this_computer("172.18.0.1", {"Host": "messages.example.org", "Origin": "https://messages.example.org"}, local_only=True),
          "A public host name was opened with FLUID_LOCAL_ONLY")

    with companion(free_port(), "") as (origin, request, _):
        opener = build_opener(ProxyHandler({}))

        def call(path, body=None, cookie=None, headers=None):
            sent = {"X-Fluid-Request": "1", "Content-Type": "application/json", "Origin": origin, **(headers or {})}
            sent = {key: value for key, value in sent.items() if value is not None}
            if cookie:
                sent["Cookie"] = cookie
            data = json.dumps(body).encode() if body is not None else None
            try:
                with opener.open(Request(origin + path, data=data, headers=sent), timeout=15) as response:
                    return response.status, json.loads(response.read() or b"{}"), response.headers.get_all("Set-Cookie") or []
            except HTTPError as error:
                return error.code, json.loads(error.read() or b"{}"), error.headers.get_all("Set-Cookie") or []

        check(call("/api/auth", headers={"Origin": None})[1]["local"] is True, "A new install should open on this computer")
        for refused, why in (({"X-Forwarded-For": "198.51.100.7"}, "through a proxy"), ({"Forwarded": "for=198.51.100.7"}, "with Forwarded"),
                             ({"X-Real-IP": "198.51.100.7"}, "with X-Real-IP"), ({"Origin": None}, "without an origin"),
                             ({"Origin": "http://evil.example"}, "from another site"), ({"Sec-Fetch-Site": "cross-site"}, "cross-site"),
                             ({"X-Fluid-Request": None}, "without the page's header"),
                             ({"Host": "evil.example", "Origin": "http://evil.example"}, "under a rebound host name")):
            check(call("/api/auth/local", {}, headers=refused)[0] == 403, "This computer's sign-in worked " + why)
        check(call("/api/inbox")[0] == 401, "The inbox answered without a session")
        # nginx's default proxying (HTTP/1.0, Host rewritten to 127.0.0.1, no X-Forwarded-For) doesn't count either.
        with socket.create_connection(("127.0.0.1", int(origin.rsplit(":", 1)[1])), timeout=10) as raw:
            raw.sendall(("POST /api/auth/local HTTP/1.0\r\nHost: " + origin[7:] + "\r\nOrigin: " + origin
                         + "\r\nX-Fluid-Request: 1\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n{}").encode())
            check(raw.recv(64).split(b" ")[1] == b"403", "An HTTP/1.0 request, as nginx forwards by default, was opened as this computer")
        status, _, cookies = call("/api/auth/local", {})
        check(status == 200 and cookies and "HttpOnly" in cookies[0], "This computer couldn't open the app")
        cookie = cookies[0].split(";")[0]
        check(call("/api/inbox", cookie=cookie)[0] == 200, "This computer's session didn't open the inbox")
        check(call("/api/auth/security", cookie=cookie)[1]["owner"] is False, "Opening on this computer made a password")
        # Turning on other devices: a password, set from this computer's session without a setup code.
        check(call("/api/auth/password", {"password": "harbor lantern morning"}, cookie=cookie)[0] == 200, "Couldn't set a password here")
        state = call("/api/auth/security", cookie=cookie)[1]
        check(state["owner"] and state["local"] and state["here"], "A password made later took this computer's access away")
        check(call("/api/auth/local", {})[0] == 200, "This computer stopped opening once a password existed")
        remote = {"X-Forwarded-For": "198.51.100.30", "Origin": None}
        check(call("/api/auth", headers=remote)[1] == {"owner": True, "signed_in": False, "local": False}, "Other devices weren't asked to sign in")
        check(call("/api/auth/login", {"password": "harbor lantern morning"}, headers=remote)[0] == 200, "Another device couldn't sign in")
        check(call("/api/auth/setup", {"code": "", "password": "another password here"}, headers=remote)[0] == 409, "Setup reopened")
        # The owner can switch it off; then this computer signs in like any other device.
        check(call("/api/auth/local-access", {"enabled": False}, cookie=cookie)[0] == 200, "Couldn't turn local access off")
        check(call("/api/auth/local", {})[0] == 403 and call("/api/auth")[1]["local"] is False, "Local access stayed on")
        check(call("/api/auth/local-access", {"enabled": True}, cookie=cookie, headers={"Sec-Fetch-Site": "cross-site"})[0] == 403,
              "Another site could turn local access on")
        call("/api/auth/local-access", {"enabled": True}, cookie=cookie)
        check(call("/api/auth/local", {})[0] == 200, "Couldn't turn local access back on")
        with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db:
            stored = json.dumps(db.execute("SELECT * FROM auth_state").fetchall() + db.execute("SELECT * FROM auth_sessions").fetchall())
        check("harbor lantern morning" not in stored and cookie.split("=", 1)[1] not in stored, "Secrets must only be stored as hashes")
        # Fun and effects, and the first-run welcome, are saved for every browser.
        status, settings, _ = call("/api/settings", {"prefs": {"games": False}, "welcomed": True}, cookie=cookie)
        check(status == 200 and settings["prefs"]["games"] is False and settings["prefs"]["effects"] is True and settings["welcomed"],
              "Fun and effects settings weren't saved")
        check(call("/api/settings", {"prefs": {"games": "no"}}, cookie=cookie)[0] == 400, "An invalid preference was accepted")
        check(call("/api/inbox", cookie=cookie)[1]["prefs"]["games"] is False, "The inbox doesn't carry Fun and effects settings")

    # FLUID_LOCAL_ONLY reaches the server, and a server without it still only trusts loopback.
    with companion(free_port(), "", extra_env={"FLUID_LOCAL_ONLY": "1"}) as (origin, request, _):
        opener = build_opener(ProxyHandler({}))
        login = Request(origin + "/api/auth/local", data=b"{}", headers={"X-Fluid-Request": "1", "Content-Type": "application/json", "Origin": origin})
        with opener.open(login, timeout=10) as response:
            cookie = response.headers.get("Set-Cookie").split(";")[0]
        with opener.open(Request(origin + "/api/auth/security", headers={"Cookie": cookie}), timeout=10) as response:
            check(json.loads(response.read())["local_only"] is True, "FLUID_LOCAL_ONLY wasn't read")
    # The icon set and the files the Docker image serves.
    with companion(free_port(), "") as (origin, request, _):
        for path, kind in (("/favicon.ico", "image/x-icon"), ("/icons/favicon-32.png", "image/png"), ("/icons/maskable-512.png", "image/png"),
                           ("/icons/icon-192.png", "image/png"), ("/welcome.js", "text/javascript")):
            with build_opener(ProxyHandler({})).open(Request(origin + path, method="HEAD"), timeout=10) as response:
                check(response.status == 200 and response.headers.get_content_type() == kind, f"{path} isn't served as {kind}")
        manifest = json.loads(request("/manifest.webmanifest", authorized=False))
        purposes = {icon["purpose"] for icon in manifest["icons"]}
        check(purposes == {"any", "maskable"} and all((ROOT / "server" / icon["src"].lstrip("/")).is_file() for icon in manifest["icons"]),
              "The manifest's icons are missing or lack a maskable version")
    dockerfile = (ROOT / "server/Dockerfile").read_text()
    check("COPY *.py *.html *.js *.css *.webp *.webmanifest ./" in dockerfile and "COPY icons/ ./icons/" in dockerfile,
          "The Dockerfile no longer copies every file the web app serves")
    print("PASS  this computer opens without a password; proxies, other hosts, other sites, and other devices sign in; FLUID_LOCAL_ONLY; icons")


def erase_test():
    """Settings → Privacy and security → Erase everything on this server: a signed-in browser only, CSRF, the word ERASE,
    the password again, a rate limit, and afterward nothing of the old data, sessions, tokens, or password is left."""
    import sqlite3
    password = "copper lantern meadow"
    with companion(free_port(), "") as (origin, request, _):
        opener = build_opener(ProxyHandler({}))

        def call(path, body=None, cookie=None, headers=None):
            sent = {"X-Fluid-Request": "1", "Content-Type": "application/json", "Origin": origin, **(headers or {})}
            sent = {key: value for key, value in sent.items() if value is not None}
            if cookie:
                sent["Cookie"] = cookie
            data = json.dumps(body).encode() if body is not None else None
            try:
                with opener.open(Request(origin + path, data=data, headers=sent), timeout=30) as response:
                    return response.status, json.loads(response.read() or b"{}"), response.headers
            except HTTPError as error:
                return error.code, json.loads(error.read() or b"{}"), error.headers

        def sign_in_here():
            status, _, headers = call("/api/auth/local", {})
            check(status == 200, "This computer couldn't open the app")
            return headers.get("Set-Cookie").split(";")[0]

        cookie = sign_in_here()
        check(call("/api/auth/password", {"password": password}, cookie=cookie)[0] == 200, "Couldn't set the web password")
        token = call("/api/auth/pairing", {}, cookie=cookie)[1]["token"]
        bearer = {"Authorization": "Bearer " + token}
        # Fictional data in every place the server keeps it.
        now = int(time.time() * 1000)
        request("/api/sync", {"messages": sample_messages()}, authorized=False, extra_headers=bearer)
        request("/api/schedule", {"address": "+12025550123", "body": "Fictional queued text", "due": now + 3_600_000},
                authorized=False, extra_headers=bearer)
        request("/api/protocols/upload", b"fictional upload", authorized=False,
                extra_headers={**bearer, "Content-Type": "text/plain", "X-Fluid-Name": "note.txt"})
        check(call("/api/protocols/accounts", {"protocol": "email", "fields": {"address": "me@example.test", "imap_host": "imap.example.test",
              "imap_password": "fixture-secret", "smtp_host": "smtp.example.test"}}, cookie=cookie)[0] == 200, "Couldn't save a fixture account")
        check(call("/api/settings", {"prefs": {"games": False}, "welcomed": True, "web_appearance": {"theme": "love", "mode": "dark"}},
                   cookie=cookie)[0] == 200, "Couldn't save fixture settings")
        files = request.directory / "protocol-files"
        with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db, db:
            db.execute("INSERT INTO protocol_messages VALUES ('web-erase-me', ?, ?)", (now, json.dumps(
                {"id": "web-erase-me", "address": "web-fixture", "protocol": "matrix", "title": "Fixture", "body": "Fictional",
                 "date": now, "type": 1, "read": 0, "attachment": {"name": "a.txt", "mime": "text/plain", "size": 9}})))
        (files / "web-erase-me").write_bytes(b"fictional")
        (files / "matrix-store").mkdir(exist_ok=True)
        (files / "matrix-store" / "pickle.key").write_text("fixture")
        (request.directory / "rclone.conf").write_text("[fixture]\ntype = local\n")
        accounts_file = request.directory / "protocol-accounts.json"
        check(accounts_file.is_file() and any((files / "uploads").iterdir()), "The fixture account or upload wasn't stored")

        confirm = {"confirm": "ERASE", "password": password}
        check(call("/api/erase", confirm)[0] == 401, "Erase worked without signing in")
        check(call("/api/erase", confirm, headers=bearer)[0] == 403, "Erase worked with the phone's pairing token")
        for refused, why in (({"X-Fluid-Request": None}, "without the page's header"), ({"Sec-Fetch-Site": "cross-site"}, "cross-site"),
                             ({"Origin": "https://evil.example"}, "from another site")):
            check(call("/api/erase", confirm, cookie=cookie, headers=refused)[0] == 403, "Erase worked " + why)
        check(call("/api/erase", {**confirm, "confirm": "erase"}, cookie=cookie)[0] == 400, "Erase worked without typing ERASE")
        check(call("/api/erase", {**confirm, "password": "not the password"}, cookie=cookie)[0] == 403, "Erase worked with a wrong password")
        check(call("/api/erase", {"confirm": "ERASE"}, cookie=cookie)[0] == 403, "Erase worked without the password")
        check(len(call("/api/inbox", cookie=cookie)[1]["messages"]) == 4, "A refused erase deleted something")

        status, result, headers = call("/api/erase", confirm, cookie=cookie)
        check(status == 200 and result == {"erased": True}, "Erase failed: " + json.dumps(result))
        check('"storage"' in (headers.get("Clear-Site-Data") or "") and any("Max-Age=0" in item for item in headers.get_all("Set-Cookie")),
              "Erase didn't tell the browser to forget its cookie and stored data")
        check(call("/api/inbox", cookie=cookie)[0] == 401, "The old browser session still works after erasing")
        try:
            request("/api/inbox", authorized=False, extra_headers=bearer)
            raise RuntimeError("The phone's pairing token still works after erasing")
        except HTTPError as error:
            check(error.code == 401, f"Expected HTTP 401 for the old pairing token, got {error.code}")
        with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db:
            tables = [row[0] for row in db.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'")]
            left = {table: db.execute(f'SELECT count(*) FROM "{table}"').fetchone()[0] for table in tables}
        check({"inbox", "jobs", "protocol_messages", "auth_state", "auth_sessions"} <= set(tables) and not any(left.values()),
              "Rows were left after erasing: " + json.dumps(left))
        raw = (request.directory / "demo.sqlite").read_bytes()
        check(b"Fictional queued text" not in raw and b"fixture-secret" not in raw, "Erased text is still in the database file")
        check(not accounts_file.exists() and not (files / "web-erase-me").exists() and not (files / "matrix-store").exists()
              and (files / "uploads").is_dir() and not any((files / "uploads").iterdir()), "Account, attachment, upload, or key files were left")
        check((request.directory / "rclone.conf").is_file(), "Erase removed the server admin's rclone configuration")
        check((request.directory / "setup-code").is_file(), "Erase didn't make a new setup code for other devices")
        # A fresh start: no password, this computer opens it, and the first-run welcome shows again.
        check(call("/api/auth")[1] == {"owner": False, "signed_in": False, "local": True}, "The server isn't like a new install after erasing")
        cookie = sign_in_here()
        settings = call("/api/settings", cookie=cookie)[1]
        check(settings["welcomed"] is False and settings["prefs"]["games"] is True and settings["web_appearance"] == {"theme": "fluid", "mode": "system"},
              "Settings weren't erased: " + json.dumps({key: settings[key] for key in ("welcomed", "prefs", "web_appearance")}))
        snapshot = call("/api/inbox", cookie=cookie)[1]
        check(snapshot["messages"] == [] and snapshot["accounts"] == [] and snapshot["updated"] is None, "Messages or accounts are left")
        check(call("/api/jobs", cookie=cookie)[1] == [], "The phone's queue wasn't emptied")
        # Five tries in ten minutes from one address, then it waits.
        check(call("/api/erase", {"confirm": "no"}, cookie=cookie)[0] == 400, "A wrong word wasn't refused")
        check(call("/api/erase", {"confirm": "ERASE"}, cookie=cookie)[0] == 429, "Repeated erase tries weren't rate-limited")
    print("PASS  erase everything: browser session, CSRF, ERASE and password, rate limit; data, accounts, files, tokens, sessions gone; fresh welcome")


def web_privacy_test():
    """Settings → Privacy and security on the web: the private folder (hidden by the server until a session opens it),
    decoy mode (a decoy password that only ever reaches a pretend inbox), and the emergency erase passcode (erases
    everything and looks like a normal sign-in). Fictional people and codes only."""
    import sqlite3
    password, decoy, code, distress = "harbor maple lantern", "willow candle orbit", "4821", "violet anchor 93"
    opener = build_opener(ProxyHandler({}))

    def caller(origin):
        def call(path, body=None, cookie=None, headers=None):
            sent = {"X-Fluid-Request": "1", "Content-Type": "application/json", "Origin": origin, **(headers or {})}
            sent = {key: value for key, value in sent.items() if value is not None}
            if cookie:
                sent["Cookie"] = cookie
            data = json.dumps(body).encode() if body is not None else None
            try:
                with opener.open(Request(origin + path, data=data, headers=sent), timeout=30) as response:
                    return response.status, json.loads(response.read() or b"{}"), response.headers
            except HTTPError as error:
                return error.code, json.loads(error.read() or b"{}"), error.headers
        return call

    with companion(free_port(), "") as (origin, request, _):
        call = caller(origin)

        def sign_in(secret):
            started = time.monotonic()
            status, result, headers = call("/api/auth/login", {"password": secret, "remember": True})
            elapsed = time.monotonic() - started
            cookies = headers.get_all("Set-Cookie") or []
            return status, result, cookies[0].split(";")[0] if cookies else "", elapsed, [item.split("=", 1)[1].split(";", 1)[1] for item in cookies]

        def stored(key=None):
            with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db:
                if key:
                    return json.loads(db.execute("SELECT value FROM protocol_state WHERE key=?", (key,)).fetchone()[0])
                return json.dumps(db.execute("SELECT * FROM auth_state").fetchall() + db.execute("SELECT * FROM protocol_state").fetchall())

        status, _, headers = call("/api/auth/local", {})
        check(status == 200, "This computer couldn't open the app")
        here = headers.get("Set-Cookie").split(";")[0]
        check(call("/api/auth/password", {"password": password}, cookie=here)[0] == 200, "Couldn't set the web password")
        bearer = {"Authorization": "Bearer " + call("/api/auth/pairing", {}, cookie=here)[1]["token"]}
        secret_chat, now = "+12025550123", int(time.time() * 1000)
        request("/api/sync", {"messages": sample_messages()}, authorized=False, extra_headers=bearer)
        request("/api/schedule", {"address": secret_chat, "body": "Fictional private text", "due": now + 3_600_000},
                authorized=False, extra_headers=bearer)
        status, _, real, _, _ = sign_in(password)
        check(status == 200 and real, "Couldn't sign in with the password")

        # Private folder: set up with its own passcode, typed twice, different from the password.
        check(call("/api/privacy/private/move", {"address": secret_chat, "private": True}, cookie=real)[0] == 409,
              "A chat moved to a private folder that isn't set up")
        for body, why in (({"code": "12", "again": "12"}, "a too-short passcode"), ({"code": code, "again": "4822"}, "passcodes that don't match"),
                          ({"code": password, "again": password}, "the web password as its passcode")):
            check(call("/api/privacy/private/setup", body, cookie=real)[0] == 400, "The private folder accepted " + why)
        status, result, _ = call("/api/privacy/private/setup", {"code": code, "again": code}, cookie=real)
        check(status == 200 and result["private"] == {"set": True, "open": True, "count": 0}, "Couldn't set up the private folder")
        check(call("/api/privacy/private/move", {"address": secret_chat, "private": True}, cookie=real)[0] == 200, "Couldn't move a chat")
        check(call("/api/settings", {"web_chats": {"pinned": [secret_chat], "archived": [], "blocked": [], "muted": [], "locks": {}}},
                   cookie=real)[0] == 200, "Couldn't pin the private chat")
        opened = call("/api/inbox", cookie=real)[1]
        check(any(row["address"] == secret_chat for row in opened["messages"]) and opened["private_chats"] == [secret_chat],
              "The session that set up the private folder doesn't see its chat")

        def hides(cookie, why):
            snapshot = json.dumps(call("/api/inbox", cookie=cookie)[1]) + json.dumps(call("/api/settings", cookie=cookie)[1]) \
                + json.dumps(call("/api/jobs", cookie=cookie)[1]) + json.dumps(call("/api/merge", cookie=cookie)[1])
            check("5550123" not in snapshot and "Fictional private text" not in snapshot and "Coffee at ten?" not in snapshot,
                  "A private chat is visible " + why)
            check("5550146" in snapshot, "The rest of the inbox went missing " + why)

        hides(here, "to another session that never opened the folder")
        check(call("/api/privacy/private/lock", {}, cookie=real)[1] == {"open": False}, "Couldn't lock the private folder")
        hides(real, "after locking the folder")
        # A locked session saving its chat settings keeps the private chat's pin it never saw.
        check(call("/api/settings", {"web_chats": {"pinned": [], "archived": [], "blocked": [], "muted": [], "locks": {}}},
                   cookie=real)[0] == 200, "A locked session couldn't save chat settings")
        check(stored("web_chats")["pinned"] == [secret_chat], "A locked session's save dropped the private chat's pin")
        check("5550123" not in json.dumps(request("/api/merge", authorized=False, extra_headers=bearer)["web"]),
              "The private chat went into the phone↔web merge")
        check(call("/api/privacy/private/unlock", {"code": "0000"}, cookie=real)[1] == {"open": False}, "A wrong passcode opened the folder")
        hides(real, "after a wrong passcode")
        check(call("/api/privacy/private/unlock", {"code": code}, cookie=real)[1] == {"open": True}, "The right passcode didn't open the folder")
        check(any(row["address"] == secret_chat for row in call("/api/inbox", cookie=real)[1]["messages"]), "Opening didn't show the chat")
        hides(here, "to another session while this one has it open")

        # Decoy mode: a second password, typed twice, confirmed with the real one, different from every other code.
        check(call("/api/privacy/decoy", {"password": decoy, "again": decoy, "current": "not it"}, cookie=real)[0] == 403,
              "The decoy password was set without the web password")
        for body, why in (({"password": decoy, "again": decoy + "x"}, "passwords that don't match"),
                          ({"password": password, "again": password}, "the real password"), ({"password": "short", "again": "short"}, "a short one")):
            check(call("/api/privacy/decoy", {**body, "current": password}, cookie=real)[0] == 400, "Decoy mode accepted " + why)
        check(call("/api/privacy/decoy", {"password": decoy, "again": decoy, "current": password}, cookie=real)[1]["decoy"]["set"] is True,
              "Couldn't set the decoy password")
        check(call("/api/privacy/decoy/chats", {"chats": [{"name": "Rowan Hale", "lines": [{"me": False, "text": "Lunch tomorrow?"},
              {"me": True, "text": "Sounds good"}]}, {"name": "Garden Club", "lines": [{"me": False, "text": "Seeds swap is Saturday"}]}]},
              cookie=real)[0] == 200, "Couldn't save pretend chats")
        timings = {"real": [], "decoy": [], "wrong": []}
        answers = {}
        for _ in range(3):
            for name, secret in (("real", password), ("decoy", decoy), ("wrong", "not the password at all")):
                status, result, cookie, elapsed, flags = sign_in(secret)
                timings[name].append(elapsed)
                answers[name] = (status, result, flags)
                if name == "decoy":
                    fake = cookie
        check(answers["real"] == answers["decoy"], "A decoy sign-in answers differently: " + repr((answers["real"], answers["decoy"])))
        middle = {name: sorted(values)[1] for name, values in timings.items()}
        check(middle["decoy"] < middle["real"] * 2 + 0.15 and middle["real"] < middle["decoy"] * 2 + 0.15,
              "A decoy sign-in takes a different time: " + json.dumps(middle))
        check(call("/api/auth", cookie=fake)[1]["owner"] is True and call("/api/auth", cookie=fake)[1]["signed_in"] is True,
              "The decoy session doesn't look signed in")
        pretend = call("/api/inbox", cookie=fake)[1]
        text = json.dumps(pretend)
        check("Rowan Hale" in text and "Garden Club" in text and pretend["updated"], "The decoy inbox doesn't show the pretend chats")
        check(not any(word in text for word in ("Coffee at ten?", "5550146", "5550123", "I sent the route")), "The decoy inbox shows real messages")
        check(call("/api/privacy", cookie=fake)[1]["private"] is None, "The decoy session can see the private folder settings")
        security = call("/api/auth/security", cookie=fake)[1]
        check(security["pairing"]["web"] is False and security["sessions"] == 1, "The decoy session sees real pairing and sessions")
        check(call("/api/protocols/accounts", cookie=fake)[1]["accounts"] == [], "The decoy session sees accounts")
        check("5550" not in json.dumps(call("/api/settings", cookie=fake)[1]) and call("/api/jobs", cookie=fake)[1] == [],
              "The decoy session sees real settings or the queue")
        for path, body in (("/api/erase", {"confirm": "ERASE", "password": decoy}), ("/api/auth/pairing", {}), ("/api/auth/pairing/delete", {}),
                           ("/api/auth/password", {"current": decoy, "password": "a brand new password"}), ("/api/auth/sessions/end-others", {}),
                           ("/api/auth/local-access", {"enabled": False}), ("/api/protocols/accounts", {"protocol": "email", "fields": {}}),
                           ("/api/protocols/accounts/delete", {"protocol": "email"}), ("/api/privacy/decoy/off", {"current": decoy}),
                           ("/api/privacy/distress", {"code": "123456", "again": "123456", "understood": True, "current": decoy}),
                           ("/api/privacy/private/unlock", {"code": code}), ("/api/merge/resolve", {}), ("/api/sync", {"messages": []}),
                           ("/api/contacts", {"name": "Rowan Hale"}), ("/api/contacts/delete", {"id": "wc-0000000000000000"})):
            check(call(path, body, cookie=fake)[0] == 503, "The decoy session reached " + path)
        check(call("/api/contacts", cookie=fake)[1]["contacts"] == [], "The decoy session sees web contacts")
        check(call("/api/settings", {"follow_phone": False}, cookie=fake, headers={"X-Fluid-Request": None})[0] == 403,
              "CSRF isn't checked for decoy sessions")
        check(call("/api/schedule", {"address": "+12025550161", "body": "Fictional decoy reply", "due": now}, cookie=fake)[0] == 200,
              "Sending in the decoy inbox wasn't sandboxed")
        check("Fictional decoy reply" in json.dumps(call("/api/inbox", cookie=fake)[1]), "The sandboxed text didn't show in the decoy chat")
        check("Fictional decoy reply" not in json.dumps(call("/api/jobs", cookie=real)[1]), "A decoy text reached the phone's queue")
        # Inbox filters in a decoy session: its own menu, no real favorites, no servers, and only the pretend chats.
        check(call("/api/settings", {"web_favorites": ["+12025550123"], "prefs": {"inboxFilters": ["favorites", "inbox", "-groups"]}},
                   cookie=real)[0] == 200, "Real favorites or inbox filters weren't saved")
        pretend = call("/api/inbox", cookie=fake)[1]
        check("web_favorites" not in pretend and pretend["accounts"] == [] and pretend["routes"] == []
              and pretend["prefs"]["inboxFilters"][0] == "inbox", "The decoy session sees real favorites, servers, or filters")
        check(call("/api/settings", {"prefs": {"inboxFilters": ["groups", "inbox"], "communitySort": "name"}}, cookie=fake)[1]["prefs"]["inboxFilters"][0] == "groups"
              and call("/api/inbox", cookie=fake)[1]["prefs"]["inboxFilters"][0] == "groups", "The decoy session can't keep its own inbox filters")
        check(call("/api/settings", {"prefs": {"inboxFilters": ["-inbox"]}}, cookie=fake)[0] == 400, "The decoy session hid Inbox")
        real_prefs = call("/api/inbox", cookie=real)[1]["prefs"]
        check(real_prefs["inboxFilters"][:3] == ["favorites", "inbox", "-groups"] and real_prefs["communitySort"] == "recent",
              "The decoy session changed the real inbox filters")
        check(call("/api/settings", {"web_favorites": [], "prefs": {"inboxFilters": []}}, cookie=real)[0] == 200, "Inbox filters weren't reset")
        check(len(call("/api/inbox", cookie=real)[1]["messages"]) >= 3 and call("/api/auth/security", cookie=real)[1]["pairing"]["web"],
              "The decoy session changed real data")

        # Quick hide switches this session to decoy mode; Show your real inbox takes the private folder passcode.
        check(call("/api/privacy/quick-hide", {}, cookie=real)[0] == 200, "Quick hide failed")
        check("Rowan Hale" in json.dumps(call("/api/inbox", cookie=real)[1]), "Quick hide didn't show the decoy inbox")
        check(call("/api/privacy/reveal", {"code": "0000"}, cookie=real)[0] == 403, "A wrong passcode ended decoy mode")
        check(call("/api/privacy/reveal", {"code": code}, cookie=real)[1] == {"ok": True}, "The private folder passcode didn't end decoy mode")
        back = call("/api/inbox", cookie=real)[1]
        check("Rowan Hale" not in json.dumps(back) and "5550123" not in json.dumps(back), "Decoy mode didn't end, or left the private folder open")

        # Emergency erase passcode: at least 6 characters, typed twice, confirmed, and unlike every other code.
        base = {"code": distress, "again": distress, "understood": True, "current": password}
        for body, why in (({**base, "understood": False}, "without confirming"), ({**base, "again": distress + "!"}, "passcodes that don't match"),
                          ({**base, "code": "12345", "again": "12345"}, "a short one"), ({**base, "code": password, "again": password}, "the password"),
                          ({**base, "code": decoy, "again": decoy}, "the decoy password")):
            check(call("/api/privacy/distress", body, cookie=real)[0] == 400, "The emergency passcode accepted " + why)
        check(call("/api/privacy/distress", {**base, "current": "nope"}, cookie=real)[0] == 403, "The emergency passcode was set without the password")
        check(call("/api/privacy/distress", base, cookie=real)[1]["distress"]["set"] is True, "Couldn't set the emergency passcode")
        check(call("/api/auth/password", {"current": password, "password": distress}, cookie=real)[0] == 400,
              "The password could be changed to the emergency passcode")
        saved = stored()
        check(all(value not in saved for value in (password, decoy, code, distress)) and saved.count("scrypt") >= 4,
              "A password or passcode is stored in the clear")

        # Wrong codes count toward the sign-in rate limit, from one address.
        away = {"X-Forwarded-For": "198.51.100.23"}
        for _ in range(5):
            call("/api/privacy/private/unlock", {"code": "9999"}, cookie=real, headers=away)
        check(call("/api/privacy/private/unlock", {"code": code}, cookie=real, headers=away)[0] == 429, "Wrong private folder passcodes weren't rate-limited")
        check(call("/api/auth/login", {"password": password}, headers=away)[0] == 429, "Wrong passcodes didn't count toward sign-in limits")

        status, result, cookie, elapsed, flags = sign_in(distress)
        check((status, result, flags) == answers["real"], "The emergency passcode answers differently from a real sign-in")
        check(elapsed < middle["real"] * 2 + 0.15, "The emergency passcode took longer than a sign-in: %.3f vs %.3f" % (elapsed, middle["real"]))
        timing = "sign-in %d ms, decoy %d ms, wrong %d ms, emergency %d ms" % (
            middle["real"] * 1000, middle["decoy"] * 1000, middle["wrong"] * 1000, elapsed * 1000)
        after = call("/api/inbox", cookie=cookie)
        check(after[0] == 200 and "Coffee at ten?" not in json.dumps(after[1]) and after[1]["messages"], "After the emergency passcode the page isn't a decoy inbox")
        check(call("/api/inbox", cookie=here)[0] == 401 and call("/api/auth")[1]["owner"] is False, "The emergency passcode didn't erase everything")
        with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db:
            left = [db.execute(f"SELECT count(*) FROM {table}").fetchone()[0] for table in ("inbox", "jobs", "protocol_messages")]
            secrets_left = db.execute("SELECT key FROM auth_state").fetchall()
        check(not any(left) and not secrets_left and b"Fictional private text" not in (request.directory / "demo.sqlite").read_bytes(),
              "Data was left after the emergency erase")

    # The emergency passcode in the private folder prompt answers like a wrong passcode, and erases everything.
    with companion(free_port(), "") as (origin, request, _):
        call = caller(origin)
        status, _, headers = call("/api/auth/local", {})
        here = headers.get("Set-Cookie").split(";")[0]
        token = call("/api/auth/pairing", {}, cookie=here)[1]["token"]
        request("/api/sync", {"messages": sample_messages()}, authorized=False, extra_headers={"Authorization": "Bearer " + token})
        call("/api/privacy/private/setup", {"code": code, "again": code}, cookie=here)
        check(call("/api/privacy/distress", {**base, "current": ""}, cookie=here)[0] == 200, "Couldn't set the emergency passcode without a password")
        call("/api/privacy/private/lock", {}, cookie=here)
        wrong = call("/api/privacy/private/unlock", {"code": "11111111"}, cookie=here)[:2]
        check(call("/api/privacy/private/unlock", {"code": distress}, cookie=here)[:2] == wrong, "The emergency passcode answers differently from a wrong one")
        after = json.dumps(call("/api/inbox", cookie=here)[1])
        check("Coffee at ten?" not in after and "Mom" in after, "The private folder prompt's emergency passcode didn't erase into a decoy inbox")
    print("PASS  web privacy: private folder hidden by the server until opened, decoy password sandboxed everywhere and indistinguishable, "
          "emergency erase passcode, rate limits, and hashes only (" + timing + ")")


def merge_test():
    """Phone and web merge: auth and CSRF, a conflict settled in the browser, the phone picking it up, stickers."""
    token = secrets.token_hex(24)
    with companion(free_port(), token) as (origin, request, _):
        opener = build_opener(ProxyHandler({}))

        def call(path, body=None, cookie=None, headers=None, bearer=False, raw=False):
            sent = {"X-Fluid-Request": "1", "Content-Type": "application/json", "Origin": origin, **(headers or {})}
            if bearer:
                sent = {"Authorization": "Bearer " + token, "Content-Type": "application/json", **(headers or {})}
            sent = {key: value for key, value in sent.items() if value is not None}
            if cookie:
                sent["Cookie"] = cookie
            data = body if isinstance(body, bytes) else json.dumps(body).encode() if body is not None else None
            try:
                with opener.open(Request(origin + path, data=data, headers=sent), timeout=15) as response:
                    content = response.read()
                    return response.status, content if raw else json.loads(content or b"{}"), response.headers
            except HTTPError as error:
                return error.code, json.loads(error.read() or b"{}"), error.headers

        status, _, headers = call("/api/auth/local", {})
        check(status == 200, "This computer couldn't open FluidMessages Web for the merge test")
        cookie = headers.get_all("Set-Cookie")[0].split(";")[0]
        # Who may do what
        check(call("/api/merge", headers={"Origin": None, "X-Fluid-Request": None})[0] == 401, "The merge answered without signing in")
        check(call("/api/merge", {"revision": ""}, cookie=cookie)[0] == 403, "A browser posted a merge; only the phone does")
        check(call("/api/merge/resolve", {"id": "x", "choices": {}}, cookie=cookie, headers={"X-Fluid-Request": None})[0] == 403,
              "CSRF: settling without the page's header worked")
        check(call("/api/merge/resolve", {"id": "x", "choices": {}}, cookie=cookie, headers={"Sec-Fetch-Site": "cross-site"})[0] == 403,
              "CSRF: settling from another site worked")
        check(call("/api/merge", bearer=True, headers={"Authorization": "Bearer " + "0" * 64})[0] == 401, "A wrong token read the merge")

        # The web's own settings before the phone ever connects (fictional chats)
        web_chats = {"pinned": ["+15550101"], "archived": ["+15550102"], "blocked": [], "muted": ["+15550105"], "locks": {},
                     "senders": {"+15550106": "automated"}}
        status, _, _ = call("/api/settings", {"web_appearance": {"theme": "ember", "mode": "dark"}, "web_chats": web_chats,
                                              "disappearing": {"default": 0, "chats": {"+15550103": 3600}},
                                              "web_extras": {"gifs": {"own": [{"name": "Kittens", "search": "https://gifs.example.net/s/{query}"}], "off": ["imgur"]},
                                                             "money": {"custom": [{"name": "Tips jar", "template": "https://pay.example.net/{address}/{amount}"},
                                                                                  {"name": "Bad", "template": "javascript:{address}"}], "default": "Tips jar"}}},
                            cookie=cookie)
        check(status == 200, "The web's settings weren't saved")
        check(call("/api/settings", {"web_chats": {**web_chats, "senders": {"+1": "robot"}}}, cookie=cookie)[0] == 400, "A bad sender type was kept")
        status, state, _ = call("/api/merge", bearer=True)
        web = state["web"]
        check(status == 200 and state["supported"] == 1 and state["pair"] is None and state["baseline"] is None and state["pending"] is None,
              "A new server should have nothing merged yet")
        expected = {"look:theme": "ember", "look:mode": "dark", "folder:+15550101": "pinned", "folder:+15550102": "archived",
                    "muted:+15550105": "on", "sender:+15550106": "automated", "timer:+15550103": "3600",
                    "gif:Kittens": "https://gifs.example.net/s/{query}", "gifoff:imgur": "off",
                    "pay:Tips jar": "https://pay.example.net/{address}/{amount}", "pay:*": "Tips jar"}
        check(web == expected, "The web's items are wrong: " + json.dumps(web))
        check("pay:Bad" not in web, "An unsafe payment link was kept")

        # The phone (SyncMerge.kt) merged and found two true conflicts; everything else is unioned.
        phone = {"look:theme": "midnight", "folder:+15550102": "pinned", "folder:+15550104": "pinned", "fun:games": "off",
                 "timer:+15550103": "3600"}
        union_web = {"folder:+15550104": "pinned", "fun:games": "off"}
        baseline = {key: value for key, value in {**web, **phone}.items() if key not in ("look:theme", "folder:+15550102")}
        post = {"revision": state["revision"], "apply_web": union_web, "baseline": baseline,
                "conflicts": [{"key": "look:theme", "phone": "midnight", "phone_t": 1700000000000},
                              {"key": "folder:+15550102", "phone": "pinned"},
                              {"key": "timer:+15550103", "phone": "3600"}]}
        check(call("/api/merge", {**post, "revision": "stale"}, bearer=True)[0] == 409, "A merge from a stale look was accepted")
        check(call("/api/merge", {**post, "apply_web": {"nope": "1"}}, bearer=True)[0] == 400, "An unknown item was accepted")
        status, after, _ = call("/api/merge", post, bearer=True)
        check(status == 200 and after["pair"] and len(after["pending"]["conflicts"]) == 2, "The merge didn't keep two conflicts")
        theme = next(item for item in after["pending"]["conflicts"] if item["key"] == "look:theme")
        check(theme["web"] == "ember" and theme["phone"] == "midnight" and theme["phone_t"] == 1700000000000 and theme["web_t"] > 0,
              "A conflict should carry both values and when each changed")
        snapshot = call("/api/inbox", cookie=cookie)[1]
        check(snapshot["merge"]["active"] and len(snapshot["merge"]["pending"]["conflicts"]) == 2, "The browser doesn't see the conflicts")
        check(snapshot["prefs"]["games"] is False and "+15550104" in snapshot["web_chats"]["pinned"], "The union didn't reach the web")
        # The phone's regular sync doesn't overwrite a timer that waits for a choice.
        pending_id = after["pending"]["id"]

        # Settled in the browser: the phone's theme, the web's folder.
        choices = {"look:theme": "phone", "folder:+15550102": "web"}
        check(call("/api/merge/resolve", {"id": "other", "choices": choices}, cookie=cookie)[0] == 409, "A stale choice was accepted")
        check(call("/api/merge/resolve", {"id": pending_id, "choices": {"look:theme": "phone"}}, cookie=cookie)[0] == 400,
              "A choice was accepted with a difference left open")
        status, settled, _ = call("/api/merge/resolve", {"id": pending_id, "choices": choices}, cookie=cookie)
        check(status == 200 and settled["pending"] is None and settled["resolved"]["picks"] == choices, "The choices weren't saved")
        settings = call("/api/settings", cookie=cookie)[1]
        check(settings["web_appearance"]["theme"] == "midnight" and "+15550102" in settings["web_chats"]["archived"]
              and "+15550102" not in settings["web_chats"]["pinned"], "The browser's choices weren't applied on the web")
        check(call("/api/merge/resolve", {"id": pending_id, "choices": choices}, cookie=cookie)[0] == 409, "The same choices were applied twice")

        # The phone looks again: it writes the web's picks, and both sides hold the same items.
        status, state, _ = call("/api/merge", bearer=True)
        resolved = state["resolved"]
        for key, pick in resolved["picks"].items():
            if pick == "web":
                phone[key] = resolved["values"][key]
        phone.update(union_web)
        phone.update({key: value for key, value in web.items() if key not in phone})
        check(state["web"] == phone and state["baseline"] == phone, "The phone and the web don't end up the same")
        status, state, _ = call("/api/merge", {"revision": state["revision"], "apply_web": {}, "baseline": phone, "conflicts": []}, bearer=True)
        check(status == 200 and state["pending"] is None, "A clean merge left something to choose")

        # Settled on the phone instead: the pairing token works, no CSRF header needed.
        status, state, _ = call("/api/merge", {"revision": state["revision"], "apply_web": {}, "baseline": phone,
                                               "conflicts": [{"key": "look:mode", "phone": "light"}]}, bearer=True)
        check(status == 200 and state["pending"]["conflicts"][0]["web"] == "dark", "The second conflict wasn't kept")
        status, state, _ = call("/api/merge/resolve", {"id": state["pending"]["id"], "choices": {"look:mode": "web"}}, bearer=True)
        check(status == 200 and state["web"]["look:mode"] == "dark" and state["baseline"]["look:mode"] == "dark",
              "Settling on the phone didn't work")

        # While a timer waits for a choice, the phone's regular sync doesn't overwrite the web's side of it.
        status, state, _ = call("/api/merge", {"revision": state["revision"], "apply_web": {}, "baseline": state["baseline"],
                                               "conflicts": [{"key": "timer:+15550103", "phone": "60"}]}, bearer=True)
        check(status == 200 and state["pending"]["conflicts"][0]["web"] == "3600", "The timer conflict wasn't kept")
        call("/api/sync", {"messages": [], "privacy": {"disappearing": {"default": 0, "chats": {"+15550103": 60}}}}, bearer=True)
        check(call("/api/settings", cookie=cookie)[1]["disappearing"]["chats"]["+15550103"] == 3600,
              "The phone's sync overwrote a timer that waits for a choice")

        # Stickers: a small fictional picture from the phone, listed for browsers, served as a download only.
        png = b"\x89PNG\r\n\x1a\n" + b"\x00" * 40
        status, sticker, _ = call("/api/stickers/upload", png, bearer=True, headers={"Content-Type": "image/png", "X-Fluid-Sticker": "sticker-1"})
        check(status == 200 and sticker["mime"] == "image/png", "The phone couldn't add a sticker")
        check(call("/api/stickers/upload", b"<svg/>", bearer=True, headers={"Content-Type": "image/png", "X-Fluid-Sticker": "sticker-2"})[0] == 400,
              "Something other than a picture was kept as a sticker")
        check(call("/api/stickers/upload", png, bearer=True, headers={"Content-Type": "image/svg+xml", "X-Fluid-Sticker": "sticker-3"})[0] == 400,
              "An SVG sticker was kept")
        check(call("/api/stickers/upload", png, cookie=cookie, headers={"Content-Type": "image/png", "X-Fluid-Sticker": "sticker-4",
                                                                       "X-Fluid-Request": None})[0] == 403, "CSRF: a sticker upload worked")
        status, content, headers = call("/api/stickers/file?id=sticker-1", headers={"Origin": None}, cookie=cookie, raw=True)
        check(status == 200 and content == png and headers.get_content_type() == "application/octet-stream"
              and headers["X-Fluid-Type"] == "image/png", "The sticker wasn't served as a download")
        check(call("/api/merge", bearer=True)[1]["web"].get("sticker:sticker-1") == "1", "The sticker isn't an item")
        call("/api/merge/stickers/delete", {"id": "sticker-1"}, cookie=cookie)
        check(call("/api/stickers", cookie=cookie)[1]["stickers"] == [], "The sticker wasn't deleted")
        stored = json.dumps([str(path) for path in request.directory.rglob("*")])
        check(token not in stored, "The pairing token showed up in a file name")

        # Timed mutes (fictional chats): "muted:" stays "on" for every version; how long travels only to phones that ask.
        soon = int(time.time() * 1000) + 3_600_000
        server = "server:irc:fixture@irc.example.test"
        chats_now = call("/api/settings", cookie=cookie)[1]["web_chats"]
        status, _, _ = call("/api/settings", {"web_chats": {**chats_now, "muted": chats_now["muted"] + ["+15550107", server],
                                                            "mute_until": {"+15550107": soon}}}, cookie=cookie)
        check(status == 200, "A timed mute wasn't saved")
        older = call("/api/merge", bearer=True)[1]
        check(older["web"].get("muted:+15550107") == "on" and older["web"].get("muted:" + server) == "on"
              and not any(key.startswith("muteuntil:") for key in older["web"]), "An older phone would see items it doesn't know")
        timed = call("/api/merge", bearer=True, headers={"X-Fluid-Merge-Items": "muteuntil"})[1]
        check(timed["mute_until"] == 1 and timed["web"].get("muteuntil:+15550107") == str(soon) and "muteuntil:" + server not in timed["web"],
              "A newer phone doesn't see when a mute ends")
        later = soon + 86_400_000
        changes = {"muteuntil:+15550107": str(later), "muted:+15550108": "on", "muteuntil:+15550108": str(later)}
        check(call("/api/merge", {"revision": timed["revision"], "apply_web": changes, "baseline": {}, "conflicts": []}, bearer=True)[0] == 409,
              "A merge against the timed view was taken as an older phone's")
        status, state, _ = call("/api/merge", {"revision": timed["revision"], "mute_until": 1, "apply_web": changes,
                                               "baseline": {**timed["web"], **changes}, "conflicts": []}, bearer=True)
        stored = call("/api/settings", cookie=cookie)[1]["web_chats"]
        check(status == 200 and stored["mute_until"].get("+15550107") == later and stored["mute_until"].get("+15550108") == later
              and "+15550108" in stored["muted"], "The phone's mute times didn't reach the web: " + json.dumps(stored.get("mute_until")))
        # Forever from the phone, then a time that has already passed: unmuted on its own.
        status, state, _ = call("/api/merge", {"revision": state["revision"], "mute_until": 1, "baseline": {},
                                               "apply_web": {"muteuntil:+15550107": None, "muteuntil:+15550108": str(soon - 7_200_000)},
                                               "conflicts": []}, bearer=True)
        stored = call("/api/settings", cookie=cookie)[1]["web_chats"]
        check(status == 200 and "+15550107" in stored["muted"] and "+15550107" not in stored.get("mute_until", {})
              and "+15550108" not in stored["muted"] and "muted:+15550108" not in state["web"], "Forever or an ended mute is wrong")
    print("PASS  phone and web merge: auth, CSRF, a settled conflict on both sides, stickers, and timed mutes")


# Typed addresses and what they are, shared with the phone's NewAddressTest.kt: [text, [[service, target], ...]].
NEW_ADDRESSES = [
    ["+1 (202) 555-0143", [["sms", "+1 (202) 555-0143"]]],
    ["2025550143", [["sms", "2025550143"]]],
    ["12", []],
