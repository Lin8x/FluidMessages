#!/usr/bin/env python3
"""Exercise FluidMessages locally without touching a real inbox."""
import argparse
from concurrent.futures import ThreadPoolExecutor
from contextlib import contextmanager
import json
import os
import re
from pathlib import Path
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from urllib.error import HTTPError, URLError
from urllib.request import ProxyHandler, Request, build_opener
import webbrowser
import zipfile

ROOT = Path(__file__).resolve().parents[1]
PACKAGE = "org.fluidmessages"
GRADLE_APK = ROOT / "app/build/outputs/apk/debug/app-debug.apk"
CLOUD_TARGETS = ("onedrive", "drive", "s3")


def check(condition, message):
    if not condition:
        raise RuntimeError(message)


@contextmanager
def companion(port, token, cloud_fixtures=False):
    with tempfile.TemporaryDirectory(prefix="fluid-test-") as directory:
        env = dict(os.environ, FLUID_DB=str(Path(directory) / "demo.sqlite"),
                   FLUID_TOKEN=token, FLUID_BIND="127.0.0.1", FLUID_PORT=str(port),
                   RCLONE_CONFIG=str(Path(directory) / "rclone.conf"))
        for key in CLOUD_TARGETS:
            folder = Path(directory) / key
            if cloud_fixtures:
                folder.mkdir()
            env["FLUID_BACKUP_" + key.upper()] = str(folder) if cloud_fixtures else ""
        process = subprocess.Popen(
            [sys.executable, str(ROOT / "server/main.py")],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        origin = f"http://127.0.0.1:{port}"
        opener = build_opener(ProxyHandler({}))

        def request(path, body=None, authorized=True, method=None, extra_headers=None):
            headers = {"Authorization": "Bearer " + token} if authorized else {}
            headers.update(extra_headers or {})
            data = body if isinstance(body, bytes) else json.dumps(body).encode() if body is not None else None
            with opener.open(Request(origin + path, data=data, headers=headers, method=method), timeout=5) as response:
                content = response.read()
                return json.loads(content) if response.headers.get_content_type() == "application/json" else content

        try:
            for _ in range(50):
                check(process.poll() is None, "Companion failed to start. The port may already be in use.")
                try:
                    request("/", authorized=False)
                    break
                except URLError:
                    time.sleep(0.05)
            else:
                raise RuntimeError("Timed out starting the companion")
            yield origin, request, process
        finally:
            process.terminate()
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


def free_port():
    try:
        with socket.socket() as listener:
            listener.bind(("127.0.0.1", 0))
            return listener.getsockname()[1]
    except PermissionError as error:
        raise RuntimeError("Loopback networking is blocked. Run this command from a regular terminal.") from error


def sample_messages():
    now = int(time.time() * 1000)
    return [
        {"address": "+12025550123", "body": "See you there!", "type": 2, "date": now - 60_000},
        {"address": "+12025550123", "body": "Coffee at ten?", "type": 1, "date": now - 90_000},
        {"address": "+12025550146", "body": "I sent the route for Saturday.", "type": 1, "date": now - 150_000},
    ]


def smoke_test():
    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        for path, expected in (("/", b"FluidMessages"), ("/app.js", b"schedule"), ("/style.css", b"--canvas")):
            check(expected in request(path, authorized=False), f"Missing browser asset at {path}")
        try:
            request("/api/inbox", authorized=False)
        except HTTPError as error:
            check(error.code == 401, f"Expected HTTP 401, got {error.code}")
        else:
            raise RuntimeError("Inbox accepted an unauthenticated request")
        messages = sample_messages()
        request("/api/sync", {"messages": messages})
        check(request("/api/inbox")["messages"] == messages, "Synced inbox differs from the phone snapshot")
        appearance = {"dark": True, "exactTimes": True, "radius": 19, "folders": {"archived": [messages[0]["address"]]},
                      "colors": {"sms": "#457abc", "surface": "#172e26", "raised": "#1b372d", "action": "#8bdabb",
                                 "ink": "#ffffff", "muted": "#bfccc7", "line": "#3a4d45", "outline": "#697b73"}}
        request("/api/sync", {"messages": messages, "appearance": {**appearance, "size": 900,
                "colors": {**appearance["colors"], "accent": "url(invalid)"}}})
        snapshot = request("/api/inbox")
        check(snapshot["messages"] == messages and snapshot["appearance"] == appearance,
              "Inbox and appearance snapshot were not saved together")
        request("/api/sync", {"messages": messages})
        check(request("/api/inbox")["appearance"] == {}, "Older Android sync should use the companion theme")
        now = int(time.time() * 1000)
        draft = {"address": messages[0]["address"], "body": "Test only", "due": now + 60_000}
        cancelled = request("/api/schedule", draft)["id"]
        request("/api/cancel", {"id": cancelled})
        due = request("/api/schedule", {**draft, "due": now})["id"]
        with ThreadPoolExecutor(max_workers=4) as pool:
            claims = list(pool.map(lambda _: request("/api/claim", {})["job"], range(4)))
        check([job["id"] for job in claims if job] == [due], "Due message was lost or claimed more than once")
        request("/api/result", {"id": due, "state": "submitted"})
        check({job["id"]: job["state"] for job in request("/api/jobs")} ==
              {cancelled: "cancelled", due: "submitted"}, "Queue state did not persist")
        call = request("/api/call", {"address": messages[0]["address"]})["id"]
        claimed = request("/api/claim", {})["job"]
        check(claimed and claimed["id"] == call and claimed["protocol"] == "call", "Call request was not handed to the phone")
        request("/api/result", {"id": call, "state": "submitted"})
        try:
            request("/api/call", {"address": "not a number"})
            raise RuntimeError("Companion accepted a call to a non-number")
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for an invalid call, got {error.code}")
        upload = request("/api/protocols/upload", b"fixture", extra_headers={"Content-Type": "text/plain",
                         "X-Fluid-Name": "notes%20one.txt"})
        check(re.fullmatch(r"[0-9a-f]{40}", upload.get("upload", "")) is not None, "Attachment upload did not return an id")
        try:
            request("/api/protocols/file?id=missing", authorized=True)
            raise RuntimeError("Companion served an unknown attachment")
        except HTTPError as error:
            check(error.code == 404, f"Expected HTTP 404 for a missing attachment, got {error.code}")
    print("PASS  Companion assets, authentication, sync, scheduling, cancellation, claiming, click-to-call and attachment uploads")


def cloud_smoke_test():
    if not shutil.which("rclone"):
        print("SKIP  Cloud backup fixture test (rclone is not installed)")
        return
    with companion(free_port(), secrets.token_hex(32), cloud_fixtures=True) as (_, request, _):
        check(request("/api/backups")["targets"] == list(CLOUD_TARGETS), "Cloud target discovery failed")
        try:
            request("/api/backups/drive", b"not a backup", method="PUT")
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for an invalid backup, got {error.code}")
        else:
            raise RuntimeError("The server accepted an invalid archive")
        older = b"FMB1\x01older fixture"
        newest = b"FMB1\x01newest fixture"
        for target in CLOUD_TARGETS:
            path = "/api/backups/" + target
            dated = request(path, older, method="PUT")["name"]
            check(re.fullmatch(r"FluidMessages_\d{4}-\d{2}-\d{2}_.+\.fmb", dated), "Missing readable backup date")
            time.sleep(.005)
            request(path, newest, method="PUT")
            check(request(path + "/latest") == newest, f"The latest {target} backup did not round-trip")
            fixed = {"X-Fluid-Backup-Name": "My current backup.fmb"}
            request(path, newest, method="PUT", extra_headers=fixed)
            response = request(path, older, method="PUT", extra_headers=fixed)
            check(response["name"] == fixed["X-Fluid-Backup-Name"], "Fixed name was lost")
            check(request(path + "/latest") == older, "The fixed backup did not get replaced")
        try:
            request("/api/backups/drive", older, method="PUT", extra_headers={"X-Fluid-Backup-Name": "../outside.fmb"})
        except HTTPError as error:
            check(error.code == 400, "Invalid backup name produced the wrong response")
        else:
            raise RuntimeError("The server accepted a backup path instead of a filename")
    print("PASS  Cloud target discovery, dated names, fixed-name replacement, and newest restore across three isolated destinations")


def gateway_relations_test():
    """Replies and reactions use native Matrix and RFC 9078 email features with fictional fixtures."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    from email import policy
    from email.parser import BytesParser
    import protocol_gateway

    with tempfile.TemporaryDirectory(prefix="fluid-gateway-") as directory:
        database = str(Path(directory) / "gateway.sqlite")

        def connect():
            return sqlite3.connect(database)

        with connect() as db:
            db.executescript(protocol_gateway.SCHEMA)
        config = {"matrix": {"homeserver": "https://matrix.example.test", "access_token": "fixture",
                             "user_id": "@me:example.test"},
                  "email": {"address": "me@example.test", "smtp_host": "smtp.example.test", "smtp_password": "x",
                            "imap_host": "imap.example.test", "imap_password": "x"},
                  "routes": [{"address": "maya", "protocol": "matrix", "target": "!room:example.test", "title": "Maya"},
                             {"address": "maya", "protocol": "email", "target": "maya@example.test", "title": "Maya"}]}
        gateway = protocol_gateway.Gateway(connect, config, Path(directory) / "files")
        route = gateway.route("maya", "matrix")
        sent = []

        def fake_matrix(path, body=None, allow_missing=False, method=None):
            if allow_missing:
                return None
            sent.append((path, body))
            return {"event_id": "$out" + str(len(sent))}

        gateway.matrix_request = fake_matrix

        def deliver(message, send):
            # Same bookkeeping as Gateway.sender after a successful send.
            message.update(send(gateway.route("maya", message["protocol"]), message) or {})
            with connect() as db:
                db.execute("UPDATE protocol_messages SET payload=? WHERE id=?", (json.dumps(message), message["id"]))
        gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in1", "sender": "@maya:example.test",
                                      "origin_server_ts": 1, "content": {"msgtype": "m.text", "body": "Coffee at ten?"}})
        incoming = gateway.find("maya", "matrix", "event_id", "$in1")
        check(incoming is not None, "Matrix message did not keep its event ID")

        def enqueue(relation, body, text=""):
            with connect() as db:
                return gateway.enqueue(db, {"address": "maya", "protocol": "matrix", "body": body, "text": text,
                                            "request": secrets.token_hex(8), "relation": relation})["message"]

        reaction = enqueue({"kind": "reaction", "target": incoming["id"], "emoji": "👍"}, "Liked “Coffee at ten?”")
        check(reaction.get("reaction_target") == incoming["id"], "Reaction lost its target")
        deliver(reaction, gateway.send_matrix)
        check(sent[-1][0].startswith("rooms/") and "/send/m.reaction/" in sent[-1][0]
              and sent[-1][1]["m.relates_to"] == {"rel_type": "m.annotation", "event_id": "$in1", "key": "👍"},
              "Matrix reaction was not sent as an annotation")
        reply = enqueue({"kind": "reply", "target": incoming["id"]}, "Reply to “Coffee at ten?”\n\nSure", "Sure")
        deliver(reply, gateway.send_matrix)
        check(sent[-1][1] == {"msgtype": "m.text", "body": "Sure", "m.relates_to": {"m.in_reply_to": {"event_id": "$in1"}}},
              "Matrix reply was not linked natively")
        try:
            enqueue({"kind": "reaction", "target": incoming["id"], "emoji": "hello"}, "Reacted hello")
            raise RuntimeError("Gateway accepted a text reaction")
        except ValueError:
            pass

        gateway.accept_matrix(route, {"type": "m.reaction", "event_id": "$in2", "sender": "@maya:example.test",
                                      "origin_server_ts": 2, "content": {"m.relates_to": {
                                          "rel_type": "m.annotation", "event_id": "$out2", "key": "❤️"}}})
        folded = gateway.find("maya", "matrix", "event_id", "$in2")
        check(folded and folded["reaction_target"] == reply["id"] and folded["body"].startswith("Loved “"),
              "Incoming Matrix reaction did not fold onto the sent reply")
        gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in3", "sender": "@maya:example.test",
                                      "origin_server_ts": 3, "content": {"msgtype": "m.text",
                                      "body": "> <@me:example.test> Sure\n\nGreat",
                                      "m.relates_to": {"m.in_reply_to": {"event_id": "$out2"}}}})
        quoted = gateway.find("maya", "matrix", "event_id", "$in3")
        check(quoted["body"].endswith("\n\nGreat") and quoted["body"].startswith("Reply to “")
              and quoted["reply_target"] == reply["id"], "Incoming Matrix reply kept its legacy fallback")

        mail_route = gateway.route("maya", "email")
        gateway.accept_mail(mail_route, "1", 1, b"From: Maya <maya@example.test>\r\nMessage-ID: <m1@example.test>\r\n"
                            b"Subject: Plans\r\nDate: Mon, 1 Jan 2024 10:00:00 +0000\r\n\r\nSee you there\r\n")
        first = gateway.find("maya", "email", "mail_id", "<m1@example.test>")
        outgoing = []

        class FakeSmtp:
            def __init__(self, *args, **kwargs): pass
            def __enter__(self): return self
            def __exit__(self, *args): return False
            def login(self, *args): pass
            def send_message(self, envelope, **kwargs): outgoing.append(envelope)

        protocol_gateway.smtplib.SMTP_SSL = FakeSmtp
        with connect() as db:
            mail = gateway.enqueue(db, {"address": "maya", "protocol": "email", "body": "Liked “See you there”",
                                        "request": secrets.token_hex(8),
                                        "relation": {"kind": "reaction", "target": first["id"], "emoji": "👍"}})["message"]
        deliver(mail, gateway.send_mail)
        envelope = outgoing[-1]
        check(envelope["In-Reply-To"] == "<m1@example.test>" and envelope.get_content_disposition() == "reaction"
              and envelope.get_content().strip() == "👍" and "FluidMessages" not in envelope.get_content(),
              "Email reaction does not follow RFC 9078")
        gateway.accept_mail(mail_route, "1", 2, b"From: maya@example.test\r\nMessage-ID: <m2@example.test>\r\n"
                            b"In-Reply-To: <m1@example.test>\r\nContent-Type: text/plain; charset=utf-8\r\n"
                            b"Content-Disposition: reaction\r\n\r\n" + "😆".encode() + b"\r\n")
        laughed = gateway.find("maya", "email", "mail_id", "<m2@example.test>")
        check(laughed and laughed["reaction_target"] == first["id"] and laughed["body"].startswith("Laughed at “"),
              "Incoming email reaction did not fold")
        # Attachments: upload, attach, send as Matrix media and an email attachment, and receive both.
        import io
        pdf = b"%PDF-1.4 fixture"
        with connect() as db:
            upload = gateway.store_upload(db, io.BytesIO(pdf), len(pdf), "application/pdf", "plan.pdf")["upload"]
            try:
                gateway.store_upload(db, io.BytesIO(b"x"), protocol_gateway.MAX_FILE + 1, "text/plain", "big.txt")
                raise RuntimeError("Gateway accepted an oversized upload")
            except ValueError:
                pass
            filed = gateway.enqueue(db, {"address": "maya", "protocol": "matrix", "body": "plan.pdf", "text": "",
                                         "request": secrets.token_hex(8),
                                         "attachment": {"upload": upload, "kind": "file"}})["message"]
        check(filed["attachment"]["name"] == "plan.pdf" and gateway.file_path(filed["id"]).read_bytes() == pdf,
              "Uploaded attachment was not moved onto its message")
        uploads = []

        def fake_raw(url, data=None, headers=None, method=None, limit=0):
            uploads.append((url, data, headers))
            return json.dumps({"content_uri": "mxc://example.test/abc"}).encode()

        gateway.matrix_raw = fake_raw
        deliver(filed, gateway.send_matrix)
        check(uploads[-1][1] == pdf and sent[-1][1]["msgtype"] == "m.file" and sent[-1][1]["url"] == "mxc://example.test/abc"
              and sent[-1][1]["filename"] == "plan.pdf", "Matrix file was not sent through the media repository")
        with connect() as db:
            voice_upload = gateway.store_upload(db, io.BytesIO(b"aac"), 3, "audio/mp4", "Voice message")["upload"]
            voice = gateway.enqueue(db, {"address": "maya", "protocol": "matrix", "body": "Voice message", "text": "",
                                         "request": secrets.token_hex(8),
                                         "attachment": {"upload": voice_upload, "kind": "voice", "duration": 4200}})["message"]
        deliver(voice, gateway.send_matrix)
        check(sent[-1][1]["msgtype"] == "m.audio" and "org.matrix.msc3245.voice" in sent[-1][1]
              and sent[-1][1]["info"]["duration"] == 4200, "Voice message was not marked as a Matrix voice note")
        gateway.matrix_download = lambda mxc: b"\x89PNG fixture"
        gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in4", "sender": "@maya:example.test",
                                      "origin_server_ts": 4, "content": {"msgtype": "m.image", "body": "lake.png",
                                      "url": "mxc://example.test/lake", "info": {"mimetype": "image/png", "size": 12}}})
        photo = gateway.find("maya", "matrix", "event_id", "$in4")
        check(photo and photo["attachment"]["kind"] == "photo" and gateway.file_path(photo["id"]).read_bytes() == b"\x89PNG fixture",
              "Incoming Matrix image was not stored")
        with connect() as db:
            mail_upload = gateway.store_upload(db, io.BytesIO(pdf), len(pdf), "application/pdf", "plan.pdf")["upload"]
            mailed = gateway.enqueue(db, {"address": "maya", "protocol": "email", "body": "Here it is", "text": "Here it is",
                                          "request": secrets.token_hex(8), "attachment": {"upload": mail_upload}})["message"]
        deliver(mailed, gateway.send_mail)
        parts = list(outgoing[-1].iter_attachments())
        check(len(parts) == 1 and parts[0].get_filename() == "plan.pdf" and parts[0].get_content() == pdf
              and "Sent with FluidMessages" in outgoing[-1].get_body(("plain",)).get_content(), "Email attachment was not sent")
        raw = (b"From: maya@example.test\r\nMessage-ID: <m3@example.test>\r\nMIME-Version: 1.0\r\n"
               b"Content-Type: multipart/mixed; boundary=b\r\n\r\n--b\r\nContent-Type: text/plain\r\n\r\nMenu attached\r\n"
               b"--b\r\nContent-Type: application/pdf\r\nContent-Disposition: attachment; filename=menu.pdf\r\n"
               b"Content-Transfer-Encoding: base64\r\n\r\nJVBERi0xLjQ=\r\n--b--\r\n")
        gateway.accept_mail(mail_route, "1", 3, raw)
        menu = gateway.find("maya", "email", "mail_id", "<m3@example.test>")
        check(menu and menu["attachment"]["name"] == "menu.pdf" and menu["body"] == "Menu attached"
              and gateway.file_path(menu["id"]).read_bytes() == b"%PDF-1.4", "Incoming email attachment was not stored")
        import matrix_e2ee
        if matrix_e2ee.available():
            # An encrypted image: the companion downloads the ciphertext and decrypts it with the event's key.
            from nio.crypto.attachments import encrypt_attachment
            ciphertext, keys = encrypt_attachment(b"\x89PNG secret fixture")
            gateway.matrix_download = lambda mxc: ciphertext
            gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in5", "sender": "@maya:example.test",
                                          "origin_server_ts": 5, "content": {"msgtype": "m.image", "body": "lake.png",
                                          "file": {**keys, "url": "mxc://example.test/secret"}, "info": {"mimetype": "image/png"}}})
            secret = gateway.find("maya", "matrix", "event_id", "$in5")
            check(secret and gateway.file_path(secret["id"]).read_bytes() == b"\x89PNG secret fixture",
                  "Encrypted Matrix attachment was not decrypted")
            print("PASS  encrypted Matrix attachments decrypt on the companion")
        else:
            print("SKIP  Matrix encryption checks (matrix-nio[e2e] is not installed)")
    print("PASS  companion replies, reactions, and attachments use native Matrix and email features")


def reaction_revisions_test():
    """Removing or changing a reaction is native on Matrix and XMPP, with fictional fixtures."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import protocol_gateway

    with tempfile.TemporaryDirectory(prefix="fluid-revisions-") as directory:
        database = str(Path(directory) / "gateway.sqlite")

        def connect():
            return sqlite3.connect(database)

        with connect() as db:
            db.executescript(protocol_gateway.SCHEMA)
        config = {"matrix": {"homeserver": "https://matrix.example.test", "access_token": "fixture",
                             "user_id": "@me:example.test"},
                  "routes": [{"address": "maya", "protocol": "matrix", "target": "!room:example.test", "title": "Maya"},
                             {"address": "leo", "protocol": "xmpp", "target": "leo@example.test", "title": "Leo"}]}
        gateway = protocol_gateway.Gateway(connect, config, Path(directory) / "files")
        sent, stanzas = [], []

        def fake_matrix(path, body=None, allow_missing=False, method=None):
            if allow_missing:
                return None
            sent.append((path, body))
            return {"event_id": "$out" + str(len(sent))}

        class FakeXmpp:
            def send(self, to, text, group=False, reply=None, reply_author=None, react=None, file=None):
                stanzas.append({"to": to, "text": text, "reply": reply, "react": react})
                return "xout" + str(len(stanzas))

        gateway.matrix_request = fake_matrix
        gateway.client = lambda protocol: FakeXmpp()

        def send(address, protocol, relation, body):
            with connect() as db:
                message = gateway.enqueue(db, {"address": address, "protocol": protocol, "body": body, "text": "",
                                               "request": secrets.token_hex(8), "relation": relation})["message"]
            route = gateway.route(address, protocol)
            message.update({"matrix": gateway.send_matrix, "xmpp": gateway.send_xmpp}[protocol](route, message) or {})
            message["status"] = "Sent"
            with connect() as db:
                db.execute("UPDATE protocol_messages SET payload=? WHERE id=?", (json.dumps(message), message["id"]))
            return message

        route = gateway.route("maya", "matrix")
        gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in1", "sender": "@maya:example.test",
                                      "origin_server_ts": 1, "content": {"msgtype": "m.text", "body": "Coffee at ten?"}})
        coffee = gateway.find("maya", "matrix", "event_id", "$in1")
        send("maya", "matrix", {"kind": "reaction", "target": coffee["id"], "emoji": "👍"}, "Liked “Coffee at ten?”")
        first = sent[-1]
        send("maya", "matrix", {"kind": "reaction", "target": coffee["id"], "emoji": "❤️", "previous": "👍"},
             "Changed reaction from 👍 to ❤️ on “Coffee at ten?”")
        check(sent[-2][0].startswith("rooms/") and "/redact/%24out1/" in sent[-2][0] and sent[-2][1] == {}
              and sent[-1][1]["m.relates_to"]["key"] == "❤️" and first[1]["m.relates_to"]["key"] == "👍",
              "Changing a Matrix reaction did not redact the old one and send the new one")
        changed_event = "$out" + str(len(sent))
        count = len(sent)
        removal = send("maya", "matrix", {"kind": "reaction", "target": coffee["id"], "emoji": "❤️", "removed": True},
                       "Removed a heart from “Coffee at ten?”")
        check(len(sent) == count + 1 and "/redact/" + changed_event.replace("$", "%24") + "/" in sent[-1][0]
              and removal.get("reaction_target") == coffee["id"], "Removing a Matrix reaction did not redact it")
        try:
            with connect() as db:
                gateway.enqueue(db, {"address": "maya", "protocol": "matrix", "body": "x", "request": secrets.token_hex(8),
                                     "relation": {"kind": "reaction", "target": coffee["id"], "emoji": "👍",
                                                  "previous": "hello"}})
            raise RuntimeError("Gateway accepted a text previous reaction")
        except ValueError:
            pass
        gateway.accept_matrix(route, {"type": "m.reaction", "event_id": "$in2", "sender": "@maya:example.test",
                                      "origin_server_ts": 2, "content": {"m.relates_to": {
                                          "rel_type": "m.annotation", "event_id": "$in1", "key": "😆"}}})
        gateway.accept_matrix(route, {"type": "m.room.redaction", "event_id": "$in3", "sender": "@maya:example.test",
                                      "origin_server_ts": 3, "redacts": "$in2", "content": {}})
        taken = gateway.find("maya", "matrix", "event_id", "$in3")
        check(taken and taken["body"] == "Removed a laugh from “Coffee at ten?”" and taken["reaction_target"] == coffee["id"],
              "A redacted Matrix reaction was not recorded as a removal")

        gateway.accept_xmpp("leo@example.test", "leo@example.test", "Lunch?", "x1", 1, False, {})
        lunch = gateway.find("leo", "xmpp", "xmpp_id", "x1")
        gateway.accept_xmpp("leo@example.test", "leo@example.test", "", "x2", 2, False, {"reaction": "👍", "reaction_to": "x1"})
        gateway.accept_xmpp("leo@example.test", "leo@example.test", "", "x3", 3, False, {"reaction": "", "reaction_to": "x1"})
        taken = gateway.find("leo", "xmpp", "xmpp_id", "x3")
        check(taken and taken["body"] == "Removed a like from “Lunch?”" and taken["reaction_target"] == lunch["id"],
              "An empty XMPP reaction set was not recorded as a removal")
        send("leo", "xmpp", {"kind": "reaction", "target": lunch["id"], "emoji": "❤️", "previous": "👍"},
             "Changed reaction from 👍 to ❤️ on “Lunch?”")
        check(stanzas[-1]["react"] == ["❤️"] and stanzas[-1]["reply"] == "x1", "Changing an XMPP reaction did not send the new set")
        send("leo", "xmpp", {"kind": "reaction", "target": lunch["id"], "emoji": "❤️", "removed": True},
             "Removed a heart from “Lunch?”")
        check(stanzas[-1]["react"] == [], "Removing an XMPP reaction did not send an empty set")
    print("PASS  removing and changing reactions is native on Matrix and XMPP and recorded from others")


def email_quotes_test():
    """Incoming email replies lose the quoted history, with fictional fixtures."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import protocol_gateway

    with tempfile.TemporaryDirectory(prefix="fluid-mail-") as directory:
        database = str(Path(directory) / "gateway.sqlite")

        def connect():
            return sqlite3.connect(database)

        with connect() as db:
            db.executescript(protocol_gateway.SCHEMA)
        config = {"email": {"address": "me@example.test", "smtp_host": "smtp.example.test", "smtp_password": "x",
                            "imap_host": "imap.example.test", "imap_password": "x"},
                  "routes": [{"address": "maya", "protocol": "email", "target": "maya@example.test", "title": "Maya"}]}
        gateway = protocol_gateway.Gateway(connect, config, Path(directory) / "files")
        route = gateway.route("maya", "email")

        def mail(uid, message_id, body, reply_to=""):
            headers = (f"From: Maya <maya@example.test>\r\nMessage-ID: {message_id}\r\nSubject: Plans\r\n"
                       f"Date: Mon, 1 Jan 2024 10:0{uid}:00 +0000\r\n")
            if reply_to:
                headers += f"In-Reply-To: {reply_to}\r\n"
            gateway.accept_mail(route, "1", uid, (headers + "\r\n" + body).encode())
            return gateway.find("maya", "email", "mail_id", message_id)

        first = mail(1, "<m1@example.test>", "Lunch on Friday?")
        check(first["read"] == 0, "A new email arrived already read")
        with connect() as db, db:
            check(gateway.mark_read(db, {"ids": [first["id"]]}) == {"read": 1}, "Reading an email did not mark it read")
        check(gateway.find("maya", "email", "id", first["id"])["read"] == 1, "The read email still shows as unread")
        try:
            with connect() as db:
                gateway.mark_read(db, {"ids": "everything"})
            raise RuntimeError("Gateway accepted an invalid read request")
        except ValueError:
            pass
        second = mail(2, "<m2@example.test>", "hello there\r\n\r\nOn Sun, Nov 22, 2026 at 11:47 PM\r\n"
                      "<me@example.test> wrote:\r\n\r\n> hello\r\n>\r\n> Sent with FluidMessages\r\n>\r\n",
                      "<m1@example.test>")
        check(second["body"] == "hello there" and "reply_target" not in second,
              "An email reply to the latest message kept its quoted history")
        third = mail(3, "<m3@example.test>", "Yes, Friday works\r\n\r\nOn Mon, Maya <maya@example.test> wrote:\r\n> Lunch on Friday?\r\n",
                     "<m1@example.test>")
        check(third["body"] == "Reply to “Lunch on Friday?”\n\nYes, Friday works" and third["reply_target"] == first["id"],
              "An email reply to an older message did not become a reply card")
        with connect() as db, db:
            old = dict(first, id="mail-old", body="Old reply\n\nOn Sun, Maya wrote:\n> earlier", mail_id="<old@example.test>")
            db.execute("INSERT INTO protocol_messages VALUES (?, ?, ?)", ("mail-old", 0, json.dumps(old)))
        gateway.strip_stored_quotes()
        check(gateway.find("maya", "email", "id", "mail-old")["body"] == "Old reply", "Stored emails kept their quoted history")
    print("PASS  incoming email replies drop the quoted history, and reading a message clears it everywhere")


def privacy_calls_test():
    """Hidden chats, disappearing messages, group members, and call relay on the companion, with fictional fixtures."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import protocol_gateway

    with tempfile.TemporaryDirectory(prefix="fluid-privacy-") as directory:
        database = str(Path(directory) / "gateway.sqlite")

        def connect():
            return sqlite3.connect(database)

        with connect() as db:
            db.executescript(protocol_gateway.SCHEMA)
        config = {"matrix": {"homeserver": "https://matrix.example.test", "user_id": "@me:example.test", "access_token": "x"},
                  "routes": [{"address": "maya", "protocol": "matrix", "target": "!maya:example.test", "title": "Maya"},
                             {"address": "club", "protocol": "matrix", "target": "!club:example.test", "title": "Club",
                              "group": True},
                             {"address": "jordan", "protocol": "email", "target": "jordan@example.test", "title": "Jordan"}]}
        gateway = protocol_gateway.Gateway(connect, config, Path(directory) / "files")
        sent = []
        gateway.matrix_request = lambda path, body=None, allow_missing=False, method=None: (
            sent.append((path, body, method)) or {"event_id": "$sent" + str(len(sent))})
        now = gateway.time()
        maya, jordan = gateway.route("maya", "matrix"), gateway.route("jordan", "email")
        gateway.add_incoming(gateway.message(maya, "m-old", "Old news", False, now - 7200_000))
        gateway.add_incoming(gateway.message(maya, "m-new", "Fresh", False, now))
        mine = gateway.message(maya, "m-mine", "Mine", True, now - 7200_000, "Sent")
        mine["event_id"] = "$mine"
        gateway.add_incoming(mine)
        gateway.add_incoming(gateway.message(jordan, "j-1", "Quarterly plans", False, now))
        gateway.add_incoming(gateway.message(maya, "m-before", "From before the timer", False, now - 5 * 3600_000))

        with connect() as db, db:
            gateway.save_settings(db, {"hidden_protocols": ["EMAIL"], "disappearing": {"default": 0, "chats": {"maya": 3600},
                                                                         "since": {"maya": now - 3 * 3600_000}}},
                                  from_phone=True)
            shown = {message["id"] for message in gateway.snapshot(db)["messages"]}
        check("j-1" not in shown, "A protocol hidden on the phone still showed on the companion")
        check("m-old" not in shown and "m-new" in shown, "An expired message still showed, or a fresh one was hidden")
        check(gateway.sweep_expired() == 2, "Expired messages were not deleted")
        check(any(path.startswith("rooms/%21maya%3Aexample.test/redact/%24mine/") for path, _, _ in sent),
              "Your own expired Matrix message was not redacted")
        check(gateway.find("maya", "matrix", "id", "m-new") is not None, "A message within its timer was deleted")
        check(gateway.find("maya", "matrix", "id", "m-before") is not None, "Turning on a timer deleted earlier messages")
        with connect() as db, db:
            gateway.save_settings(db, {"disappearing": {"default": 0, "chats": {"jordan": 60}}})
        check(gateway.sweep_expired() == 0, "A timer set in the browser deleted earlier messages")

        with connect() as db, db:
            gateway.save_settings(db, {"follow_phone": False, "disappearing": {"default": 60, "chats": {}}})
            gateway.save_settings(db, {"disappearing": {"default": 0, "chats": {}}, "hidden_protocols": []}, from_phone=True)
            settings = gateway.settings(db)
        check(settings["disappearing"]["default"] == 60 and settings["hidden_protocols"] == [],
              "Companion settings did not stay its own when not following the phone")
        with connect() as db, db:
            gateway.save_settings(db, {"fluid_encryption": {"protocols": ["sms"], "chats": {"maya": "on"}}}, from_phone=True)
            reset = gateway.save_settings(db, {"reset": True})
        check(reset["disappearing"]["default"] == 0 and reset["follow_phone"] and reset["fluid_encryption"]["chats"] == {"maya": "on"},
              "Resetting companion settings lost the phone's encryption info or kept old timers")
        try:
            with connect() as db:
                gateway.save_settings(db, {"disappearing": {"default": -5, "chats": {}}})
            raise RuntimeError("Companion accepted a negative timer")
        except ValueError:
            pass

        with connect() as db:
            gateway.change_member(db, {"address": "club", "protocol": "matrix", "action": "add", "member": "@sam:example.test"})
            gateway.change_member(db, {"address": "club", "protocol": "matrix", "action": "remove", "member": "@sam:example.test"})
        check(sent[-2][0].endswith("/invite") and sent[-1][0].endswith("/kick") and sent[-1][1]["user_id"] == "@sam:example.test",
              "Inviting or removing a Matrix member did not reach the room")
        for bad in ({"address": "club", "protocol": "matrix", "action": "add", "member": "sam"},
                    {"address": "jordan", "protocol": "email", "action": "add", "member": "x@example.test"},
                    {"address": "club", "protocol": "matrix", "action": "ban", "member": "@sam:example.test"}):
            try:
                with connect() as db:
                    gateway.change_member(db, bad)
                raise RuntimeError("Companion accepted an invalid member change")
            except ValueError:
                pass

        invite = {"type": "m.call.invite", "event_id": "$call", "sender": "@maya:example.test", "origin_server_ts": gateway.time(),
                  "content": {"call_id": "c1", "party_id": "p1", "version": "1", "lifetime": 60000,
                              "offer": {"type": "offer", "sdp": "v=0\r\nm=audio 9 UDP/TLS/RTP/SAVPF 111\r\n"}}}
        gateway.accept_matrix(maya, invite)
        events = gateway.call_events(0)
        check(events["events"][0]["type"] == "m.call.invite" and events["events"][0]["live"], "An incoming call did not ring")
        check(gateway.call_events(events["next"])["events"] == [], "Call events repeated after they were read")
        check(gateway.find("maya", "matrix", "event_id", "$call") is None
              and any(m.get("event") and m["body"].startswith("Voice call") for m in gateway.snapshot(connect())["messages"]),
              "The call was not noted in the conversation")
        gateway.send_call({"address": "maya", "protocol": "matrix", "type": "m.call.answer",
                           "content": {"call_id": "c1", "party_id": "p2", "version": "1", "answer": {"type": "answer", "sdp": "v=0"}}})
        check("/send/m.call.answer/" in sent[-1][0], "Answering a call did not send the Matrix answer event")
        try:
            gateway.send_call({"address": "jordan", "protocol": "email", "type": "m.call.invite", "content": {}})
            raise RuntimeError("Companion relayed a call outside Matrix")
        except ValueError:
            pass
    print("PASS  hidden protocols, disappearing timers, group members, and call signaling on the companion")


def protocol_accounts_test():
    """Account storage, Compose accounts, links, and the IRC client, with fictional fixtures and no network."""
    sys.path.insert(0, str(ROOT / "server"))
    import socket
    import threading
    import accounts
    import irc_client

    with tempfile.TemporaryDirectory(prefix="fluid-accounts-") as directory:
        store = accounts.AccountStore(Path(directory) / "accounts.json", environ={
            "FLUID_IRC_SERVER": "irc.example.test", "FLUID_IRC_NICK": "fluidtest", "FLUID_IRC_CHANNELS": "#radio-club,#garden",
            "FLUID_XMPP_JID": "broken"})
        saved = store.save("email", {"address": "me@example.test", "imap_host": "imap.example.test",
                                     "smtp_host": "smtp.example.test", "imap_password": "fixture-secret"})
        check(saved["smtp_password"] == "fixture-secret", "SMTP password should default to the IMAP password")
        store.save("email", {"address": "me@example.test", "imap_host": "imap.example.test", "smtp_host": "smtp.example.test"})
        check(store.current()["email"]["imap_password"] == "fixture-secret", "A blank password should keep the saved one")
        listed = json.dumps(store.redacted())
        check("fixture-secret" not in listed and '"set": true' in listed, "Account secrets must never be listed")
        check(oct(Path(directory, "accounts.json").stat().st_mode & 0o777) == "0o600", "Account file must be private")
        irc = store.current()["irc"]
        check(irc["port"] == 6697 and irc["channels"] == ["#radio-club", "#garden"], "Compose IRC account was not read")
        check(any(item.get("error", "").startswith("Docker Compose") for item in store.redacted()),
              "An invalid Compose account should be reported")
        for bad in ({"server": "irc.example.test", "nick": "x", "port": 6667},
                    {"server": "irc.example.test", "nick": "x", "channels": ["radio"]}):
            try:
                accounts.validate("irc", bad)
                raise RuntimeError("Accepted an unsafe IRC account")
            except ValueError:
                pass
        try:
            store.save("irc", {"server": "x.test", "nick": "y"})
            raise RuntimeError("Phone changed a Compose account")
        except ValueError:
            pass

    # IRC: CAP negotiation, SASL, joins, member list, a tagged message, and a reply, over a local socket pair.
    server, phone = socket.socketpair()
    server.settimeout(5)
    received, states = [], {}
    client = irc_client.IrcClient({"server": "irc.example.test", "nick": "fluidtest", "sasl_password": "pw",
                                   "channels": ["#radio-club"]},
                                  lambda *args: received.append(args), lambda name, state: states.__setitem__(name, state),
                                  connect=lambda: phone)
    def session():
        # The test closes the fake server at the end, which ends the session; that's expected, not an error.
        try:
            client.session()
        except (ConnectionError, OSError):
            pass

    worker = threading.Thread(target=session, daemon=True)
    worker.start()
    lines = b""

    def expect(fragment):
        nonlocal lines
        deadline = time.time() + 5
        while fragment not in lines:
            check(time.time() < deadline, f"IRC client never sent {fragment!r}")
            lines += server.recv(4096)

    def say(text):
        server.sendall(text.encode() + b"\r\n")

    expect(b"CAP LS 302")
    say(":irc.example.test CAP * LS * :sasl message-tags")
    say(":irc.example.test CAP * LS :server-time echo-message")
    expect(b"CAP REQ :sasl message-tags server-time echo-message")
    say(":irc.example.test CAP * ACK :sasl message-tags server-time echo-message")
    expect(b"AUTHENTICATE PLAIN")
    say("AUTHENTICATE +")
    expect(b"AUTHENTICATE ")
    say(":irc.example.test 903 fluidtest :SASL authentication successful")
    expect(b"CAP END")
    say(":irc.example.test 001 fluidtest :Welcome")
    expect(b"JOIN #radio-club")
    say(":irc.example.test 332 fluidtest #radio-club :Antenna night")
    say(":irc.example.test 353 fluidtest = #radio-club :@mosaic +kestrel fluidtest")
    say(":irc.example.test 366 fluidtest #radio-club :End of NAMES")
    say("@msgid=abc;time=2026-01-01T10:00:00.000Z :mosaic!m@host PRIVMSG #radio-club :Bring the analyzer")
    say(":kestrel!k@host PRIVMSG #radio-club :\x01ACTION waves\x01")
    say("PING :keepalive")
    expect(b"PONG :keepalive")
    deadline = time.time() + 5
    while len(received) < 2 and time.time() < deadline:
        time.sleep(0.05)
    check(states.get("#radio-club") == {"topic": "Antenna night", "members": ["fluidtest", "kestrel", "mosaic"]},
          "IRC channel topic and members were not tracked")
    check(received[0][:4] == ("#radio-club", "mosaic", "Bring the analyzer", {"msgid": "abc", "time": "2026-01-01T10:00:00.000Z"})
          and received[0][4] == 1767261600000, "Tagged IRC message was not parsed")
    check(received[1][2] == "/me waves", "CTCP ACTION was not shown as /me")
    client.send("#radio-club", "", reply="abc", react="👍")
    expect("@+draft/reply=abc;+draft/react=👍 TAGMSG #radio-club".encode())
    client.send("#radio-club", "x" * 900)
    expect(b"PRIVMSG #radio-club :" + b"x" * 400 + b"\r\nPRIVMSG")
    client.stopped.set()
    server.close()
    print("PASS  protocol accounts stay private, Compose accounts are read-only, and IRC speaks CAP, SASL, and IRCv3 tags")


def find_apk(explicit):
    if explicit:
        return explicit.resolve()
    if GRADLE_APK.is_file():
        return GRADLE_APK
    builds = sorted((ROOT / "dist").glob("FluidMessages-*-debug.apk"), key=lambda path: path.stat().st_mtime)
    return builds[-1] if builds else None


def check_apk(apk):
    with zipfile.ZipFile(apk) as archive:
        check({"AndroidManifest.xml", "classes.dex"} <= set(archive.namelist()), "APK is missing its manifest or DEX")
        check(archive.testzip() is None, "APK failed its ZIP integrity check")
    print(f"PASS  APK archive integrity and structure ({apk.name})")


def android(args):
    if args.build:
        wrapper = ROOT / "gradlew"
        gradle = str(wrapper) if wrapper.is_file() else shutil.which("gradle")
        check(gradle, "Gradle is missing. See CONTRIBUTING.md for Android build prerequisites.")
        subprocess.run([gradle, "assembleDebug"], cwd=ROOT, check=True)
    apk = find_apk(args.apk)
    if apk:
        check_apk(apk)
    elif args.install:
        raise RuntimeError("No debug APK is available. Build one with --build or provide --apk.")
    else:
        print("SKIP  APK check (no debug APK found)")
    if args.install:
        adb = shutil.which("adb")
        check(adb, "adb is missing")
        command = [adb, "-s", args.serial] if args.serial else [adb]
        subprocess.run([*command, "install", "-r", str(apk)], check=True)
        subprocess.run([*command, "shell", "am", "start", "-W", "-n", PACKAGE + "/.MainActivity"], check=True)
        print("PASS  APK installed and launcher activity started")


def demo(no_browser):
    token = secrets.token_hex(24)
    with companion(free_port(), token) as (origin, request, process):
        request("/api/sync", {"messages": sample_messages()})
        print(f"Open {origin}\nPairing token: {token}", flush=True)
        print("Sample data only. Press Ctrl+C to close the demo and clear its data.", flush=True)
        if not no_browser:
            webbrowser.open(origin)
        result = process.wait()
        check(result == 0, f"Companion exited with status {result}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--demo", action="store_true", help="open a temporary browser demo after smoke checks")
    parser.add_argument("--no-browser", action="store_true", help="print the demo URL without opening a browser")
    parser.add_argument("--build", action="store_true", help="compile a fresh debug APK with Gradle")
    parser.add_argument("--apk", type=Path, help="use a specific existing APK")
    parser.add_argument("--install", action="store_true", help="install and launch the APK on an ADB target")
    parser.add_argument("--serial", help="ADB device or emulator serial")
    args = parser.parse_args()
    try:
        smoke_test()
        cloud_smoke_test()
        gateway_relations_test()
        reaction_revisions_test()
        email_quotes_test()
        privacy_calls_test()
        protocol_accounts_test()
        android(args)
        if args.demo:
            demo(args.no_browser)
    except KeyboardInterrupt:
        return 130
    except (OSError, RuntimeError, ValueError, subprocess.CalledProcessError, zipfile.BadZipFile) as error:
        print(f"FAIL  {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
