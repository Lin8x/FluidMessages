#!/usr/bin/env python3
"""Exercise FluidMessages locally without touching a real inbox."""
import argparse
from concurrent.futures import ThreadPoolExecutor
from contextlib import contextmanager
import json
import os
import re
from pathlib import Path
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from urllib.error import HTTPError, URLError
from urllib.request import ProxyHandler, Request, build_opener
import webbrowser
import zipfile

ROOT = Path(__file__).resolve().parents[1]
PACKAGE = "org.fluidmessages"
GRADLE_APK = ROOT / "app/build/outputs/apk/debug/app-debug.apk"
CLOUD_TARGETS = ("onedrive", "drive", "s3")


def check(condition, message):
    if not condition:
        raise RuntimeError(message)


@contextmanager
def companion(port, token, cloud_fixtures=False):
    with tempfile.TemporaryDirectory(prefix="fluid-test-") as directory:
        env = dict(os.environ, FLUID_DB=str(Path(directory) / "demo.sqlite"),
                   FLUID_TOKEN=token, FLUID_BIND="127.0.0.1", FLUID_PORT=str(port),
                   RCLONE_CONFIG=str(Path(directory) / "rclone.conf"))
        for key in CLOUD_TARGETS:
            folder = Path(directory) / key
            if cloud_fixtures:
                folder.mkdir()
            env["FLUID_BACKUP_" + key.upper()] = str(folder) if cloud_fixtures else ""
        process = subprocess.Popen(
            [sys.executable, str(ROOT / "server/main.py")],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        origin = f"http://127.0.0.1:{port}"
        opener = build_opener(ProxyHandler({}))

        def request(path, body=None, authorized=True, method=None, extra_headers=None):
            headers = {"Authorization": "Bearer " + token} if authorized else {}
            headers.update(extra_headers or {})
            data = body if isinstance(body, bytes) else json.dumps(body).encode() if body is not None else None
            with opener.open(Request(origin + path, data=data, headers=headers, method=method), timeout=5) as response:
                content = response.read()
                return json.loads(content) if response.headers.get_content_type() == "application/json" else content

        try:
            for _ in range(50):
                check(process.poll() is None, "Companion failed to start. The port may already be in use.")
                try:
                    request("/", authorized=False)
                    break
                except URLError:
                    time.sleep(0.05)
            else:
                raise RuntimeError("Timed out starting the companion")
            yield origin, request, process
        finally:
            process.terminate()
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


def free_port():
    try:
        with socket.socket() as listener:
            listener.bind(("127.0.0.1", 0))
            return listener.getsockname()[1]
    except PermissionError as error:
        raise RuntimeError("Loopback networking is blocked. Run this command from a regular terminal.") from error


def sample_messages():
    now = int(time.time() * 1000)
    return [
        {"address": "+12025550123", "body": "See you there!", "type": 2, "date": now - 60_000},
        {"address": "+12025550123", "body": "Coffee at ten?", "type": 1, "date": now - 90_000},
        {"address": "+12025550146", "body": "I sent the route for Saturday.", "type": 1, "date": now - 150_000},
    ]


def smoke_test():
    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        for path, expected in (("/", b"FluidMessages"), ("/app.js", b"schedule"), ("/style.css", b"--canvas")):
            check(expected in request(path, authorized=False), f"Missing browser asset at {path}")
        try:
            request("/api/inbox", authorized=False)
        except HTTPError as error:
            check(error.code == 401, f"Expected HTTP 401, got {error.code}")
        else:
            raise RuntimeError("Inbox accepted an unauthenticated request")
        messages = sample_messages()
        request("/api/sync", {"messages": messages})
        check(request("/api/inbox")["messages"] == messages, "Synced inbox differs from the phone snapshot")
        appearance = {"dark": True, "exactTimes": True, "radius": 19, "folders": {"archived": [messages[0]["address"]]},
                      "colors": {"sms": "#457abc", "surface": "#172e26", "raised": "#1b372d", "action": "#8bdabb",
                                 "ink": "#ffffff", "muted": "#bfccc7", "line": "#3a4d45", "outline": "#697b73"}}
        request("/api/sync", {"messages": messages, "appearance": {**appearance, "size": 900,
                "colors": {**appearance["colors"], "accent": "url(invalid)"}}})
        snapshot = request("/api/inbox")
        check(snapshot["messages"] == messages and snapshot["appearance"] == appearance,
              "Inbox and appearance snapshot were not saved together")
        request("/api/sync", {"messages": messages})
        check(request("/api/inbox")["appearance"] == {}, "Older Android sync should use the companion theme")
        now = int(time.time() * 1000)
        draft = {"address": messages[0]["address"], "body": "Test only", "due": now + 60_000}
        cancelled = request("/api/schedule", draft)["id"]
        request("/api/cancel", {"id": cancelled})
        due = request("/api/schedule", {**draft, "due": now})["id"]
        with ThreadPoolExecutor(max_workers=4) as pool:
            claims = list(pool.map(lambda _: request("/api/claim", {})["job"], range(4)))
        check([job["id"] for job in claims if job] == [due], "Due message was lost or claimed more than once")
        request("/api/result", {"id": due, "state": "submitted"})
        check({job["id"]: job["state"] for job in request("/api/jobs")} ==
              {cancelled: "cancelled", due: "submitted"}, "Queue state did not persist")
    print("PASS  Companion assets, authentication, sync, scheduling, cancellation and concurrent claiming")


def cloud_smoke_test():
    if not shutil.which("rclone"):
        print("SKIP  Cloud backup fixture test (rclone is not installed)")
        return
    with companion(free_port(), secrets.token_hex(32), cloud_fixtures=True) as (_, request, _):
        check(request("/api/backups")["targets"] == list(CLOUD_TARGETS), "Cloud target discovery failed")
        try:
            request("/api/backups/drive", b"not a backup", method="PUT")
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for an invalid backup, got {error.code}")
        else:
            raise RuntimeError("The server accepted an invalid archive")
        older = b"FMB1\x01older fixture"
        newest = b"FMB1\x01newest fixture"
        for target in CLOUD_TARGETS:
            path = "/api/backups/" + target
            dated = request(path, older, method="PUT")["name"]
            check(re.fullmatch(r"FluidMessages_\d{4}-\d{2}-\d{2}_.+\.fmb", dated), "Missing readable backup date")
            time.sleep(.005)
            request(path, newest, method="PUT")
            check(request(path + "/latest") == newest, f"The latest {target} backup did not round-trip")
            fixed = {"X-Fluid-Backup-Name": "My current backup.fmb"}
            request(path, newest, method="PUT", extra_headers=fixed)
            response = request(path, older, method="PUT", extra_headers=fixed)
            check(response["name"] == fixed["X-Fluid-Backup-Name"], "Fixed name was lost")
            check(request(path + "/latest") == older, "The fixed backup did not get replaced")
        try:
            request("/api/backups/drive", older, method="PUT", extra_headers={"X-Fluid-Backup-Name": "../outside.fmb"})
        except HTTPError as error:
            check(error.code == 400, "Invalid backup name produced the wrong response")
        else:
            raise RuntimeError("The server accepted a backup path instead of a filename")
    print("PASS  Cloud target discovery, dated names, fixed-name replacement, and newest restore across three isolated destinations")


def find_apk(explicit):
    if explicit:
        return explicit.resolve()
    if GRADLE_APK.is_file():
        return GRADLE_APK
    builds = sorted((ROOT / "dist").glob("FluidMessages-*-debug.apk"), key=lambda path: path.stat().st_mtime)
    return builds[-1] if builds else None


def check_apk(apk):
    with zipfile.ZipFile(apk) as archive:
        check({"AndroidManifest.xml", "classes.dex"} <= set(archive.namelist()), "APK is missing its manifest or DEX")
        check(archive.testzip() is None, "APK failed its ZIP integrity check")
    print(f"PASS  APK archive integrity and structure ({apk.name})")


def android(args):
    if args.build:
        wrapper = ROOT / "gradlew"
        gradle = str(wrapper) if wrapper.is_file() else shutil.which("gradle")
        check(gradle, "Gradle is missing. See CONTRIBUTING.md for Android build prerequisites.")
        subprocess.run([gradle, "assembleDebug"], cwd=ROOT, check=True)
    apk = find_apk(args.apk)
    if apk:
        check_apk(apk)
    elif args.install:
        raise RuntimeError("No debug APK is available. Build one with --build or provide --apk.")
    else:
        print("SKIP  APK check (no debug APK found)")
    if args.install:
        adb = shutil.which("adb")
        check(adb, "adb is missing")
        command = [adb, "-s", args.serial] if args.serial else [adb]
        subprocess.run([*command, "install", "-r", str(apk)], check=True)
        subprocess.run([*command, "shell", "am", "start", "-W", "-n", PACKAGE + "/.MainActivity"], check=True)
        print("PASS  APK installed and launcher activity started")


def demo(no_browser):
    token = secrets.token_hex(24)
    with companion(free_port(), token) as (origin, request, process):
        request("/api/sync", {"messages": sample_messages()})
        print(f"Open {origin}\nPairing token: {token}", flush=True)
        print("Sample data only. Press Ctrl+C to close the demo and clear its data.", flush=True)
        if not no_browser:
            webbrowser.open(origin)
        result = process.wait()
        check(result == 0, f"Companion exited with status {result}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--demo", action="store_true", help="open a temporary browser demo after smoke checks")
    parser.add_argument("--no-browser", action="store_true", help="print the demo URL without opening a browser")
    parser.add_argument("--build", action="store_true", help="compile a fresh debug APK with Gradle")
    parser.add_argument("--apk", type=Path, help="use a specific existing APK")
    parser.add_argument("--install", action="store_true", help="install and launch the APK on an ADB target")
    parser.add_argument("--serial", help="ADB device or emulator serial")
    args = parser.parse_args()
    try:
        smoke_test()
        cloud_smoke_test()
        android(args)
        if args.demo:
            demo(args.no_browser)
    except KeyboardInterrupt:
        return 130
    except (OSError, RuntimeError, ValueError, subprocess.CalledProcessError, zipfile.BadZipFile) as error:
        print(f"FAIL  {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
