          "The phone and the web list different meeting services")
    check(re.findall(r'@JvmField val [A-Z]+ = MeetingService\("\w+", "[^"]+", "[^"]*", (true|false)', kotlin) == ["true"] * 4
          and re.findall(r"\{id: '\w+', label: '[^']+', short: '[^']+', company: '[^']*', on: (true|false)", block) == ["true"] * 4,
          "Not every meeting service is on at first on the phone and the web")
    check("NAME_MAX = 32" in kotlin and "CUSTOM_MAX = 10" in kotlin, "The phone's limits for your own services changed")
    check("MEETING_NAME_MAX = 32, MEETING_CUSTOM_MAX = 10" in block and "MEETING_NAME_MAX, MEETING_CUSTOM_MAX = 32, 10" in main_py,
          "The web and the server limit your own meeting services differently")
    print("PASS  meeting links: Zoom first, all four on at first, older choices kept, your own services, saved links checked, the last one used, and call cards")


def irc_calls_and_nickserv_test():
    """IRC chats: call and meeting-link buttons off until turned on, and the NickServ card: its rules (the same on the
    phone and the web), IDENTIFY over the connection only, and saving the password without reconnecting. Fictional
    lines in Atheme, Anope, and OFTC wording; the password is a fixture."""
    sys.path.insert(0, str(ROOT / "server"))
    import contextlib
    import types
    import irc_client
    import protocol_gateway

    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        check(request("/api/settings")["prefs"]["ircCalls"] is False, "Call buttons in IRC chats aren't off by default")
        check(request("/api/settings", {"prefs": {"ircCalls": True}})["prefs"]["ircCalls"] is True, "The IRC calls switch wasn't saved")
        check(request("/api/settings")["prefs"]["callMeetings"] is True, "The IRC calls switch changed meeting links")
        try:
            request("/api/settings", {"prefs": {"ircCalls": "yes"}})
            raise RuntimeError("A non-boolean IRC calls switch was accepted")
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for a bad IRC calls switch, got {error.code}")
    commands_text = (ROOT / "server/chat-commands.js").read_text()
    check("showModal" not in commands_text and "<dialog" not in commands_text, "The NickServ card uses a pop-up")
    companion_js = (ROOT / "server/companion.js").read_text()
    check(companion_js.count("ircCallsHidden(") >= 3, "The web doesn't hide meeting-link buttons in IRC chats")
    settings_js = (ROOT / "server/settings.js").read_text()
    check("Not recommended. Many IRC channels ban call and meeting links" in settings_js, "The IRC calls switch has no warning")
    kotlin_calls = (ROOT / "app/src/main/kotlin/org/fluidmessages/IrcCalls.kt").read_text()
    check("Not recommended. Many IRC channels ban call and meeting links" in kotlin_calls, "The phone's IRC calls switch has no warning")

    # The NickServ rules in Node, with the same fixtures as NickServTest.kt.
    node = os.environ.get("NODE") or shutil.which("node")
    commands_js = (ROOT / "server/chat-commands.js").read_text()
    block = re.search(r"// nickserv:start[^\n]*\n(.*?)// nickserv:end", commands_js, re.S).group(1)
    kotlin = (ROOT / "app/src/main/kotlin/org/fluidmessages/NickServ.kt").read_text()
    for phrase in ("invalid password|password incorrect", "you are now (identified|recognized|logged in)", "nick(name)? is owned by someone else",
                   "change your nick", "This nickname is registered", "That password didn’t work", "NickServ answered below."):
        check(phrase in block and phrase in kotlin, "The phone and the web NickServ rules differ: " + phrase)
    if node:
        script = block + r"""
const wrong = [];
const same = (what, got, want) => { if (JSON.stringify(got) !== JSON.stringify(want)) wrong.push([what, got, want]); };
const B = '\x02';
const ns = (text) => ({author: 'NickServ', text, incoming: true, event: false});
const athemeAsk = 'This nickname is registered. Please choose a different nickname, or identify via ' + B + '/msg NickServ IDENTIFY kit <password>' + B;
const athemeTime = 'You have 30 seconds to identify to your nickname before it is changed.';
const athemeOk = 'You are now identified for ' + B + 'kit' + B + '.';
const athemeLast = 'Last login from: ~kit@example.test on Jan 01 12:00:00 2026.';
const warning = 'kit!~kit@example.test failed to login to kit. There has been 1 failed login attempt since your last successful login.';
const anopeAsk = 'This nickname is registered and protected. If it is your nick, type /msg NickServ IDENTIFY password. Otherwise, please choose a different nick.';
const anopeChange = 'If you do not change within 1 minute, I will change your nick.';
same('kinds', [athemeAsk, anopeAsk, athemeOk, 'Password accepted - you are now recognized.', 'You are successfully identified as kit.',
  'Invalid password for kit.', 'Password incorrect.', 'Identify failed as kit. You may have entered an incorrect password.', athemeTime, anopeChange,
  athemeLast, warning, 'Information on kit (account kit):', 'Registered : Jan 01 2026 (1y 2w ago)'].map(nickServKind),
  ['ask', 'ask', 'identified', 'identified', 'identified', 'failed', 'failed', 'failed', 'note', 'note', 'note', null, null, null]);
same('nicks', [nickServNick(athemeOk), nickServNick('Identify failed as kit.'), nickServNick('Password accepted - you are now recognized.')], ['kit', 'kit', '']);
const cards = nickServFold([ns(athemeAsk), ns(athemeTime), ns(athemeOk), ns(athemeLast), ns(warning),
  {author: '', text: '/msg NickServ INFO kit', incoming: false}, ns(anopeAsk), ns(anopeChange), ns('Password incorrect.')]);
same('cards', cards.map((card) => [card.first, card.last, card.state, card.nick, card.answered]), [[0, 3, 'identified', 'kit', true], [6, 8, 'failed', '', false]]);
same('said', cards[0].said[2], 'You are now identified for kit.');
same('titles', [nickServTitle(cards[0], 'x'), nickServTitle(cards[1], 'kit'), nickServTitle({state: 'ask'}, 'kit')],
  ['Identified as kit', 'That password didn’t work', 'This nickname is registered']);
same('not nickserv', nickServFold([{author: 'maya', text: athemeAsk, incoming: true}, {author: 'NickServ', text: athemeAsk, incoming: false}]), []);
same('own chat', nickServFold([{author: '', text: anopeAsk, incoming: true}], true).map((card) => card.state), ['ask']);
process.stdout.write(JSON.stringify(wrong));
"""
        result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
        check(result.returncode == 0 and result.stdout == "[]", "The web's NickServ rules are wrong: " + (result.stdout or result.stderr)[:600])
    else:
        print("SKIP  NickServ rules in Node: node is missing")

    # IDENTIFY goes over the connection, paced, with the account name; nothing reaches chat history.
    server, phone = socket.socketpair()
    server.settimeout(5)
    heard = []
    client = irc_client.IrcClient({"server": "irc.example.test", "nick": "kit_", "sasl_user": "kit"}, lambda *args: heard.append(args), lambda *a: None)
    client.sock = phone
    client.ready.set()
    client.identify_now("fixture-pass-1", save=True)
    check(server.recv(4096) == b"PRIVMSG NickServ :IDENTIFY kit fixture-pass-1\r\n", "The card's IDENTIFY line is wrong")
    check(client.account["nickserv_password"] == "fixture-pass-1" and not heard, "The password wasn't kept for the next connect, or went into a chat")
    for bad in ("", "two words", "line\r\nQUIT", "x" * 301, None):
        try:
            client.identify_now(bad)
            raise RuntimeError("An unsafe NickServ password was sent")
        except ValueError:
            pass
    # The gateway: the route's account, saving through the account store, and no reconnect for the saved password.
    saved = {}
    values = {"server": "irc.example.test", "nick": "kit", "port": 6697}
    store = types.SimpleNamespace(all=lambda: [{"id": "irc:kit@irc.example.test", "protocol": "irc", "source": "phone", "values": values}],
                                  save=lambda protocol, fields, ident: saved.update(fields) or dict(fields))
    fake = types.SimpleNamespace(route=lambda address, protocol: {"address": address, "protocol": "irc", "via": "irc", "account": "irc:kit@irc.example.test"}
                                 if address == "irc-nickserv" else None,
                                 enabled=lambda db: ["irc"], using=lambda ident: contextlib.nullcontext(), client=lambda protocol: client,
                                 accounts=store, clients={"irc:kit@irc.example.test": ("old", client)}, default_account=lambda protocol: "")
    result = protocol_gateway.Gateway.identify_nickserv(fake, None, {"address": "irc-nickserv", "password": "fixture-pass-2", "save": True})
    check(result == {"ok": True, "saved": True} and saved["nickserv_password"] == "fixture-pass-2", "The card's password wasn't saved")
    check(fake.clients["irc:kit@irc.example.test"] == (json.dumps(saved, sort_keys=True), client), "Saving the password would reconnect")
    check(b"IDENTIFY kit fixture-pass-2" in server.recv(4096), "The gateway didn't send IDENTIFY")
    check("fixture-pass-2" not in json.dumps(result), "The password came back in the reply")
    for bad in ({"address": "nowhere", "password": "x"}, {"address": "irc-nickserv", "password": "has space"}):
        try:
            protocol_gateway.Gateway.identify_nickserv(fake, None, bad)
            raise RuntimeError("A bad identify request was accepted")
        except ValueError as error:
            check("has space" not in str(error), "An error repeated the password")
    server.close()
    phone.close()
    print("PASS  IRC: call and meeting-link buttons off until turned on with a warning, and the NickServ card's rules, IDENTIFY, and saved password")


def irc_join_requirements_test():
    """IRC join requirements, the same on the phone (IrcJoins.kt) and the web (irc_client.py): channels for signed-in
    nicknames wait for signing in and try once more, channels a network says to join first are joined first and
    remembered, refusals are plain words, and Communities won't remove a channel another one needs. Fictional texts."""
    sys.path.insert(0, str(ROOT / "server"))
    import threading
    import irc_client

    # The rules, with the same fixtures as IrcJoinsTest.kt.
    for code, text, wanted in (("477", "Cannot join channel (+r) - you need to be identified with services", True),
                               ("477", "You need a registered nick to join that channel.", True),
                               ("473", "Cannot join channel (+r) - you need to be identified with services", True),
                               ("474", "You must be logged in to a services account to join this channel", True),
                               ("477", "Channel doesn't support modes", False), ("473", "Cannot join channel (+i)", False),
                               ("474", "Cannot join channel (+b) - you are banned", False),
                               ("475", "Cannot join channel (+k) - registered users know the key", False),
                               ("001", "Welcome, you must be registered", False)):
        check(irc_client.needs_sign_in(code, text) is wanted, f"Signed-in-only was misread: {code} {text}")
    for code, text, channel, wanted in (("473", "Cannot join channel #chat (You must join #help first)", "#chat", "#help"),
                                        ("520", "Please join #lobby before #chat.", "#chat", "#lobby"),
                                        ("477", "You need to be in #rules to join this channel", "#chat", "#rules"),
                                        ("474", "join #lobby first!", "#Chat", "#lobby"),
                                        ("473", "Cannot join channel (+i)", "#chat", None),
                                        ("474", "Cannot join channel (+b) - you are banned. Appeal in #appeals", "#chat", None),
                                        ("473", "You must join #chat first", "#CHAT", None),
                                        ("PRIVMSG", "You must join #help first", "#chat", None)):
        check(irc_client.prerequisite(code, text, channel) == wanted, f"The channel to join first was misread: {text}")
    needs = {"#chat": ["#lobby"], "#lobby": ["#gate"], "#a": ["#b"], "#b": ["#a"]}
    first = lambda channel: needs.get(channel.lower(), [])
    check(irc_client.join_order(["#chat", "#news", "#lobby"], first) == ["#gate", "#lobby", "#chat", "#news"]
          and irc_client.join_order(["#a"], first) == ["#b", "#a"], "The join order was wrong")
    saved = irc_client.remember_first(irc_client.remember_first({}, "#chat", "#lobby"), "#Chat", "#LOBBY")
    check(irc_client.first_for(saved, "#CHAT") == ["#lobby"] and irc_client.first_for(irc_client.forget_first(saved, "#chat", "#Lobby"), "#chat") == [],
          "The remembered join-first list was wrong")
    check(irc_client.join_error("477", "#pond", "Harbor Net", "You need to be identified") ==
          "#pond only lets in people who are signed in to their nickname. Sign in with NickServ, then try again. "
          "Type your password in the NickServ card, or save it as Password in the IRC account settings.", "The 477 words differ from the phone's")
    check(irc_client.join_error("999", "#pond", "Libera.Chat", " Try later ") == "Couldn’t join #pond. Libera.Chat said: “Try later”"
          and "invite" in irc_client.join_error("473", "#pond", "n", "Cannot join channel (+i)")
          and "password" in irc_client.join_error("475", "#pond", "n", "Cannot join channel (+k)")
          and "moderators" in irc_client.error_text("482", "#pond", "x") and irc_client.error_text("999", "", "Ask") == "Ask",
          "Refusals weren't plain words")
    kotlin = (ROOT / "app/src/main/kotlin/org/fluidmessages/IrcJoins.kt").read_text() + (ROOT / "app/src/main/kotlin/org/fluidmessages/IrcChannels.kt").read_text()
    for phrase in ("only lets in people who are signed in to their nickname", "is locked with a password", "this network needs it",
                   "is needed to stay in", "IRC channels are public rooms", " · network messages",
                   "Account name: the name you registered with the network’s NickServ"):
        check(phrase in kotlin, "The phone is missing: " + phrase)
    web = "".join((ROOT / "server" / name).read_text() for name in ("irc_client.py", "servers.js", "chat-commands.js", "companion.js"))
    for phrase in ("only lets in people who are signed in to their nickname", "is locked with a password", "this network needs it",
                   "is needed to stay in", "IRC channels are public rooms", " · network messages",
                   "Account name: the name you registered with the network’s NickServ", "Leave and remove channel"):
        check(phrase in web, "The web is missing: " + phrase)

    class Recorder:
        def __init__(self):
            self.lines = []

        def sendall(self, data):
            self.lines.append(data.decode().rstrip("\r\n"))

    # Signing in first: joins wait for NickServ, a channel that wanted it tries once more, and a second refusal is shown.
    heard, remembered = [], {}
    client = irc_client.IrcClient({"server": "irc.example.test", "nick": "kit", "sasl_password": "fixture-pass", "channels": ["#quiet"]},
                                  lambda *args: heard.append(args), lambda *a: None, flood=irc_client.Flood(burst=1000),
                                  first=lambda channel: irc_client.first_for(remembered, channel),
                                  on_first=lambda channel, before: remembered.update(irc_client.remember_first(remembered, channel, before)))
    client.sock = Recorder()
    say = lambda line: client.handle(irc_client.parse(line))
    say(":irc.example.test CAP * LS :message-tags")  # No SASL offered: the Password goes to NickServ instead.
    say(":irc.example.test 001 kit :Welcome")
    check("PRIVMSG NickServ :IDENTIFY kit fixture-pass" in client.sock.lines and "JOIN #quiet" not in client.sock.lines,
          "Without SASL the Password wasn't sent to NickServ, or channels joined before signing in")
    say(":irc.example.test 477 kit #quiet :Cannot join channel (+r) - you need to be identified with services")
    check(any("FluidMessages is signing you in" in args[2] for args in heard), "Waiting to sign in wasn't said")
    say(":NickServ!NickServ@services.example.test NOTICE kit :You are now identified for kit.")
    # Joined on its own (Keep joined) and tried once more because it asked for signing in.
    check(client.sock.lines.count("JOIN #quiet") == 2, f"The channel didn't try again after signing in: {client.sock.lines}")
    say(":irc.example.test 477 kit #quiet :Cannot join channel (+r) - you need to be identified with services")
    check(client.sock.lines.count("JOIN #quiet") == 2 and any("signing in didn’t work" in args[2] for args in heard),
          "A refusal after signing in was retried again, or not explained")

    # A channel to join first: joined first, the channel again, remembered, and in that order on the next connect.
    say(":irc.example.test 473 kit #chat :Cannot join channel #chat (You must join #help first)")
    check(client.sock.lines[-2:] == ["JOIN #help", "JOIN #chat"] and irc_client.first_for(remembered, "#chat") == ["#help"],
          "The channel to join first wasn't joined first or remembered")
    say(":irc.example.test 473 kit #chat :Cannot join channel #chat (You must join #help first)")
    check(client.sock.lines.count("JOIN #chat") == 1, "A join-first loop retried forever")
    say(":irc.example.test 475 kit #vault :Cannot join channel (+k)")
    check(any("#vault is locked with a password" in args[2] for args in heard), "A password-locked channel wasn't explained")
    say(":irc.example.test 482 kit #chat :You're not channel operator")
    check(any("Only moderators of #chat" in args[2] for args in heard), "An error wasn't plain words")
    client.account = {**client.account, "channels": ["#chat"]}
    client.sock = Recorder()
    client.session = lambda: None
    client.joins_sent, client.joined = False, set()
    client.sign_in_pending = False
    client.join_kept()
    check(client.sock.lines == ["JOIN #help", "JOIN #chat"], f"Reconnecting didn't join the channel it needs first: {client.sock.lines}")

    # join_wait: a refusal comes back in plain words with its code, for the Join page's password field.
    client.ready.set()
    client.joined = set()
    worker_result = {}
    worker = threading.Thread(target=lambda: worker_result.update(r=client.join_wait("#vault", "", wait=3)), daemon=True)
    worker.start()
    deadline = time.time() + 3
    while "JOIN #vault" not in client.sock.lines and time.time() < deadline:
        time.sleep(0.02)
    say(":irc.example.test 475 kit #vault :Cannot join channel (+k)")
    worker.join(4)
    check(worker_result.get("r", (None,))[0] == "475", f"join_wait didn't report the password-locked channel: {worker_result}")
    try:
        client.join_wait("#vault", "two words")
        raise RuntimeError("A channel password with a space was sent")
    except ValueError:
        pass

    # Communities: a channel another joined channel needs can't be removed alone (servers.js, in Node).
    node = os.environ.get("NODE") or shutil.which("node")
    servers_js = (ROOT / "server/servers.js").read_text()
    commands_js = (ROOT / "server/chat-commands.js").read_text()
    check("showModal" not in servers_js and "<dialog" not in servers_js, "Leave and remove channel uses a pop-up")
    if node:
        block = re.search(r"// join-first:start[^\n]*\n(.*?)// join-first:end", servers_js, re.S).group(1)
        intro = re.search(r"// irc-intro:start[^\n]*\n(.*?)// irc-intro:end", commands_js, re.S).group(1)
        script = block + intro + r"""
const wrong = [];
const same = (what, got, want) => { if (JSON.stringify(got) !== JSON.stringify(want)) wrong.push([what, got, want]); };
const lobby = {address: 'a1', protocol: 'irc', group: true, account: 'irc:kit@irc.example.test', target: '#lobby'};
const chat = {address: 'a2', protocol: 'irc', group: true, account: 'irc:kit@irc.example.test', target: '#chat', join_first: ['#Lobby']};
const other = {address: 'a3', protocol: 'irc', group: true, account: 'irc:kit@irc.other.test', target: '#chat2', join_first: ['#lobby']};
const all = [lobby, chat, other];
same('needed', channelNeededBy(lobby, all).map((route) => route.target), ['#chat']);
same('free', channelNeededBy(chat, all), []);
same('words', channelNeededText('#lobby', [chat]), '#lobby is needed to stay in #chat on this network.');
same('title', [serverChatTitle('irc.libera.chat', [{host: 'irc.libera.chat', name: 'Libera.Chat'}]), serverChatTitle('irc.example.test', []),
  serverChatTitle('Harbor Net · network messages', [])], ['Libera.Chat · network messages', 'irc.example.test · network messages',
  'Harbor Net · network messages']);
same('intro', ircChannelIntro('#pond'), 'IRC channels are public rooms. Anyone in #pond can read what you write. Moderators can remove people.');
process.stdout.write(JSON.stringify(wrong));
"""
        result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
        check(result.returncode == 0 and result.stdout == "[]", "The web's join-first rules are wrong: " + (result.stdout or result.stderr)[:600])
    else:
        print("SKIP  join-first rules in Node: node is missing")
    print("PASS  IRC join requirements: signing in first, channels joined first and remembered, plain refusals, and Communities removal")


def web_parity_node_test():
    """The browser's rules for the same features, run in Node: failed messages and their choices, kind locks,
    contrast and tints with readable fallbacks, a chat's own colors, and theme switching keeping sound and motion."""
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("SKIP  web parity rules in Node: node is missing")
        return
    app_js, chats_js, look_js, media_js = ((ROOT / "server" / name).read_text() for name in ("app.js", "chats.js", "look.js", "media.js"))
    engine = re.search(r"const RCS_LIGHT = .*?(?=// Facts about the phone)", app_js, re.S).group(0)
    failed = re.search(r"function failedMessage\(message\).*?(?=async function retryMessage)", app_js, re.S).group(0)
    locks = re.search(r"// Lock every chat of one kind.*?(?=\n// Muting)", chats_js, re.S).group(0)
    theme_keys = re.search(r"const THEME_KEYS = .*?(?=/\*\* The look settings)", look_js, re.S).group(0)
    chat_colors = re.search(r"const CHAT_ROLES = .*?(?=/\*\* Sets a chat's colors)", look_js, re.S).group(0)
    gif_address = re.search(r"const GIF_API_ADDRESS = .*?;\n", media_js).group(0)
    script = "const window = {};\n" + engine + failed + locks + theme_keys + chat_colors + gif_address + r"""
const labels = {email: 'Email', matrix: 'Matrix'};
const family = (protocol) => ['rcs', 'mms', undefined, ''].includes(protocol) ? 'sms' : protocol;
const internet = (protocol) => !['sms', 'mms', 'rcs', undefined, ''].includes(protocol);
const parseEffect = () => null;
let sampleOn = false, threadsByKey = {'web-rowan\u001femail': 'email', '+12025550146\u001fsms': 'sms', 'web-kit\u001fmatrix': 'matrix'};
const threadAddress = (key) => key.split('\u001f')[0];
const threadProtocol = (key) => threadsByKey[key];
let state = {locks: {}};
const chatState = () => state;
const wrong = [];
const say = (ok, what) => { if (!ok) wrong.push(what); };
// Failed messages: internet ones by their status, texts by type 5; Edit and resend isn't offered for files.
const failedEmail = {id: 'web-1', protocol: 'email', type: 2, body: 'Fictional', status: 'Couldn’t send · The server didn’t answer'};
say(failedMessage(failedEmail) && failedMessage({type: 5, body: 'x'}) && !failedMessage({type: 1, status: 'Couldn’t send'}) && !failedMessage({type: 2, status: 'Sent'}), 'failed');
say(failedReason(failedEmail) === 'The server didn’t answer' && failedReason({status: 'Couldn’t send'}) === '', 'reason');
say(JSON.stringify(failedChoices(failedEmail).map(([label]) => label)) === '["Try again","Edit and resend","Delete"]', 'choices');
say(JSON.stringify(failedChoices({...failedEmail, attachment: {name: 'a.pdf'}}).map(([label]) => label)) === '["Try again","Delete"]', 'file choices');
say(failedOnline(failedEmail) && !failedOnline({protocol: 'sms', id: 'x'}), 'online');
// Kind locks: a chat's own code first, then its kind's; texts include RCS and MMS.
say(chatLockKey('web-rowan\u001femail') === '', 'unlocked');
state = {locks: {'service:email': {}, 'service:sms': {}}};
say(chatLockKey('web-rowan\u001femail') === 'service:email' && chatLockKey('+12025550146\u001fsms') === 'service:sms'
  && chatLockKey('web-kit\u001fmatrix') === '', 'kind lock');
state = {locks: {'service:email': {}, 'web-rowan': {}}};
say(chatLockKey('web-rowan\u001femail') === 'web-rowan', 'own code first');
say(JSON.stringify(lockCounts(state)) === '{"chats":1,"kinds":1}', 'counts');
// A lock that opens with the computer's screen lock counts as locked, and leaving a chat locks it again.
state = {locks: {'web-rowan': {credential: 'ZmljdGlvbmFsLWNyZWRlbnRpYWw'}}};
say(chatLockKey('web-rowan\u001femail') === 'web-rowan' && deviceLock(state.locks['web-rowan']) && !deviceLock({salt: 'ab', hash: 'cd'})
  && JSON.stringify(lockCounts(state)) === '{"chats":1,"kinds":0}', 'screen lock');
say(stillUnlocked('web-rowan', 'web-rowan') === 'web-rowan' && stillUnlocked('web-rowan', 'web-kit') === ''
  && stillUnlocked('web-rowan', '') === '' && stillUnlocked('', 'web-rowan') === '', 'relock');
// Palette contrast: Fluid's increased-contrast colors, stronger muted text; the tints are your own.
const plain = themeAppearance({theme: 'fluid', mode: 'light'}), strong = themeAppearance({theme: 'fluid', mode: 'light', contrast: true});
say(plain.colors.sms === '#0088ff' && strong.colors.sms === '#1e6ef4' && strong.contrast === true, 'fluid contrast');
say(contrast(strong.colors.muted, strong.colors.surface) >= 7 && contrast(plain.colors.muted, plain.colors.surface) >= 4.5, 'muted contrast');
const tinted = themeAppearance({theme: 'ember', mode: 'dark', colors: {canvas: '#101820', controls: '#ff9500', chrome: '#d8ecff'}});
say(tinted.colors.canvas === '#101820' && tinted.colors.ink === '#ffffff', 'canvas');
say(contrast(tinted.colors.surface, tinted.colors.ink) >= 4.5 && contrast(tinted.colors.raised, tinted.colors.ink) >= 4.5, 'light tint on dark stays readable');
say(contrast(bubbleFill('#ffd60a'), bubbleInk('#ffd60a')) >= 4.5 && bubbleInk('#ffd60a') === '#ffffff', 'bright fill');
say(textOn('#f2f2f2') === '#000000' && textOn('#1c1c1e') === '#ffffff', 'neutral fills');
// Nearby: turquoise in every theme, light and dark and increased contrast, with readable white text once shaded.
say(plain.colors.nearby === '#00c8b3' && strong.colors.nearby === '#008575' && BUBBLES.includes('nearby') && CHAT_ROLES.includes('nearby'), 'nearby fluid');
for (const key of Object.keys(THEMES)) for (const mode of ['light', 'dark']) for (const strongColors of [false, true]) {
  const shown = themeAppearance({theme: key, mode, contrast: strongColors}).colors.nearby;
  say(/^#[0-9a-f]{6}$/.test(shown || '') && bubbleInk(shown) === '#ffffff' && contrast(bubbleFill(shown), bubbleInk(shown)) >= 4.5,
    'nearby ' + key + ' ' + mode + (strongColors ? ' increased' : ''));
  say(key === 'fluid' || THEMES[key].light[6].length === 5, 'nearby color for ' + key);
}
say(themeAppearance({theme: 'ember', mode: 'light', colors: {nearby: '#40e0d0'}}).colors.nearby === '#40e0d0', 'own nearby color');
// Switching or resetting a theme clears its colors and contrast, and keeps sound, haptics, and motion.
const look = {theme: 'fluid', contrast: true, colors: {canvas: '#101820'}, sendSound: 'pop', haptics: 'soft', speed: 0, soundVolume: 40};
const next = themeLook(look, 'love');
say(next.theme === 'love' && next.wallpaper === 'love' && !next.colors && !next.contrast, 'theme reset');
say(['sendSound', 'haptics', 'speed', 'soundVolume'].every((key) => next[key] === look[key]), 'sound kept');
const kept = themeLook({...look, palettes: {Sunny: {theme: 'ember', colors: {sms: '#ffd60a'}, contrast: true}}}, 'fluid', 'Sunny');
say(kept.contrast === true && kept.colors.sms === '#ffd60a' && kept.activePalette === 'Sunny', 'palette contrast');
// A chat's own colors: a theme, then outgoing, incoming, and background on top; readable text for its background.
let webLook = {chatThemes: {}}, appearance = {dark: false};
const resolvedAppearance = () => themeAppearance({theme: 'fluid', mode: 'light'});
say(chatColors('web-rowan') === null, 'no chat theme');
const own = chatColors('web-rowan', {theme: 'ember', outgoing: '#ffd60a', background: '#1d1a2b'});
say(own.sms === '#ffd60a' && own.email === '#ffd60a' && own.automated !== '#ffd60a' && own.canvas === '#1d1a2b' && own.ink === '#ffffff'
  && contrast(own.muted, own.canvas) >= 4.5, 'chat colors');
say(chatColors('x', {theme: 'love'}).canvas === THEMES.love.light[0], 'chat theme canvas');
// The GIF API address check matches the server's.
say(GIF_API_ADDRESS.test('https://gifs.example.org/tenor/') && !GIF_API_ADDRESS.test('http://gifs.example.org')
  && !GIF_API_ADDRESS.test('https://gifs.example.org/?q=1') && !GIF_API_ADDRESS.test('https://gifs.example.org:8443'), 'gif address');
process.stdout.write(JSON.stringify(wrong));
"""
    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0 and result.stdout == "[]", "Web parity rules are wrong: " + (result.stdout or result.stderr)[:900])
    print("PASS  web parity rules in Node: failed message choices, kind locks, palette contrast and readable tints, chat colors, theme reset")


def running_status_test():
    """Settings → Running on this server: /api/running needs sign-in, and lists the server's loops, Tor, the phone, and
    cloud backups in its groups. running_status.rows is checked on fixed facts too."""
    sys.path.insert(0, str(ROOT / "server"))
    import running_status
    sys.path.remove(str(ROOT / "server"))
    facts = {"now": 1000, "threads": ["protocol-sender", "protocol-clients", "protocol-disappearing"], "tls": None, "waiting": 2,
             "accounts": [{"id": "irc:1", "protocol": "irc", "name": "kit@irc.example.org", "client": "connection", "every": None,
                           "state": "reconnecting", "manual": False, "retry_at": 5000},
                          {"id": "email:1", "protocol": "email", "name": "kit@example.org", "client": "poll", "every": 300,
                           "state": "", "manual": False, "retry_at": 0},
                          {"id": "xmpp:1", "protocol": "xmpp", "name": "kit@example.org", "client": None, "every": None,
                           "state": "off", "manual": False, "retry_at": 0}],
             "tor": {"on": False, "proxy": "127.0.0.1:9050", "reachable": False}, "backups": ["s3"],
             "phone": {"paired": True, "last_sync": 900}, "scheduled": {"texts": 1, "texts_next": 2000, "chats": 0, "chats_next": None}}
    page = running_status.rows(facts)
    by_id = {row["id"]: row for group in page["groups"] for row in group["rows"]}
    check([group["id"] for group in page["groups"]] == ["always", "schedule", "phone", "off"], "Running groups out of order")
    check(by_id["account-irc:1"]["group"] == "always" and by_id["account-irc:1"]["state"] == "Reconnecting"
          and by_id["account-irc:1"]["at"] == 5000, "A reconnecting IRC account isn't shown with its next try")
    check(by_id["account-email:1"]["group"] == "schedule" and by_id["account-email:1"]["state"] == "Checks every 5 minutes",
          "Email polling isn't on a schedule")
    check(by_id["account-xmpp:1"]["group"] == "off", "An account without a connection shows as running")
    check(by_id["sender"]["state"] == "2 waiting to send" and by_id["tor"]["group"] == "off", "The sender or Tor rows are wrong")
    check(by_id["phone"]["group"] == "phone" and by_id["phone"]["at"] == 900 and "S3" in by_id["backups"]["state"],
          "The phone or cloud backup rows are wrong")
    check(page["count"] == 5 and page["summary"] == "5 things running", "Running count is wrong: " + page["summary"])
    quiet = running_status.rows({**facts, "threads": [], "accounts": [], "waiting": 0})
    check(quiet["count"] == 0 and quiet["summary"] == running_status.NOTHING, "Nothing running doesn't say so")

    token = secrets.token_hex(32)
    with companion(free_port(), token) as (origin, request, _):
        try:
            request("/api/running", authorized=False)
            raise RuntimeError("/api/running answered without signing in")
        except HTTPError as error:
            check(error.code == 401, f"/api/running without signing in: expected 401, got {error.code}")
        status = request("/api/running")
        check(set(status) == {"count", "summary", "groups", "now"} and isinstance(status["count"], int), "Running has the wrong shape")
        rows = {row["id"]: row for group in status["groups"] for row in group["rows"]}
        check(all(set(row) >= {"group", "id", "icon", "name", "state", "why", "opens"} for row in rows.values()),
              "A running row is missing a field")
        check({"sender", "supervisor", "disappearing"} <= set(rows), "The server's own loops aren't listed: " + ", ".join(rows))
        check(rows["tor"]["group"] == "off" and rows["phone"]["state"] == "Not connected", "A new server shows Tor or a phone")
        check(status["count"] == 3 and status["summary"] == "3 things running", "A new server's count is wrong: " + status["summary"])
        page = request("/", authorized=False).decode()
        check('src="/running.js"' in page and "'/running.js'" in request("/sw.js", authorized=False).decode()
              and b"runningPage" in request("/running.js", authorized=False), "running.js isn't served or cached")
    print("PASS  Running on this server: sign-in required, groups, and words")


def quick_setup_test():
    """Quick setup on FluidMessages Web: its choices match the phone's, the current one is worked out from the settings,
    and Only send encrypted messages refuses on the server with the composer's words (quick-setup.js, quick_setup.py)."""
    sys.path.insert(0, str(ROOT / "server"))
    import quick_setup
    quick_js = (ROOT / "server/quick-setup.js").read_bytes()
    kotlin = (ROOT / "app/src/main/kotlin/org/fluidmessages/QuickSetup.kt").read_text()
    block = re.search(rb"// quick-setup:start[^\n]*\n(.*?)// quick-setup:end", quick_js, re.S)
    check(block, "quick-setup.js has no Quick setup rules")
    # Never called a privacy level, and never named private, secure, or safe.
    for text in (quick_js.decode(), kotlin):
        check("privacy level" not in text.lower(), "Quick setup is still called a privacy level somewhere")
    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        index = request("/", authorized=False).decode()
        check(index.index("/tor.js") < index.index("/quick-setup.js"), "The page doesn't load quick-setup.js after tor.js")
        check("'/quick-setup.js'" in request("/sw.js", authorized=False).decode(), "The service worker doesn't cache quick-setup.js")
        check(b"quickRefusal" in request("/quick-setup.js", authorized=False), "quick-setup.js isn't served")
        check(request("/api/inbox")["prefs"].get("encryptedOnly") is False, "Only send encrypted messages isn't off by default")
        draft = {"address": "+15555550123", "body": "Fictional test", "due": int(time.time() * 1000)}
        check(request("/api/schedule", draft)["id"], "A text didn't queue with Only send encrypted messages off")
        check(request("/api/settings", {"prefs": {"encryptedOnly": True}})["prefs"]["encryptedOnly"] is True,
              "Only send encrypted messages wasn't saved")
        for path, body, protocol in (("/api/schedule", draft, "sms"),
                                     ("/api/protocols/send", {"address": "irc:#fictional", "protocol": "irc", "body": "Hi",
                                                              "request": "quick-setup-test"}, "irc")):
            try:
                request(path, body)
                raise RuntimeError("FluidMessages Web sent with Only send encrypted messages on: " + path)
            except HTTPError as error:
                reason = json.loads(error.read() or b"{}").get("error", "")
                check(error.code == 400 and reason == quick_setup.refusal(True, protocol, False),
                      f"{path} refused with the wrong words: {error.code} {reason}")
        request("/api/settings", {"prefs": {"encryptedOnly": False}})
        check(request("/api/schedule", draft)["id"], "Texts didn't queue again after turning the switch off")
    words = {protocol: quick_setup.refusal(True, protocol, False) for protocol in ("sms", "mms", "irc", "email", "matrix", "xmpp")}
    check(quick_setup.refusal(False, "irc", False) == "" and quick_setup.refusal(True, "matrix", True) == "",
          "Only send encrypted messages blocks when it's off, or in an encrypted room")
    # The phone's choices, in its order, with the same names and who they're for.
    titles = re.findall(r'Choice\("(\w+)", "([^"]+)", "([^"]+)"', kotlin)
    check([item[0] for item in titles] == ["everything", "standard", "lock", "encrypted", "tor", "nearby"],
          "The phone's Quick setup choices aren't in the agreed order")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("PASS  Quick setup on FluidMessages Web (the rules in Node skipped: node is missing)")
        return
    script = block.group(1).decode() + """
const [phone, refusals] = JSON.parse(process.argv[1]);
const wrong = [];
const expect = (got, want, what) => { if (JSON.stringify(got) !== JSON.stringify(want)) wrong.push([what, got, want]); };
const use = (id, start = {}, ready = {tor: true}) => ({...start, ...quickPlan(start, ready, quickChoice(id).values).set});
expect(QUICK_CHOICES.map((choice) => [choice.id, choice.title, choice.forWho]), phone, 'the same choices as the phone');
expect(quickCurrent({}), 'standard', 'a fresh install is Standard');
for (const id of ['standard', 'lock', 'encrypted', 'tor']) expect(quickCurrent(use(id)), id, id + ' shows after it is used');
for (const first of ['standard', 'lock', 'encrypted', 'tor']) for (const second of ['standard', 'lock', 'encrypted', 'tor'])
  expect(quickCurrent(use(second, use(first))), second, first + ' then ' + second);
expect(quickCurrent(use('everything', {allServices: false})), 'standard', 'Everything on looks like Standard without Nearby');
expect(quickCurrent({...use('encrypted'), linkPreviews: true}), 'custom', 'changing one switch shows Custom');
expect(quickCurrent({...use('standard'), notifyPreview: false}), 'custom', 'notification text off is Custom');
expect(use('encrypted').encryptedOnly, true, 'Encrypted only turns the switch on');
expect(use('lock').gifSearch, 'none', 'fewer leaks turns GIF search off');
expect('gifSearch' in quickPlan({gifSearch: 'giphy'}, {tor: true}, quickChoice('standard').values).set, false, 'Standard leaves GIF search');
const noTor = quickPlan({}, {tor: false}, quickChoice('tor').values);
expect(['tor' in noTor.set, noTor.steps, noTor.set.encryptedOnly], [false, [QUICK_NEEDS_TOR], true], 'Tor waits for a proxy that answers');
expect(quickPlan({}, {tor: true, twoStep: false}, quickChoice('lock').values).notes, [QUICK_TWO_STEP], 'two-step sign-in is suggested');
expect(Object.keys(quickPlan({}, {tor: true}, quickChoice('standard').values).set), [], 'only changes are saved');
expect(quickAnswers(use('tor')), {send: 'encrypted', tor: true, fewerLeaks: true}, 'the questions read the settings');
expect(quickAnswers({linkPreviews: false}).fewerLeaks, null, 'some extras on and some off');
expect(quickCurrent({...QUICK_ENCRYPTED, ...QUICK_TOR, ...QUICK_FEWER}), 'tor', 'answering the questions reaches the same choice');
for (const [protocol, words] of Object.entries(refusals)) expect(quickRefusal(true, protocol, false), words, protocol + ' says the server words');
expect(quickRefusal(true, 'matrix', true), '', 'an encrypted Matrix room sends');
expect(quickRefusal(false, 'irc', false), '', 'off blocks nothing');
expect([quickServiceMark(true, 'irc'), quickServiceMark(true, 'matrix'), quickServiceMark(false, 'irc')], ['Can’t encrypt', 'Encrypted rooms only', ''], 'service marks');
for (const choice of QUICK_CHOICES) if (/private|secure|safe/i.test(choice.title)) wrong.push(['a name says private, secure, or safe', choice.title]);
process.stdout.write(JSON.stringify(wrong));
"""
    phone = [[item[0], item[1], item[2].replace("'", "’")] for item in titles]
    result = subprocess.run([node, "-e", script, json.dumps([phone, words], ensure_ascii=False)], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0 and result.stdout == "[]", "The Quick setup rules are wrong: " + (result.stdout or result.stderr)[:900])
    print("PASS  Quick setup: the phone's six choices on the web, Standard by default, Custom after any change, Tor waits for a proxy, "
          "and Only send encrypted messages refuses texts and IRC on the server with the composer's words")


def tor_test():
    """Connect through Tor: the SOCKS5 handshake (remote DNS) against a fake local SOCKS server, which connections go
    through Tor, that nothing goes direct when Tor is on but not running, and the Settings API."""
    import threading
    sys.path.insert(0, str(ROOT / "server"))
    import irc_client
    import tor_route
    seen = {}

    def fake_socks(server):
        client, _ = server.accept()
        with client:
            seen["greeting"] = client.recv(3)
            client.sendall(b"\x05\x00")
            head = client.recv(5)
            name = client.recv(head[4])
            port = int.from_bytes(client.recv(2), "big")
            seen["request"], seen["name"], seen["port"] = head[:4], name.decode(), port
            client.sendall(b"\x05\x00\x00\x01\x7f\x00\x00\x01\x00\x50")
            client.sendall(b"hello")

    with socket.socket() as server:
        server.bind(("127.0.0.1", 0))
        server.listen(1)
        worker = threading.Thread(target=fake_socks, args=(server,), daemon=True)
        worker.start()
        tor_route.configure(True, "127.0.0.1:%d" % server.getsockname()[1])
        try:
            with tor_route.create_connection(("irc.example.org", 6697), timeout=5) as sock:
                check(sock.recv(5) == b"hello", "The SOCKS tunnel didn't carry data")
            worker.join(5)
            check(seen["greeting"] == b"\x05\x01\x00", "The SOCKS5 greeting is wrong")
            check(seen["request"] == b"\x05\x01\x00\x03", "SOCKS5 CONNECT must send the host name (remote DNS)")
            check(seen["name"] == "irc.example.org" and seen["port"] == 6697, "Tor must get the name and port unresolved")
            check(tor_route.ready() is False, "A closed proxy isn't ready")
        finally:
            tor_route.configure(False)
    # Refusals in plain words.
    with socket.socket() as server:
        server.bind(("127.0.0.1", 0))
        server.listen(1)

        def refuse():
            client, _ = server.accept()
            with client:
                client.recv(3)
                client.sendall(b"\x05\x00")
                client.recv(300)
                client.sendall(b"\x05\x04\x00\x01\x00\x00\x00\x00\x00\x00")
        threading.Thread(target=refuse, daemon=True).start()
        tor_route.configure(True, "127.0.0.1:%d" % server.getsockname()[1])
        try:
            tor_route.create_connection(("matrix.example.org", 443), timeout=5)
            raise RuntimeError("A refused Tor connection went ahead")
        except tor_route.TorError as error:
            check("couldn’t reach that server" in str(error) or "couldn't reach that server" in str(error), "Tor's refusal needs plain words")
        finally:
            tor_route.configure(False)
    # On but not running: never direct.
    closed = free_port()
    tor_route.configure(True, "127.0.0.1:%d" % closed)
    try:
        with socket.socket() as direct:
            direct.bind(("127.0.0.1", 0))
            direct.listen(1)
            try:
                tor_route.create_connection(("example.org", direct.getsockname()[1]), timeout=2)
                raise RuntimeError("Tor on but not running connected without Tor")
            except tor_route.TorError as error:
                check(str(error) == tor_route.NOT_READY, "Tor not running needs the plain message")
        # Your own network still connects directly.
        with socket.socket() as local:
            local.bind(("127.0.0.1", 0))
            local.listen(1)
            tor_route.create_connection(("127.0.0.1", local.getsockname()[1]), timeout=2).close()
    finally:
        tor_route.configure(False)
    check(tor_route.decide(False, False, False) == "direct", "Tor off changes nothing")
    check(tor_route.decide(True, True, False) == "tor" and tor_route.decide(True, False, False) == "wait", "Tor on goes through Tor or waits")
    check(tor_route.decide(True, False, True) == "direct", "Your own network connects directly")
    for host in ("192.168.1.4", "10.1.2.3", "fluid.local", "nas", "box.tail1.ts.net", "100.64.1.1", "::1"):
        check(tor_route.local_host(host), host + " is on your own network")
    for host in ("irc.libera.chat", "8.8.8.8", "abc.onion", "2606:4700::1"):
        check(not tor_route.local_host(host), host + " is on the internet")
    check(tor_route.parse_proxy("tor:9050") == ("tor", 9050), "A container name works as the proxy")
    for bad in ("", "127.0.0.1", "127.0.0.1:0", "a b:9050"):
        try:
            tor_route.parse_proxy(bad)
            raise RuntimeError("Accepted a bad proxy address " + repr(bad))
        except ValueError:
            pass
    words, fatal = irc_client.explain("ERROR", "Closing Link: banned (Tor exit node)", "Libera.Chat", "kit", False, tor=True)
    check(fatal and "through Tor" in words and "SASL" in words, "IRC refusals over Tor say so in plain words")
    check("Tor" not in irc_client.explain("ERROR", "K-lined", "Libera.Chat", "kit", False)[0], "Without Tor the earlier words stay")
    sys.path.remove(str(ROOT / "server"))
    # The setting: off by default, the warning needs "I understand", and it's saved.
    with companion(free_port(), secrets.token_urlsafe(32)) as (_, request, _process):
        status = request("/api/tor")
        check(status["on"] is False and status["proxy"] == "127.0.0.1:9050", "Connect through Tor is off by default")
        check("slower and less reliable" in status["warning"], "The Tor warning is missing")
    print("PASS  Tor: SOCKS5 with remote DNS, nothing direct while Tor isn't running, IRC refusals, and the setting")
    tor_chat_test()
    tor_intro_test()


def tor_intro_test():
    """"What is Tor?": the same words on the phone (TorIntro.kt) and the web (tor.js), shown once before the warning,
    reachable from the Tor page and Settings → Help, kept as a server pref; and the setup guide's Tor tip."""
    kotlin = (ROOT / "app/src/main/kotlin/org/fluidmessages/TorIntro.kt").read_text()
    tor_js = (ROOT / "server/tor.js").read_text()
    block = re.search(r"// tor-intro:start[^\n]*\n(.*?)// tor-intro:end", tor_js, re.S)
    check(block is not None, "tor.js has no tor-intro block")
    flat = lambda text: re.sub(r"\"\s*\+\s*\"|'\s*\+\s*'", "", text)
    for words in ("bouncing your connection through three computers run by volunteers", "a school, a workplace, or an internet provider",
                  "It doesn’t lock your messages.", "Texts and phone calls never use Tor.", "It’s slower.", "sometimes drops",
                  "Some servers block Tor", "each chat’s details have their own Connect through Tor switch",
                  "show a small onion next to their name"):
        check(words in flat(kotlin) and words in flat(block.group(1)), "The phone and web differ on What is Tor?: " + words)
    page = (ROOT / "app/src/main/kotlin/org/fluidmessages/TorSettingsPage.kt").read_text()
    check("TorIntro.due(prefs, true)" in page and "Intro.READING" in page, "The phone's Tor page doesn't show What is Tor? first, or link to it")
    activity = (ROOT / "app/src/main/java/org/fluidmessages/MainActivity.java").read_text()
    check("action(TorIntro.TITLE" in activity.split("new SettingsSection(\"Help\"", 1)[1], "Settings → Help has no What is Tor? on the phone")
    check("if (value && torIntroDue(true))" in tor_js and "settingsLink('tor-intro'" in tor_js and "id: 'what-is-tor'" in tor_js,
          "The web's Tor page doesn't show What is Tor? first, link to it, or list it in Help")
    check("\"torIntroSeen\"" in (ROOT / "server/main.py").read_text(), "The web doesn't keep whether What is Tor? has shown")
    onboarding = (ROOT / "app/src/main/kotlin/org/fluidmessages/OnboardingScreen.kt").read_text()
    welcome = (ROOT / "server/welcome.js").read_text()
    for text in (onboarding, welcome):
        check("Hide where you connect from" in text and "Connect through Tor: Settings → Privacy and security" in text,
              "The setup guide's Keep chats private step has no Tor tip")
    node = os.environ.get("NODE") or shutil.which("node")
    if node:
        script = block.group(1) + """
const wrong = [];
const expect = (got, want, what) => { if (got !== want) wrong.push([what, got, want]); };
expect(torIntroDue(true, false), true, 'first time on');
expect(torIntroDue(true, true), false, 'already seen');
expect(torIntroDue(false, false), false, 'turning off');
expect(TOR_INTRO.downsides.length, 3, 'downsides');
process.stdout.write(JSON.stringify(wrong));
"""
        result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
        check(result.returncode == 0 and result.stdout == "[]", "tor.js's What is Tor? rule is wrong: " + (result.stdout or result.stderr)[:600])
    else:
        print("Skipped running tor.js's What is Tor? rule: node isn't installed (set NODE to its path)")
    # Settings → Battery and sync: plain words, a link to Running now, and the same pref keys as before.
    battery = (ROOT / "app/src/main/kotlin/org/fluidmessages/BatteryPage.kt").read_text()
    for words in ("How often to check for new messages", "While FluidMessages is open", "While FluidMessages is closed",
                  "Only check on Wi-Fi", "Pause checks during Battery Saver", "Download pictures and files you get",
                  "See what’s running now", "Stay discoverable", "Connect through Tor"):
        check(words in battery, "Battery and sync is missing: " + words)
    policy = (ROOT / "app/src/main/java/org/fluidmessages/SyncPolicy.java").read_text()
    for key in ("syncForegroundSeconds", "syncBackgroundMinutes", "syncWifiOnly", "syncPauseOnBatterySaver", "attachmentDownloads"):
        check('"' + key + '"' in policy, "Battery and sync lost its pref key " + key)
    check("BatteryPage.mount(root, prefs, this::runningNow)" in activity, "Battery and sync doesn't link to Running now")
    print("PASS  What is Tor? on the phone and web, the setup guide's Tor tip, and Battery and sync's words and keys")


def tor_chat_test():
    """Tor per chat: the decision table, one connection's choice changing the route, the mark data, the per-chat switch
    API, and the browser's rules and onion (tor.js), which must match the phone's words."""
    sys.path.insert(0, str(ROOT / "server"))
    import smtplib
    import tor_route
    # Which chats can use Tor, and why not, in the phone's words (TorChat.kt).
    torchat_kt = (ROOT / "app/src/main/kotlin/org/fluidmessages/TorChat.kt").read_text()
    table = [("sms", False, False, tor_route.TEXTS), ("mms", False, False, tor_route.TEXTS), ("rcs", False, False, tor_route.TEXTS),
             ("nearby", False, False, tor_route.NEARBY), ("xmpp", False, False, tor_route.XMPP_SWITCH),
             ("matrix", False, True, tor_route.E2EE_SWITCH), ("matrix", False, False, ""), ("irc", False, False, ""),
             ("email", False, False, "")]
    for protocol, local, encrypted, why in table:
        allowed, words = tor_route.chat_choice(protocol, local, encrypted)
        check(allowed == (why == "") and words == why, f"Tor per chat is wrong for {protocol}: {words!r}")
    allowed, words = tor_route.chat_choice("irc", True, False, "nas.local")
    check(not allowed and words.startswith("nas.local is on your own network"), "A server on your own network says why")
    for phrase in (tor_route.TEXTS, tor_route.NEARBY, tor_route.E2EE_SWITCH):
        check(phrase in torchat_kt, "The phone and FluidMessages Web disagree on: " + phrase)
    # Each connection's own choice comes before the setting, and changes where it connects.
    check(tor_route.account_hosts("email", {"imap_host": "IMAP.example.org", "smtp_host": "smtp.example.org"})
          == ["imap.example.org", "smtp.example.org"], "A mailbox's switch covers both its servers")
    check(tor_route.account_hosts("matrix", {"homeserver": "https://matrix.example.org:8448"}) == ["matrix.example.org"], "Matrix host")
    check(tor_route.account_hosts("xmpp", {"jid": "kit@example.org"}) == ["example.org"], "XMPP host")
    check(tor_route.with_choice({}, ["irc.example.org"], True, False) == {"irc.example.org": True}, "Choosing Tor for one network")
    check(tor_route.with_choice({"irc.example.org": True}, ["irc.example.org"], False, False) == {}, "Back to the setting")
    check(tor_route.wants(False, {"irc.example.org": True}, "IRC.example.org.") is True, "The choice is per server, any case")
    check(tor_route.wants(True, {"smtp.example.org": False}, "smtp.example.org") is False, "One mailbox can skip Tor")
    closed = free_port()
    tor_route.configure(False, "127.0.0.1:%d" % closed, {"irc.example.org": True})
    try:
        check(tor_route.used() and not tor_route.enabled(), "One network's choice uses Tor while the setting is off")
        try:
            tor_route.create_connection(("irc.example.org", 6697), timeout=2)
            raise RuntimeError("A network that chose Tor connected without it")
        except tor_route.TorError as error:
            check(str(error) == tor_route.NOT_READY, "A network that chose Tor waits for it")
        check(tor_route.mail(smtplib.SMTP, "smtp.example.org") is smtplib.SMTP, "Other connections stay direct")
        tor_route.configure(True, "127.0.0.1:%d" % closed, {"smtp.example.org": False})
        check(tor_route.mail(smtplib.SMTP, "smtp.example.org") is smtplib.SMTP, "A mailbox that turned Tor off connects directly")
        check(tor_route.mail(smtplib.SMTP, "imap.other.example") is tor_route.SMTP, "The rest go through Tor")
        # Mark data: only a connection that really goes through Tor gets "tor".
        check(tor_route.route("irc", ["irc.example.org"], True) == "tor", "Through Tor")
        check(tor_route.route("irc", ["irc.example.org"], False) == "wait", "Waiting for Tor")
        check(tor_route.route("email", ["smtp.example.org"], True) == "direct", "Not through Tor")
        check(tor_route.route("xmpp", ["example.org"], True) == "wait", "XMPP waits on FluidMessages Web, never marked")
        check(tor_route.route("irc", ["192.168.1.5"], True) == "direct", "Your own network is never marked")
        entry = tor_route.connection("email", {"imap_host": "imap.mail.example", "smtp_host": "smtp.mail.example"}, "me@mail.example")
        check(entry["route"] == "wait" and entry["words"] == "Waiting for Tor" and entry["on"] and entry["allowed"], "Mailbox mark data")
        xmpp = tor_route.connection("xmpp", {"jid": "kit@example.org"}, "example.org")
        check(not xmpp["allowed"] and xmpp["why"] == tor_route.XMPP_SWITCH and xmpp["route"] != "tor", "XMPP's switch is disabled")
    finally:
        tor_route.configure(False, tor_route.DEFAULT_PROXY, {})
    sys.path.remove(str(ROOT / "server"))
    # The browser's rules, run on their own in Node: the same decisions and words, and the onion only while routed.
    tor_js = (ROOT / "server/tor.js").read_bytes()
    block = re.search(rb"// tor-chat:start[^\n]*\n(.*?)// tor-chat:end", tor_js, re.S)
    check(block and b"function torMark()" in tor_js and b"api('tor/connection'" in tor_js and b"head.append(torMark())" in tor_js
          and b"Connect through Tor" in tor_js, "tor.js is missing the onion, the header mark, or the per-chat switch")
    node = os.environ.get("NODE") or shutil.which("node")
    if node:
        script = block.group(1).decode() + """
const wrong = [];
const expect = (got, want, what) => { if (JSON.stringify(got) !== JSON.stringify(want)) wrong.push([what, got, want]); };
const routed = {route: 'tor', on: true, allowed: true, why: '', where: 'Harbor Net'};
expect(torChatChoice('sms', routed, false), {allowed: false, why: TOR_TEXTS}, 'texts');
expect(torChatChoice('nearby', routed, false), {allowed: false, why: TOR_NEARBY}, 'nearby');
expect(torChatChoice('irc', null, false), {allowed: false, why: TOR_ON_PHONE}, 'a chat this server does not connect');
expect(torChatChoice('matrix', routed, true), {allowed: false, why: TOR_E2EE}, 'encrypted matrix');
expect(torChatChoice('xmpp', {allowed: false, why: 'XMPP waits'}, false), {allowed: false, why: 'XMPP waits'}, 'server reason');
expect(torChatChoice('irc', routed, false), {allowed: true, why: ''}, 'irc');
expect(torScope('Harbor Net'), 'Also applies to other chats on Harbor Net', 'scope');
expect(torMarked({allowed: true}, 'tor'), true, 'marked');
expect(torMarked({allowed: true}, 'wait'), false, 'waiting is not marked');
expect(torMarked({allowed: false}, 'tor'), false, 'texts are never marked');
expect(SAMPLE_TOR['sample:irc'], true, 'the sample shows the onion');
expect(TOR_WORDS, {tor: 'Through Tor', wait: 'Waiting for Tor', direct: 'Not through Tor'}, 'words');
process.stdout.write(JSON.stringify(wrong));
"""
        result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
        check(result.returncode == 0 and result.stdout == "[]", "tor.js's per-chat rules are wrong: " + (result.stdout or result.stderr)[:600])
    else:
        print("Skipped running tor.js's rules: node isn't installed (set NODE to its path)")
    # The API: the snapshot's mark data per account, and the per-chat switch, which is saved and can't apply to XMPP.
    # Its Tor proxy is a closed port, so a Tor already running on this computer doesn't change the answers.
    with companion(free_port(), secrets.token_urlsafe(32), extra_env={"FLUID_TOR_PROXY": "127.0.0.1:%d" % free_port()}) as (_, request, _process):
        request("/api/protocols/accounts", {"protocol": "email", "fields": {"address": "me@example.test", "imap_host": "imap.example.test",
                "imap_password": "fixture-secret", "smtp_host": "smtp.example.test"}})
        request("/api/protocols/accounts", {"protocol": "xmpp", "fields": {"jid": "kit@chat.example.test", "password": "fixture-secret"}})
        tor = request("/api/protocols", {})["tor"]
        email = next(ident for ident in tor if ident.startswith("email:"))
        xmpp = next(ident for ident in tor if ident.startswith("xmpp:"))
        check(tor[email]["route"] == "direct" and tor[email]["on"] is False and tor[email]["allowed"], "Tor is off for a new mailbox")
        check(tor[xmpp]["allowed"] is False and "XMPP" in tor[xmpp]["why"], "XMPP's switch says why it can't")
        chosen = request("/api/tor/connection", {"account": email, "on": True})
        check(chosen["on"] is True and chosen["route"] == "wait" and chosen["where"] == "me@example.test",
              "One mailbox through Tor waits while no Tor proxy answers, and never connects without it: " + json.dumps(chosen))
        check(request("/api/tor")["on"] is False and request("/api/tor")["chosen"] == 2, "The setting stays off; both mail servers chose Tor")
        check(request("/api/protocols", {})["tor"][email]["on"] is True, "The choice is kept")
        for bad in ({"account": xmpp, "on": True}, {"account": "email:nobody@example.test", "on": True}, {"account": email, "on": "yes"}):
            try:
                request("/api/tor/connection", bad)
                raise RuntimeError("Accepted a Tor choice it can't apply: " + json.dumps(bad))
            except HTTPError as error:
                check(error.code == 400, "A Tor choice it can't apply is refused plainly")
        request("/api/tor/connection", {"account": email, "on": False})
        check(request("/api/tor")["chosen"] == 0, "Turning it back off follows the setting again")
    print("PASS  Tor per chat: decision table, per-connection choice, mark data, the switch API, and tor.js's rules")


def find_apk(explicit):
    if explicit:
        return explicit.resolve()
    if GRADLE_APK.is_file():
        return GRADLE_APK
    builds = sorted((ROOT / "dist").glob("FluidMessages-*-debug.apk"), key=lambda path: path.stat().st_mtime)
    return builds[-1] if builds else None


def check_apk(apk):
    with zipfile.ZipFile(apk) as archive:
        check({"AndroidManifest.xml", "classes.dex"} <= set(archive.namelist()), "APK is missing its manifest or DEX")
        check(archive.testzip() is None, "APK failed its ZIP integrity check")
    print(f"PASS  APK archive integrity and structure ({apk.name})")


def android(args):
    if args.build:
        wrapper = ROOT / "gradlew"
        gradle = str(wrapper) if wrapper.is_file() else shutil.which("gradle")
        check(gradle, "Gradle is missing. See CONTRIBUTING.md for Android build prerequisites.")
        subprocess.run([gradle, "assembleDebug"], cwd=ROOT, check=True)
    apk = find_apk(args.apk)
    if apk:
        check_apk(apk)
    elif args.install:
        raise RuntimeError("No debug APK is available. Build one with --build or provide --apk.")
    else:
        print("SKIP  APK check (no debug APK found)")
    if args.install:
        adb = shutil.which("adb")
        check(adb, "adb is missing")
        command = [adb, "-s", args.serial] if args.serial else [adb]
        subprocess.run([*command, "install", "-r", str(apk)], check=True)
        subprocess.run([*command, "shell", "am", "start", "-W", "-n", PACKAGE + "/.MainActivity"], check=True)
        print("PASS  APK installed and launcher activity started")


def demo(no_browser):
    token = secrets.token_hex(24)
    with companion(free_port(), token) as (origin, request, process):
        request("/api/sync", {"messages": sample_messages()})
        # Like the desktop app: the token rides in the # part, which never leaves the browser, and the page swaps it
        # for a session cookie. The demo's token is throwaway, so the link is safe to print.
        link = f"{origin}/#token={token}"
        print(f"Open {link}", flush=True)
        print("Sample data only. Press Ctrl+C to close the demo and clear its data.", flush=True)
        if not no_browser:
            webbrowser.open(link)
        result = process.wait()
        check(result == 0, f"Companion exited with status {result}")


def phone_reach_and_access_test():
    """The address a phone types (main.phone_reach) and, over plain http, every /api endpoint still asking for a
    session, the pairing token in a header, or this computer; wrong tokens wait per address."""
    sys.path.insert(0, str(ROOT / "server"))
    import main as server
    reach = server.phone_reach("127.0.0.1:8080", False, bind="0.0.0.0", port=8080, local_only=False, container=False,
                               addresses=["192.168.1.20", "100.64.1.2"])
    check([item["url"] for item in reach["addresses"]] == ["http://192.168.1.20:8080", "http://100.64.1.2:8080"]
          and [item["kind"] for item in reach["addresses"]] == ["wifi", "private"] and reach["listening"], "LAN addresses: " + repr(reach))
    reach = server.phone_reach("192.168.1.20:8080", False, bind="0.0.0.0", port=8080, local_only=False, container=False,
                               addresses=["192.168.1.20"])
    check([item["url"] for item in reach["addresses"]] == ["http://192.168.1.20:8080"], "The page's own address was listed twice")
    reach = server.phone_reach("messages.example.net", True, bind="127.0.0.1", port=8080, local_only=False, container=False)
    check(reach["addresses"] == [{"url": "https://messages.example.net", "kind": "page"}] and not reach["listening"],
          "A proxy's https address should be the one shown: " + repr(reach))
    for bind, local_only, container in (("127.0.0.1", False, False), ("0.0.0.0", True, False), ("0.0.0.0", False, True)):
        reach = server.phone_reach("localhost:8080", False, bind=bind, port=8080, local_only=local_only, container=container,
                                   addresses=["192.168.1.20"])
        check(reach["addresses"] == [], f"An address the phone can't reach was shown ({bind}, {local_only}, {container})")
    for host in ("<b>x</b>", "evil.example/path", "a b", "localhost:8080", "127.0.0.1", "[::1]:8080", "app.localhost"):
        check(server.phone_reach(host, False, bind="127.0.0.1")["addresses"] == [], "Host shown as an address: " + host)
    check(all(any(ip.startswith(prefix) for prefix in ("10.", "172.", "192.168.", "100.")) for ip in server.lan_ipv4()),
          "lan_ipv4 listed an address outside home and private networks")

    token = secrets.token_hex(32)
    with companion(free_port(), token) as (origin, request, _):
        opener = build_opener(ProxyHandler({}))

        def status(path, method="GET", headers=None, body=None):
            data = json.dumps(body).encode() if body is not None else (b"{}" if method in ("POST", "PUT") else None)
            try:
                with opener.open(Request(origin + path, data=data, method=method,
                                         headers={"Content-Type": "application/json", **(headers or {})}), timeout=10) as response:
                    return response.status
            except HTTPError as error:
                return error.code

        guarded = [("GET", path) for path in ("/api/inbox", "/api/settings", "/api/jobs", "/api/auth/security", "/api/backups",
                                              "/api/contacts", "/api/merge", "/api/privacy", "/api/protocols/accounts",
                                              "/api/stickers", "/api/calls/ice", "/api/running", "/api/protocols/file?id=abc", "/api/backups/s3/latest",
                                              "/api/preview?url=https%3A%2F%2Fexample.com", "/api/gifs?q=cat")]
        guarded += [("POST", path) for path in ("/api/sync", "/api/schedule", "/api/claim", "/api/settings", "/api/auth/pairing",
                                                "/api/auth/password", "/api/erase", "/api/privacy/private/lock", "/api/merge",
                                                "/api/protocols/upload", "/api/auth/local-access")]
        guarded += [("PUT", "/api/backups/s3")]
        for method, path in guarded:
            got = status(path, method, headers={"X-Fluid-Request": "1"})
            check(got in (401, 403), f"{method} {path} answered {got} without signing in over http")
        # The phone's token only counts in the Authorization header, never in the address.
        for path in ("/api/inbox?token=" + token, "/api/inbox?access_token=" + token, "/api/settings?authorization=Bearer%20" + token):
            check(status(path) in (401, 403, 404), "A token in the address was accepted: " + path.split("?")[0])
        check(status("/api/inbox", headers={"Cookie": "fluid-session=" + token}) == 401, "The token worked as a cookie")
        check(status("/api/inbox", headers={"Authorization": "Bearer " + token}) == 200, "The pairing token stopped working over http")
        # The address this page was opened at is the one to show; on 127.0.0.1 only, no network address is.
        reach = request("/api/auth/security")["reach"]
        check(reach["addresses"] == [] and not reach["listening"] and reach["https"] is False, "127.0.0.1 reach: " + repr(reach))
        reach = request("/api/auth/security", extra_headers={"Host": "192.168.1.20:8080"})["reach"]
        check(reach["addresses"] == [{"url": "http://192.168.1.20:8080", "kind": "page"}], "Page address: " + repr(reach))
        # Wrong tokens: that address waits after five (429), other addresses and the real phone keep going.
        stranger = {"X-Forwarded-For": "198.51.100.23"}
        for _ in range(5):
            check(status("/api/inbox", headers={**stranger, "Authorization": "Bearer " + "0" * 64}) == 401, "A wrong token wasn't refused")
        check(status("/api/inbox", headers={**stranger, "Authorization": "Bearer " + "0" * 64}) == 429, "Wrong tokens aren't rate-limited")
        check(status("/api/inbox", headers={**stranger, "Authorization": "Bearer " + token}) == 429, "A waiting address got in")
        check(status("/api/inbox", headers={"Authorization": "Bearer " + token}) == 200, "Someone else's wrong tokens locked out the phone")
        # Sign-in over plain http still checks the page's own header and origin, and its cookie stays HttpOnly and Strict.
        check(status("/api/auth/token", "POST", body={"token": token}) == 403, "Sign-in worked without the page's own header")
        check(status("/api/auth/token", "POST", headers={"X-Fluid-Request": "1", "Sec-Fetch-Site": "cross-site"}, body={"token": token}) == 403,
              "Another site could sign in over http")
        with opener.open(Request(origin + "/api/auth/token", data=json.dumps({"token": token}).encode(), method="POST",
                                 headers={"Content-Type": "application/json", "X-Fluid-Request": "1"}), timeout=10) as response:
            flags = set((response.headers.get("Set-Cookie") or "").split("; "))
        check({"HttpOnly", "SameSite=Strict"} <= flags and "Secure" not in flags, "Cookie flags over http: " + repr(flags))

    companion_js = (ROOT / "server/companion.js").read_text()
    welcome_js = (ROOT / "server/welcome.js").read_text()
    guide = (ROOT / "docs/self-hosting.md").read_text()
    check("function phoneAddressCard" in companion_js and "phoneAddressCard(security.reach)" in welcome_js
          and "phoneAddressCard(current.reach)" in companion_js, "The pairing steps don't show the address to type")
    check("innerHTML" not in companion_js[companion_js.index("function phoneAddressCard"):companion_js.index("function phoneConnect")],
          "The address card builds HTML from the server's answer")
    check("same Wi-Fi" in companion_js and "FLUID_BIND=0.0.0.0" in companion_js and "#reach-it-from-outside-your-home" in companion_js,
          "The address card is missing its plain-words help")
    for old in ("Your phone needs an https:// address", "Your phone needs HTTPS", "over HTTPS (a reverse proxy"):
        check(old not in companion_js + welcome_js, "Still says https is required: " + old)
    check("## HTTPS and connecting your phone" in guide and "### Reach it from outside your home" in guide
          and "Tailscale" in guide and "reverse_proxy 127.0.0.1:8080" in guide and "Port forwarding" in guide,
          "docs/self-hosting.md is missing the connecting guide")
    print("PASS  phone address: LAN, private network, and page addresses with the port; none when only this computer can reach it")
    print("PASS  access over http: every sampled /api endpoint asks to sign in, no token in the address, wrong tokens wait, CSRF and cookie flags hold")


def companion_tls_test():
    """FluidMessages Web's own certificate (companion_tls.py): made once with the key private, served on the second
    port, the fingerprint in the answer matches the certificate the port really shows, and the pairing QR code
    (companion.js pairPayload) carries that fingerprint, the token, and the https:// addresses."""
    import base64
    import hashlib
    import ssl
    import stat
    sys.path.insert(0, str(ROOT / "server"))
    import companion_tls
    import main as server
    check(companion_tls.tls_port(8080, "") == 8081 and companion_tls.tls_port(8080, "0") == 0
          and companion_tls.tls_port(8080, "off") == 0 and companion_tls.tls_port(8080, "9443") == 9443, "FLUID_TLS_PORT rules")
    # Packaged desktop apps hand openssl the system library path, not their bundled one (PyInstaller's _ORIG copies).
    saved = {name: os.environ.get(name) for name in ("LD_LIBRARY_PATH", "LD_LIBRARY_PATH_ORIG", "DYLD_LIBRARY_PATH")}
    try:
        os.environ.update(LD_LIBRARY_PATH="/tmp/_MEIbundle", LD_LIBRARY_PATH_ORIG="/opt/lib", DYLD_LIBRARY_PATH="/tmp/_MEIbundle")
        sys.frozen = True
        env = companion_tls.system_env()
        check(env.get("LD_LIBRARY_PATH") == "/opt/lib" and "DYLD_LIBRARY_PATH" not in env and "LD_LIBRARY_PATH_ORIG" not in env,
              "openssl would run with the packaged app's libraries: " + repr({k: env.get(k) for k in saved}))
        del sys.frozen
        check(companion_tls.system_env().get("LD_LIBRARY_PATH") == "/tmp/_MEIbundle", "A source run should keep its library path")
    finally:
        if hasattr(sys, "frozen"):
            del sys.frozen
        for name, value in saved.items():
            if value is None:
                os.environ.pop(name, None)
            else:
                os.environ[name] = value
    with tempfile.TemporaryDirectory(prefix="fluid-tls-") as folder:
        made = companion_tls.ensure(folder)
        if made is None:
            print("Skipped the HTTPS port checks: the openssl command isn't installed")
            return
        cert, key = made
        check(stat.S_IMODE(os.stat(key).st_mode) == 0o600, "The certificate's key can be read by others")
        again = companion_tls.ensure(folder)
        check(again == made and companion_tls.fingerprint(cert) == companion_tls.fingerprint(again[0]), "A second start made a new certificate")
        check(re.fullmatch(r"([0-9A-F]{2}:){31}[0-9A-F]{2}", companion_tls.fingerprint(cert)), "Fingerprint format")
    tls = {"port": 8081, "fingerprint": "AB:" * 31 + "CD"}
    reach = server.phone_reach("127.0.0.1:8080", False, bind="0.0.0.0", port=8080, local_only=False, container=False,
                               addresses=["192.168.1.20"], tls=tls)
    check(reach["addresses"] == [{"url": "https://192.168.1.20:8081", "kind": "wifi", "pinned": True}] and reach["tls"] == tls,
          "With HTTPS on, the phone's LAN address should be https:// on its port: " + repr(reach))
    reach = server.phone_reach("nas.example:8080", False, bind="0.0.0.0", port=8080, local_only=False, container=True, tls=tls)
    check(reach["addresses"] == [{"url": "https://nas.example:8081", "kind": "page", "pinned": True}], "Page address with HTTPS on: " + repr(reach))
    reach = server.phone_reach("messages.example.net", True, bind="127.0.0.1", port=8080, local_only=False, container=False, tls=tls)
    check(reach["addresses"] == [{"url": "https://messages.example.net", "kind": "page"}], "A proxy's address isn't the pinned certificate's")

    token = secrets.token_hex(32)
    tls_port = free_port()
    with companion(free_port(), token, extra_env={"FLUID_TLS_PORT": str(tls_port)}) as (origin, request, process):
        cert_file = request.directory / companion_tls.CERT_NAME
        key_file = request.directory / companion_tls.KEY_NAME
        for _ in range(50):
            try:
                with socket.create_connection(("127.0.0.1", tls_port), timeout=2):
                    break
            except OSError:
                time.sleep(0.05)
        check(cert_file.exists() and stat.S_IMODE(key_file.stat().st_mode) == 0o600, "The server didn't make its certificate, or its key isn't private")
        context = ssl.create_default_context()
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE
        with socket.create_connection(("127.0.0.1", tls_port), timeout=5) as raw, context.wrap_socket(raw) as conn:
            served = hashlib.sha256(conn.getpeercert(binary_form=True)).hexdigest()
        on_disk = hashlib.sha256(ssl.PEM_cert_to_DER_cert(cert_file.read_text())).hexdigest()
        check(served == on_disk, "The HTTPS port shows a different certificate than the one in the data folder")
        opener = build_opener(ProxyHandler({}), __import__("urllib.request").request.HTTPSHandler(context=context))
        with opener.open(Request(f"https://127.0.0.1:{tls_port}/api/inbox", headers={"Authorization": "Bearer " + token}), timeout=5) as response:
            check(response.status == 200, "The pairing token doesn't work on the HTTPS port")
        with opener.open(Request(f"https://127.0.0.1:{tls_port}/"), timeout=5) as response:
            check(b"FluidMessages" in response.read(), "The HTTPS port doesn't serve the app")
        # Plain http keeps working the same.
        check(b"FluidMessages" in request("/", authorized=False), "The http port stopped working with HTTPS on")
        reach = request("/api/auth/security", extra_headers={"Host": "192.168.1.20:8080"})["reach"]
        check(reach["tls"]["port"] == tls_port and reach["tls"]["fingerprint"].replace(":", "").lower() == on_disk
              and reach["addresses"] == [{"url": "https://192.168.1.20:%d" % tls_port, "kind": "page", "pinned": True}],
              "The pairing info doesn't match the certificate: " + repr(reach))
        check(key_file.read_text().strip() not in json.dumps(reach), "The key reached the page")

    node = os.environ.get("NODE") or shutil.which("node")
    companion_js = (ROOT / "server/companion.js").read_text()
    block = re.search(r"// pair-payload:start[^\n]*\n(.*?)// pair-payload:end", companion_js, re.S)
    check(block, "companion.js has no pairing payload")
    if not node:
        print("Skipped running the pairing QR code payload: node isn't installed (set NODE to its path)")
    else:
        script = (ROOT / "server/qr.js").read_text() + "\n" + block.group(1) + """
const [reach, token] = JSON.parse(process.argv[1]);
const fits = (text) => { try { qrMatrix(text); return true; } catch (error) { return false; } };
const many = {...reach, addresses: [...reach.addresses, ...Array.from({length: 12}, (_, i) => ({url: 'https://192.168.7.' + (100 + i) + ':' + reach.tls.port, kind: 'wifi', pinned: true}))]};
process.stdout.write(JSON.stringify({text: pairPayload(reach, token, 'http://192.168.1.20:8080', fits),
  proxy: pairPayload(reach, token, 'https://messages.example.net', fits), none: pairPayload(reach, '', '', fits),
  long: pairPayload(many, token, 'https://messages.example.net', fits), longFits: fits(pairPayload(many, token, 'https://messages.example.net', fits))}));
"""
        result = subprocess.run([node, "-e", script, json.dumps([reach, token])], capture_output=True, text=True, timeout=30)
        check(result.returncode == 0, "The pairing payload didn't run: " + result.stderr[:400])
        made = json.loads(result.stdout)
        from urllib.parse import parse_qs, urlsplit
        link = urlsplit(made["text"])
        fields = parse_qs(link.query)
        fingerprint = base64.urlsafe_b64decode(fields["f"][0] + "=").hex()
        check(link.scheme == "fluidmessages" and link.netloc == "pair" and fields["t"] == [token]
              and fields["a"] == ["192.168.1.20:%d" % tls_port] and "o" not in fields and fingerprint == on_disk,
              "The QR code's payload is wrong: " + made["text"].replace(token, "<token>"))
        check(parse_qs(urlsplit(made["proxy"]).query).get("o") == ["https://messages.example.net"], "The page's https:// origin isn't in the QR code")
        check(made["none"] is None, "A QR code was made without a pairing token")
        long_fields = parse_qs(urlsplit(made["long"]).query)
        check(made["longFits"] and long_fields["a"][0] == "192.168.1.20:%d" % tls_port and long_fields["t"] == [token],
              "With many addresses the QR code should drop the last ones and still fit")
    welcome_js = (ROOT / "server/welcome.js").read_text()
    check("value ? pairingQr(current.reach, value)" in companion_js and "token && security.reach ? pairingQr(security.reach, token)" in welcome_js
          and "Scan this with FluidMessages on your phone. Or type these in." in companion_js
          and "fingerprintBlock(security.reach)" in welcome_js and "copyBlock('Port'" in companion_js,
          "The QR code should show only with a fresh token, above the address, port, token, and fingerprint")
    check("'/qr.js'" in (ROOT / "server/sw.js").read_text() and 'src="/qr.js"' in (ROOT / "server/index.html").read_text(),
          "qr.js isn't loaded or cached")
    gradle = (ROOT / "app/build.gradle").read_text()
    check("com.google.zxing:core" in gradle and "androidx.camera:camera-camera2" in gradle
          and "play-services" not in gradle and "mlkit" not in gradle, "The scanner should use CameraX and ZXing only")
    scan = (ROOT / "app/src/main/kotlin/org/fluidmessages/PairScanScreen.kt").read_text()
    activity = (ROOT / "app/src/main/java/org/fluidmessages/MainActivity.java").read_text()
    check("Dialog" not in scan and "startPairScan" in activity and "CAMERA_PERMISSION" in activity
          and 'render("pairScan")' in activity, "The scanner should be a full page that asks for the camera when tapped")
    for name in ("CloudBackup.java", "SyncJob.java", "GatewayClient.java"):
        java = (ROOT / "app/src/main/java/org/fluidmessages" / name).read_text()
        check("CompanionTls.open(prefs" in java and 'URL(origin + "/api' not in java and 'URL(root + "/api' not in java,
              name + " opens FluidMessages Web without the certificate pin")
    guide = (ROOT / "docs/self-hosting.md").read_text()
    check("FLUID_TLS_PORT" in guide and "fingerprint" in guide and "QR code" in guide, "docs/self-hosting.md is missing the QR pairing")
    print("PASS  phone HTTPS: own certificate made once with a private key, served on the second port, QR payload has the served fingerprint")
def omemo_test():
    """OMEMO for XMPP: trust rules, fingerprints, xmpp: links, and the lock color always; with the optional OMEMO
    modules installed, two in-process devices, saved messages from an independent implementation, limits, the
    encrypted store, and the XMPP glue. Fictional addresses and keys only."""
    sys.path.insert(0, str(ROOT / "server"))
    import omemo_trust as rules
    key = "05" + "ab12cd34" * 8
    check(rules.fingerprint_groups(key) == ["ab12cd34"] * 8 and rules.fingerprint_text("AB12 CD34" * 8).count(" ") == 7,
          "OMEMO fingerprints are not 8 groups of 8 hex characters")
    uri = rules.xmpp_uri("maya@example.test", [(1234, "ab12cd34" * 8)])
    check(uri == "xmpp:maya@example.test?omemo-sid-1234=" + "ab12cd34" * 8, "The xmpp: link is not in Conversations' format")
    check(rules.parse_xmpp_uri("xmpp:Maya@Example.test?message;omemo-sid-1234=" + "AB12CD34" * 8 + ";omemo-sid-x=1")
          == ("maya@example.test", {1234: "ab12cd34" * 8}), "An xmpp: link with fingerprints was not read")
    check(rules.parse_xmpp_uri("https://example.test") is None and rules.parse_xmpp_uri("xmpp:no-at-sign") is None,
          "Something that isn't an xmpp: address was read as one")
    check(rules.verify_from_uri(uri, "maya@example.test", {1234: key, 99: key}) == ([1234], [])
          and rules.verify_from_uri(uri, "maya@example.test", {1234: "05" + "00" * 32}) == ([], [1234]),
          "Scanning an xmpp: link doesn't match devices by fingerprint")
    check(rules.first_use([]) == rules.BLIND and rules.first_use([rules.BLIND]) == rules.BLIND
          and rules.first_use([rules.VERIFIED, rules.BLIND]) == rules.UNCONFIRMED,
          "New devices aren't blindly trusted before a verification, and held for your OK after one")
    check(rules.trusted(rules.BLIND) and rules.trusted(rules.VERIFIED) and not rules.trusted(rules.UNCONFIRMED)
          and not rules.trusted(rules.DISTRUSTED), "Only trusted and verified devices get locked messages")
    green = {"available": True, "devices": 2, "trusted": 2}
    check(rules.lock(green)[0] == "green" and "only you and the people you're talking to" in rules.lock(green)[1],
          "A chat locked for all trusted devices isn't green")
    for state in ({}, {**green, "available": False}, {**green, "devices": 0}, {**green, "plain": True},
                  {**green, "trusted": 0}, {**green, "failed": 1}, {**green, "group": True, "group_ok": False}):
        check(rules.lock(state)[0] == "yellow", "A chat that isn't fully locked doesn't show the yellow lock: %r" % state)
    check(rules.lock({**green, "group": True, "group_ok": True})[0] == "green", "A members-only group locked for everyone isn't green")
    import xmpp_omemo
    if not xmpp_omemo.available():
        print("PASS  OMEMO trust rules, fingerprints, xmpp: links, and lock colors")
        print("SKIP  OMEMO encryption checks (omemo, doubleratchet, x3dh, and xeddsa are not installed)")
        return
    import asyncio
    import xml.etree.ElementTree as ET
    import omemo_legacy as legacy

    class Network:
        def __init__(self, nodes, outbox, jid):
            self.nodes, self.outbox, self.jid = nodes, outbox, jid
        async def publish(self, node, element):
            self.nodes[(self.jid, node)] = ET.tostring(element)
        async def fetch(self, bare_jid, node):
            raw = self.nodes.get((bare_jid, node))
            return None if raw is None else ET.fromstring(raw)
        async def delete(self, node):
            self.nodes.pop((self.jid, node), None)
        async def send(self, bare_jid, element):
            self.outbox.append((self.jid, bare_jid, ET.tostring(element)))

    async def devices():
        nodes, outbox = {}, []
        maya = await xmpp_omemo.Omemo("maya@example.test", Network(nodes, outbox, "maya@example.test"),
                                      storage=xmpp_omemo.MemoryStorage(), max_skipped=20).start()
        leo = await xmpp_omemo.Omemo("leo@example.test", Network(nodes, outbox, "leo@example.test"),
                                     storage=xmpp_omemo.MemoryStorage(), max_skipped=20).start()
        await maya.history_done()
        await leo.history_done()
        element, report = await maya.encrypt({"leo@example.test"}, "Coffee at ten?")
        raw = ET.tostring(element).decode()
        check('prekey="true"' in raw and "Coffee" not in raw and report["devices"] == 1,
              "The first OMEMO message isn't a key exchange, or it carries readable text")
        opened = await leo.decrypt("maya@example.test", element)
        check(opened["text"] == "Coffee at ten?" and opened["trust"] == rules.BLIND, "Leo's device didn't open Maya's key exchange")
        check(any(sender == "leo@example.test" for sender, _, _ in outbox), "Leo's device didn't answer the key exchange")
        for sender, _, raw in outbox:
            heartbeat = await maya.decrypt(sender, ET.fromstring(raw))
            check(heartbeat["error"] == "" and heartbeat["text"] is None, "The key exchange answer didn't open")
        outbox.clear()
        element, _ = await leo.encrypt({"maya@example.test"}, "See you there")
        check(ET.tostring(element).decode().count('prekey="true"') == 0, "An answer on an open session is a key exchange")
        check((await maya.decrypt("leo@example.test", element))["text"] == "See you there", "Maya didn't open Leo's answer")
        replay = await maya.decrypt("leo@example.test", element)
        check(replay["text"] is None and replay["error"] == "failed", "A replayed OMEMO message opened twice")
        # Skipped-message limit: a message that skips more keys than allowed fails plainly, and the session still works.
        for count in range(25):
            far, _ = await leo.encrypt({"maya@example.test"}, "skip %d" % count)
        check((await maya.decrypt("leo@example.test", far))["error"] == "failed",
              "A message skipping more keys than the limit was opened")
        listed = await maya.devices("leo@example.test")
        check(len(listed) == 1 and len(listed[0]["fingerprint"]) == 8, "Leo's device isn't listed with its fingerprint")
        check(await maya.set_trust("leo@example.test", listed[0]["id"], rules.VERIFIED)
              and (await maya.devices("leo@example.test"))[0]["trust"] == rules.VERIFIED, "Marking a device verified didn't stick")
        # No OMEMO devices: refused, so the caller sends plain text with a notice.
        try:
            await maya.encrypt({"sam@example.test"}, "Hello")
            check(False, "A message to someone without OMEMO was 'locked'")
        except xmpp_omemo.OmemoUnavailable:
            pass
        # A tampered key element fails plainly instead of crashing.
        element, _ = await maya.encrypt({"leo@example.test"}, "One more")
        for key_element in element.iter("{%s}key" % legacy.NAMESPACE):
            data = bytearray(__import__("base64").b64decode(key_element.text))
            data[-3] ^= 1
            key_element.text = __import__("base64").b64encode(bytes(data)).decode()
        broken = await leo.decrypt("maya@example.test", element)
        check(broken["text"] is None and broken["error"] == "failed", "A tampered OMEMO key didn't fail plainly")

    async def vectors():
        """Messages made by an independent legacy OMEMO implementation (saved once; see the file's "about")."""
        saved = json.loads((ROOT / "app/src/test/resources/omemo/legacy-vectors.json").read_text(encoding="utf-8"))
        case, sender = saved["cases"]["key_exchange"], saved["oracle_bundle"]
        nodes, outbox = {}, []
        nodes[(sender["jid"], legacy.bundle_node(sender["device_id"]))] = sender["bundle"].encode()
        nodes[(sender["jid"], legacy.DEVICE_LIST_NODE)] = ET.tostring(legacy.serialize_device_list({sender["device_id"]: None}))
        storage = xmpp_omemo.MemoryStorage()
        storage.data = json.loads(json.dumps(case["storage"]))
        own = await xmpp_omemo.Omemo(case["own_jid"], Network(nodes, outbox, case["own_jid"]), storage=storage).start()
        await own.history_done()
        used = next(iter(legacy.parse_message(ET.fromstring(case["message"]), case["sender"], case["own_jid"],
                                              own.device_id).keys))[1].pre_key_id
        first = await own.decrypt(case["sender"], ET.fromstring(case["message"]))
        check(first["text"] == case["plaintext"], "A saved key exchange from another OMEMO implementation didn't open")
        for followup in case["followups"]:
            check((await own.decrypt(case["sender"], ET.fromstring(followup["message"])))["text"] == followup["plaintext"],
                  "A saved message from another OMEMO implementation didn't open")
        bundle = legacy.parse_bundle(ET.fromstring(nodes[(case["own_jid"], legacy.bundle_node(own.device_id))]),
                                     case["own_jid"], own.device_id)
        check(all(pre_key_id != used for pre_key_id in bundle.pre_key_ids.values())
              and len(bundle.pre_key_ids) == 100, "The used prekey wasn't removed and replaced in the republished bundle")
        normal = saved["cases"]["normal"]
        storage = xmpp_omemo.MemoryStorage()
        storage.data = json.loads(json.dumps(normal["storage"]))
        later = await xmpp_omemo.Omemo(normal["own_jid"], Network(nodes, outbox, normal["own_jid"]), storage=storage).start()
        await later.history_done()
        check((await later.decrypt(normal["sender"], ET.fromstring(normal["message"])))["text"] == normal["plaintext"],
              "A saved normal message (after the key exchange) from another OMEMO implementation didn't open")

    asyncio.run(devices())
    asyncio.run(vectors())
    # The store on disk is encrypted, private, and reloads.
    with tempfile.TemporaryDirectory() as folder:
        store = xmpp_omemo.EncryptedFileStorage(Path(folder) / "omemo-store")
        asyncio.run(store.store("/fixture", "fictional secret value"))
        blob = (Path(folder) / "omemo-store" / "omemo.json.enc").read_bytes()
        check(b"fictional secret value" not in blob and b"/fixture" not in blob, "The OMEMO store isn't encrypted on disk")
        check(os.stat(Path(folder) / "omemo-store" / "omemo.key").st_mode & 0o077 == 0, "The OMEMO store key isn't private")
        again = xmpp_omemo.EncryptedFileStorage(Path(folder) / "omemo-store")
        check(again.data.get("/fixture") == "fictional secret value", "The OMEMO store didn't reload")
    print("PASS  OMEMO: two devices exchange locked messages, saved messages from another implementation open,"
          " replays and tampering fail plainly, skipped keys are limited, and the store is encrypted")
    try:
        import slixmpp  # noqa: F401
    except ImportError:
        print("SKIP  OMEMO XMPP glue (slixmpp is not installed)")
        return
    omemo_glue_test()


def omemo_glue_test():
    """FluidMessages Web's XMPP connection with OMEMO, with the network replaced by an in-process stand-in: locked
    one-to-one messages both ways, the green lock, plain fallback with a notice and the yellow lock, the Security
    list, a new device held for your OK after verifying, and a broken message shown as a plain notice."""
    import asyncio
    import xml.etree.ElementTree as ET
    import slixmpp
    from slixmpp.plugins.xep_0060 import stanza as pubsub_stanza
    import xmpp_client
    import omemo_legacy as legacy

    class FakeIq:
        def __init__(self, condition):
            self.condition = condition
        def __getitem__(self, key):
            return {"condition": self.condition, "text": "", "type": "cancel"} if key == "error" else None

    async def main():
        loop = asyncio.get_running_loop()
        nodes, clients = {}, {}

        def make(jid, omemo_dir):
            got, events = [], []
            xc = xmpp_client.XmppClient({"jid": jid, "password": "x"}, lambda *a: got.append(a), [],
                                        on_event=lambda *a: events.append(a), omemo_store=omemo_dir)
            client = slixmpp.ClientXMPP(jid, "x")
            for plugin in ("xep_0030", "xep_0004", "xep_0060", "xep_0163", "xep_0334", "xep_0461", "xep_0444", "xep_0066", "xep_0184", "xep_0203", "xep_0359", "xep_0045"):
                client.register_plugin(plugin)
            bare = slixmpp.JID(jid).bare
            def deliver(stanza, *args, **kwargs):
                to = stanza["to"].bare
                stanza["from"] = jid + "/web"
                copy = slixmpp.Message(xml=ET.fromstring(ET.tostring(stanza.xml)))
                target = clients.get(to)
                if target is not None:
                    loop.call_soon(target.received, copy)
            client.send = deliver
            ps = client.plugin["xep_0060"]
            async def publish(j, node, id=None, payload=None, options=None, **kw):
                nodes[(bare, node)] = ET.tostring(payload)
            async def get_items(j, node, max_items=None, **kw):
                raw = nodes.get((j, node))
                if raw is None:
                    raise xmpp_client.IqError(FakeIq("item-not-found"))
                iq = client.Iq()
                item = pubsub_stanza.Item()
                item["id"] = "current"
                item["payload"] = ET.fromstring(raw)
                iq["pubsub"]["items"]["node"] = node
                iq["pubsub"]["items"].append(item)
                return iq
            async def delete_node(j, node, **kw):
                nodes.pop((bare, node), None)
            ps.publish, ps.get_items, ps.delete_node = publish, get_items, delete_node
            xc.client, xc.loop = client, loop
            xc.ready.set()
            clients[bare] = xc
            return xc, got, events

        with tempfile.TemporaryDirectory() as tmp:
            maya, maya_got, maya_events = make("maya@example.test", tmp + "/m")
            leo, leo_got, leo_events = make("leo@example.test", tmp + "/l")
            plain, plain_got, _ = make("sam@example.test", None)  # No OMEMO on this side.
            await maya.after_start(0)
            await leo.after_start(0)
            sent = await loop.run_in_executor(None, maya.send, "leo@example.test", "Coffee at ten?")
            await asyncio.sleep(0.5)
            check(maya.was_locked(sent), "Maya's message to Leo went with OMEMO")
            check(leo_got and leo_got[-1][2] == "Coffee at ten?" and leo_got[-1][6]["omemo"]["trust"] == "blind",
                  "Leo's FluidMessages Web opened it (trusted on first use)")
            await loop.run_in_executor(None, leo.send, "maya@example.test", "See you there")
            await asyncio.sleep(0.5)
            check(maya_got[-1][2] == "See you there", "Maya opened Leo's answer")
            color = [e for e in maya_events if e[0] == "omemo_state" and e[1] == "leo@example.test"][-1][2]["color"]
            check(color == "green", "Maya's chat with Leo shows the green lock")
            # Plain fallback with a notice and a yellow lock.
            sent = await loop.run_in_executor(None, maya.send, "sam@example.test", "Hello Sam")
            await asyncio.sleep(0.3)
            check(not maya.was_locked(sent) and plain_got[-1][2] == "Hello Sam", "A contact without OMEMO gets plain text")
            notices = [e for e in maya_events if e[0] == "omemo_notice" and e[1] == "sam@example.test"]
            state = [e for e in maya_events if e[0] == "omemo_state" and e[1] == "sam@example.test"][-1][2]
            check(len(notices) == 1 and state["color"] == "yellow", "…with a notice in the chat and the yellow lock")
            # Security list: fingerprints in groups of 8, verify one device.
            info = await loop.run_in_executor(None, maya.omemo_devices, "leo@example.test")
            device = info["people"][0]["devices"][0]
            check(len(device["fingerprint"]) == 8 and all(len(g) == 8 for g in device["fingerprint"]), "Fingerprints in 8 groups of 8")
            check(info["own"]["devices"][0]["this"] and info["uri"].startswith("xmpp:maya@example.test?omemo-sid-"), "Own device and xmpp: link listed")
            await loop.run_in_executor(None, maya.omemo_trust, "leo@example.test", "leo@example.test", device["id"], "verified")
            # Leo gets a new device (new install): Maya must OK it now that she verified one.
            leo2_dir = tmp + "/l2"
            clients.pop("leo@example.test")
            leo2, leo2_got, _ = make("leo@example.test", leo2_dir)
            await leo2.after_start(0)
            maya.omemo.checked.clear()
            await loop.run_in_executor(None, maya.send, "leo@example.test", "Still on?")
            await asyncio.sleep(0.5)
            check(not leo2_got or "couldn" in leo2_got[-1][2] or "other devices" in leo2_got[-1][2],
                  "A new unconfirmed device of Leo's doesn't get the message (shows a plain notice instead)")
            check(any(e[0] == "omemo_notice" and "new device" in e[2]["text"] for e in maya_events), "Maya is told Leo has a new device")
            # Garbage never crashes and shows a plain notice.
            bad = slixmpp.Message()
            bad["from"], bad["to"], bad["type"] = "leo@example.test/x", "maya@example.test", "chat"
            enc = ET.SubElement(bad.xml, "{%s}encrypted" % legacy.NAMESPACE)
            header = ET.SubElement(enc, "{%s}header" % legacy.NAMESPACE, {"sid": "1"})
            ET.SubElement(header, "{%s}key" % legacy.NAMESPACE, {"rid": str(maya.omemo.device_id)}).text = "AAAA"
            ET.SubElement(header, "{%s}iv" % legacy.NAMESPACE).text = "AAAAAAAAAAAAAAAA"
            before = len(maya_got)
            maya.received(bad)
            await asyncio.sleep(0.3)
            check(len(maya_got) == before + 1 and maya_got[-1][2].startswith("🔒") and maya_got[-1][6]["omemo"]["error"],
                  "A broken locked message shows a plain notice")
    


    import logging
    logging.getLogger("slixmpp").setLevel(logging.ERROR)
    asyncio.run(main())
    print("PASS  OMEMO in the XMPP connection: locked chats both ways, green and yellow locks, plain-text notices,"
          " fingerprints, new devices held after verifying, and broken messages")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--demo", action="store_true", help="open a temporary browser demo after smoke checks")
    parser.add_argument("--no-browser", action="store_true", help="print the demo URL without opening a browser")
    parser.add_argument("--build", action="store_true", help="compile a fresh debug APK with Gradle")
    parser.add_argument("--apk", type=Path, help="use a specific existing APK")
    parser.add_argument("--install", action="store_true", help="install and launch the APK on an ADB target")
    parser.add_argument("--serial", help="ADB device or emulator serial")
    args = parser.parse_args()
    try:
        smoke_test()
        sign_in_test()
        local_access_test()
        two_step_test()
        erase_test()
        web_privacy_test()
        cloud_smoke_test()
        gateway_relations_test()
        reaction_revisions_test()
        reactions_test()
        email_quotes_test()
        privacy_calls_test()
        protocol_accounts_test()
        email_ports_test()
        multi_account_test()
        unique_chats_test()
        chat_features_test()
        server_directory_test()
        account_setup_test()
        communities_test()
        requests_test()
        merge_test()
        merge_items_test()
        new_conversations_test()
        web_contacts_test()
        web_gaps_test()
        sample_onboarding_test()
        onboarding_followups_test()
        web_parity_test()
        meeting_links_test()
        irc_calls_and_nickserv_test()
        irc_join_requirements_test()
        phone_reach_and_access_test()
        companion_tls_test()
        tor_test()
        quick_setup_test()
        running_status_test()
        omemo_test()
        android(args)
        if args.demo:
            demo(args.no_browser)
    except KeyboardInterrupt:
        return 130
    except (OSError, RuntimeError, ValueError, subprocess.CalledProcessError, zipfile.BadZipFile) as error:
        print(f"FAIL  {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
