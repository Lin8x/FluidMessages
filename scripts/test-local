def chat_notice_test(cards_js, app_js, style_css):
    """The browser recognizes the phone's chat setting notices and draws them as outlined notes, not bubbles."""
    block = re.search(rb"// chat-notice:start[^\n]*\n(.*?)// chat-notice:end", cards_js, re.S)
    check(block, "cards.js has no chat setting notice parser")
    check(b"parseChatNotice" in app_js and re.search(rb"#conversation > \.event\.notice \{[^}]*border: 1px solid", style_css),
          "Chat setting notices aren't drawn as outlined notes")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("Skipped running the chat notice parser: node isn't installed (set NODE to its path)")
        return
    script = block.group(1).decode() + """
const cases = JSON.parse(process.argv[1]);
const wrong = cases.filter(([text, expected]) => JSON.stringify(parseChatNotice(text)) !== JSON.stringify(expected));
for (const seconds of [0, 30, 300, 3600, 28800, 86400, 604800, 2419200]) {
  const back = parseChatNotice(timerNoticeText(seconds));
  if (!back || back.seconds !== seconds) wrong.push(['timer', seconds]);
}
if (parseChatNotice(encryptionNoticeText(true))?.on !== true || parseChatNotice(encryptionNoticeText(false))?.on !== false) wrong.push(['encryption']);
for (const text of [timerNoticeText(86400), timerNoticeText(0), encryptionNoticeText(true), encryptionNoticeText(false)]) {
  // Sent with a line for other apps; FluidMessages shows only the note.
  const label = chatNoticeLabel(parseChatNotice(text));
  if (!text.includes('\\n\\n') || label.includes('\\n') || label.includes('github.com') || !text.startsWith(label + '\\n\\n')) wrong.push(['label', text]);
}
if (!encryptionNoticeText(true).includes("You'll need FluidMessages to read encrypted messages")) wrong.push(['encryption footer']);
process.stdout.write(JSON.stringify(wrong));
"""
    result = subprocess.run([node, "-e", script, json.dumps(CHAT_NOTICES, ensure_ascii=False)], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0 and result.stdout == "[]", "The browser's chat notice parser disagrees with the phone's: "
          + (result.stdout or result.stderr)[:400])


def connection_marks_test(connections_js, servers_js):
    """The inbox's connection mark beside IRC, Matrix, and XMPP tags, the bar's words, and Remove channel on the web."""
    block = re.search(rb"// connection-state:start[^\n]*\n(.*?)// connection-state:end", connections_js, re.S)
    check(block, "connections.js has no connection state rules")
    # The mark sits beside the tag and is never an unread-style dot; switches are read out as switches.
    check(b"connectionMark(state)" in connections_js and b"'role', 'switch'" in connections_js
          and b"autoReconnectToggle(account)" in connections_js and b"connectionSection(account.id)" in servers_js
          and b"protocols/disconnect" in connections_js and b"openConnections()" in connections_js
          and b"'Remove ' + noun" in servers_js
          and b"route.group || route.server_chat" in servers_js, "The connection mark, switches, Remove, or server chats are missing")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("Skipped running the connection state rules: node isn't installed (set NODE to its path)")
        return
    script = block.group(1).decode() + """
const wrong = [];
const expect = (got, want, what) => { if (got !== want) wrong.push([what, got, want]); };
expect(connectionState('connected'), 'connected', 'connected');
expect(connectionState('reconnecting'), 'connecting', 'waiting to try again');
expect(connectionState('paused'), 'disconnected', 'paused by the hourly limit');
expect(connectionState(''), 'disconnected', 'nothing known yet still shows a mark');
expect(connectionState('off'), 'off', 'the service is off on the server');
expect(connectionState('disconnected', true), 'off', 'turned off by you');
expect(CONNECTION_LABELS.off, 'Turned off', 'turned off reads out as text');
expect(connectionSummary({state: 'connected'}, 'Harbor Net', 'kit'), 'Connected to Harbor Net as kit', 'the details say who you are');
expect(connectionSummary({state: 'disconnected', error: 'The connection to Harbor Net dropped.'}, 'Harbor Net', 'kit'),
  'Not connected to Harbor Net · The connection to Harbor Net dropped.', 'the details say why');
expect(connectionSummary({state: 'disconnected', manual: true}, 'Harbor Net', 'kit'), 'Turned off · Tap Connect to connect to Harbor Net', 'off');
expect(connectionSummary({state: 'reconnecting'}, 'Harbor Net', ''), 'Connecting to Harbor Net…', 'connecting');
expect(connectionWords({state: 'disconnected', error: 'Harbor Net only lets registered nicknames connect'}, 'Harbor Net'),
  'Disconnected from Harbor Net · Harbor Net only lets registered nicknames connect', 'the network reason reaches the bar');
expect(connectionWords({state: 'disconnected', manual: true}, 'Harbor Net'), 'Not connected to Harbor Net · Turned off until you connect', 'off');
expect(connectionWords({state: 'connecting', manual: true}, 'Harbor Net'), 'Connecting to Harbor Net…', 'connecting after Reconnect');
expect(SAMPLE_CONNECTIONS['sample:matrix'], 'disconnected', 'the sample shows a server that is not connected');
expect(CONNECTION_LABELS.disconnected, 'Not connected', 'the mark reads out as text');
process.stdout.write(JSON.stringify(wrong));
"""
    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0 and result.stdout == "[]", "The connection mark rules are wrong: " + (result.stdout or result.stderr)[:600])


def from_account_test(servers_js, app_js, companion_js):
    """The web composer's "From:" line shows only with two accounts on a service, and names the chat's own account."""
    block = re.search(rb"// from-account:start[^\n]*\n(.*?)// from-account:end", servers_js, re.S)
    check(block, "servers.js has no From account rules")
    check(b"updateFromLine()" in app_js and b"function updateFromLine" in servers_js and b"showModal" not in servers_js.split(b"function updateFromLine", 1)[1].split(b"\n}\n", 1)[0] and b"inboxAccountHint(routeFor(key)" in app_js,
          "The web composer or inbox doesn't show which account sends")
    check(b"field('From', account" in companion_js and b"preselectFrom(mine" in companion_js and b"Most recently used" not in companion_js,
          "New chat has no From picker preselected to the most recent account")
    # Sending names only the chat (address and protocol); the server sends through that chat's own account.
    send = re.search(rb"async function send\(.*?\n}\n", app_js, re.S)
    check(send and b"account" not in send.group(0), "The web composer picks an account itself instead of the chat's own")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("Skipped running the From account rules: node isn't installed (set NODE to its path)")
        return
    script = block.group(1).decode() + """
const wrong = [];
const one = [{protocol: 'email', id: 'email:alice@example.test', name: 'alice@example.test'},
             {protocol: 'matrix', id: 'matrix:@alice:example.test', name: '@alice:example.test'}];
const two = [...one, {protocol: 'email', id: 'email:alice@work.example.test', name: 'alice@work.example.test', recent: true}];
const work = {address: 'web-1', protocol: 'email', target: 'maya@example.test', account: 'email:alice@work.example.test'};
const home = {address: 'web-2', protocol: 'email', target: 'sam@example.test', account: 'email:alice@example.test'};
const old = {address: 'web-3', protocol: 'email', target: 'lee@example.test'};
const room = {address: 'web-4', protocol: 'matrix', target: '!r:example.test', account: 'matrix:@alice:example.test'};
const expect = (got, want, what) => { if (got !== want) wrong.push([what, got, want]); };
expect(fromLineText(work, one), '', 'one account shows no From');
expect(fromLineText(old, one), '', 'one account, older link');
expect(fromLineText(work, two), 'From: alice@work.example.test', 'the chat names its own account');
expect(fromLineText(home, two), 'From: alice@example.test', 'the first account');
expect(fromLineText(old, two), 'From: alice@example.test', 'an older link is the first account');
expect(fromLineText(room, two), '', 'a service with one account stays quiet');
expect(fromLineText({...work, account: 'email:gone@example.test'}, two), '', 'a removed account is not guessed');
expect(preselectFrom(sendAccounts('email', two)), 'email:alice@work.example.test', 'New chat preselects the most recent');
expect(preselectFrom(sendAccounts('email', two.map((a) => ({...a, recent: false})))), 'email:alice@work.example.test', 'else the newest');
expect(inboxAccountHint(work, two), 'alice@work.example.test', 'the inbox hints another account');
expect(inboxAccountHint(home, two), '', 'not the first account');
expect(inboxAccountHint(work, one), '', 'not with one account');
expect(targetKey('irc', '#Radio[Club]'), targetKey('irc', '#radio{club}'), 'IRC folds case by RFC 1459');
expect(targetKey('matrix', '!AbC:Example.org'), '!AbC:example.org', 'a Matrix room ID keeps its case');
expect(targetKey('email', 'Maya@Example.TEST'), 'maya@example.test', 'email ignores case');
process.stdout.write(JSON.stringify(wrong));
"""
    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0 and result.stdout == "[]", "The web's From account rules are wrong: " + (result.stdout or result.stderr)[:400])
    print("PASS  web From line: shown only with two accounts on a service, naming the chat's own account, which sends")


def web_people_test(request):
    """The Calls tab like the phone's Phone tab, the contacts list and contact pages, favorites, and sample photos."""
    people_js = request("/people.js", authorized=False)
    for expected in (b"function showPhoneTab", b"function knownPeople", b"function openPersonPage", b"function keypadView",
                     b"function openMemberContact", b"'Favorites'", b"'Recents'", b"'Contacts'", b"Text instead"):
        check(expected in people_js, f"Missing {expected.decode()} in /people.js")
    check(b"/people.js" in request("/", authorized=False), "The page doesn't load people.js")
    check(b"showPhoneTab" in request("/companion.js", authorized=False), "The Calls tab doesn't draw the phone-style sections")
    check(b"openMemberContact" in request("/chats.js", authorized=False), "A group member doesn't open their contact page")
    shell = request("/sw.js", authorized=False)
    for path in ("/people.js", "/samples/maya.webp", "/samples/jordan.webp"):
        check(path.encode() in shell, f"The offline cache leaves out {path}")
        if path.endswith(".webp"):
            picture = request(path, authorized=False)
            check(picture[:4] == b"RIFF" and picture[8:12] == b"WEBP", f"{path} isn't the sample WebP portrait")
            check(picture == (ROOT / "app/src/main/res/drawable-nodpi" / ("sample_" + Path(path).name)).read_bytes(),
                  f"{path} differs from the phone's sample portrait")
    check(b"COPY samples/" in (ROOT / "server/Dockerfile").read_bytes(), "The Docker image leaves out the sample portraits")
    # Favorites are kept for every browser, by number or chat address, and only as short plain text.
    favorites = ["+12025550123", "web-fixture"]
    check(request("/api/settings", {"web_favorites": favorites + ["+12025550123"]})["web_favorites"] == favorites, "Favorites weren't saved")
    check(request("/api/inbox")["web_favorites"] == favorites, "The inbox doesn't carry favorites")
    for bad in ("+12025550123", [5], ["x" * 301], ["line\nbreak"], [""]):
        try:
            request("/api/settings", {"web_favorites": bad})
            raise RuntimeError("Invalid favorites were accepted: " + json.dumps(bad))
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for invalid favorites, got {error.code}")
    check(request("/api/settings", {"web_favorites": []})["web_favorites"] == [], "Favorites couldn't be cleared")
    # Counts on the tabs: on by default, a server preference, and drawn white on red on both tab bars.
    for expected in (b"function updateTabBadges", b"setAppBadge", b"clearAppBadge", b"function tabCountsCard", b"markCallsSeen"):
        check(expected in people_js, f"Missing {expected.decode()} in /people.js")
    check(b"tabCountsCard" not in request("/settings.js", authorized=False), "Show counts on tabs is still under Settings → Messaging")
    check(b"tabCountsCard()" in request("/notify.js", authorized=False), "Settings → Sounds and notifications has no App badges card")
    check(re.search(rb"\.tab-badge \{[^}]*color: #fff", request("/features.css", authorized=False)), "Tab counts aren't white on their fill")
    check(request("/api/inbox")["prefs"].get("tabCounts") is True, "Counts on tabs aren't on by default")
    check(request("/api/settings", {"prefs": {"tabCounts": False}})["prefs"]["tabCounts"] is False, "Counts on tabs couldn't be turned off")
    check(request("/api/settings", {"prefs": {"tabCounts": True}})["prefs"]["tabCounts"] is True, "Counts on tabs couldn't be turned back on")
    web_inbox_sounds_test(request)


def web_inbox_sounds_test(request):
    """The inbox filter's Unread, Settings → Sounds and notifications, notifications through the service worker,
    and New chat's People and Channels."""
    index = request("/", authorized=False).decode()
    options = re.search(r'<select id="folder"[^>]*>(.*?)</select>', index, re.S)
    check(options and re.findall(r"<option>([^<]+)</option>", options.group(1)) == ["Inbox", "Unread", "Archived", "Blocked"],
          "The inbox filter doesn't offer Inbox, Unread, Archived, and Blocked in that order")
    check(index.index('class="folder-filter"') > index.index('id="inbox-title"') and index.index('class="folder-filter"') < index.index('id="threads"'),
          "The inbox filter left the top of the inbox")
    check("/notify.js" in index, "The page doesn't load notify.js")
    people_js, app_js, chats_js = (request(path, authorized=False).decode() for path in ("/people.js", "/app.js", "/chats.js"))
    check("function unreadIncoming" in people_js and "unreadIncoming(message, quiet, now)" in people_js.split("function countTabs", 1)[1],
          "The Chats tab count and Unread don't share one rule")
    check("unreadChats()" in app_js and "unread.has(address)" in app_js
          and "case 'unread': return !!chat.unread" in request("/inbox-filters.js", authorized=False).decode(),
          "The inbox filter's Unread isn't drawn from the unread rule")
    check(len(re.findall(r"'(?:Leo Park|Kestrel)', 0\)", chats_js)) == 2, "The sample inbox has no unread chats to try Unread with")
    notify_js = request("/notify.js", authorized=False).decode()
    for expected in ("registration.showNotification", "Notification.requestPermission", "isSecureContext", "Send a test notification",
                     "Show names and message text in notifications", "Sounds for muted chats", "decoyLike", "sampleOn", "watchingChat",
                     "fluid-open-chat", "push notifications", "Allowed", "Blocked", "Not asked"):
        check(expected in notify_js, f"Missing {expected} in /notify.js")
    # Permission is asked only from a click: every requestPermission is inside askNotifyPermission, which only buttons call.
    check(notify_js.count("Notification.requestPermission") == 2 and notify_js.count("await askNotifyPermission()") == 2
          and all("addEventListener('click'" in notify_js[max(0, m.start() - 400):m.start()]
                  for m in re.finditer(r"await askNotifyPermission\(\)", notify_js)),
          "Notification permission is asked outside a click")
    shell = request("/sw.js", authorized=False).decode()
    check("'/notify.js'" in shell and "notificationclick" in shell and "postMessage" in shell and "openWindow" in shell,
          "The service worker doesn't cache notify.js or open the chat from a notification")
    check("?chat=" not in shell and "#chat=" not in shell, "The notification puts the chat in the address")
    settings_js = request("/settings.js", authorized=False).decode()
    look_group = settings_js.split("['Look and feel', [", 1)[1].split("]],", 1)[0]
    check("title: 'Sounds and notifications'" in look_group and "id: 'sounds'" in look_group,
          "Sounds and notifications isn't in Look and feel")
    look_js = request("/look.js", authorized=False).decode()
    check("out.gain.value = .16 * volume / 100" in look_js, "The volume doesn't scale the Web Audio gain")
    check("lookChoice('Outgoing sound'" not in look_js and "Motion and haptics" in look_js, "Sounds are still on the appearance page")
    check("notifyIncoming(loud, played)" in look_js, "New messages don't reach the notifications")
    servers_js, companion_js = (request(path, authorized=False).decode() for path in ("/servers.js", "/companion.js"))
    check("function newChatChannels" in servers_js and "Join or browse…" in servers_js and "openAddServer()" in servers_js
          and "No servers yet" in servers_js, "New chat has no Channels list")
    check("[[form, 'People'], [channels, 'Channels']]" in companion_js, "New chat has no People and Channels switch")
    # Sound choices, volume, and muted-chat sounds are saved and cleaned; old keys keep working.
    sounds = {"theme": "fluid", "mode": "system", "sendSound": "pop", "receiveSound": "ding", "soundVolume": 40, "mutedSounds": True}
    check(request("/api/settings", {"web_appearance": sounds})["web_appearance"] == sounds, "Sound choices weren't saved")
    noisy = {**sounds, "sendSound": "airhorn", "soundVolume": 150, "mutedSounds": "yes"}
    check(request("/api/settings", {"web_appearance": noisy})["web_appearance"] == {"theme": "fluid", "mode": "system", "receiveSound": "ding"},
          "Invalid sound choices were kept")
    old = {"theme": "fluid", "mode": "system", "sendSound": "silent", "receiveSound": "fluid"}
    check(request("/api/settings", {"web_appearance": old})["web_appearance"] == old, "The older sound choices stopped working")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("Skipped running the unread rule and theme switching: node isn't installed (set NODE to its path)")
        return
    # Switching or resetting a theme keeps the sound choices (look.js themeLook), and the unread rule leaves out
    # muted, archived, blocked, private, expired, and call rows (people.js).
    theme = re.search(r"const THEME_KEYS = .*?\n(?=/\*\* The look settings)", look_js, re.S).group(0)
    rule = re.search(r"/\*\* Chats that never count.*?(?=function countTabs)", people_js, re.S).group(0)
    script = theme + rule + """
let sampleOn = false, sampleChats = {}, webChats = {muted: ['m'], archived: ['a'], blocked: ['b']}, appearance = {folders: {archived: ['pa']}};
const privateFolderHas = (address) => address === 'p';
const threadKey = (message) => message.address;
const row = (address, extra = {}) => ({address, type: 1, read: 0, body: 'Fictional', ...extra});
let inbox = [row('u'), row('m'), row('a'), row('b'), row('pa'), row('p'), row('r', {read: 1}), row('o', {type: 2}),
  row('x', {expires: 1}), row('c', {event: 'call', body: 'Voice call · missed'})];
const wrong = [];
if (JSON.stringify([...unreadChats()]) !== '["u"]') wrong.push('unread ' + JSON.stringify([...unreadChats()]));
sampleOn = true; sampleChats = {muted: ['u']};
if (unreadChats().size !== 4) wrong.push('sample ' + JSON.stringify([...unreadChats()]));
const look = {theme: 'ember', colors: {sms: '#123456'}, sendSound: 'pop', receiveSound: 'bubble', soundVolume: 30, mutedSounds: true, speed: 0, haptics: 'soft'};
const next = themeLook(look, 'midnight');
for (const key of ['sendSound', 'receiveSound', 'soundVolume', 'mutedSounds', 'speed', 'haptics']) if (next[key] !== look[key]) wrong.push(key);
if (next.colors || next.theme !== 'midnight') wrong.push('theme colors');
process.stdout.write(JSON.stringify(wrong));
"""
    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0 and result.stdout == "[]", "Unread or theme switching is wrong: " + (result.stdout or result.stderr)[:400])


def cloud_smoke_test():
    if not shutil.which("rclone"):
        print("SKIP  Cloud backup fixture test (rclone is not installed)")
        return
    with companion(free_port(), secrets.token_hex(32), cloud_fixtures=True) as (_, request, _):
        check(request("/api/backups")["targets"] == list(CLOUD_TARGETS), "Cloud target discovery failed")
        try:
            request("/api/backups/drive", b"not a backup", method="PUT")
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for an invalid backup, got {error.code}")
        else:
            raise RuntimeError("The server accepted an invalid archive")
        older = b"FMB1\x01older fixture"
        newest = b"FMB1\x01newest fixture"
        for target in CLOUD_TARGETS:
            path = "/api/backups/" + target
            dated = request(path, older, method="PUT")["name"]
            check(re.fullmatch(r"FluidMessages_\d{4}-\d{2}-\d{2}_.+\.fmb", dated), "Missing readable backup date")
            time.sleep(.005)
            request(path, newest, method="PUT")
            check(request(path + "/latest") == newest, f"The latest {target} backup did not round-trip")
            fixed = {"X-Fluid-Backup-Name": "My current backup.fmb"}
            request(path, newest, method="PUT", extra_headers=fixed)
            response = request(path, older, method="PUT", extra_headers=fixed)
            check(response["name"] == fixed["X-Fluid-Backup-Name"], "Fixed name was lost")
            check(request(path + "/latest") == older, "The fixed backup did not get replaced")
        try:
            request("/api/backups/drive", older, method="PUT", extra_headers={"X-Fluid-Backup-Name": "../outside.fmb"})
        except HTTPError as error:
            check(error.code == 400, "Invalid backup name produced the wrong response")
        else:
            raise RuntimeError("The server accepted a backup path instead of a filename")
    print("PASS  Cloud target discovery, dated names, fixed-name replacement, and newest restore across three isolated destinations")


def gateway_relations_test():
    """Replies and reactions use native Matrix and RFC 9078 email features with fictional fixtures."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    from email import policy
    from email.parser import BytesParser
    import protocol_gateway

    with tempfile.TemporaryDirectory(prefix="fluid-gateway-") as directory:
        database = str(Path(directory) / "gateway.sqlite")

        def connect():
            return sqlite3.connect(database)

        with connect() as db:
            db.executescript(protocol_gateway.SCHEMA)
        config = {"matrix": {"homeserver": "https://matrix.example.test", "access_token": "fixture",
                             "user_id": "@me:example.test"},
                  "email": {"address": "me@example.test", "smtp_host": "smtp.example.test", "smtp_password": "x",
                            "imap_host": "imap.example.test", "imap_password": "x"},
                  "routes": [{"address": "maya", "protocol": "matrix", "target": "!room:example.test", "title": "Maya"},
                             {"address": "maya", "protocol": "email", "target": "maya@example.test", "title": "Maya"}]}
        gateway = protocol_gateway.Gateway(connect, config, Path(directory) / "files")
        route = gateway.route("maya", "matrix")
        sent = []

        def fake_matrix(path, body=None, allow_missing=False, method=None):
            if allow_missing:
                return None
            sent.append((path, body))
            return {"event_id": "$out" + str(len(sent))}

        gateway.matrix_request = fake_matrix

        def deliver(message, send):
            # Same bookkeeping as Gateway.sender after a successful send.
            message.update(send(gateway.route("maya", message["protocol"]), message) or {})
            with connect() as db:
                db.execute("UPDATE protocol_messages SET payload=? WHERE id=?", (json.dumps(message), message["id"]))
        gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in1", "sender": "@maya:example.test",
                                      "origin_server_ts": 1, "content": {"msgtype": "m.text", "body": "Coffee at ten?"}})
        incoming = gateway.find("maya", "matrix", "event_id", "$in1")
        check(incoming is not None, "Matrix message did not keep its event ID")

        def enqueue(relation, body, text=""):
            with connect() as db:
                return gateway.enqueue(db, {"address": "maya", "protocol": "matrix", "body": body, "text": text,
                                            "request": secrets.token_hex(8), "relation": relation})["message"]

        reaction = enqueue({"kind": "reaction", "target": incoming["id"], "emoji": "👍"}, "Liked “Coffee at ten?”")
        check(reaction.get("reaction_target") == incoming["id"], "Reaction lost its target")
        deliver(reaction, gateway.send_matrix)
        check(sent[-1][0].startswith("rooms/") and "/send/m.reaction/" in sent[-1][0]
              and sent[-1][1]["m.relates_to"] == {"rel_type": "m.annotation", "event_id": "$in1", "key": "👍"},
              "Matrix reaction was not sent as an annotation")
        reply = enqueue({"kind": "reply", "target": incoming["id"]}, "Reply to “Coffee at ten?”\n\nSure", "Sure")
        deliver(reply, gateway.send_matrix)
        check(sent[-1][1] == {"msgtype": "m.text", "body": "Sure", "m.relates_to": {"m.in_reply_to": {"event_id": "$in1"}}},
              "Matrix reply was not linked natively")
        try:
            enqueue({"kind": "reaction", "target": incoming["id"], "emoji": "hello"}, "Reacted hello")
            raise RuntimeError("Gateway accepted a text reaction")
        except ValueError:
            pass

        gateway.accept_matrix(route, {"type": "m.reaction", "event_id": "$in2", "sender": "@maya:example.test",
                                      "origin_server_ts": 2, "content": {"m.relates_to": {
                                          "rel_type": "m.annotation", "event_id": "$out2", "key": "❤️"}}})
        folded = gateway.find("maya", "matrix", "event_id", "$in2")
        check(folded and folded["reaction_target"] == reply["id"] and folded["body"].startswith("Loved “"),
              "Incoming Matrix reaction did not fold onto the sent reply")
        gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in3", "sender": "@maya:example.test",
                                      "origin_server_ts": 3, "content": {"msgtype": "m.text",
                                      "body": "> <@me:example.test> Sure\n\nGreat",
                                      "m.relates_to": {"m.in_reply_to": {"event_id": "$out2"}}}})
        quoted = gateway.find("maya", "matrix", "event_id", "$in3")
        check(quoted["body"].endswith("\n\nGreat") and quoted["body"].startswith("Reply to “")
              and quoted["reply_target"] == reply["id"], "Incoming Matrix reply kept its legacy fallback")

        mail_route = gateway.route("maya", "email")
        gateway.accept_mail(mail_route, "1", 1, b"From: Maya <maya@example.test>\r\nMessage-ID: <m1@example.test>\r\n"
                            b"Subject: Plans\r\nDate: Mon, 1 Jan 2024 10:00:00 +0000\r\n\r\nSee you there\r\n")
        first = gateway.find("maya", "email", "mail_id", "<m1@example.test>")
        outgoing = []

        class FakeSmtp:
            def __init__(self, *args, **kwargs): pass
            def __enter__(self): return self
            def __exit__(self, *args): return False
            def login(self, *args): pass
            def send_message(self, envelope, **kwargs): outgoing.append(envelope)

        protocol_gateway.smtplib.SMTP_SSL = FakeSmtp
        with connect() as db:
            mail = gateway.enqueue(db, {"address": "maya", "protocol": "email", "body": "Liked “See you there”",
                                        "request": secrets.token_hex(8),
                                        "relation": {"kind": "reaction", "target": first["id"], "emoji": "👍"}})["message"]
        deliver(mail, gateway.send_mail)
        envelope = outgoing[-1]
        check(envelope["In-Reply-To"] == "<m1@example.test>" and envelope.get_content_disposition() == "reaction"
              and envelope.get_content().strip() == "👍" and "FluidMessages" not in envelope.get_content(),
              "Email reaction does not follow RFC 9078")
        gateway.accept_mail(mail_route, "1", 2, b"From: maya@example.test\r\nMessage-ID: <m2@example.test>\r\n"
                            b"In-Reply-To: <m1@example.test>\r\nContent-Type: text/plain; charset=utf-8\r\n"
                            b"Content-Disposition: reaction\r\n\r\n" + "😆".encode() + b"\r\n")
        laughed = gateway.find("maya", "email", "mail_id", "<m2@example.test>")
        check(laughed and laughed["reaction_target"] == first["id"] and laughed["body"].startswith("Laughed at “"),
              "Incoming email reaction did not fold")
        # Attachments: upload, attach, send as Matrix media and an email attachment, and receive both.
        import io
        pdf = b"%PDF-1.4 fixture"
        with connect() as db:
            upload = gateway.store_upload(db, io.BytesIO(pdf), len(pdf), "application/pdf", "plan.pdf")["upload"]
            try:
                gateway.store_upload(db, io.BytesIO(b"x"), protocol_gateway.MAX_FILE + 1, "text/plain", "big.txt")
                raise RuntimeError("Gateway accepted an oversized upload")
            except ValueError:
                pass
            filed = gateway.enqueue(db, {"address": "maya", "protocol": "matrix", "body": "plan.pdf", "text": "",
                                         "request": secrets.token_hex(8),
                                         "attachment": {"upload": upload, "kind": "file"}})["message"]
        check(filed["attachment"]["name"] == "plan.pdf" and gateway.file_path(filed["id"]).read_bytes() == pdf,
              "Uploaded attachment was not moved onto its message")
        uploads = []

        def fake_raw(url, data=None, headers=None, method=None, limit=0):
            uploads.append((url, data, headers))
            return json.dumps({"content_uri": "mxc://example.test/abc"}).encode()

        gateway.matrix_raw = fake_raw
        deliver(filed, gateway.send_matrix)
        check(uploads[-1][1] == pdf and sent[-1][1]["msgtype"] == "m.file" and sent[-1][1]["url"] == "mxc://example.test/abc"
              and sent[-1][1]["filename"] == "plan.pdf", "Matrix file was not sent through the media repository")
        with connect() as db:
            voice_upload = gateway.store_upload(db, io.BytesIO(b"aac"), 3, "audio/mp4", "Voice message")["upload"]
            voice = gateway.enqueue(db, {"address": "maya", "protocol": "matrix", "body": "Voice message", "text": "",
                                         "request": secrets.token_hex(8),
                                         "attachment": {"upload": voice_upload, "kind": "voice", "duration": 4200}})["message"]
        deliver(voice, gateway.send_matrix)
        check(sent[-1][1]["msgtype"] == "m.audio" and "org.matrix.msc3245.voice" in sent[-1][1]
              and sent[-1][1]["info"]["duration"] == 4200, "Voice message was not marked as a Matrix voice note")
        gateway.matrix_download = lambda mxc: b"\x89PNG fixture"
        gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in4", "sender": "@maya:example.test",
                                      "origin_server_ts": 4, "content": {"msgtype": "m.image", "body": "lake.png",
                                      "url": "mxc://example.test/lake", "info": {"mimetype": "image/png", "size": 12}}})
        photo = gateway.find("maya", "matrix", "event_id", "$in4")
        check(photo and photo["attachment"]["kind"] == "photo" and gateway.file_path(photo["id"]).read_bytes() == b"\x89PNG fixture",
              "Incoming Matrix image was not stored")
        with connect() as db:
            mail_upload = gateway.store_upload(db, io.BytesIO(pdf), len(pdf), "application/pdf", "plan.pdf")["upload"]
            mailed = gateway.enqueue(db, {"address": "maya", "protocol": "email", "body": "Here it is", "text": "Here it is",
                                          "request": secrets.token_hex(8), "attachment": {"upload": mail_upload}})["message"]
        deliver(mailed, gateway.send_mail)
        parts = list(outgoing[-1].iter_attachments())
        check(len(parts) == 1 and parts[0].get_filename() == "plan.pdf" and parts[0].get_content() == pdf
              and "Sent with FluidMessages" in outgoing[-1].get_body(("plain",)).get_content(), "Email attachment was not sent")
        raw = (b"From: maya@example.test\r\nMessage-ID: <m3@example.test>\r\nMIME-Version: 1.0\r\n"
               b"Content-Type: multipart/mixed; boundary=b\r\n\r\n--b\r\nContent-Type: text/plain\r\n\r\nMenu attached\r\n"
               b"--b\r\nContent-Type: application/pdf\r\nContent-Disposition: attachment; filename=menu.pdf\r\n"
               b"Content-Transfer-Encoding: base64\r\n\r\nJVBERi0xLjQ=\r\n--b--\r\n")
        gateway.accept_mail(mail_route, "1", 3, raw)
        menu = gateway.find("maya", "email", "mail_id", "<m3@example.test>")
        check(menu and menu["attachment"]["name"] == "menu.pdf" and menu["body"] == "Menu attached"
              and gateway.file_path(menu["id"]).read_bytes() == b"%PDF-1.4", "Incoming email attachment was not stored")
        import matrix_e2ee
        if matrix_e2ee.available():
            # An encrypted image: the companion downloads the ciphertext and decrypts it with the event's key.
            from nio.crypto.attachments import encrypt_attachment
            ciphertext, keys = encrypt_attachment(b"\x89PNG secret fixture")
            gateway.matrix_download = lambda mxc: ciphertext
            gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in5", "sender": "@maya:example.test",
                                          "origin_server_ts": 5, "content": {"msgtype": "m.image", "body": "lake.png",
                                          "file": {**keys, "url": "mxc://example.test/secret"}, "info": {"mimetype": "image/png"}}})
            secret = gateway.find("maya", "matrix", "event_id", "$in5")
            check(secret and gateway.file_path(secret["id"]).read_bytes() == b"\x89PNG secret fixture",
                  "Encrypted Matrix attachment was not decrypted")
            print("PASS  encrypted Matrix attachments decrypt on the companion")
        else:
            print("SKIP  Matrix encryption checks (matrix-nio[e2e] is not installed)")
    print("PASS  companion replies, reactions, and attachments use native Matrix and email features")


def reaction_revisions_test():
    """Removing or changing a reaction is native on Matrix and XMPP, with fictional fixtures."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import protocol_gateway

    with tempfile.TemporaryDirectory(prefix="fluid-revisions-") as directory:
        database = str(Path(directory) / "gateway.sqlite")

        def connect():
            return sqlite3.connect(database)

        with connect() as db:
            db.executescript(protocol_gateway.SCHEMA)
        config = {"matrix": {"homeserver": "https://matrix.example.test", "access_token": "fixture",
                             "user_id": "@me:example.test"},
                  "routes": [{"address": "maya", "protocol": "matrix", "target": "!room:example.test", "title": "Maya"},
                             {"address": "leo", "protocol": "xmpp", "target": "leo@example.test", "title": "Leo"}]}
        gateway = protocol_gateway.Gateway(connect, config, Path(directory) / "files")
        sent, stanzas = [], []

        def fake_matrix(path, body=None, allow_missing=False, method=None):
            if allow_missing:
                return None
            sent.append((path, body))
            return {"event_id": "$out" + str(len(sent))}

        class FakeXmpp:
            def send(self, to, text, group=False, reply=None, reply_author=None, react=None, file=None):
                stanzas.append({"to": to, "text": text, "reply": reply, "react": react})
                return "xout" + str(len(stanzas))

        gateway.matrix_request = fake_matrix
        gateway.client = lambda protocol: FakeXmpp()

        def send(address, protocol, relation, body):
            with connect() as db:
                message = gateway.enqueue(db, {"address": address, "protocol": protocol, "body": body, "text": "",
                                               "request": secrets.token_hex(8), "relation": relation})["message"]
            route = gateway.route(address, protocol)
            message.update({"matrix": gateway.send_matrix, "xmpp": gateway.send_xmpp}[protocol](route, message) or {})
            message["status"] = "Sent"
            with connect() as db:
                db.execute("UPDATE protocol_messages SET payload=? WHERE id=?", (json.dumps(message), message["id"]))
            return message

        route = gateway.route("maya", "matrix")
        gateway.accept_matrix(route, {"type": "m.room.message", "event_id": "$in1", "sender": "@maya:example.test",
                                      "origin_server_ts": 1, "content": {"msgtype": "m.text", "body": "Coffee at ten?"}})
        coffee = gateway.find("maya", "matrix", "event_id", "$in1")
        send("maya", "matrix", {"kind": "reaction", "target": coffee["id"], "emoji": "👍"}, "Liked “Coffee at ten?”")
        first = sent[-1]
        send("maya", "matrix", {"kind": "reaction", "target": coffee["id"], "emoji": "❤️", "previous": "👍"},
             "Changed reaction from 👍 to ❤️ on “Coffee at ten?”")
        check(sent[-2][0].startswith("rooms/") and "/redact/%24out1/" in sent[-2][0] and sent[-2][1] == {}
              and sent[-1][1]["m.relates_to"]["key"] == "❤️" and first[1]["m.relates_to"]["key"] == "👍",
              "Changing a Matrix reaction did not redact the old one and send the new one")
        changed_event = "$out" + str(len(sent))
        count = len(sent)
        removal = send("maya", "matrix", {"kind": "reaction", "target": coffee["id"], "emoji": "❤️", "removed": True},
                       "Removed a heart from “Coffee at ten?”")
        check(len(sent) == count + 1 and "/redact/" + changed_event.replace("$", "%24") + "/" in sent[-1][0]
              and removal.get("reaction_target") == coffee["id"], "Removing a Matrix reaction did not redact it")
        try:
            with connect() as db:
                gateway.enqueue(db, {"address": "maya", "protocol": "matrix", "body": "x", "request": secrets.token_hex(8),
                                     "relation": {"kind": "reaction", "target": coffee["id"], "emoji": "👍",
                                                  "previous": "hello"}})
            raise RuntimeError("Gateway accepted a text previous reaction")
        except ValueError:
            pass
        gateway.accept_matrix(route, {"type": "m.reaction", "event_id": "$in2", "sender": "@maya:example.test",
                                      "origin_server_ts": 2, "content": {"m.relates_to": {
                                          "rel_type": "m.annotation", "event_id": "$in1", "key": "😆"}}})
        gateway.accept_matrix(route, {"type": "m.room.redaction", "event_id": "$in3", "sender": "@maya:example.test",
                                      "origin_server_ts": 3, "redacts": "$in2", "content": {}})
        taken = gateway.find("maya", "matrix", "event_id", "$in3")
        check(taken and taken["body"] == "Removed a laugh from “Coffee at ten?”" and taken["reaction_target"] == coffee["id"],
              "A redacted Matrix reaction was not recorded as a removal")

        gateway.accept_xmpp("leo@example.test", "leo@example.test", "Lunch?", "x1", 1, False, {})
        lunch = gateway.find("leo", "xmpp", "xmpp_id", "x1")
        gateway.accept_xmpp("leo@example.test", "leo@example.test", "", "x2", 2, False, {"reaction": "👍", "reaction_to": "x1"})
        gateway.accept_xmpp("leo@example.test", "leo@example.test", "", "x3", 3, False, {"reaction": "", "reaction_to": "x1"})
        taken = gateway.find("leo", "xmpp", "xmpp_id", "x3")
        check(taken and taken["body"] == "Removed a like from “Lunch?”" and taken["reaction_target"] == lunch["id"],
              "An empty XMPP reaction set was not recorded as a removal")
        send("leo", "xmpp", {"kind": "reaction", "target": lunch["id"], "emoji": "❤️", "previous": "👍"},
             "Changed reaction from 👍 to ❤️ on “Lunch?”")
        check(stanzas[-1]["react"] == ["❤️"] and stanzas[-1]["reply"] == "x1", "Changing an XMPP reaction did not send the new set")
        send("leo", "xmpp", {"kind": "reaction", "target": lunch["id"], "emoji": "❤️", "removed": True},
             "Removed a heart from “Lunch?”")
        check(stanzas[-1]["react"] == [], "Removing an XMPP reaction did not send an empty set")
    print("PASS  removing and changing reactions is native on Matrix and XMPP and recorded from others")


def reactions_test():
    """Reactions sent as a text by iPhones and other Android apps: FluidMessages Web reads the cases the phone's
    ReactionTextsTest.kt reads, folds them onto the same messages, and sends the standard wording for its own."""
    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        index = request("/", authorized=False).decode()
        scripts = re.findall(r'src="(/[^"#?]+)"', index)
        check("/reactions.js" in scripts and scripts.index("/reactions.js") < scripts.index("/app.js"),
              "The page doesn't load reactions.js before app.js")
        check("'/reactions.js'" in request("/sw.js", authorized=False).decode(), "The service worker doesn't cache reactions.js")
        check(b"function parseReaction" in request("/reactions.js", authorized=False), "reactions.js isn't served")
    app_js, notify_js = ((ROOT / "server" / name).read_text() for name in ("app.js", "notify.js"))
    check("function parseReaction" not in app_js and "reactionTarget(parsed, senderKey(message), shown, senderKey)" in app_js,
          "app.js doesn't fold reactions with the shared rules")
    check("reactionNotice(message.author, body)" in notify_js, "Notifications don't word a reaction as a sentence")
    kotlin = (ROOT / "app/src/main/kotlin/org/fluidmessages/MessageInteractions.kt").read_text()
    web_rules = (ROOT / "server/reactions.js").read_text()
    for phrase in ("an image", "a photo", "a picture", "a video", "a movie", "an audio message", "a voice message", "an attachment", "a file"):
        check(f'"{phrase}" to ReactionMedia.' in kotlin and f"['{phrase}', '" in web_rules, f"The phone and the browser don't both read “{phrase}”")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("SKIP  reaction texts in Node: node is missing")
        return
    excerpt = re.search(r"function excerpt\(value, limit\) \{.*?\n\}\n", app_js, re.S).group(0)
    fold = re.search(r"// One reaction per sender: yourself.*?(?=\nfunction threadKey)", app_js, re.S).group(0)
    react = re.search(r"const REACTIONS = .*?(?=\n// A click anywhere else)", app_js, re.S).group(0)
    nouns = re.search(r"const nouns = \{.*?\};\n", app_js, re.S).group(0)
    script = "const rules = require(process.argv[1]);\nObject.assign(globalThis, rules);\n" + excerpt + nouns + fold + react + r"""
const vectors = JSON.parse(require('fs').readFileSync(process.argv[2], 'utf8'));
const wrong = [];
const same = (label, got, want) => { if (JSON.stringify(got) !== JSON.stringify(want)) wrong.push(label + ': ' + JSON.stringify(got)); };
for (const {text, expect} of vectors.parse) same('parse ' + text, parseReaction(text), expect);
for (const [value, expected] of vectors.emoji) same('emoji ' + value, reactionEmoji(value), expected);
// Pictures and files as the companion stores them, and as MMS rows (a photo flag) or with a type alone.
const files = {photo: ['Photo', 'image/jpeg'], video: ['clip.mp4', 'video/mp4'], voice: ['Voice message', 'audio/mp4'],
  audio: ['song.mp3', 'audio/mpeg'], file: ['notes.pdf', 'application/pdf']};
const attach = (kind, bare, name) => !kind ? {} : bare && kind === 'photo' ? {photo: true}
  : {attachment: {...(bare ? {} : {kind}), name: name || files[kind][0], mime: files[kind][1]}};
const row = (message, bare) => ({id: message.id, body: message.body, type: message.from === 'me' ? 2 : 1,
  author: message.from === 'me' ? '' : message.from, status: message.status || '', reaction_target: message.target,
  ...attach(message.media, bare)});
for (const bare of [false, true]) {
  for (const chat of vectors.fold) {
    const shown = fold(chat.messages.map((message) => row(message, bare)));
    same('fold ' + chat.name + (bare ? ' (bare)' : ''), shown.map((message) => ({id: message.id,
      reactions: [...message.reactions].map(([who, emoji]) => [who === 'me' ? 'me' : who.slice(5), emoji])})), chat.shown);
    // Never dropped: a text that isn't a reaction always keeps its bubble.
    for (const message of chat.messages) if (!parseReaction(message.body) && !shown.some((kept) => kept.id === message.id)) wrong.push('dropped ' + message.body);
  }
}
for (const [body, kind, name, words] of vectors.words) {
  same('words ' + body, reactionTargetWords({body, ...attach(kind, false, name)}), words);
  if (kind === 'photo' && !/\.\w+$/.test(body)) same('words (MMS) ' + body, reactionTargetWords({body, photo: true}), words);
}
for (const [who, text, sentence] of vectors.notice) same('notice ' + text, reactionNotice(who, text), sentence);
// What goes out when you react: the standard wording for texts, with a change sent as the new reaction.
const sent = [];
const send = async (body, text, relation) => { sent.push(body); };
const internet = (protocol) => !['sms', 'mms', 'rcs', undefined, ''].includes(protocol);
const playReaction = () => {}, reactionId = () => '', showError = (error) => wrong.push(String(error));
const react = (message, emoji, current) => { reactWith({...message, reactions: new Map(current ? [['me', current]] : [])}, null, emoji); return sent.pop(); };
const theirs = {id: 't1', type: 1, protocol: 'sms', body: 'See you at 7'};
same('send like', react(theirs, '👍'), 'Liked “See you at 7”');
same('send love', react(theirs, '❤️'), 'Loved “See you at 7”');
same('send dislike', react(theirs, '👎'), 'Disliked “See you at 7”');
same('send laugh', react(theirs, '😆'), 'Laughed at “See you at 7”');
same('send emphasis', react(theirs, '‼️'), 'Emphasized “See you at 7”');
same('send question', react(theirs, '❓'), 'Questioned “See you at 7”');
same('send emoji', react(theirs, '😂'), 'Reacted 😂 to “See you at 7”');
same('send removal', react(theirs, '❤️', '❤️'), 'Removed a heart from “See you at 7”');
same('send emoji removal', react(theirs, '😂', '😂'), 'Removed 😂 from “See you at 7”');
same('send change', react(theirs, '❤️', '👍'), 'Loved “See you at 7”');
same('send change to emoji', react({...theirs, protocol: 'mms'}, '😂', '👍'), 'Reacted 😂 to “See you at 7”');
same('send change by email', react({...theirs, protocol: 'email'}, '❤️', '👍'), 'Changed reaction from 👍 to ❤️ on “See you at 7”');
same('send photo', react({...theirs, protocol: 'mms', body: 'Photo', photo: true}, '❤️'), 'Loved an image');
same('send photo removal', react({...theirs, protocol: 'mms', body: 'Photo', photo: true}, '❤️', '❤️'), 'Removed a heart from an image');
same('send own', react({...theirs, type: 2}, '👍'), 'Liked “See you at 7” (my message)');
// Everything sent is read back as the same reaction.
for (const emoji of ['👍', '❤️', '👎', '😆', '‼️', '❓', '😂']) {
  same('round trip ' + emoji, parseReaction(react(theirs, emoji)), {change: 'add', emoji, quote: 'See you at 7', media: null, own: false});
  same('round trip removal ' + emoji, parseReaction(react(theirs, emoji, emoji)), {change: 'remove', emoji, quote: 'See you at 7', media: null, own: false});
}
process.stdout.write(JSON.stringify(wrong));
"""
    result = subprocess.run([node, "-e", script, str(ROOT / "server/reactions.js"), str(ROOT / "app/src/test/resources/reaction-vectors.json")],
                            capture_output=True, text=True, timeout=30)
    check(result.returncode == 0 and result.stdout == "[]", "Reaction texts are read wrong: " + (result.stdout or result.stderr)[:900])
    print("PASS  reaction texts: the six verbs, any emoji, removals, pictures and files, cut and straight quotes, groups, "
          "near misses that stay texts, notifications, and the standard wording sent to texts (the phone's cases)")


def email_quotes_test():
    """Incoming email replies lose the quoted history, with fictional fixtures."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import protocol_gateway

    with tempfile.TemporaryDirectory(prefix="fluid-mail-") as directory:
        database = str(Path(directory) / "gateway.sqlite")

        def connect():
            return sqlite3.connect(database)

        with connect() as db:
            db.executescript(protocol_gateway.SCHEMA)
        config = {"email": {"address": "me@example.test", "smtp_host": "smtp.example.test", "smtp_password": "x",
                            "imap_host": "imap.example.test", "imap_password": "x"},
                  "routes": [{"address": "maya", "protocol": "email", "target": "maya@example.test", "title": "Maya"}]}
        gateway = protocol_gateway.Gateway(connect, config, Path(directory) / "files")
        route = gateway.route("maya", "email")

        def mail(uid, message_id, body, reply_to=""):
            headers = (f"From: Maya <maya@example.test>\r\nMessage-ID: {message_id}\r\nSubject: Plans\r\n"
                       f"Date: Mon, 1 Jan 2024 10:0{uid}:00 +0000\r\n")
            if reply_to:
                headers += f"In-Reply-To: {reply_to}\r\n"
            gateway.accept_mail(route, "1", uid, (headers + "\r\n" + body).encode())
            return gateway.find("maya", "email", "mail_id", message_id)

        first = mail(1, "<m1@example.test>", "Lunch on Friday?")
        check(first["read"] == 0, "A new email arrived already read")
        with connect() as db, db:
            check(gateway.mark_read(db, {"ids": [first["id"]]}) == {"read": 1}, "Reading an email did not mark it read")
        check(gateway.find("maya", "email", "id", first["id"])["read"] == 1, "The read email still shows as unread")
        try:
            with connect() as db:
                gateway.mark_read(db, {"ids": "everything"})
            raise RuntimeError("Gateway accepted an invalid read request")
        except ValueError:
            pass
        second = mail(2, "<m2@example.test>", "hello there\r\n\r\nOn Sun, Nov 22, 2026 at 11:47 PM\r\n"
                      "<me@example.test> wrote:\r\n\r\n> hello\r\n>\r\n> Sent with FluidMessages\r\n>\r\n",
                      "<m1@example.test>")
        check(second["body"] == "hello there" and "reply_target" not in second,
              "An email reply to the latest message kept its quoted history")
        third = mail(3, "<m3@example.test>", "Yes, Friday works\r\n\r\nOn Mon, Maya <maya@example.test> wrote:\r\n> Lunch on Friday?\r\n",
                     "<m1@example.test>")
        check(third["body"] == "Reply to “Lunch on Friday?”\n\nYes, Friday works" and third["reply_target"] == first["id"],
              "An email reply to an older message did not become a reply card")
        with connect() as db, db:
            old = dict(first, id="mail-old", body="Old reply\n\nOn Sun, Maya wrote:\n> earlier", mail_id="<old@example.test>")
            db.execute("INSERT INTO protocol_messages VALUES (?, ?, ?)", ("mail-old", 0, json.dumps(old)))
        gateway.strip_stored_quotes()
        check(gateway.find("maya", "email", "id", "mail-old")["body"] == "Old reply", "Stored emails kept their quoted history")
    print("PASS  incoming email replies drop the quoted history, and reading a message clears it everywhere")


def privacy_calls_test():
    """Hidden chats, disappearing messages, group members, and call relay on the companion, with fictional fixtures."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import protocol_gateway

    with tempfile.TemporaryDirectory(prefix="fluid-privacy-") as directory:
        database = str(Path(directory) / "gateway.sqlite")

        def connect():
            return sqlite3.connect(database)

        with connect() as db:
            db.executescript(protocol_gateway.SCHEMA)
        config = {"matrix": {"homeserver": "https://matrix.example.test", "user_id": "@me:example.test", "access_token": "x"},
                  "routes": [{"address": "maya", "protocol": "matrix", "target": "!maya:example.test", "title": "Maya"},
                             {"address": "club", "protocol": "matrix", "target": "!club:example.test", "title": "Club",
                              "group": True},
                             {"address": "jordan", "protocol": "email", "target": "jordan@example.test", "title": "Jordan"}]}
        gateway = protocol_gateway.Gateway(connect, config, Path(directory) / "files")
        sent = []
        gateway.matrix_request = lambda path, body=None, allow_missing=False, method=None: (
            sent.append((path, body, method)) or {"event_id": "$sent" + str(len(sent))})
        now = gateway.time()
        maya, jordan = gateway.route("maya", "matrix"), gateway.route("jordan", "email")
        gateway.add_incoming(gateway.message(maya, "m-old", "Old news", False, now - 7200_000))
        gateway.add_incoming(gateway.message(maya, "m-new", "Fresh", False, now))
        mine = gateway.message(maya, "m-mine", "Mine", True, now - 7200_000, "Sent")
        mine["event_id"] = "$mine"
        gateway.add_incoming(mine)
        gateway.add_incoming(gateway.message(jordan, "j-1", "Quarterly plans", False, now))
        gateway.add_incoming(gateway.message(maya, "m-before", "From before the timer", False, now - 5 * 3600_000))

        with connect() as db, db:
            gateway.save_settings(db, {"hidden_protocols": ["EMAIL"], "disappearing": {"default": 0, "chats": {"maya": 3600},
                                                                         "since": {"maya": now - 3 * 3600_000}}},
                                  from_phone=True)
            shown = {message["id"] for message in gateway.snapshot(db)["messages"]}
        check("j-1" not in shown, "A protocol hidden on the phone still showed on the companion")
        check("m-old" not in shown and "m-new" in shown, "An expired message still showed, or a fresh one was hidden")
        check(gateway.sweep_expired() == 2, "Expired messages were not deleted")
        check(any(path.startswith("rooms/%21maya%3Aexample.test/redact/%24mine/") for path, _, _ in sent),
              "Your own expired Matrix message was not redacted")
        check(gateway.find("maya", "matrix", "id", "m-new") is not None, "A message within its timer was deleted")
        check(gateway.find("maya", "matrix", "id", "m-before") is not None, "Turning on a timer deleted earlier messages")
        with connect() as db, db:
            gateway.save_settings(db, {"disappearing": {"default": 0, "chats": {"jordan": 60}}})
        check(gateway.sweep_expired() == 0, "A timer set in the browser deleted earlier messages")

        with connect() as db, db:
            gateway.save_settings(db, {"follow_phone": False, "disappearing": {"default": 60, "chats": {}}})
            gateway.save_settings(db, {"disappearing": {"default": 0, "chats": {}}, "hidden_protocols": []}, from_phone=True)
            settings = gateway.settings(db)
        check(settings["disappearing"]["default"] == 60 and settings["hidden_protocols"] == [],
              "Companion settings did not stay its own when not following the phone")
        with connect() as db, db:
            gateway.save_settings(db, {"fluid_encryption": {"protocols": ["sms"], "chats": {"maya": "on"}}}, from_phone=True)
            reset = gateway.save_settings(db, {"reset": True})
        check(reset["disappearing"]["default"] == 0 and reset["follow_phone"] and reset["fluid_encryption"]["chats"] == {"maya": "on"},
              "Resetting companion settings lost the phone's encryption info or kept old timers")
        try:
            with connect() as db:
                gateway.save_settings(db, {"disappearing": {"default": -5, "chats": {}}})
            raise RuntimeError("Companion accepted a negative timer")
        except ValueError:
            pass

        with connect() as db:
            gateway.change_member(db, {"address": "club", "protocol": "matrix", "action": "add", "member": "@sam:example.test"})
            gateway.change_member(db, {"address": "club", "protocol": "matrix", "action": "remove", "member": "@sam:example.test"})
        check(sent[-2][0].endswith("/invite") and sent[-1][0].endswith("/kick") and sent[-1][1]["user_id"] == "@sam:example.test",
              "Inviting or removing a Matrix member did not reach the room")
        for bad in ({"address": "club", "protocol": "matrix", "action": "add", "member": "sam"},
                    {"address": "jordan", "protocol": "email", "action": "add", "member": "x@example.test"},
                    {"address": "club", "protocol": "matrix", "action": "ban", "member": "@sam:example.test"}):
            try:
                with connect() as db:
                    gateway.change_member(db, bad)
                raise RuntimeError("Companion accepted an invalid member change")
            except ValueError:
                pass

        invite = {"type": "m.call.invite", "event_id": "$call", "sender": "@maya:example.test", "origin_server_ts": gateway.time(),
                  "content": {"call_id": "c1", "party_id": "p1", "version": "1", "lifetime": 60000,
                              "offer": {"type": "offer", "sdp": "v=0\r\nm=audio 9 UDP/TLS/RTP/SAVPF 111\r\n"}}}
        gateway.accept_matrix(maya, invite)
        events = gateway.call_events(0)
        check(events["events"][0]["type"] == "m.call.invite" and events["events"][0]["live"], "An incoming call did not ring")
        check(gateway.call_events(events["next"])["events"] == [], "Call events repeated after they were read")
        check(gateway.find("maya", "matrix", "event_id", "$call") is None
              and any(m.get("event") and m["body"].startswith("Voice call") for m in gateway.snapshot(connect())["messages"]),
              "The call was not noted in the conversation")
        gateway.send_call({"address": "maya", "protocol": "matrix", "type": "m.call.answer",
                           "content": {"call_id": "c1", "party_id": "p2", "version": "1", "answer": {"type": "answer", "sdp": "v=0"}}})
        check("/send/m.call.answer/" in sent[-1][0], "Answering a call did not send the Matrix answer event")
        try:
            gateway.send_call({"address": "jordan", "protocol": "email", "type": "m.call.invite", "content": {}})
            raise RuntimeError("Companion relayed a call outside Matrix")
        except ValueError:
            pass
    print("PASS  hidden protocols, disappearing timers, group members, and call signaling on the companion")


def email_ports_test():
    """Email ports: 993 and 465 by default, 1 to 65535, STARTTLS on 143 and 587, and never plain text. No network."""
    sys.path.insert(0, str(ROOT / "server"))
    import accounts
    import protocol_gateway

    base = {"address": "me@example.test", "imap_host": "imap.example.test", "smtp_host": "smtp.example.test",
            "imap_password": "fixture-secret"}
    check("imap_port" not in accounts.validate("email", base), "An account without ports gained ports")
    check(accounts.validate("email", {**base, "imap_port": "143", "smtp_port": 587}) | {} == {
        **base, "imap_port": 143, "smtp_port": 587, "smtp_password": "fixture-secret"}, "Email ports weren't read as numbers")
    for bad in (0, 65536, -1, "abc", "5.5", True):
        for name in ("imap_port", "smtp_port"):
            try:
                accounts.validate("email", {**base, name: bad})
                raise RuntimeError(f"Accepted {name} {bad!r}")
            except ValueError as error:
                check("1 to 65535" in str(error), f"Unclear message for {name} {bad!r}: {error}")
    with tempfile.TemporaryDirectory(prefix="fluid-ports-") as directory:
        store = accounts.AccountStore(Path(directory) / "accounts.json", environ={
            "FLUID_EMAIL_ADDRESS": "me@example.test", "FLUID_EMAIL_IMAP_HOST": "imap.example.test",
            "FLUID_EMAIL_SMTP_HOST": "smtp.example.test", "FLUID_EMAIL_PASSWORD": "fixture-secret",
            "FLUID_EMAIL_IMAP_PORT": "143", "FLUID_EMAIL_SMTP_PORT": "587"})
        email = store.current()["email"]
        check(email["imap_port"] == 143 and email["smtp_port"] == 587, "Compose email ports weren't read")
        listed = json.dumps(store.redacted())
        check("fixture-secret" not in listed and '"imap_port": 143' in listed and '"smtp_port": 587' in listed,
              "Ports should show in the redacted account list, and secrets never")
    compose = (ROOT / "compose.yaml").read_text()
    check("FLUID_EMAIL_IMAP_PORT" in compose and "FLUID_EMAIL_SMTP_PORT" in compose, "compose.yaml leaves out the email ports")
    docs = (ROOT / "docs/self-hosting.md").read_text()
    check("FLUID_EMAIL_IMAP_PORT" in docs and "STARTTLS" in docs, "The self-hosting guide doesn't explain the email ports")

    calls = []

    class Fake:
        def __init__(self, kind, host, port, *args, starttls=True, **kwargs):
            self.kind, self.offers = kind, starttls
            calls.append([kind, host, port])
        def __enter__(self): return self
        def __exit__(self, *args): return False
        def ehlo(self): calls[-1].append("ehlo")
        def has_extn(self, name): return self.offers and name == "starttls"
        def starttls(self, **kwargs):
            if not self.offers:
                raise imap_error("STARTTLS not supported")
            calls[-1].append("starttls")
        def close(self): calls[-1].append("closed")
        def shutdown(self): calls[-1].append("closed")

    saved = (protocol_gateway.smtplib.SMTP_SSL, protocol_gateway.smtplib.SMTP,
             protocol_gateway.imaplib.IMAP4_SSL, protocol_gateway.imaplib.IMAP4)
    offers = {"value": True}
    imap_error = protocol_gateway.imaplib.IMAP4.error
    protocol_gateway.smtplib.SMTP_SSL = lambda host, port, **kw: Fake("smtp-tls", host, port)
    protocol_gateway.smtplib.SMTP = lambda host, port, **kw: Fake("smtp", host, port, starttls=offers["value"])
    protocol_gateway.imaplib.IMAP4_SSL = lambda host, port, **kw: Fake("imap-tls", host, port)
    protocol_gateway.imaplib.IMAP4 = lambda host, port, **kw: Fake("imap", host, port, starttls=offers["value"])
    try:
        gateway = protocol_gateway.Gateway.__new__(protocol_gateway.Gateway)
        gateway.tls = None
        gateway.smtp_connection(base)
        gateway.imap_connection(base)
        check(calls == [["smtp-tls", "smtp.example.test", 465], ["imap-tls", "imap.example.test", 993]],
              f"An account without ports didn't use TLS on 465 and 993: {calls}")
        calls.clear()
        gateway.smtp_connection({**base, "smtp_port": 587})
        gateway.imap_connection({**base, "imap_port": 143})
        check(calls == [["smtp", "smtp.example.test", 587, "ehlo", "starttls", "ehlo"], ["imap", "imap.example.test", 143, "starttls"]],
              f"Ports 587 and 143 didn't upgrade with STARTTLS: {calls}")
        gateway.imap_connection({**base, "imap_port": 1993})
        check(calls[-1][0] == "imap-tls", "IMAP on another port should use TLS from the start")
        offers["value"] = False
        for connect, port in ((gateway.smtp_connection, {"smtp_port": 587}), (gateway.imap_connection, {"imap_port": 143})):
            calls.clear()
            try:
                connect({**base, **port})
                raise ValueError("Connected without STARTTLS")
            except (RuntimeError, imap_error):
                check(calls[-1][-1] == "closed", "A server without STARTTLS wasn't hung up on")
    finally:
        (protocol_gateway.smtplib.SMTP_SSL, protocol_gateway.smtplib.SMTP,
         protocol_gateway.imaplib.IMAP4_SSL, protocol_gateway.imaplib.IMAP4) = saved

    companion_js = (ROOT / "server/companion.js").read_text()
    check("['imap_port', 'IMAP port', '993'" in companion_js and "['smtp_port', 'SMTP port', '465'" in companion_js
          and "EMAIL_PORTS = {imap_port: 993, smtp_port: 465}" in companion_js, "The web email form has no IMAP and SMTP ports")
    form = (ROOT / "app/src/main/kotlin/org/fluidmessages/AccountsScreen.kt").read_text()
    check("EmailPorts.IMAP_KEY" in form and "EmailPorts.SMTP_KEY" in form, "The phone's email form has no IMAP and SMTP ports")
    print("PASS  email ports default to 993 and 465, stay from 1 to 65535, show in account lists, and always use TLS or STARTTLS")


def protocol_accounts_test():
    """Account storage, Compose accounts, links, and the IRC client, with fictional fixtures and no network."""
    sys.path.insert(0, str(ROOT / "server"))
    import socket
    import threading
    import accounts
    import irc_client

    with tempfile.TemporaryDirectory(prefix="fluid-accounts-") as directory:
        store = accounts.AccountStore(Path(directory) / "accounts.json", environ={
            "FLUID_IRC_SERVER": "irc.example.test", "FLUID_IRC_NICK": "fluidtest", "FLUID_IRC_CHANNELS": "#radio-club,#garden",
            "FLUID_XMPP_JID": "broken"})
        saved = store.save("email", {"address": "me@example.test", "imap_host": "imap.example.test",
                                     "smtp_host": "smtp.example.test", "imap_password": "fixture-secret"})
        check(saved["smtp_password"] == "fixture-secret", "SMTP password should default to the IMAP password")
        store.save("email", {"address": "me@example.test", "imap_host": "imap.example.test", "smtp_host": "smtp.example.test"})
        check(store.current()["email"]["imap_password"] == "fixture-secret", "A blank password should keep the saved one")
        listed = json.dumps(store.redacted())
        check("fixture-secret" not in listed and '"set": true' in listed, "Account secrets must never be listed")
        check(oct(Path(directory, "accounts.json").stat().st_mode & 0o777) == "0o600", "Account file must be private")
        irc = store.current()["irc"]
        check(irc["port"] == 6697 and irc["channels"] == ["#radio-club", "#garden"], "Compose IRC account was not read")
        check(any(item.get("error", "").startswith("Docker Compose") for item in store.redacted()),
              "An invalid Compose account should be reported")
        for bad in ({"server": "irc.example.test", "nick": "x", "port": 6667},
                    {"server": "irc.example.test", "nick": "x", "channels": ["radio"]}):
            try:
                accounts.validate("irc", bad)
                raise RuntimeError("Accepted an unsafe IRC account")
            except ValueError:
                pass
        try:
            store.save("irc", {"server": "x.test", "nick": "y"})
            raise RuntimeError("Phone changed a Compose account")
        except ValueError:
            pass

    # IRC: CAP negotiation, SASL, joins, member list, a tagged message, and a reply, over a local socket pair.
    server, phone = socket.socketpair()
    server.settimeout(5)
    received, states = [], {}
    client = irc_client.IrcClient({"server": "irc.example.test", "nick": "fluidtest", "sasl_password": "pw",
                                   "channels": ["#radio-club"]},
                                  lambda *args: received.append(args), lambda name, state: states.__setitem__(name, state),
                                  connect=lambda: phone)
    def session():
        # The test closes the fake server at the end, which ends the session; that's expected, not an error.
        try:
            client.session()
        except (ConnectionError, OSError):
            pass

    worker = threading.Thread(target=session, daemon=True)
    worker.start()
    lines = b""

    def expect(fragment):
        nonlocal lines
        deadline = time.time() + 5
        while fragment not in lines:
            check(time.time() < deadline, f"IRC client never sent {fragment!r}")
            lines += server.recv(4096)

    def say(text):
        server.sendall(text.encode() + b"\r\n")

    expect(b"CAP LS 302")
    say(":irc.example.test CAP * LS * :sasl message-tags")
    say(":irc.example.test CAP * LS :server-time echo-message")
    expect(b"CAP REQ :sasl message-tags server-time echo-message")
    say(":irc.example.test CAP * ACK :sasl message-tags server-time echo-message")
    expect(b"AUTHENTICATE PLAIN")
    say("AUTHENTICATE +")
    expect(b"AUTHENTICATE ")
    say(":irc.example.test 903 fluidtest :SASL authentication successful")
    expect(b"CAP END")
    say(":irc.example.test 001 fluidtest :Welcome")
    expect(b"JOIN #radio-club")
    say(":irc.example.test 332 fluidtest #radio-club :Antenna night")
    say(":irc.example.test 353 fluidtest = #radio-club :@mosaic +kestrel fluidtest")
    say(":irc.example.test 366 fluidtest #radio-club :End of NAMES")
    say("@msgid=abc;time=2026-01-01T10:00:00.000Z :mosaic!m@host PRIVMSG #radio-club :Bring the analyzer")
    say(":kestrel!k@host PRIVMSG #radio-club :\x01ACTION waves\x01")
    say("PING :keepalive")
    expect(b"PONG :keepalive")
    deadline = time.time() + 5
    while len(received) < 2 and time.time() < deadline:
        time.sleep(0.05)
    check(states.get("#radio-club") == {"topic": "Antenna night", "members": ["fluidtest", "kestrel", "mosaic"],
                                        "modes": {"kestrel": "+", "mosaic": "@"}},
          "IRC channel topic and members were not tracked")
    check(received[0][:4] == ("#radio-club", "mosaic", "Bring the analyzer", {"msgid": "abc", "time": "2026-01-01T10:00:00.000Z"})
          and received[0][4] == 1767261600000, "Tagged IRC message was not parsed")
    check(received[1][2] == "/me waves", "CTCP ACTION was not shown as /me")
    client.send("#radio-club", "", reply="abc", react="👍")
    expect("@+draft/reply=abc;+draft/react=👍 TAGMSG #radio-club".encode())
    client.send("#radio-club", "x" * 900)
    expect(b"PRIVMSG #radio-club :" + b"x" * 400 + b"\r\nPRIVMSG")
    client.stopped.set()
    server.close()
    print("PASS  protocol accounts stay private, Compose accounts are read-only, and IRC speaks CAP, SASL, and IRCv3 tags")


def unique_chats_test():
    """One chat per person, group, channel, or room on a service and account; another account gets its own. No network."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import accounts
    import protocol_gateway

    with tempfile.TemporaryDirectory(prefix="fluid-unique-") as directory:
        database = Path(directory) / "gateway.sqlite"

        def connect():
            return sqlite3.connect(database, timeout=10)

        with closing(connect()) as db, db:
            db.executescript(protocol_gateway.SCHEMA)
            # A link from before multiple accounts: it names no account and belongs to the first one.
            db.execute("INSERT INTO protocol_routes (address, protocol, payload) VALUES (?, ?, ?)", ("maya", "email", json.dumps(
                {"address": "maya", "protocol": "email", "target": "maya@example.test", "via": "email", "group": False,
                 "title": "Maya", "members": []})))
        store = accounts.AccountStore(Path(directory) / "accounts.json", environ={})
        for address in ("me@example.test", "me@work.example.test"):
            store.save("email", {"address": address, "imap_host": "imap.example.test", "smtp_host": "smtp.example.test",
                                 "imap_password": "fixture-secret"}, add=True)
        store.save("irc", {"server": "irc.example.test", "nick": "riley"}, add=True)
        store.save("irc", {"server": "irc.other.test", "nick": "riley"}, add=True)
        gateway = protocol_gateway.Gateway(connect, {}, Path(directory) / "files", accounts=store)
        home, work = "email:me@example.test", "email:me@work.example.test"
        one, two = "irc:riley@irc.example.test", "irc:riley@irc.other.test"

        def link(address, target, account="", protocol="email", group=False):
            with closing(connect()) as db, db:
                return gateway.add_route(db, {"address": address, "protocol": protocol, "target": target, "title": target,
                                              "group": group, **({"account": account} if account else {})})

        # The same person on the same account, typed differently, opens the chat that's already there.
        again = link("web-new1", "Maya@Example.TEST", home)
        check(again.get("existing") and again["route"]["address"] == "maya", "Starting the same email chat again made another one")
        # Another account on the same service is a chat of its own, every time the same one.
        other = link("web-new2", "maya@example.test", work)
        check(not other.get("existing") and other["route"]["account"] == work and other["route"]["address"] != "maya",
              "A different account didn't get its own chat")
        check(link("web-new3", "MAYA@example.test", work)["route"]["address"] == other["route"]["address"],
              "The second account's chat was made twice")
        # Linking an address that's taken to a phone-number conversation still says so.
        try:
            link("12025550123", "maya@example.test", home)
            raise RuntimeError("An address linked to a chat was linked to a second conversation on the same account")
        except ValueError:
            pass
        # Channels: joining twice, in another case or with RFC 1459's capitals, is one chat; another network is another.
        with closing(connect()) as db, db:
            first = gateway.join(db, {"account": one, "target": "#Radio[Club]"})
        with closing(connect()) as db, db:
            second = gateway.join(db, {"account": one, "target": "#radio{club}"})
        with closing(connect()) as db, db:
            elsewhere = gateway.join(db, {"account": two, "target": "#radio{club}"})
        check(first["joined"] and not second["joined"] and second["route"]["address"] == first["route"]["address"],
              "Joining the same IRC channel twice made two chats")
        check(elsewhere["joined"] and elsewhere["route"]["address"] != first["route"]["address"],
              "The same channel on another network didn't get its own chat")
        # A direct message to a channel member, twice and in another case, is one chat per network.
        dm = link("web-dm1", "Kestrel", one, protocol="irc")
        check(link("web-dm2", "kestrel", one, protocol="irc")["route"]["address"] == dm["route"]["address"],
              "Messaging the same IRC nick twice made two chats")
        check(protocol_gateway.target_key("matrix", "!AbC:Example.org") == "!AbC:example.org"
              and protocol_gateway.target_key("matrix", "@Maya:Example.org") == "@maya:example.org",
              "Matrix addresses aren't compared the way Matrix does")
        keys = [(r["protocol"], protocol_gateway.target_key(r.get("via", r["protocol"]), r["target"]), r["account"]) for r in gateway.routes]
        check(len(keys) == len(set(keys)), "Two chats share an address, service, and account: " + json.dumps(keys))
    print("PASS  one chat per address, service, and account; another account or network gets its own")


def multi_account_test():
    """Several accounts per service, joining and leaving servers' channels and rooms, with fictional fixtures only."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import threading
    import accounts
    import irc_client
    import protocol_gateway
    import sync_merge

    with tempfile.TemporaryDirectory(prefix="fluid-multi-") as directory:
        database = Path(directory) / "gateway.sqlite"

        def connect():
            db = sqlite3.connect(database, timeout=10)
            return db

        with closing(connect()) as db, db:
            db.executescript(protocol_gateway.SCHEMA)
            # A chat and a message from before multiple accounts: no account named anywhere.
            db.execute("INSERT INTO protocol_routes VALUES ('maya', 'matrix', ?)", (json.dumps(
                {"address": "maya", "protocol": "matrix", "target": "!maya:alpha.test", "via": "matrix", "group": False,
                 "title": "Maya", "members": []}),))
            db.execute("INSERT INTO protocol_messages VALUES ('matrix-old', 1, ?)", (json.dumps(
                {"id": "matrix-old", "address": "maya", "protocol": "matrix", "title": "Maya", "body": "From before",
                 "date": 1, "type": 1, "read": 1, "status": "", "author": "@maya:alpha.test"}),))
        # The one-account-per-service file from before.
        store_path = Path(directory) / "protocol-accounts.json"
        store_path.write_text(json.dumps({"matrix": {"homeserver": "https://alpha.test", "user_id": "@alice:alpha.test",
                                                     "access_token": "fixture-alpha-token"}}))
        store = accounts.AccountStore(store_path, environ={})
        gateway = protocol_gateway.Gateway(connect, {}, Path(directory) / "files", store)
        gateway.refresh_clients = lambda: None  # No real connections in this test.
        alice, bob = "matrix:@alice:alpha.test", "matrix:@bob:beta.test"
        check(gateway.route("maya", "matrix")["account"] == alice, "An old chat didn't stay with the first account")
        store.save("matrix", {"homeserver": "https://beta.test", "user_id": "@bob:beta.test",
                              "access_token": "fixture-beta-token"}, add=True)
        saved = json.loads(store_path.read_text())
        check(saved["version"] == 2 and [entry["id"] for entry in saved["accounts"]] == [alice, bob],
              "The account file wasn't migrated in order")
        check(gateway.route("maya", "matrix")["account"] == alice, "Adding an account moved an old chat")
        try:
            store.save("matrix", {"homeserver": "https://beta.test", "user_id": "@bob:beta.test", "access_token": "x"}, add=True)
            raise RuntimeError("The same account was added twice")
        except ValueError:
            pass
        listed = json.dumps(store.redacted())
        check("fixture-alpha-token" not in listed and "fixture-beta-token" not in listed, "Account secrets were listed")

        calls = []

        def fake_matrix(path, body=None, allow_missing=False, method=None):
            me = gateway.matrix["user_id"]
            calls.append((me, path, body))
            if path.startswith("sync?"):
                room = "!maya:alpha.test" if me.endswith("alpha.test") else "!maya:beta.test"
                return {"next_batch": "batch-" + me, "rooms": {"join": {room: {"timeline": {"events": [
                    {"type": "m.room.message", "event_id": "$same", "sender": "@maya:x.test", "origin_server_ts": 5,
                     "content": {"msgtype": "m.text", "body": "Hello " + me}}]}}}}}
            if path.startswith("join/"):
                return {"room_id": "!garden:beta.test"}
            if path == "publicRooms":
                return {"chunk": [{"room_id": "!garden:beta.test", "name": "Garden club", "num_joined_members": 12},
                                  {"room_id": "!chess:beta.test", "name": "Chess", "num_joined_members": 4}]}
            if "/send/" in path:
                return {"event_id": "$sent-" + me}
            return None if allow_missing else {}
        gateway.matrix_request = fake_matrix

        # The same contact through the second account is a chat of its own; the first keeps its address.
        with closing(connect()) as db, db:
            added = gateway.add_route(db, {"address": "maya", "protocol": "matrix", "target": "!maya:beta.test",
                                           "title": "Maya", "account": bob})["route"]
        second = "maya~" + accounts.tag(bob)
        check(added["address"] == second and added["account"] == bob, "The second account's chat wasn't kept apart")
        gateway.receive_matrix(alice)
        gateway.receive_matrix(bob)
        first_in = gateway.find("maya", "matrix", "body", "Hello @alice:alpha.test")
        second_in = gateway.find(second, "matrix", "body", "Hello @bob:beta.test")
        check(first_in and second_in and first_in["id"] != second_in["id"] and first_in["account"] == alice
              and second_in["account"] == bob, "The two Matrix accounts didn't receive independently")
        check(gateway.state("matrix:since") == "batch-@alice:alpha.test"
              and gateway.state("matrix:since:" + accounts.tag(bob)) == "batch-@bob:beta.test",
              "Matrix sync positions were mixed between accounts")
        for address in ("maya", second):
            with closing(connect()) as db, db:
                gateway.enqueue(db, {"address": address, "protocol": "matrix", "body": "Reply to " + address,
                                     "request": secrets.token_hex(8)})
            gateway.deliver_job(gateway.claim())
        failed = [json.loads(row[0])["status"] for row in connect().execute("SELECT payload FROM protocol_messages")
                  if json.loads(row[0]).get("type") == 2 and json.loads(row[0])["status"] != "Sent"]
        check(not failed, "A reply wasn't sent: " + ", ".join(failed))
        sends = [(me, path) for me, path, body in calls if "/send/" in path]
        check(len(sends) == 2 and sends[0][0] == "@alice:alpha.test" and "!maya:alpha.test" in sends[0][1].replace("%21", "!").replace("%3A", ":")
              and sends[1][0] == "@bob:beta.test" and "!maya:beta.test" in sends[1][1].replace("%21", "!").replace("%3A", ":"),
              "Replies didn't go through each chat's own account")
        with closing(connect()) as db:
            snapshot = gateway.snapshot(db)
        check(any(m["id"] == "matrix-old" for m in snapshot["messages"]), "The old message was lost")
        check({a["id"] for a in snapshot["accounts"]} == {alice, bob}
              and any(r["address"] == second and r["account_name"] == "@bob:beta.test" for r in snapshot["routes"]),
              "The snapshot doesn't name each chat's account")
        accounts_listed = {a["id"]: a for a in snapshot["accounts"]}
        check(accounts_listed[alice]["primary"] and not accounts_listed[bob]["primary"]
              and accounts_listed[bob]["recent"] and not accounts_listed[alice]["recent"],
              "The snapshot doesn't mark the first account and the one used most recently (New message's From)")
        # A new chat without a choice uses the account that was active most recently (bob replied last).
        with closing(connect()) as db, db:
            fresh = gateway.add_route(db, {"address": "web-new", "protocol": "matrix", "target": "!new:beta.test", "title": "New"})
        check(fresh["route"]["account"] == bob, "A new chat didn't default to the most recent account")

        # Browsing and joining a room on the second homeserver, then leaving it.
        found = gateway.browse({"account": bob, "search": "garden", "limit": 10})["rooms"]
        check(found[0]["name"] == "Garden club" and not found[0]["joined"]
              and any(path == "publicRooms" and body.get("filter") == {"generic_search_term": "garden"} for _, path, body in calls),
              "The Matrix room directory wasn't searched")
        with closing(connect()) as db, db:
            joined = gateway.join(db, {"account": bob, "target": "#garden:beta.test"})["route"]
        check(joined["target"] == "!garden:beta.test" and joined["account"] == bob and joined["group"], "Joining a room failed")
        check(gateway.browse({"account": bob, "search": "", "limit": 10})["rooms"][0]["joined"], "A joined room isn't marked")
        servers = {server["id"]: server for server in gateway.servers()}
        check(joined["address"] in servers[bob]["channels"] and second in servers[bob]["direct"]
              and "maya" in servers[alice]["direct"], "Servers don't group their rooms and direct messages")
        with closing(connect()) as db, db:
            gateway.leave(db, {"address": joined["address"], "protocol": "matrix"})
        check(any(me == "@bob:beta.test" and path.endswith("/leave") for me, path, _ in calls)
              and gateway.route(joined["address"], "matrix") is None, "Leaving a room failed")

        # Phone and web merge: the old item for older phones, and one per account.
        hooks = {"appearance": lambda db: {}, "prefs": lambda db: {}, "chats": lambda db: {}}
        with closing(connect()) as db:
            items = sync_merge.Merge(gateway, hooks).web_items(db)
        check(items.get("account:matrix") == "@alice:alpha.test" and items.get("account:matrix:@alice:alpha.test") == "web"
              and items.get("account:matrix:@bob:beta.test") == "web", "Merge items aren't per account")

        # IRC: two networks; a channel joined on one only appears and connects there.
        store.save("irc", {"server": "irc.alpha.test", "nick": "fluidtest", "channels": "#radio-club"}, add=True)
        store.save("irc", {"server": "irc.beta.test", "nick": "fluidtest"}, add=True)
        one, two = "irc:fluidtest@irc.alpha.test", "irc:fluidtest@irc.beta.test"
        with closing(connect()) as db, db:
            channel = gateway.join(db, {"account": two, "target": "garden"})["route"]
        check(channel["target"] == "#garden" and channel["account"] == two, "Joining an IRC channel failed")
        wanted = gateway.wanted_clients()
        check(wanted[one][2] == ["#radio-club"] and wanted[two][2] == ["#garden"], "IRC channels went to the wrong network")
        gateway.accept_irc("#garden", "kestrel", "Seeds?", {"msgid": "g1"}, 7, False, account=two)
        gateway.accept_irc("#garden", "kestrel", "Wrong network", {"msgid": "g2"}, 8, False, account=one)
        check(gateway.find(channel["address"], "irc", "irc_msgid", "g1") and not gateway.find(channel["address"], "irc", "irc_msgid", "g2"),
              "An IRC message reached the wrong network's channel")
        radio = next(r for r in gateway.routes if r["account"] == one and r["target"] == "#radio-club")
        with closing(connect()) as db, db:
            gateway.leave(db, {"address": radio["address"], "protocol": "irc"})
            gateway.leave(db, {"address": channel["address"], "protocol": "irc"})
        check(not store.get(one).get("channels") and gateway.route(channel["address"], "irc") is None,
              "Leaving IRC channels failed")

    # IRC LIST with a search and a limit, and live JOIN/PART, on a recorded connection.
    class Recorder:
        def __init__(self):
            self.lines = []

        def sendall(self, data):
            self.lines.append(data.decode().strip())

    client = irc_client.IrcClient({"server": "irc.example.test", "nick": "fluidtest", "channels": ["#a", "#c"]},
                                  lambda *args: None, lambda *args: None)
    client.sock = Recorder()
    client.ready.set()
    result = {}
    worker = threading.Thread(target=lambda: result.update(rows=client.list_channels("radio", 2)), daemon=True)
    worker.start()
    deadline = time.time() + 5
    while not client.sock.lines and time.time() < deadline:
        time.sleep(0.02)
    check(client.sock.lines[-1] == "LIST *radio*", "IRC LIST didn't ask for matching channels")
    for line in (":irc.example.test 321 fluidtest Channel :Users Name",
                 ":irc.example.test 322 fluidtest #radio-club 40 :Antenna night",
                 ":irc.example.test 322 fluidtest #garden 9 :Seeds",
                 ":irc.example.test 322 fluidtest #radio-help 3 :Questions",
                 ":irc.example.test 322 fluidtest #radio-more 90 :Over the limit",
                 ":irc.example.test 323 fluidtest :End of /LIST"):
        client.handle(irc_client.parse(line))
    worker.join(5)
    check([row["target"] for row in result.get("rows", [])] == ["#radio-more", "#radio-club"],
          "IRC LIST didn't keep the busiest matching channels")
    client.sync_channels(["#a", "#b"])
    check(client.sock.lines[-2:] == ["JOIN #b", "PART #c :Left in FluidMessages"], "IRC didn't join and part live")
    print("PASS  several accounts per service: migration keeps old chats, two Matrix accounts and two IRC networks send and "
          "receive apart, per-account merge items, and joining, browsing, and leaving channels and rooms")


def chat_features_test():
    """Daily IRC, Matrix, and XMPP use on the companion: bots and server notices, slash commands, invitations, event
    lines, mentions, nick fallback, line splitting, and flood pacing. Fictional fixtures; no sockets leave the process."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import accounts
    import chat_commands
    import irc_client
    import protocol_gateway

    class Recorder:
        def __init__(self):
            self.lines = []

        def sendall(self, data):
            self.lines.append(data.decode().rstrip("\r\n"))

    # Flood pacing: a burst of five, then one line every two seconds, on a fake clock.
    clock = {"now": 0.0}
    slept = []
    flood = irc_client.Flood(burst=5, every=2.0, clock=lambda: clock["now"],
                             sleep=lambda seconds: (slept.append(seconds), clock.__setitem__("now", clock["now"] + seconds)))
    for _ in range(7):
        flood.wait()
    check(slept == [2.0, 2.0], f"IRC flood pacing didn't wait after the burst: {slept}")

    # The command table, shared with the phone (ChatCommands.kt) and the browser (chat-commands.js).
    check(chat_commands.parse("irc", "/me waves") == {"name": "me", "args": "waves", "argv": ["waves"]}, "/me didn't parse")
    check(chat_commands.parse("irc", "/raw PING x")["name"] == "quote", "/raw isn't /quote")
    check(chat_commands.parse("irc", "//shrug") is None and chat_commands.parse("sms", "/shrug") is None,
          "// and unknown words in texts should stay text")
    for protocol, text, wanted in (("irc", "/frobnicate now", "Unknown command /frobnicate"), ("matrix", "/whois maya", "isn’t available"),
                                   ("sms", "/me waves", "Commands work in"), ("email", "/join #x", "Commands work in"),
                                   ("irc", "/join", "Usage: /join")):
        try:
            chat_commands.parse(protocol, text)
            raise RuntimeError(f"{text!r} on {protocol} wasn't refused")
        except chat_commands.CommandError as error:
            check(wanted in str(error), f"Wrong error for {text!r}: {error}")

    with tempfile.TemporaryDirectory(prefix="fluid-chat-") as directory:
        database = Path(directory) / "gateway.sqlite"
        connect = lambda: sqlite3.connect(database, timeout=10)
        with closing(connect()) as db, db:
            db.executescript(protocol_gateway.SCHEMA)
        store = accounts.AccountStore(Path(directory) / "accounts.json", environ={})
        store.save("irc", {"server": "irc.example.test", "nick": "fluidtest", "channels": "#radio-club",
                           "nickserv_password": "fixture-nickserv"}, add=True)
        ident = "irc:fluidtest@irc.example.test"
        check("fixture-nickserv" not in json.dumps(store.redacted()), "The NickServ password was listed")
        gateway = protocol_gateway.Gateway(connect, {}, Path(directory) / "files", store)
        gateway.refresh_clients = lambda: None
        invites = []
        client = irc_client.IrcClient({**store.get(ident), "channels": ["#radio-club"]},
                                      lambda *args: gateway.accept_irc(*args, account=ident),
                                      lambda channel, state: gateway.channel_state(channel, state, ident),
                                      on_invite=lambda channel, sender: invites.append(
                                          gateway.add_invite(ident, "irc", "channel", channel, sender, channel)),
                                      flood=irc_client.Flood(burst=1000))
        client.sock = Recorder()
        gateway.clients[ident] = ("fixture", client)
        say = lambda line: client.handle(irc_client.parse(line))

        # Nick in use while connecting: nick_, then nick__; identify to NickServ once registered (no SASL here).
        say(":irc.example.test 433 * fluidtest :Nickname is already in use")
        say(":irc.example.test 433 * fluidtest_ :Nickname is already in use")
        check(client.sock.lines[-2:] == ["NICK fluidtest_", "NICK fluidtest__"], "The nick-in-use fallback didn't try nick_")
        say(":irc.example.test 001 fluidtest__ :Welcome")
        # With a password saved, channels wait until NickServ says you're signed in (or SIGN_IN_WAIT passes).
        check("PRIVMSG NickServ :IDENTIFY fluidtest fixture-nickserv" in client.sock.lines and "JOIN #radio-club" not in client.sock.lines,
              "Identify on connect failed, or channels joined before signing in")
        say(":NickServ!NickServ@services.example.test NOTICE fluidtest__ :You are now identified for \x02fluidtest\x02.")
        check("JOIN #radio-club" in client.sock.lines, "Channels didn't join once signed in")
        check(client.wanted == "fluidtest" and client.nick == "fluidtest__", "The wanted nick was forgotten")

        # A service bot's NOTICE and a person's PRIVMSG each open a direct chat; services are labeled automated.
        say(":NickServ!NickServ@services.example.test NOTICE fluidtest__ :This nickname is registered.")
        say(":maya!m@host PRIVMSG fluidtest__ :hi from a new person")
        say(":irc.example.test NOTICE fluidtest__ :*** You are connected using TLS")
        routes = {r["target"]: r for r in gateway.routes if r["account"] == ident}
        check(routes.get("NickServ", {}).get("automated") and "maya" in routes and not routes["maya"].get("automated"),
              "Bot or person direct messages didn't open their own chats")
        bot = gateway.find(routes["NickServ"]["address"], "irc", "author", "NickServ")
        check(bot and bot["body"] == "This nickname is registered." and bot.get("notice"), "The NickServ notice wasn't kept")
        server = routes.get(irc_client.SERVER)
        check(server and server.get("server_chat") and gateway.find(server["address"], "irc", "body", "*** You are connected using TLS"),
              "Server notices didn't reach the server chat")

        # Channel events with kinds, never unread; prefixes for operators and voice; mentions of your nick.
        radio = routes["#radio-club"]
        for line in (":irc.example.test 353 fluidtest__ = #radio-club :@mosaic +kestrel fluidtest__",
                     ":irc.example.test 366 fluidtest__ #radio-club :End of NAMES",
                     ":orbital!o@host JOIN #radio-club", ":orbital!o@host NICK orbit",
                     ":mosaic!m@host MODE #radio-club +v orbit", ":orbit!o@host PART #radio-club :later",
                     ":mosaic!m@host KICK #radio-club kestrel :too loud", ":mosaic!m@host TOPIC #radio-club :Antenna night",
                     "@msgid=m1 :mosaic!m@host PRIVMSG #radio-club :fluidtest: bring the analyzer?",
                     "@msgid=m2 :mosaic!m@host PRIVMSG #radio-club :fluidtesting is not a mention"):
            say(line)
        with closing(connect()) as db:
            items = [json.loads(row[0]) for row in db.execute("SELECT payload FROM protocol_messages ORDER BY date, rowid")]
        events = [(i["event_kind"], i["body"]) for i in items if i["address"] == radio["address"] and i.get("event")]
        check([kind for kind, _ in events] == ["join", "nick", "mode", "part", "kick", "topic"],
              f"Channel event lines were wrong: {events}")
        check(all(i["read"] == 1 for i in items if i.get("event")), "Event lines shouldn't be unread")
        check(dict(events)["kick"] == "mosaic removed kestrel (too loud)", "Kick line was wrong")
        state = json.loads(gateway.state("channel:" + radio["address"]))
        check(state["modes"] == {"mosaic": "@"} and "kestrel" not in state["members"] and state["topic"] == "Antenna night",
              f"Channel prefixes or members were wrong: {state}")
        check(gateway.find(radio["address"], "irc", "irc_msgid", "m1").get("mention")
              and not gateway.find(radio["address"], "irc", "irc_msgid", "m2").get("mention"), "Mentions were wrong")

        # CTCP: off by default (no reply), and a generic reply when allowed.
        before = len(client.sock.lines)
        say(":maya!m@host PRIVMSG fluidtest__ :\x01VERSION\x01")
        check(len(client.sock.lines) == before, "CTCP VERSION was answered while off")
        client.account["ctcp_replies"] = True
        say(":maya!m@host PRIVMSG fluidtest__ :\x01VERSION\x01")
        check(client.sock.lines[-1] == "NOTICE maya :\x01VERSION FluidMessages\x01", "CTCP VERSION wasn't answered when on")

        client.ready.set()
        def command(route, text):
            with closing(connect()) as db, db:
                return gateway.run_command(db, {"address": route["address"], "protocol": route["protocol"], "text": text,
                                                "request": secrets.token_hex(8)})

        def deliver():
            while (job := gateway.claim()) is not None:
                gateway.deliver_job(job)

        # /me round trip: sent as CTCP ACTION, and received back as "/me", which the apps show as "* nick waves".
        command(radio, "/me waves at everyone")
        deliver()
        check(client.sock.lines[-1] == "PRIVMSG #radio-club :\x01ACTION waves at everyone\x01", "/me wasn't sent as an ACTION")
        say(":kestrel!k@host PRIVMSG #radio-club :\x01ACTION waves back\x01")
        check(gateway.find(radio["address"], "irc", "body", "/me waves back"), "An incoming ACTION wasn't kept as /me")

        # /join, /topic, /nick, /whois (as event lines), /msg (opens a DM), /part.
        joined = command(radio, "/join #garden")
        garden = gateway.route(joined["open"]["address"], "irc")
        check(garden and garden["target"] == "#garden", "/join didn't add the channel")
        command(garden, "/topic Seeds and soil")
        check(client.sock.lines[-1] == "TOPIC #garden :Seeds and soil", "/topic didn't set the topic")
        check(command(radio, "/topic")["notice"] == "Topic of #radio-club: Antenna night", "/topic didn't show the topic")
        command(radio, "/nick fluidtest")
        check(client.sock.lines[-1] == "NICK fluidtest", "/nick wasn't sent")
        say(":fluidtest__!f@host NICK fluidtest")
        command(radio, "/whois kestrel")
        say(":irc.example.test 311 fluidtest kestrel k host.example.test * :Kestrel Fixture")
        say(":irc.example.test 318 fluidtest kestrel :End of /WHOIS list.")
        check(gateway.find(radio["address"], "irc", "body", "kestrel is k@host.example.test (Kestrel Fixture)").get("event_kind") == "whois",
              "/whois results weren't event lines in the chat")
        opened = command(radio, "/msg ChanServ HELP")
        deliver()
        check(gateway.route(opened["open"]["address"], "irc")["target"] == "ChanServ" and client.sock.lines[-1] == "PRIVMSG ChanServ :HELP",
              "/msg didn't open a direct chat and send")
        command(garden, "/part bye for now")
        check("PART #garden :bye for now" in client.sock.lines and gateway.route(garden["address"], "irc") is None, "/part didn't leave")
        command(radio, "/quote MODE #radio-club +m")
        check(client.sock.lines[-1] == "MODE #radio-club +m", "/quote didn't send the raw line")
        check(len(command(radio, "/help")["help"]) == len(chat_commands.available("irc")), "/help didn't list the commands")

        # Unknown commands are refused, and commands never go out as text.
        for text in ("/frobnicate", "/join"):
            try:
                command(radio, text)
                raise RuntimeError(f"{text} wasn't refused")
            except ValueError as error:
                check("Unknown command" in str(error) or "Usage" in str(error), f"Unhelpful error for {text}: {error}")
        try:
            with closing(connect()) as db, db:
                gateway.enqueue(db, {"address": radio["address"], "protocol": "irc", "body": "/join #x", "request": "r-join"})
            raise RuntimeError("A command was queued as a message")
        except ValueError as error:
            check("is a command" in str(error), "Wrong error for a command sent as a message")
        with closing(connect()) as db, db:
            gateway.enqueue(db, {"address": radio["address"], "protocol": "irc", "body": "/join is literal", "request": "r-lit",
                                 "literal": True})
        deliver()
        check(client.sock.lines[-1] == "PRIVMSG #radio-club :/join is literal", "// didn't send the text as written")
        with closing(connect()) as db, db:
            gateway.enqueue(db, {"address": server["address"], "protocol": "irc", "body": "hello", "request": "r-srv"})
        deliver()
        check("server chat" in gateway.find(server["address"], "irc", "id", "gateway-r-srv")["status"],
              "Text in the server chat should explain itself")

        # Line splitting: each line fits in 512 bytes once the server adds the prefix, at word breaks, and /me too.
        long_channel = "#" + "a" * 45
        client.sock.lines.clear()
        client.send(long_channel, ("word " * 300).strip())
        client.send(long_channel, "/me " + ("é" * 500))
        sizes = [len(line.encode()) + len(":fluidtest!") + 64 + 2 for line in client.sock.lines]
        check(len(client.sock.lines) > 4 and max(sizes) <= 512, f"Long messages weren't split to fit: {sizes}")
        check(all(not line.endswith(" ") for line in client.sock.lines[:3]), "Splits should fall between words")
        check(all(line.startswith("PRIVMSG " + long_channel + " :\x01ACTION ") and line.endswith("\x01")
                  for line in client.sock.lines if "\x01" in line), "A long /me wasn't split into actions")

        # An invitation waits on the Invitations page; accepting joins and adds the channel.
        say(":kestrel!k@host INVITE fluidtest #secret-lab")
        with closing(connect()) as db:
            waiting = gateway.snapshot(db)["invites"]
        check([i["target"] for i in waiting] == ["#secret-lab"] and waiting[0]["from"] == "kestrel", "The IRC invite wasn't kept")
        with closing(connect()) as db, db:
            answer = gateway.answer_invite(db, {"id": waiting[0]["id"], "accept": True})
        check(answer["route"]["target"] == "#secret-lab" and not answer["invites"], "Accepting the invite didn't join")

        # Reconnecting asks for your own nick again.
        client.wanted = "fluidtest"
        client.nick = "fluidtest_"
        phone, far = socket.socketpair()
        far.close()
        client.connect_socket = lambda: phone
        try:
            client.session()
        except (ConnectionError, OSError):
            pass
        check(client.nick == "fluidtest", "A reconnect kept the fallback nick")

        # Matrix: an invitation from sync, accepted; topic and member events; /me as m.emote; edits; mentions.
        store.save("matrix", {"homeserver": "https://matrix.example.test", "user_id": "@alice:example.test",
                              "access_token": "fixture-token"}, add=True)
        alice = "matrix:@alice:example.test"
        sent = []

        def fake_matrix(path, body=None, allow_missing=False, method=None):
            sent.append((path, body, method))
            if path.startswith("sync?"):
                return {"next_batch": "b1", "rooms": {"invite": {"!lab:example.test": {"invite_state": {"events": [
                    {"type": "m.room.name", "state_key": "", "sender": "@maya:example.test", "content": {"name": "Radio lab"}},
                    {"type": "m.room.member", "state_key": "@alice:example.test", "sender": "@maya:example.test",
                     "content": {"membership": "invite"}}]}}}}}
            if path.startswith("join/"):
                return {"room_id": "!lab:example.test"}
            if "/send/" in path:
                return {"event_id": "$sent"}
            return None if allow_missing else {}
        gateway.matrix_request = fake_matrix
        gateway.receive_matrix(alice)
        with closing(connect()) as db:
            waiting = [i for i in gateway.snapshot(db)["invites"] if i["protocol"] == "matrix"]
        check(waiting and waiting[0]["name"] == "Radio lab" and waiting[0]["from"] == "@maya:example.test", "The Matrix invite wasn't kept")
        with closing(connect()) as db, db:
            lab = gateway.answer_invite(db, {"id": waiting[0]["id"], "accept": True})["route"]
        check(lab["target"] == "!lab:example.test" and any(p.startswith("join/") for p, _, _ in sent), "Accepting the Matrix invite failed")
        lab = gateway.route(lab["address"], "matrix")
        for event in ({"type": "m.room.topic", "event_id": "$t", "sender": "@maya:example.test", "content": {"topic": "Field day"}},
                      {"type": "m.room.member", "event_id": "$j", "sender": "@sam:example.test", "state_key": "@sam:example.test",
                       "content": {"membership": "join", "displayname": "Sam"}},
                      {"type": "m.room.member", "event_id": "$k", "sender": "@maya:example.test", "state_key": "@sam:example.test",
                       "content": {"membership": "leave", "reason": "spam"}, "unsigned": {"prev_content": {"membership": "join", "displayname": "Sam"}}},
                      {"type": "m.room.message", "event_id": "$e", "sender": "@sam:example.test", "content": {"msgtype": "m.emote", "body": "waves"}},
                      {"type": "m.room.message", "event_id": "$m", "sender": "@maya:example.test", "content": {"msgtype": "m.text", "body": "alice, ready?"}},
                      {"type": "m.room.message", "event_id": "$m2", "sender": "@maya:example.test", "content": {
                          "msgtype": "m.text", "body": "* alice, ready now?", "m.new_content": {"msgtype": "m.text", "body": "alice, ready now?"},
                          "m.relates_to": {"rel_type": "m.replace", "event_id": "$m"}}}):
            gateway.accept_matrix(lab, {"origin_server_ts": 10, **event})
        with closing(connect()) as db:
            rows = [json.loads(row[0]) for row in db.execute("SELECT payload FROM protocol_messages ORDER BY rowid")]
        lab_rows = [i for i in rows if i["address"] == lab["address"]]
        matrix_events = [(i["event_kind"], i["body"]) for i in lab_rows if i.get("event")]
        check(matrix_events == [("topic", "@maya:example.test changed the topic to “Field day”"), ("join", "Sam joined"),
                                ("kick", "@maya:example.test removed Sam (spam)")], f"Matrix event lines were wrong: {matrix_events}")
        check(json.loads(gateway.state("channel:" + lab["address"]))["topic"] == "Field day", "The Matrix topic wasn't kept")
        check(any(i["body"] == "/me waves" for i in lab_rows), "m.emote wasn't kept as /me")
        check(any(i["body"] == "alice, ready?" and i.get("mention") for i in lab_rows), "A Matrix mention wasn't marked")
        check(any(i["body"] == "✏️ Edited “alice, ready?” to: alice, ready now?" for i in lab_rows), "A Matrix edit wasn't shown as an edit")
        with closing(connect()) as db, db:
            gateway.run_command(db, {"address": lab["address"], "protocol": "matrix", "text": "/me tunes in @sam:example.test",
                                     "request": "r-emote"})
        deliver()
        emote = next(body for path, body, _ in sent if "/send/m.room.message/" in path)
        check(emote["msgtype"] == "m.emote" and emote["body"] == "tunes in @sam:example.test"
              and emote["m.mentions"] == {"user_ids": ["@sam:example.test"]}, f"/me on Matrix wasn't an emote with a mention: {emote}")
        with closing(connect()) as db, db:
            gateway.run_command(db, {"address": lab["address"], "protocol": "matrix", "text": "/topic Field day at noon"})
            gateway.run_command(db, {"address": lab["address"], "protocol": "matrix", "text": "/nick Alice Fixture"})
        check(any(p.endswith("/state/m.room.topic") and b == {"topic": "Field day at noon"} for p, b, _ in sent)
              and any(p.endswith("/displayname") and b == {"displayname": "Alice Fixture"} for p, b, _ in sent),
              "Matrix /topic or /nick didn't reach the homeserver")
        # Reconnecting: 15 s, 30 s, 1, 2, 5, then 10 minutes, ±20%, and at most five automatic reconnects an hour.
        check([round(irc_client.backoff(n, lambda: 0.5)) for n in range(8)] == [15, 30, 60, 120, 300, 600, 600, 600]
              and round(irc_client.backoff(0, lambda: 0.0), 6) == 12 and round(irc_client.backoff(0, lambda: 1.0), 6) == 18,
              "The IRC backoff schedule or its jitter is wrong")
        now = {"t": 10_000.0}
        paced = irc_client.IrcClient({"server": "irc.example.test", "nick": "fluidtest"}, lambda *a: None, lambda *a: None,
                                     clock=lambda: now["t"], rand=lambda: 0.5)
        delays = []
        for attempt in range(6):
            delays.append(round(paced.next_delay(attempt)))
            now["t"] += delays[-1]
            paced.budget.record(now["t"])
        check(delays[:5] == [15, 30, 60, 120, 300], f"Backoff delays were wrong: {delays}")
        check(delays[5] == round(10_000 + 15 + 3600 - (10_000 + 525)), f"The sixth reconnect in an hour wasn't held back: {delays}")
        paced.wake.set()  # Reconnect by hand doesn't wait.
        check(paced.wait_to_reconnect(60) is True and paced.status["state"] == "reconnecting", "Reconnect didn't skip the wait")
        check(paced.wait_to_reconnect(0.01) is False, "An ordinary wait was taken for Reconnect")
        with closing(connect()) as db:
            check(ident in gateway.snapshot(db)["connections"], "The connection state isn't in the snapshot")
        gateway.reconnect({"account": ident})
        check(client.wake.is_set(), "Reconnect didn't reach the IRC client")

        # Keep joined: on by default; after a reconnect only kept channels rejoin, the others when opened or written to.
        with closing(connect()) as db, db:
            gateway.set_keep(db, {"address": radio["address"], "protocol": "irc", "keep": False})
        with closing(connect()) as db:
            shown = next(r for r in gateway.snapshot(db)["routes"] if r["address"] == radio["address"])
        check(shown["keep_joined"] is False and gateway.keeps(ident, "#garden-new"), "Keep joined wasn't saved")
        check(irc_client.keep_joined_channels(["#radio-club", "#other"], lambda c: gateway.keeps(ident, c)) == ["#other"],
              "The rejoin policy kept the wrong channels")
        rejoin = irc_client.IrcClient({"server": "irc.example.test", "nick": "fluidtest", "channels": ["#radio-club", "#other"]},
                                      lambda *a: None, lambda *a: None, keep=lambda c: gateway.keeps(ident, c))
        rejoin.sock = Recorder()
        rejoin.handle(irc_client.parse(":irc.example.test 001 fluidtest :Welcome"))
        check([l for l in rejoin.sock.lines if l.startswith("JOIN")] == ["JOIN #other"] and rejoin.status["state"] == "connected",
              "A channel that isn't kept joined rejoined on connect")
        gateway.clients[ident] = ("fixture", rejoin)
        gateway.open_chat({"address": radio["address"], "protocol": "irc"})
        check(rejoin.sock.lines[-1] == "JOIN #radio-club", "Opening the channel didn't rejoin it")
        rejoin.handle(irc_client.parse(":fluidtest!f@host JOIN #radio-club"))
        before = len(rejoin.sock.lines)
        gateway.open_chat({"address": radio["address"], "protocol": "irc"})
        check(len(rejoin.sock.lines) == before, "An open channel was joined twice")
        gateway.clients[ident] = ("fixture", client)

        # Refusals in plain words: SASL needed from this connection, a nickname the network won't take, a ban. Each
        # stops retrying and waits for Reconnect, with the reason in the bar's status and the server chat.
        sasl = irc_client.explain("ERROR", "Closing Link: 192.0.2.7 (SASL authentication is required)", "irc.example.test", "fluidtest", False)
        check(sasl and sasl[1] and "registered nickname" in sasl[0] and "Password in the IRC account settings" in sasl[0], f"SASL-only wasn't explained: {sasl}")
        check(irc_client.explain("ERROR", "Closing Link: host (Client Quit)", "n", "k", False) is None
              and irc_client.explain("ERROR", "Closing Link: host (Ping timeout: 240 seconds)", "n", "k", False)[1] is False
              and irc_client.explain("465", "You are banned", "n", "k", False)[1] is True
              and irc_client.explain("904", "SASL failed", "n", "k", False) is None
              and irc_client.explain("904", "SASL failed", "n", "k", True)[1] is False, "A refusal was classed wrongly")
        refused = irc_client.IrcClient({"server": "irc.example.test", "nick": "9fluid"}, lambda *a: None, lambda *a: None)
        refused.sock = Recorder()
        try:
            refused.handle(irc_client.parse(":irc.example.test 432 * 9fluid :Erroneous Nickname"))
            raise RuntimeError("An erroneous nickname was retried as nick_")
        except irc_client.Refused as error:
            check("“9fluid”" in str(error) and refused.problem[1], "The refused nickname wasn't explained")
        check(not any(line.startswith("NICK 9fluid_") for line in refused.sock.lines), "An erroneous nickname fell back to nick_")
        notices = []
        only = irc_client.IrcClient({"server": "irc.example.test", "nick": "fluidtest"}, lambda *a: notices.append(a), lambda *a: None)
        only.sock = Recorder()
        only.handle(irc_client.parse(":irc.example.test NOTICE * :*** You need to identify via SASL to use this server"))
        only.handle(irc_client.parse("ERROR :Closing Link: 192.0.2.7 (Bye)"))
        check(only.problem and only.problem[1] and "registered nickname" in only.problem[0], f"The SASL notice wasn't the reason: {only.problem}")
        only.wake.set()
        check(only.wait_for_reconnect(only.problem[0]) is True and only.status["state"] == "disconnected"
              and "registered nickname" in only.status["error"], "A refusal didn't wait for Reconnect with its reason")

        # Reconnect automatically: on by default; off, nothing connects until Reconnect, and it's in the snapshot.
        check(gateway.reconnects(ident), "Reconnect automatically wasn't on by default")
        with closing(connect()) as db, db:
            gateway.set_auto_reconnect(db, {"account": ident, "on": False})
        with closing(connect()) as db:
            listed = next(a for a in gateway.snapshot(db)["accounts"] if a["id"] == ident)
        check(listed["reconnect"] is False and not gateway.reconnects(ident), "Reconnect automatically off wasn't saved")
        manual = irc_client.IrcClient({"server": "irc.example.test", "nick": "fluidtest"}, lambda *a: None, lambda *a: None,
                                      connect=lambda: (_ for _ in ()).throw(RuntimeError("connected while Reconnect automatically was off")),
                                      auto=lambda: gateway.reconnects(ident))
        manual.stopped.set()
        manual.wake.set()
        manual.run()
        check(manual.status["state"] == "disconnected" and manual.status["manual"] is True, f"Off still connected: {manual.status}")
        client.wake.clear()
        with closing(connect()) as db, db:
            gateway.set_auto_reconnect(db, {"account": ident, "on": True})
        check(gateway.reconnects(ident) and client.wake.is_set(), "Turning Reconnect automatically back on didn't connect")
        # Disconnect: Reconnect automatically goes off, the network gets a QUIT, and nothing connects until Connect.
        client.wake.clear()
        live_sock, client.sock = client.sock, Recorder()
        with closing(connect()) as db, db:
            gateway.disconnect(db, {"account": ident})
        quit_sent = "QUIT :FluidMessages" in client.sock.lines
        client.sock = live_sock
        check(not gateway.reconnects(ident) and client.dropped and client.status["state"] == "disconnected" and client.status["manual"]
              and quit_sent, f"Disconnect didn't close the connection: {client.status}")
        check(gateway.connections()[ident]["manual"] is True, "Disconnect isn't in the connection state")
        with closing(connect()) as db, db:
            gateway.set_auto_reconnect(db, {"account": ident, "on": True})
        check(gateway.reconnects(ident) and not client.dropped and client.wake.is_set(), "Connect didn't connect again")
        import threading
        tries = []
        held = irc_client.IrcClient({"server": "irc.example.test", "nick": "fluidtest"}, lambda *a: None, lambda *a: None,
                                    connect=lambda: tries.append(1) or (_ for _ in ()).throw(OSError("fixture")))
        held.dropped = True
        holding = threading.Thread(target=held.run, daemon=True)
        holding.start()
        time.sleep(0.2)
        check(not tries and held.status["state"] == "disconnected" and held.status["manual"], f"A disconnected network connected: {held.status}")
        held.stopped.set()
        held.wake.set()
        holding.join(2)
        # Accounts with nothing running (their service is off here) still have a state, so no chat shows none.
        check(all(state.get("state") for state in gateway.connections().values()), "A connection had no state")
        try:
            with closing(connect()) as db, db:
                gateway.set_auto_reconnect(db, {"account": "email:nobody@example.test", "on": False})
            raise RuntimeError("Reconnect automatically took an unknown account")
        except ValueError:
            pass
        # The network's server chat exists as soon as its connection starts, so the network shows in the list.
        server_chat = gateway.irc_server_route(ident)
        with closing(connect()) as db:
            shown = [r for r in gateway.snapshot(db)["routes"] if r.get("server_chat")]
        check(server_chat["target"] == irc_client.SERVER and any(r["address"] == server_chat["address"] for r in shown),
              "The network's server chat isn't listed")
        # Matrix without encryption reports a connection too, and waits for Reconnect while off.
        calls = []
        poller = protocol_gateway.Poller(lambda: calls.append(1), 0.01, auto=lambda: False, network="matrix.example.test")
        import threading
        waiting = threading.Thread(target=poller.run, daemon=True)
        waiting.start()
        time.sleep(0.2)
        check(not calls and poller.status["state"] == "disconnected" and poller.status["manual"], "The Matrix check ran while off")
        poller.stop()
        waiting.join(2)
        check(not calls and not waiting.is_alive(), "The Matrix check ran after it was stopped")
        working = protocol_gateway.Poller(lambda: (calls.append(1), working.stop()), 0.01, auto=lambda: True)
        working.run()
        check(calls and working.status["state"] == "connected", "A Matrix check didn't report connected")

        # Email never takes a command as text.
        try:
            gateway.check_not_command({"protocol": "email", "via": "email"}, "/me waves", {})
            raise RuntimeError("Email accepted /me")
        except ValueError:
            pass
    print("PASS  chat features: bot NOTICEs and new people open DMs, server notices, /me round trip, /join /part /nick /topic "
          "/whois /msg /quote, invites accepted (IRC and Matrix), nick-in-use fallback, line splitting, flood pacing, "
          "unknown commands refused, mentions, CTCP off by default, event lines, the reconnect backoff and hourly cap, and Keep joined")


def communities_test():
    """Messages → Chats | Communities and the inbox filter menu: served, sorted, filtered, and their prefs round trip."""
    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        index = request("/", authorized=False).decode()
        check('id="inbox-view"' in index and index.index('id="inbox-view"') < index.index('id="threads"'),
              "Messages has no Chats | Communities switch under the title")
        check(index.index("/servers.js") < index.index("/inbox-filters.js"), "The page doesn't load inbox-filters.js after servers.js")
        check("'/inbox-filters.js'" in request("/sw.js", authorized=False).decode(), "The service worker doesn't cache inbox-filters.js")
        servers_js = request("/servers.js", authorized=False).decode()
        filters_js = request("/inbox-filters.js", authorized=False).decode()
        app_js = request("/app.js", authorized=False).decode()
        settings_js = request("/settings.js", authorized=False).decode()
        css = request("/features.css", authorized=False).decode()
        check(all(name in servers_js for name in ("function drawInboxSwitch", "'Communities'", "function drawCommunities", "function communityGroups",
                                                   "No communities yet", "Add server", "Server details", "function communityChatsSwitch"))
              and "function serverStrip" not in servers_js and "server-strip" not in css + servers_js + app_js,
              "Communities isn't served, or the old server strip is still there")
        check("function threadButton" in app_js and "drawCommunities(list, rows" in app_js, "Communities doesn't draw chat rows the way Chats does")
        check(all(name in filters_js for name in ("function inboxFiltersPage", "'Move up'", "'Move down'", "In the private folder", "inboxDecoy()"))
              and "communityChatsSwitch" in settings_js and "inbox-filters" in filters_js, "Settings → Messaging has no Inbox filters or community switch")
        # The prefs: defaults, a round trip, and bad values refused.
        prefs = request("/api/inbox")["prefs"]
        check(prefs["showCommunityChats"] is True and prefs["communitySort"] == "recent" and prefs["inboxFilters"][:3] == ["inbox", "unread", "favorites"],
              "Communities or inbox filter prefs have the wrong defaults")
        check(request("/api/settings", {"prefs": {"communitySort": "name"}})["prefs"]["communitySort"] == "name", "The community sort wasn't kept")
        check(request("/api/settings", {"prefs": {"showCommunityChats": False}})["prefs"]["showCommunityChats"] is False,
              "Show community chats in Chats couldn't be turned off")
        order = ["groups", "inbox", "-unread", "irc"]
        saved = request("/api/settings", {"prefs": {"inboxFilters": order}})["prefs"]["inboxFilters"]
        check(saved[:4] == order and len(saved) == 14 and request("/api/inbox")["prefs"]["inboxFilters"] == saved, "Inbox filters didn't round trip")
        for bad in ({"communitySort": "newest"}, {"inboxFilters": ["-inbox"]}, {"inboxFilters": ["inbox", "inbox"]}, {"inboxFilters": ["spam"]},
                    {"inboxFilters": "inbox"}, {"showCommunityChats": "yes"}):
            try:
                request("/api/settings", {"prefs": bad})
                raise RuntimeError("Invalid prefs were accepted: " + json.dumps(bad))
            except HTTPError as error:
                check(error.code == 400, f"Expected HTTP 400 for {json.dumps(bad)}, got {error.code}")
        # The phone's choices reach the browser, which follows them while it follows the phone.
        request("/api/sync", {"messages": sample_messages(), "appearance": {"showCommunityChats": False, "communitySort": "joined",
                                                                             "inboxFilters": ["direct", "inbox"]}})
        phone = request("/api/inbox")["appearance"]
        check(phone["showCommunityChats"] is False and phone["communitySort"] == "joined" and phone["inboxFilters"][:2] == ["direct", "inbox"],
              "The phone's Communities and inbox filter choices didn't reach the browser")
        request("/api/sync", {"messages": sample_messages(), "appearance": {"communitySort": "sideways", "inboxFilters": ["-inbox"]}})
        check("communitySort" not in request("/api/inbox")["appearance"] and "inboxFilters" not in request("/api/inbox")["appearance"],
              "The phone's invalid choices were kept")
        request("/api/settings", {"prefs": {"communitySort": "recent", "showCommunityChats": True, "inboxFilters": []}})

    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("SKIP  Communities sorting and inbox filter rules in Node: node is missing")
        return
    script = "globalThis.localStorage = {getItem: () => null, setItem() {}};\n" + "\n".join(
        (ROOT / "server" / name).read_text() for name in ("servers.js", "inbox-filters.js")).replace(
        "SETTINGS_SUBPAGES.push(", "[].push(") + r"""
const wrong = [];
const same = (a, b, why) => { if (JSON.stringify(a) !== JSON.stringify(b)) wrong.push(why + ': ' + JSON.stringify(a)); };
const servers = [{id: 'irc:k@alpha', name: 'Alpha Net', order: 0}, {id: 'matrix:@k:beta.test', name: 'beta.test', order: 1},
  {id: 'xmpp:k@gamma.test', name: 'gamma.test', order: 2}];
const channels = [
  {account: 'irc:k@alpha', name: '#radio-club', last: 500, joined: 1}, {account: 'irc:k@alpha', name: '#antennas', last: 900, joined: 3, unread: true},
  {account: 'matrix:@k:beta.test', name: 'Seed swap', last: 700, joined: 5}, {account: 'matrix:@k:beta.test', name: 'Allotments', last: 100, joined: 4}];
const shape = (sort) => communityGroups(servers, channels, sort).map((group) => [group.server.name, group.channels.map((c) => c.name), group.unread]);
same(shape('recent'), [['Alpha Net', ['#antennas', '#radio-club'], 1], ['beta.test', ['Seed swap', 'Allotments'], 0], ['gamma.test', [], 0]], 'recent');
same(shape('name'), [['Alpha Net', ['#antennas', '#radio-club'], 1], ['beta.test', ['Allotments', 'Seed swap'], 0], ['gamma.test', [], 0]], 'name');
same(shape('joined'), [['gamma.test', [], 0], ['beta.test', ['Seed swap', 'Allotments'], 0], ['Alpha Net', ['#antennas', '#radio-club'], 1]], 'joined');
same(shape('sideways'), shape('recent'), 'unknown sort');
// Inbox filters: the stored order, the menu, and the rules in each scope.
const order = inboxFilterOrder(['groups', '-unread', 'inbox', '-inbox', 'spam', 'groups']);
same(order.slice(0, 3), [{id: 'groups', shown: true}, {id: 'unread', shown: false}, {id: 'inbox', shown: true}], 'order');
same(order.length, INBOX_FILTERS.length, 'every filter');
same(encodeInboxFilters(order).slice(0, 3), ['groups', '-unread', 'inbox'], 'encode');
same(inboxFilterMenu(inboxFilterOrder(['inbox', 'irc', 'matrix']), new Set(['sms', 'irc'])).slice(0, 3), ['inbox', 'irc', 'unread'], 'menu');
const chat = (facts) => ({group: false, favorite: false, unread: false, services: new Set(['sms']), ...facts});
same(['groups', 'direct', 'favorites', 'texts', 'matrix', 'unread'].map((id) => inboxFilterMatches(id, chat({group: true, services: new Set(['matrix'])}))),
  [true, false, false, false, true, false], 'group room');
same(['groups', 'direct', 'favorites', 'texts'].map((id) => inboxFilterMatches(id, chat({favorite: true}))), [false, true, true, true], 'favorite text');
const place = (facts) => ({hidden: false, archived: false, blocked: false, ...facts});
same(['inbox', 'groups', 'archived', 'blocked'].map((id) => inboxFilterPlaces('', id, place({hidden: true}))), [false, false, false, false],
  'the private folder leaks');
same(['inbox', 'groups', 'archived'].map((id) => inboxFilterPlaces('private', id, place({hidden: true}))), [true, true, false], 'inside the private folder');
same(inboxFilterPlaces('', 'archived', place({archived: true})), true, 'archived');
same(inboxFilterPlaces('', 'favorites', place({archived: true})), false, 'archived favorite');
// A decoy session never matches real favorites, even if they were somehow known.
var privacyStatus = {private: null}, sampleOn = false;
globalThis.decoyLike = () => true;
globalThis.starredList = () => ['+12025550123'];
globalThis.threadAddress = (key) => key.split('\u001f')[0];
globalThis.sameText = (a, b) => a === b;
globalThis.sameNumber = (a, b) => a === b;
same(favoriteChat('+12025550123\u001fsms'), false, 'decoy favorite');
globalThis.decoyLike = () => false;
same(favoriteChat('+12025550123\u001fsms'), true, 'real favorite');
if (wrong.length) { console.log(wrong.join('\n')); process.exit(1); }
"""
    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0, "Communities or inbox filter rules failed in Node: " + (result.stdout + result.stderr).strip()[:600])
    print("PASS  Chats | Communities and inbox filters: the switch is served, servers and channels sort by recent activity, name, "
          "and date joined, filters keep to the inbox, private folder, and decoy scopes, and their prefs round trip")


# The request rule's cases, shared with the phone's MessageRequestsTest.kt: [service, facts that are on, decision,
# settings, expected]. "texts" filters unknown texts (off by default); "nochats" turns the chat services filter off.
REQUEST_CASES = [
    ["sms", [], "", [], False], ["sms", [], "", ["texts"], True], ["sms", ["contact"], "", ["texts"], False],
    ["sms", ["favorite"], "", ["texts"], False], ["sms", ["sent"], "", ["texts"], False], ["sms", ["group"], "", ["texts"], False],
    ["sms", ["automated"], "", ["texts"], False], ["sms", [], "accepted", ["texts"], False],
    ["sms", [], "deleted:1700000000000", ["texts"], True],
    ["irc", ["stranger"], "", [], True], ["xmpp", ["stranger"], "", [], True], ["matrix", ["stranger"], "", [], True],
    ["email", ["stranger"], "", [], True], ["irc", ["stranger"], "", ["nochats"], False], ["irc", [], "", [], False],
    ["xmpp", ["stranger", "sent"], "", [], False], ["email", ["stranger", "contact"], "", [], False],
    ["matrix", ["stranger", "favorite"], "", [], False], ["irc", ["stranger"], "accepted", [], False],
    ["matrix", ["invite", "stranger"], "", [], True], ["matrix", ["invite", "group", "stranger"], "", [], True],
    ["matrix", ["invite"], "accepted", [], False], ["irc", ["stranger", "service"], "", [], False], ["irc", ["group"], "", [], False],
    ["xmpp", ["group", "stranger"], "", [], False],
]
SERVICE_CASES = [["irc", "NickServ", True], ["irc", "ChanServ", True], ["irc", "*status", True], ["irc", "irc.example.net", True],
                 ["irc", "kestrel", False], ["irc", "servant", False], ["xmpp", "example.org", True], ["xmpp", "amir@example.org", False],
                 ["matrix", "@server:example.org", True], ["matrix", "@maya:example.org", False],
                 ["email", "MAILER-DAEMON@example.org", True], ["email", "leah@example.org", False]]


def requests_test():
    """Message requests and automated senders on FluidMessages Web: the rules (the phone's cases), chats from strangers
    on IRC, XMPP, and Matrix invites, the accept, delete, block, and report endpoints, the settings, the merge with the
    phone, and decoy sessions. Fictional people and numbers only."""
    sys.path.insert(0, str(ROOT / "server"))
    import sqlite3
    import accounts
    import message_requests
    import protocol_gateway

    # In the gateway: who gets a chat of their own.
    with tempfile.TemporaryDirectory(prefix="fluid-requests-") as directory:
        database = Path(directory) / "gateway.sqlite"
        connect = lambda: sqlite3.connect(database, timeout=10)
        with closing(connect()) as db, db:
            db.executescript(protocol_gateway.SCHEMA)
        store = accounts.AccountStore(Path(directory) / "accounts.json", environ={})
        store.save("irc", {"server": "irc.harbor.test", "nick": "fluidtest", "channels": "#radio-club"})
        store.save("xmpp", {"jid": "you@harbor.test", "password": "fixture-password"})
        store.save("matrix", {"homeserver": "https://matrix.harbor.test", "user_id": "@you:harbor.test", "access_token": "fixture-token"})
        gateway = protocol_gateway.Gateway(connect, {}, Path(directory) / "files", store)
        gateway.refresh_clients = lambda: None
        now = int(time.time() * 1000)
        gateway.accept_irc("kestrel", "kestrel", "Are you selling the antenna?", {}, now, False)
        gateway.accept_irc("NickServ", "NickServ", "This nickname is registered.", {"service": "1"}, now, False)
        gateway.accept_irc("irc.harbor.test", "irc.harbor.test", "Welcome", {}, now, False)
        gateway.accept_irc("#radio-club", "mosaic", "Antenna night is Friday", {}, now, False)
        stranger = gateway.irc_route("kestrel")
        check(stranger and stranger.get("request") is True and not stranger["group"], "An IRC private message didn't start a request")
        # NickServ gets its own automated chat (chat_features.irc_fallback), never a request; the server's lines go to
        # the network's server chat.
        service = gateway.irc_route("NickServ")
        check(service and service.get("automated") is True and not service.get("request") and gateway.irc_route("irc.harbor.test") is None,
              "NickServ became a request, or the server got a chat of its own")
        check(not gateway.irc_route("#radio-club").get("request"), "A joined channel was marked as a request")
        with closing(connect()) as db:
            texts = [json.loads(row[0])["body"] for row in db.execute("SELECT payload FROM protocol_messages")]
        check("Are you selling the antenna?" in texts, "The stranger's message didn't arrive")
        gateway.accept_xmpp("rowan@harbor.test", "rowan@harbor.test", "Hello from the garden club", "x1", now, False, {})
        gateway.accept_xmpp("amir@harbor.test", "amir@harbor.test", "Train at six", "x2", now, False, {"roster": True})
        gateway.accept_xmpp("harbor.test", "harbor.test", "Server notice", "x3", now, False, {})
        check(gateway.xmpp_route("rowan@harbor.test").get("request") is True, "An XMPP chat from a stranger isn't a request")
        check(not gateway.xmpp_route("amir@harbor.test").get("request"), "Someone in the XMPP roster was a request")
        check(gateway.xmpp_route("harbor.test") is None, "The XMPP server got a chat")
        message_requests.matrix_invites(gateway, "matrix:@you:harbor.test", {"rooms": {"invite": {"!lantern:harbor.test": {"invite_state": {"events": [
            {"type": "m.room.member", "sender": "@juniper:harbor.test", "content": {"membership": "invite", "is_direct": True}}]}}}}})
        invite = next(route for route in gateway.routes if route["target"] == "!lantern:harbor.test")
        check(invite.get("invite") is True and invite["inviter"] == "@juniper:harbor.test", "A Matrix invite didn't show as a request")
        calls = []
        gateway.matrix_request = lambda path, body=None, allow_missing=False, method=None: calls.append(path) or {}
        saved = {}
        with closing(connect()) as db, db:
            result = message_requests.act(gateway, db, "accept", {"address": invite["address"]}, {"blocked": []},
                                          lambda db, chats: saved.update(chats))
        check(calls == ["join/%21lantern%3Aharbor.test"] and saved["requests"] == {invite["address"]: "accepted"},
              "Accepting a Matrix invite didn't join the room: " + repr(calls))
        check(not next(route for route in gateway.routes if route["address"] == invite["address"]).get("invite"), "The invite stayed open")
        with closing(connect()) as db, db:
            reported = message_requests.act(gateway, db, "report", {"address": invite["address"]}, saved, lambda db, chats: saved.update(chats))
        check(reported["reported"] is True and calls[-1] == "rooms/%21lantern%3Aharbor.test/report" and invite["address"] in saved["blocked"],
              "Block and report didn't block and use Matrix's report endpoint")

    token = secrets.token_hex(24)
    with companion(free_port(), token) as (origin, request, _):
        stored = request.directory / "demo.sqlite"
        settings = request("/api/settings")["prefs"]
        check({key: settings[key] for key in message_requests.PREFS} == message_requests.defaults()
              and settings["requestTexts"] is False and settings["requestChats"] is True and settings["requestNotify"] == "quiet",
              "The request settings don't start at their defaults")
        for bad in ({"requestTexts": "yes"}, {"requestNotify": "loud"}, {"automatedBlock": 1}):
            try:
                request("/api/settings", {"prefs": bad})
                raise RuntimeError("Invalid request settings were accepted: " + json.dumps(bad))
            except HTTPError as error:
                check(error.code == 400, "Expected HTTP 400 for " + json.dumps(bad))
        check(request("/api/settings", {"prefs": {"inboxFilters": ["requests", "inbox", "-automated"]}})["prefs"]["inboxFilters"][:3]
              == ["requests", "inbox", "-automated"], "The Requests and Automated filters can't be placed in the menu")
        # A stranger on IRC, the way the gateway files one, and a new number from the phone.
        now = int(time.time() * 1000)
        route = {"address": "req-0123456789abcdef", "protocol": "irc", "target": "kestrel", "via": "irc", "group": False,
                 "title": "kestrel", "members": [], "request": True}
        with closing(sqlite3.connect(stored)) as db, db:
            db.execute("INSERT INTO protocol_routes VALUES (?, 'irc', ?)", (route["address"], json.dumps(route)))
            for index, body in enumerate(("Are you selling the antenna?", "It's for the club.")):
                db.execute("INSERT INTO protocol_messages VALUES (?, ?, ?)", ("irc-ask-%d" % index, now - index, json.dumps(
                    {"id": "irc-ask-%d" % index, "address": route["address"], "protocol": "irc", "title": "kestrel", "body": body,
                     "date": now - index, "type": 1, "read": 0, "author": "kestrel"})))
        request("/api/sync", {"messages": sample_messages() + [{"address": "+12025550177", "body": "Is this the bike co-op?", "type": 1,
                                                                 "date": now, "read": 0}]})
        snapshot = request("/api/inbox")
        check(any(item.get("request") is True and item["address"] == route["address"] for item in snapshot["routes"]),
              "The browser doesn't see that a chat is a request")
        try:
            request("/api/requests/nonsense", {"address": route["address"]})
            raise RuntimeError("An unknown request action worked")
        except HTTPError as error:
            check(error.code == 400, "An unknown request action didn't fail cleanly")
        accepted = request("/api/requests/accept", {"address": route["address"], "contact": True, "name": "Kestrel"})
        check(accepted["web_chats"]["requests"] == {route["address"]: "accepted"}, "Accept wasn't remembered")
        check(not next(item for item in request("/api/inbox")["routes"] if item["address"] == route["address"]).get("request"),
              "Accept didn't move the chat to the inbox")
        check(any(contact["name"] == "Kestrel" and contact["addresses"] == [{"service": "irc", "address": "kestrel"}]
                  for contact in request("/api/contacts")["contacts"]), "Accept with Add to contacts didn't add the contact")
        blocked = request("/api/requests/block", {"address": "+12025550177"})
        check("+12025550177" in blocked["web_chats"]["blocked"], "Block didn't block the number")
        reported = request("/api/requests/report", {"address": "+12025550199"})
        check("+12025550199" in reported["web_chats"]["blocked"] and reported["reported"] is False, "Block and report didn't block a text")
        deleted = request("/api/requests/delete", {"address": route["address"]})
        check(deleted["web_chats"]["requests"][route["address"]].startswith("deleted:"), "Delete wasn't remembered")
        check(not any(item["address"] == route["address"] for item in request("/api/inbox")["messages"]), "Delete left the messages")
        check(not any(item["address"] == route["address"] for item in request("/api/inbox")["routes"]), "Delete left the stranger's chat")
        request("/api/requests/accept", {"address": "+12025550188"})
        request("/api/settings", {"prefs": {"requestTexts": True, "automatedOut": True}})

        # The merge: only a phone that asks sees these items, and its changes land in the web's settings.
        plain = request("/api/merge", extra_headers={"X-Fluid-Merge-Items": "muteuntil"})
        check(plain["requests"] == 1 and not any(key.startswith(("request:", "requests:")) for key in plain["web"]),
              "A phone that didn't ask got message request items")
        asked = request("/api/merge", extra_headers={"X-Fluid-Merge-Items": "muteuntil", "X-Fluid-Merge-Requests": "1"})
        check(asked["web"].get("request:+12025550188") == "accepted" and asked["web"].get("requests:texts") == "on"
              and asked["web"].get("requests:automatedOut") == "on" and "requests:chats" not in asked["web"],
              "The web's request settings or decisions didn't reach the phone: " + json.dumps(asked["web"])[:300])
        merged = request("/api/merge", {"revision": asked["revision"], "mute_until": 1, "requests": 1, "conflicts": [],
                                        "apply_web": {"request:+12025550166": "accepted", "requests:notify": "off", "requests:texts": None},
                                        "baseline": {**asked["web"], "request:+12025550166": "accepted", "requests:notify": "off"}})
        check(merged["web"].get("request:+12025550166") == "accepted" and merged["web"].get("requests:notify") == "off"
              and "requests:texts" not in merged["web"], "The phone's request settings didn't reach the web")
        prefs = request("/api/settings")["prefs"]
        check(prefs["requestNotify"] == "off" and prefs["requestTexts"] is False, "The merged request settings weren't saved")
        # The same items for a phone that lists them with the other newer groups (X-Fluid-Merge-Groups and "items").
        grouped = request("/api/merge", extra_headers={"X-Fluid-Merge-Items": "muteuntil",
                                                       "X-Fluid-Merge-Groups": "muteuntil,pref,favorite,request,requests"})
        check(grouped["requests"] == 1 and "request" in grouped["items"] and "requests" in grouped["items"]
              and grouped["web"].get("request:+12025550166") == "accepted" and grouped["web"].get("requests:notify") == "off",
              "A phone listing request groups in X-Fluid-Merge-Groups didn't get them: " + json.dumps(grouped["web"])[:300])
        regrouped = request("/api/merge", {"revision": grouped["revision"], "items": ["muteuntil", "pref", "favorite", "request", "requests"],
                                           "mute_until": 1, "conflicts": [], "apply_web": {"requests:notify": None},
                                           "baseline": {key: value for key, value in grouped["web"].items() if key != "requests:notify"}})
        check("requests:notify" not in regrouped["web"] and regrouped["web"].get("request:+12025550166") == "accepted",
              "A request setting posted in \"items\" style didn't reach the web")
        # Groups the phone didn't name are left alone: a "pref"-only phone can't change request items.
        prefs_only = request("/api/merge", extra_headers={"X-Fluid-Merge-Groups": "muteuntil,pref"})
        request("/api/merge", {"revision": prefs_only["revision"], "items": ["muteuntil", "pref"], "mute_until": 1, "conflicts": [],
                               "apply_web": {"request:+12025550166": None}, "baseline": prefs_only["web"]})
        check(request("/api/merge", extra_headers={"X-Fluid-Merge-Requests": "1"})["web"].get("request:+12025550166") == "accepted",
              "A phone that didn't name the request groups changed them")

    # Decoy sessions only ever see the decoy world: no real requests, decisions, or request actions.
    password, decoy = "harbor maple lantern", "willow candle orbit"
    opener = build_opener(ProxyHandler({}))
    with companion(free_port(), "") as (origin, request, _):
        def call(path, body=None, cookie=None):
            sent = {"X-Fluid-Request": "1", "Content-Type": "application/json", "Origin": origin}
            if cookie:
                sent["Cookie"] = cookie
            try:
                with opener.open(Request(origin + path, data=json.dumps(body).encode() if body is not None else None, headers=sent),
                                 timeout=30) as response:
                    return response.status, json.loads(response.read() or b"{}"), response.headers
            except HTTPError as error:
                return error.code, json.loads(error.read() or b"{}"), error.headers
        status, _, headers = call("/api/auth/local", {})
        here = headers.get("Set-Cookie").split(";")[0]
        check(call("/api/auth/password", {"password": password}, cookie=here)[0] == 200, "Couldn't set the web password")
        bearer = {"Authorization": "Bearer " + call("/api/auth/pairing", {}, cookie=here)[1]["token"]}
        request("/api/sync", {"messages": [{"address": "+12025550177", "body": "Fictional request text", "type": 1,
                                            "date": int(time.time() * 1000), "read": 0}]}, authorized=False, extra_headers=bearer)
        check(call("/api/requests/accept", {"address": "+12025550177"}, cookie=here)[0] == 200, "The real session couldn't accept")
        check(call("/api/privacy/decoy", {"password": decoy, "again": decoy, "current": password}, cookie=here)[0] == 200,
              "Couldn't set the decoy password")
        status, _, headers = call("/api/auth/login", {"password": decoy, "remember": False})
        fake = headers.get_all("Set-Cookie")[0].split(";")[0]
        seen = json.dumps(call("/api/inbox", cookie=fake)[1]) + json.dumps(call("/api/settings", cookie=fake)[1])
        check("5550177" not in seen and "Fictional request text" not in seen, "A decoy session sees a real request or its decision")
        for action in ("accept", "delete", "block", "report"):
            check(call("/api/requests/" + action, {"address": "+12025550177"}, cookie=fake)[0] == 503,
                  "A decoy session reached /api/requests/" + action)
        real = call("/api/settings", cookie=here)[1] if call("/api/settings", cookie=here)[0] == 200 else {}
        check(real.get("web_chats", {}).get("requests", {}).get("+12025550177") == "accepted", "The decoy session changed a real decision")

    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("PASS  message requests on FluidMessages Web (the rules in Node skipped: node is missing)")
        return
    script = "\n".join((ROOT / "server" / name).read_text() for name in ("inbox-filters.js", "requests.js")).replace(
        "SETTINGS_SUBPAGES.push(", "[].push(") + "\nconst CASES = " + json.dumps(REQUEST_CASES) + ";\nconst SERVICES = " \
        + json.dumps(SERVICE_CASES) + r""";
const wrong = [];
for (const [service, on, decision, flags, expected] of CASES) {
  const facts = {service, decision, ...Object.fromEntries(['group', 'invite', 'contact', 'favorite', 'sent', 'automated', 'service', 'stranger']
    .map((name) => [name === 'service' ? 'networkService' : name, on.includes(name)]))};
  facts.service = service;
  const settings = {...REQUEST_DEFAULTS, requestTexts: flags.includes('texts'), requestChats: !flags.includes('nochats')};
  if (isRequest(facts, settings) !== expected) wrong.push(JSON.stringify([service, on, decision, flags]) + ' should be ' + expected);
}
for (const [service, name, expected] of SERVICES) if (requestNetworkService(service, name) !== expected) wrong.push(service + ' ' + name);
if (requestDeletedAt('deleted:1700000000000') !== 1700000000000 || requestDeletedAt('accepted') !== 0) wrong.push('deleted at');
// Where chats go: Requests and Automated in the inbox, the private folder, and their filters.
const place = (facts) => ({hidden: false, archived: false, blocked: false, ...facts});
const shown = (scope, facts) => ['inbox', 'unread', 'texts', 'requests', 'automated', 'archived', 'blocked'].filter((id) => inboxFilterPlaces(scope, id, place(facts)));
const same = (a, b, why) => { if (JSON.stringify(a) !== JSON.stringify(b)) wrong.push(why + ': ' + JSON.stringify(a)); };
same(shown('', {request: true}), ['requests'], 'a request');
same(shown('', {request: true, blocked: true}), ['blocked'], 'a blocked request');
same(shown('', {automatedOut: true}), ['automated'], 'automated kept out of the inbox');
same(shown('', {automated: true}), ['inbox', 'unread', 'texts', 'requests', 'automated'].filter((id) => id !== 'requests'), 'automated in the inbox');
same(shown('', {request: true, dismissed: true}), [], 'a deleted request');
same(shown('', {request: true, hidden: true}), [], 'a private request');
same(shown('private', {request: true, hidden: true}), ['requests'], 'a request in the private folder');
same(inboxFilterMatches('automated', {automated: true, services: new Set(['sms'])}), true, 'the Automated filter');
same(inboxFilterMatches('automated', {automated: false, services: new Set(['sms'])}), false, 'not automated');
same(INBOX_FILTERS.map((filter) => filter.id).filter((id) => ['requests', 'automated'].includes(id)), ['requests', 'automated'], 'the filters');
// The settings default like the phone's, and the sample inbox filters unknown texts.
var prefs = {}, sampleOn = false;
same(requestSettings(), REQUEST_DEFAULTS, 'defaults');
prefs = {requestNotify: 'loud', requestTexts: 'yes', automatedBlock: true};
same([requestSettings().requestNotify, requestSettings().requestTexts, requestSettings().automatedBlock], ['quiet', false, true], 'cleaning');
sampleOn = true;
same(requestSettings().requestTexts, true, 'the sample');
if (wrong.length) { console.log(wrong.join('\n')); process.exit(1); }
"""
    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0, "Message request rules failed in Node: " + (result.stdout + result.stderr).strip()[:900])
    print("PASS  message requests: the rules match the phone's (contacts, accepted, services, joined channels, defaults per service), "
          "IRC and XMPP strangers and Matrix invites become requests, accept/delete/block/report, Add to contacts, settings, "
          "the opt-in merge both ways, and decoy sessions never see real requests")


def server_directory_test():
    """Add server's public server list and Browse search, with fictional fixtures only, and no "Discord" anywhere served."""
    sys.path.insert(0, str(ROOT / "server"))
    import asyncio
    import sqlite3
    import accounts
    import protocol_gateway
    import xmpp_client

    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        index = request("/", authorized=False).decode()
        scripts = re.findall(r'(?:src|href)="(/[^"#?]+)"', index)
        check(scripts.index("/server-directory.js") < scripts.index("/servers.js"), "The page doesn't load the server list before servers.js")
        shell = request("/sw.js", authorized=False).decode()
        check("'/server-directory.js'" in shell, "The service worker doesn't cache the server list")
        served = {"/": index, "/sw.js": shell}
        for path in scripts + re.findall(r"'(/[^']+\.(?:js|css|html|webmanifest))'", shell):
            if path not in served and not path.endswith((".png", ".ico", ".webp")):
                served[path] = request(path, authorized=False).decode()
        mentions = [path for path, text in served.items() if "discord" in text.lower()]
        check(not mentions, "Discord is mentioned in " + ", ".join(mentions))
        directory = served["/server-directory.js"]
        check("const SERVER_DIRECTORY" in directory and "function directorySearch" in directory, "The server list isn't served")
        servers_js = served["/servers.js"]
        check(all(name in servers_js for name in ("function showServerList", "Other server…", "function emptyServerRows", "roomSearch(found"))
              and "prompt(" not in servers_js and "confirm(" not in servers_js and "alert(" not in servers_js,
              "Add server or Browse isn't a full page with search")

    node = os.environ.get("NODE") or shutil.which("node")
    if node:
        # The list itself: valid TLS hosts and ports, no duplicates, and search by name, address, or description.
        script = (ROOT / "server/server-directory.js").read_text() + r"""
const wrong = [];
const host = /^(?=.{1,253}$)([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/;
for (const [service, list] of Object.entries(SERVER_DIRECTORY)) {
  const names = new Set(list.map((entry) => entry.name.toLowerCase())), addresses = new Set(list.map(directoryAddress));
  if (names.size !== list.length || addresses.size !== list.length) wrong.push(service + ' duplicates');
  for (const entry of list) {
    const address = directoryAddress(entry).replace(/^https:\/\//, '');
    if (!host.test(address) || !entry.about) wrong.push(entry.name);
    if (service === 'irc' && entry.tls !== false && entry.port !== 6697) wrong.push(entry.name + ' port');
    if (service === 'matrix' && !entry.homeserver.startsWith('https://')) wrong.push(entry.name + ' https');
  }
}
for (const name of ['Libera.Chat', 'OFTC', 'EFnet', 'IRCnet', 'Undernet', 'DALnet', 'QuakeNet', 'Rizon', 'hackint', 'Snoonet', 'GIMPNet', 'EsperNet'])
  if (!SERVER_DIRECTORY.irc.some((entry) => entry.name === name)) wrong.push('missing ' + name);
const names = (list) => list.map((entry) => entry.name).join();
if (names(directorySearch(SERVER_DIRECTORY.irc, ' debian TOR ')) !== 'OFTC') wrong.push('search words');
if (names(directorySearch(SERVER_DIRECTORY.matrix, 'Mozílla')) !== 'mozilla.org') wrong.push('search accents');
if (directorySearch(SERVER_DIRECTORY.xmpp, '').length !== SERVER_DIRECTORY.xmpp.length) wrong.push('empty search');
if (!/paid/.test(SERVER_DIRECTORY.xmpp.find((entry) => entry.name === 'conversations.im').about)) wrong.push('paid');
const rooms = [{target: '#gardening', name: '#gardening', topic: 'Seeds and soil'}, {target: '!c:example.test', name: 'Chess club', alias: '#chess:example.test'}];
if (roomSearch(rooms, 'soil').map((room) => room.target).join() !== '#gardening') wrong.push('room topic');
if (roomSearch(rooms, '#chess').map((room) => room.target).join() !== '!c:example.test') wrong.push('room alias');
if (roomSearch(rooms, '').length !== 2) wrong.push('room empty');
process.stdout.write(JSON.stringify(wrong));
"""
        result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
        check(result.returncode == 0 and result.stdout == "[]", "The server list or its search is wrong: " + (result.stdout or result.stderr)[:400])
    else:
        print("Skipped running the server list's search: node isn't installed (set NODE to its path)")

    # Browse asks each server to search where it can (IRC LIST mask, Matrix filter) and XMPP is filtered here.
    with tempfile.TemporaryDirectory(prefix="fluid-browse-") as directory:
        database = Path(directory) / "gateway.sqlite"
        connect = lambda: sqlite3.connect(database, timeout=10)
        with closing(connect()) as db, db:
            db.executescript(protocol_gateway.SCHEMA)
        store = accounts.AccountStore(Path(directory) / "protocol-accounts.json", environ={})
        store.save("irc", {"server": "irc.example.test", "nick": "fluidtest"}, add=True)
        store.save("xmpp", {"jid": "sam@example.test", "password": "fixture-password"}, add=True)
        gateway = protocol_gateway.Gateway(connect, {}, Path(directory) / "files", store)
        gateway.refresh_clients = lambda: None
        asked = []

        class FakeIrc:
            def list_channels(self, search, limit):
                asked.append(search)
                rows = [{"target": "#gardening", "name": "#gardening", "members": 12, "topic": "Seeds"},
                        {"target": "#radio", "name": "#radio", "members": 4, "topic": "Antennas"}]
                return [row for row in rows if search in row["target"]][:limit]

        class FakeDisco:
            async def get_items(self, jid, timeout):
                return {"disco_items": {"items": [("garden@conference.example.test", None, "Garden club"),
                                                  ("radio@conference.example.test", None, "Ham radio")]}}

        class FakeXmpp:
            client = type("Client", (), {"plugin": {"xep_0030": FakeDisco()}})()
            call = staticmethod(asyncio.run)
            browse = xmpp_client.XmppClient.browse
            muc_services = lambda self: ["conference.example.test"]

        clients = {"irc": FakeIrc(), "xmpp": FakeXmpp()}
        gateway.client = lambda protocol: clients[protocol]
        irc, xmpp = "irc:fluidtest@irc.example.test", "xmpp:sam@example.test"
        found = gateway.browse({"account": irc, "search": "garden", "limit": 50})["rooms"]
        check(asked == ["garden"] and [room["target"] for room in found] == ["#gardening"] and found[0]["members"] == 12
              and not found[0]["joined"], "IRC Browse didn't search the network")
        with closing(connect()) as db, db:
            channel = gateway.join(db, {"account": irc, "target": "#gardening"})["route"]
        check(channel["title"] == "#gardening", "A joined IRC channel isn't named #name")
        check(gateway.browse({"account": irc, "search": "", "limit": 50})["rooms"][0]["joined"], "A joined channel isn't marked Joined")
        check(gateway.browse({"account": xmpp, "search": ""})["services"] == ["conference.example.test"], "XMPP services weren't listed")
        rooms = gateway.browse({"account": xmpp, "search": "HAM", "service": "conference.example.test", "limit": 50})["rooms"]
        check([room["name"] for room in rooms] == ["Ham radio"], "XMPP Browse didn't filter group chats")
        with closing(connect()) as db, db:
            room = gateway.join(db, {"account": xmpp, "target": "radio@conference.example.test"})["route"]
        check(room["title"] == "radio" and room["group"], "A group chat joined by address isn't named after the room")
        servers = {server["id"]: server for server in gateway.servers()}
        check(channel["address"] in servers[irc]["channels"] and room["address"] in servers[xmpp]["channels"],
              "Joined channels and rooms aren't listed under their server")
    print("PASS  Add server: public server list served and searchable (no Discord anywhere served); Browse searches IRC by "
          "mask and filters XMPP group chats; joined channels and rooms are named and listed under their server")


def account_setup_test():
    """Adding an account on the web: the email provider table, the server found from a Matrix ID or XMPP address, IRC
    channel names and Popular here, the guide page for each service, and the form that fills itself in. Fictional
    addresses only; nothing here connects anywhere."""
    sys.path.insert(0, str(ROOT / "server"))
    import accounts

    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        index = request("/", authorized=False).decode()
        scripts = re.findall(r'src="(/[^"#?]+)"', index)
        check("/account-setup.js" in scripts and scripts.index("/server-directory.js") < scripts.index("/account-setup.js")
              < scripts.index("/servers.js"), "The page doesn't load account-setup.js between the server list and servers.js")
        check("'/account-setup.js'" in request("/sw.js", authorized=False).decode(), "The service worker doesn't cache account-setup.js")
        setup = request("/account-setup.js", authorized=False).decode()
        servers_js = request("/servers.js", authorized=False).decode()
        companion_js = request("/companion.js", authorized=False).decode()
        css = request("/features.css", authorized=False).decode()
    check(all(name in setup for name in ("function serviceGuide", "function setUpAccountForm", "Get started", "I already know what I’m doing",
                                         "Don’t have an account yet?", "Show details")), "The add-account guide or automatic setup isn't served")
    check("showModal" not in setup and "prompt(" not in setup and "alert(" not in setup and "confirm(" not in setup,
          "The add-account guide opens a pop-up instead of a full page")
    check("function openServerGuide" in servers_js and "openServerGuide(protocol)" in servers_js and "Popular here" in servers_js
          and "You’re not connected to " in servers_js and "'Connect'" in servers_js,
          "Add server skips the guide, or Browse has no Popular here list or plain not-connected state")
    check("serviceGuide(protocol" in companion_js and "setUpAccountForm(form, inputs, protocol" in companion_js,
          "Settings and the setup guide add accounts without the guide page or automatic setup")
    check(".service-guide-art" in css and ".setup-note" in css and "style=" not in setup,
          "The guide's picture isn't styled from the theme (inline styles are blocked by the page's security policy)")
    for brand in ("whatsapp", "telegram", "slack", "discord", "monal"):
        check(not re.search(r"\b" + brand + r"\b", setup, re.I),
              "The add-account guide names a brand-name chat app: " + brand)
    # The table only uses ports whose security the server really applies (TLS from the start, or STARTTLS).
    check(not accounts.imap_starttls(993) and not accounts.smtp_starttls(465) and accounts.smtp_starttls(587) and accounts.smtp_starttls(1025)
          and not accounts.imap_starttls(1143), "The server's email port rules changed; update the provider table's wording")

    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("PASS  add-account guide and automatic setup are served (the rules in Node skipped: node is missing)")
        return
    block = re.search(r"// account-setup:start[^\n]*\n(.*?)// account-setup:end", (ROOT / "server/account-setup.js").read_text(), re.S)
    check(block, "account-setup.js has no rules block")
    script = (ROOT / "server/server-directory.js").read_text() + block.group(1) + r"""
