    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0 and result.stdout == "[]", "Automatic account setup is wrong: " + (result.stdout or result.stderr)[:900])
    # What the form sends for each provider is an account the server accepts, with the security the table says.
    for address, host, port in (("sam@gmail.com", "imap.gmail.com", 993), ("sam@outlook.com", "outlook.office365.com", 993),
                                ("sam@pm.me", "127.0.0.1", 1143), ("sam@garden.example", "imap.garden.example", 993)):
