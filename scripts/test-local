#!/usr/bin/env python3
"""Exercise FluidMessages locally without touching a real inbox."""
import argparse
from concurrent.futures import ThreadPoolExecutor
from contextlib import closing, contextmanager
import json
import os
import re
from pathlib import Path
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from urllib.error import HTTPError, URLError
from urllib.request import ProxyHandler, Request, build_opener
import webbrowser
import zipfile

ROOT = Path(__file__).resolve().parents[1]
PACKAGE = "org.fluidmessages"
GRADLE_APK = ROOT / "app/build/outputs/apk/debug/app-debug.apk"
CLOUD_TARGETS = ("onedrive", "drive", "s3")


def check(condition, message):
    if not condition:
        raise RuntimeError(message)


@contextmanager
def companion(port, token, cloud_fixtures=False, extra_env=None):
    with tempfile.TemporaryDirectory(prefix="fluid-test-") as directory:
        env = dict(os.environ, FLUID_DB=str(Path(directory) / "demo.sqlite"),
                   FLUID_TOKEN=token, FLUID_BIND="127.0.0.1", FLUID_PORT=str(port),
                   RCLONE_CONFIG=str(Path(directory) / "rclone.conf"))
        # The phone's HTTPS port is off unless a test turns it on (companion_tls_test), so ports never clash.
        env.update({"FLUID_LOCAL_ONLY": "", "FLUID_TLS_PORT": "0", **(extra_env or {})})
        # FLUID_TOKEN is optional: an empty one means browsers sign in with a password only.
        for key in CLOUD_TARGETS:
            folder = Path(directory) / key
            if cloud_fixtures:
                folder.mkdir()
            env["FLUID_BACKUP_" + key.upper()] = str(folder) if cloud_fixtures else ""
        process = subprocess.Popen(
            [sys.executable, str(ROOT / "server/main.py")],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        origin = f"http://127.0.0.1:{port}"
        opener = build_opener(ProxyHandler({}))

        def request(path, body=None, authorized=True, method=None, extra_headers=None):
            headers = {"Authorization": "Bearer " + token} if authorized else {}
            headers.update(extra_headers or {})
            data = body if isinstance(body, bytes) else json.dumps(body).encode() if body is not None else None
            with opener.open(Request(origin + path, data=data, headers=headers, method=method), timeout=5) as response:
                content = response.read()
                return json.loads(content) if response.headers.get_content_type() == "application/json" else content

        try:
            for _ in range(50):
                check(process.poll() is None, "Companion failed to start. The port may already be in use.")
                try:
                    request("/", authorized=False)
                    break
                except URLError:
                    time.sleep(0.05)
            else:
                raise RuntimeError("Timed out starting the companion")
            request.directory, request.env = Path(directory), env
            yield origin, request, process
        finally:
            process.terminate()
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


def free_port():
    try:
        with socket.socket() as listener:
            listener.bind(("127.0.0.1", 0))
            return listener.getsockname()[1]
    except PermissionError as error:
        raise RuntimeError("Loopback networking is blocked. Run this command from a regular terminal.") from error


def sample_messages():
    now = int(time.time() * 1000)
    return [
        {"address": "+12025550123", "body": "See you there!", "type": 2, "date": now - 60_000},
        {"address": "+12025550123", "body": "Coffee at ten?", "type": 1, "date": now - 90_000},
        {"address": "+12025550146", "body": "I sent the route for Saturday.", "type": 1, "date": now - 150_000},
    ]


def smoke_test():
    with companion(free_port(), secrets.token_hex(32)) as (_, request, _):
        for path, expected in (("/", b"FluidMessages"), ("/app.js", b"schedule"), ("/style.css", b"--canvas")):
            check(expected in request(path, authorized=False), f"Missing browser asset at {path}")
        try:
            request("/api/inbox", authorized=False)
        except HTTPError as error:
            check(error.code == 401, f"Expected HTTP 401, got {error.code}")
        else:
            raise RuntimeError("Inbox accepted an unauthenticated request")
        messages = sample_messages()
        request("/api/sync", {"messages": messages})
        check(request("/api/inbox")["messages"] == messages, "Synced inbox differs from the phone snapshot")
        appearance = {"dark": True, "exactTimes": True, "radius": 19, "folders": {"archived": [messages[0]["address"]]},
                      "colors": {"sms": "#457abc", "surface": "#172e26", "raised": "#1b372d", "action": "#8bdabb",
                                 "ink": "#ffffff", "muted": "#bfccc7", "line": "#3a4d45", "outline": "#697b73"}}
        request("/api/sync", {"messages": messages, "appearance": {**appearance, "size": 900,
                "colors": {**appearance["colors"], "accent": "url(invalid)"}}})
        snapshot = request("/api/inbox")
        check(snapshot["messages"] == messages and snapshot["appearance"] == appearance,
              "Inbox and appearance snapshot were not saved together")
        request("/api/sync", {"messages": messages})
        check(request("/api/inbox")["appearance"] == {}, "Older Android sync should use the companion theme")
        now = int(time.time() * 1000)
        draft = {"address": messages[0]["address"], "body": "Test only", "due": now + 60_000}
        cancelled = request("/api/schedule", draft)["id"]
        request("/api/cancel", {"id": cancelled})
        due = request("/api/schedule", {**draft, "due": now})["id"]
        with ThreadPoolExecutor(max_workers=4) as pool:
            claims = list(pool.map(lambda _: request("/api/claim", {})["job"], range(4)))
        check([job["id"] for job in claims if job] == [due], "Due message was lost or claimed more than once")
        request("/api/result", {"id": due, "state": "submitted"})
        check({job["id"]: job["state"] for job in request("/api/jobs")} ==
              {cancelled: "cancelled", due: "submitted"}, "Queue state did not persist")
        call = request("/api/call", {"address": messages[0]["address"]})["id"]
        claimed = request("/api/claim", {})["job"]
        check(claimed and claimed["id"] == call and claimed["protocol"] == "call", "Call request was not handed to the phone")
        request("/api/result", {"id": call, "state": "submitted"})
        try:
            request("/api/call", {"address": "not a number"})
            raise RuntimeError("Companion accepted a call to a non-number")
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for an invalid call, got {error.code}")
        upload = request("/api/protocols/upload", b"fixture", extra_headers={"Content-Type": "text/plain",
                         "X-Fluid-Name": "notes%20one.txt"})
        check(re.fullmatch(r"[0-9a-f]{40}", upload.get("upload", "")) is not None, "Attachment upload did not return an id")
        try:
            request("/api/protocols/file?id=missing", authorized=True)
            raise RuntimeError("Companion served an unknown attachment")
        except HTTPError as error:
            check(error.code == 404, f"Expected HTTP 404 for a missing attachment, got {error.code}")
        web_features_test(request)
    print("PASS  Companion assets, authentication, sync, scheduling, cancellation, claiming, click-to-call and attachment uploads")
    print("PASS  web phone features: scripts served, delete for me, pinned/archived/muted chats and chat codes, appearance extras")
    print("PASS  web details and effects: conversation details and members, call icons, floating message menu, capped effects")
    print("PASS  web Calls tab: favorites, recents, contacts, keypad, contact pages, saved favorites, sample portraits, and tab counts")
    print("PASS  web Unread filter, Sounds and notifications (volume, muted chats, service worker notifications), New chat → Channels")
    print("PASS  web mutes: 1 hour to forever, older lists forever, chats, people, and servers, no notifications or chimes, ends on its own")


def web_features_test(request):
    """FluidMessages Web's phone features: their scripts, Delete for me, chat folders and codes, and appearance extras."""
    import sqlite3
    for path, expected in (("/editor.js", b"findBackground"), ("/media.js", b"startVoiceNote"), ("/chats.js", b"chatLockGate"),
                           ("/look.js", b"applyLookExtras"), ("/features.css", b".editor-stage"), ("/settings.js", b"erasePage")):
        check(expected in request(path, authorized=False), f"Missing browser asset at {path}")
    index = request("/", authorized=False)
    check(all(name in index for name in (b"/editor.js", b"/media.js", b"/chats.js", b"/look.js", b"/features.css", b"/settings.js")),
          "The page doesn't load the phone-feature scripts")
    # Delete for me removes the web copy (and cancels it if it's still queued); other messages stay.
    now = int(time.time() * 1000)
    with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db, db:
        for key, body in (("web-delete-me", "Fictional message to delete"), ("web-keep-me", "Fictional message to keep")):
            db.execute("INSERT INTO protocol_messages VALUES (?, ?, ?)", (key, now, json.dumps(
                {"id": key, "address": "web-fixture", "protocol": "matrix", "title": "Fixture", "body": body, "date": now, "type": 2, "read": 1})))
        db.execute("INSERT INTO protocol_jobs VALUES ('web-delete-me', 'matrix', '!fixture:example.test', ?, 'queued')", (now + 3_600_000,))
    check(request("/api/protocols/delete", {"id": "web-delete-me"}) == {"deleted": "web-delete-me"}, "Delete for me failed")
    ids = {message.get("id") for message in request("/api/inbox")["messages"]}
    check("web-delete-me" not in ids and "web-keep-me" in ids, "Delete for me removed the wrong message")
    with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db:
        check(db.execute("SELECT state FROM protocol_jobs WHERE id='web-delete-me'").fetchone()[0] == "cancelled",
              "A deleted message stayed in the send queue")
    for bad in ({"id": "web-delete-me"}, {"id": "../etc"}, {"id": 5}):
        try:
            request("/api/protocols/delete", bad)
            raise RuntimeError("Delete for me accepted " + json.dumps(bad))
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for a bad delete, got {error.code}")
    # Pinned, archived, blocked, and muted chats and chat codes are kept for every browser; only hashes of codes.
    chats = {"pinned": ["web-fixture"], "archived": ["+12025550188"], "blocked": [], "muted": ["web-fixture"],
             "locks": {"web-fixture": {"salt": "ab" * 16, "hash": "cd" * 32},
                       "+12025550188": {"credential": "ZmljdGlvbmFsLWNyZWRlbnRpYWw"}}}
    check(request("/api/settings", {"web_chats": chats})["web_chats"] == chats, "Chat folders and codes weren't saved")
    check(request("/api/inbox")["web_chats"] == chats, "The inbox doesn't carry chat folders and codes")
    for bad in ({"pinned": "web-fixture"}, {"locks": {"web-fixture": {"salt": "x", "hash": "plain code"}}}, {"muted": [1]},
                {"locks": {"web-fixture": {"credential": "not a credential!"}}}):
        try:
            request("/api/settings", {"web_chats": bad})
            raise RuntimeError("Invalid chat settings were accepted: " + json.dumps(bad))
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for invalid chat settings, got {error.code}")
    # Wallpaper, layout, motion, sounds, haptics, per-chat wallpapers, and saved palettes are cleaned like the phone's choices.
    look = {"theme": "love", "mode": "dark", "wallpaper": "aurora", "searchPosition": "top", "toolbarFinish": "floating", "chromeOpacity": 60,
            "density": "compact", "tails": True, "speed": 0, "sendSound": "silent", "receiveSound": "fluid", "haptics": "confirm",
            "chatWallpapers": {"web-fixture": "orchard"}, "palettes": {"Sunny": {"theme": "ember", "colors": {"sms": "#ffd60a"}}},
            "activePalette": "Sunny"}
    noisy = {**look, "wallpaper": "url(x)", "chromeOpacity": 5, "speed": 9000, "haptics": "buzz", "tails": "yes",
             "chatWallpapers": {"web-fixture": "orchard", "other": "javascript:"}, "activePalette": "Missing",
             "palettes": {"Sunny": {"theme": "ember", "colors": {"sms": "#ffd60a", "ink": "url(x)"}}, "": {"theme": "fluid"}}}
    saved = request("/api/settings", {"web_appearance": noisy})["web_appearance"]
    dropped = ("wallpaper", "chromeOpacity", "speed", "haptics", "tails", "activePalette")
    check(saved == {key: value for key, value in look.items() if key not in dropped}, "Appearance extras weren't cleaned: " + json.dumps(saved))
    check(request("/api/settings", {"web_appearance": look})["web_appearance"] == look, "Appearance extras weren't saved")
    web_mute_test(request)
    web_details_effects_test(request)
    web_details_rules_test(request)


def web_details_rules_test(request):
    """Conversation and contact details on FluidMessages Web: long member lists fold to five, on/off rows are switches,
    Block asks again in place, and linking an address suggests people from your own chats without sending anything."""
    chats_js, people_js, companion_js, style_css = (request(path, authorized=False).decode() for path in (
        "/chats.js", "/people.js", "/companion.js", "/style.css"))
    check("checkbox('Mute notifications'" in chats_js and "checkbox(title, set" in chats_js,
          "Mute, Pin, and Archive in a chat's details aren't switches")
    check(":is(.settings-page-body, .details-body) .settings-section label.check" in style_css, "Details pages don't draw switches")
    check("blockControl(threadTitle(key), [address])" in chats_js and "!threadIsGroup(key)" in chats_js
          and "blockControl(person.name, addresses)" in people_js, "Block is missing from a chat's or a person's details")
    check("linkSuggestionBox(target" in companion_js and "linkSuggestionBox(input" in people_js,
          "Linking an address doesn't suggest people from your chats")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("Skipped running the member list and link suggestion rules: node isn't installed (set NODE to its path)")
        return
    members = re.search(r"const MEMBERS_FOLD_OVER.*?(?=\nfunction memberList)", chats_js, re.S).group(0)
    suggest = re.search(r"const LINKABLE_SERVICES.*?(?=\n/\*\*\n \* The tappable suggestions)", people_js, re.S).group(0)
    script = """
const knownPeople = () => [];
""" + members + "\n" + suggest + """
const wrong = [];
const same = (label, got, want) => { if (JSON.stringify(got) !== JSON.stringify(want)) wrong.push(label + ': ' + JSON.stringify(got)); };
const people = (count) => Array.from({length: count}, (_, index) => 'Fixture person ' + (index + 1));
for (const count of [0, 5, 10]) {
  same('in full ' + count, visibleMembers(people(count), false).length, count);
  same('no button ' + count, membersToggleLabel(count, false), '');
}
same('first five of eleven', visibleMembers(people(11), false), people(5));
same('show all', membersToggleLabel(214, false), 'Show all 214 members');
same('expanded', visibleMembers(people(214), true).length, 214);
same('show fewer', membersToggleLabel(214, true), 'Show fewer');
const book = [
  {name: 'Maya Chen', accounts: [{protocol: 'matrix', target: '@maya:example.org'}, {protocol: 'xmpp', target: 'maya@example.org'}]},
  {name: 'Rosa Amaya', accounts: [{protocol: 'matrix', target: '@rosa:example.org'}]},
  {name: 'Leo Park', accounts: [{protocol: 'email', target: 'leo.park@example.org'}, {protocol: 'sip', target: 'leo@sip.example.org'}]},
  {name: 'kestrel', accounts: [{protocol: 'irc', target: 'kestrel'}, {protocol: 'irc', target: '#radio'}]},
];
const addresses = (items) => items.map((item) => item.address);
same('nothing until typed', linkSuggestions('', 'matrix', book), []);
same('that service only', addresses(linkSuggestions('maya', 'matrix', book)), ['@maya:example.org', '@rosa:example.org']);
same('any service', linkSuggestions('maya', '', book).map((item) => item.service), ['matrix', 'xmpp', 'matrix']);
same('by address', addresses(linkSuggestions('PARK', 'email', book)), ['leo.park@example.org']);
same('no SIP or channels', addresses(linkSuggestions('e', '', book)).filter((item) => item.includes('sip') || item.startsWith('#')), []);
same('exact address not repeated', linkSuggestions('kestrel', 'irc', book), []);
same('new address finds nothing', linkSuggestions('@new.person:example.org', 'matrix', book), []);
same('tag', linkSuggestions('leo', '', book)[0], {name: 'Leo Park', address: 'leo.park@example.org', service: 'email'});
process.stdout.write(JSON.stringify(wrong));
"""
    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30)
    check(result.returncode == 0 and result.stdout == "[]", "The member list or link suggestion rules are wrong: " + (result.stdout or result.stderr)[:600])
    print("PASS  web details: member lists fold over ten, switches, Block asks in place, link suggestions from your chats")


def web_mute_test(request):
    """Muting for a while or for good, on FluidMessages Web: stored with when it ends, older lists still forever, chats
    and whole servers, nothing notifies or chimes while muted, and a mute whose time is up simply stops."""
    now = int(time.time() * 1000)
    server = "server:irc:fixture@irc.example.test"
    chats = {"pinned": [], "archived": [], "blocked": [], "locks": {},
             "muted": ["web-fixture", "+12025550177", "+12025550178", server],
             "mute_until": {"web-fixture": now + 3_600_000, "+12025550177": now - 1_000}}
    saved = request("/api/settings", {"web_chats": chats})["web_chats"]
    # The one whose time is up is gone; the server and the entry without an end stay muted forever.
    check(saved["muted"] == ["web-fixture", "+12025550178", server] and saved["mute_until"] == {"web-fixture": now + 3_600_000},
          "A timed mute wasn't kept with its end: " + json.dumps(saved))
    check(request("/api/inbox")["web_chats"]["mute_until"] == {"web-fixture": now + 3_600_000}, "The inbox doesn't carry when mutes end")
    older = {"pinned": [], "archived": [], "blocked": [], "muted": ["web-fixture"], "locks": {}}
    check(request("/api/settings", {"web_chats": older})["web_chats"] == older, "An older muted list didn't stay as it was")
    for bad in ({"muted": ["a"], "mute_until": {"a": "soon"}}, {"muted": ["a"], "mute_until": {"a": -5}}, {"muted": ["a"], "mute_until": []}):
        try:
            request("/api/settings", {"web_chats": bad})
            raise RuntimeError("Invalid mute times were accepted: " + json.dumps(bad))
        except HTTPError as error:
            check(error.code == 400, f"Expected HTTP 400 for invalid mute times, got {error.code}")
    request("/api/settings", {"web_chats": {"pinned": [], "archived": [], "blocked": [], "muted": [], "locks": {}}})
    chats_js, look_js, notify_js, people_js, app_js, servers_js = (request(path, authorized=False).decode() for path in (
        "/chats.js", "/look.js", "/notify.js", "/people.js", "/app.js", "/servers.js"))
    check("personMuteSection(person, chats)" in people_js and "serverMuteControls(account.id" in servers_js
          and "updateMuteMark()" in app_js, "The contact page, server bar, or chat header doesn't offer muting")
    check("chatMuted(message.address)) continue" in notify_js, "Notifications don't check for muted chats")
    node = os.environ.get("NODE") or shutil.which("node")
    if not node:
        print("Skipped running the mute rules: node isn't installed (set NODE to its path)")
        return
    block = re.search(r"// Muting, for a while.*?// End of muting\.", chats_js, re.S).group(0)
    muted_rule = re.search(r"function chatMuted\(address\).*?\n", chats_js).group(0)
    notice = re.search(r"const heard = new Set\(\);.*?(?=// Settings → Themes and appearance)", look_js, re.S).group(0)
    notifier = re.search(r"function notifyIncoming\(.*?(?=\nlet notifiedChat)", notify_js, re.S).group(0)
    rule = re.search(r"/\*\* Chats that never count.*?(?=function countTabs)", people_js, re.S).group(0)
    script = """
let sampleOn = false, sampleChats = {}, webChats = {muted: [], locks: {}}, appearance = {folders: {}}, inbox = [], webLook = {};
const chatState = () => webChats;
let routes = [{address: '#radio', protocol: 'irc', account: 'irc:fixture@irc.example.test'},
  {address: 'kestrel', protocol: 'irc', account: 'irc:fixture@irc.example.test'}];
const inFolder = (address, key) => key === 'blocked' && address === 'blocked-one';
const clock = (time) => new Date(time).toISOString().slice(11, 16);
const element = () => ({});
const threadKey = (message) => message.address;
const notifyOn = () => true, notifyPermission = () => 'granted', watchingChat = () => false;
const shown = [];
let tones = 0;
const showChatNotification = async (note) => { shown.push(note); };
const notificationFor = (message) => message.address;
const playTone = () => { tones++; return true; };
globalThis.setTimeout = (run) => run();
""" + "\n".join((block, muted_rule, notice, notifier, rule)) + """
let now = Date.UTC(2026, 10, 24, 21, 0);
muteClock = () => now;
const wrong = [];
const same = (label, got, want) => { if (JSON.stringify(got) !== JSON.stringify(want)) wrong.push(label + ': ' + JSON.stringify(got)); };
// Older lists: an entry without an end is muted forever.
webChats = {muted: ['sam'], locks: {}};
same('older entry is forever', muteEnds('sam'), 0);
same('forever label', muteLabel(0), 'Muted');
// Timed, chat and server, and the labels.
webChats = muteKeys(['maya'], 6 * 3600000);
same('timed end', muteEnds('maya'), now + 6 * 3600000);
// When it ends, as a weekday and time in the device's zone, with a fixed clock, zone, and language. ICU may put a
// narrow space before AM or PM, so spaces are compared plainly.
const plain = (text) => text.replace(/[\\u202f\\u00a0]/g, ' ');
const until = (ends, from = now, locale = 'en-US', zone = 'UTC') => plain(muteLabel(ends, from, 'Muted', locale, zone));
same('six hours', until(muteEnds('maya')), 'Muted until tomorrow 3:00 AM');
same('later today', until(Date.UTC(2026, 10, 24, 22, 40)), 'Muted until 10:40 PM');
same('a day', until(now + 86400000), 'Muted until tomorrow 9:00 PM');
same('a week', until(now + 7 * 86400000), 'Muted until Dec 1, 9:00 PM');
same('this week', until(Date.UTC(2026, 10, 24, 15, 45), Date.UTC(2026, 10, 22, 10, 0)), 'Muted until Tue 3:45 PM');
same('24-hour clock', until(Date.UTC(2026, 10, 24, 22, 40), now, 'en-GB'), 'Muted until 22:40');
same('time zone', until(Date.UTC(2026, 10, 24, 15, 0), Date.UTC(2026, 10, 24, 14, 0), 'en-US', 'Asia/Tokyo'), 'Muted until tomorrow 12:00 AM');
same('forever on a details row', muteLabel(0, now, MUTED_FOREVER), 'Muted until you turn it back on');
webChats = muteKeys([SERVER_MUTE + 'irc:fixture@irc.example.test'], 3600000);
same('server covers its channel', chatMuteEnds('#radio'), now + 3600000);
same('server covers its DMs', chatMuteEnds('kestrel'), now + 3600000);
same('other chats are not muted', chatMuteEnds('ana'), null);
webChats = muteKeys(['#radio'], 0);
same('forever beats the server', chatMuteEnds('#radio'), 0);
// A person: all of their addresses, muted when every one is.
webChats = muteKeys(['leo', '+12025550166'], 86400000);
same('person', keysMuteEnds(['leo', '+12025550166']), now + 86400000);
same('person partly', keysMuteEnds(['leo', '+12025550199']), null);
// Nothing notifies or chimes while muted; the tab count leaves them out; unread rows stay unread.
const arrive = (...addresses) => lookNoticeIncoming(addresses.map((address, index) => ({id: address + now + index, address, type: 1, read: 0, date: Date.now()})));
lookNoticeIncoming([]);
arrive('maya', '#radio', 'kestrel', 'leo', 'blocked-one');
same('muted stay quiet', [shown.length, tones], [0, 0]);
inbox = ['maya', '#radio', 'kestrel', 'ana'].map((address) => ({address, type: 1, read: 0, body: 'Fictional'}));
same('muted are not counted', [...unreadChats()], ['ana']);
arrive('ana');
same('others notify', [shown.slice(), tones], [['ana'], 1]);
// Time passes: the six-hour and server mutes end on their own; forever and the person's day stay.
now += 7 * 3600000;
arrive('maya', 'kestrel', '#radio', 'leo');
same('after the time is up', shown.slice(1), ['maya', 'kestrel']);
same('counted again', [...unreadChats()], ['maya', 'kestrel', 'ana']);
const tidy = pruneMutes(webChats);
same('expired ones are tidied', [tidy.muted.includes('maya'), tidy.muted.includes(SERVER_MUTE + 'irc:fixture@irc.example.test'), tidy.muted.includes('#radio')], [false, false, true]);
webChats = unmuteKeys(['#radio']);
same('unmute', chatMuteEnds('#radio'), null);
process.stdout.write(JSON.stringify(wrong));
"""
    result = subprocess.run([node, "-e", script], capture_output=True, text=True, timeout=30, env={**os.environ, "TZ": "UTC"})
    check(result.returncode == 0 and result.stdout == "[]", "The mute rules are wrong: " + (result.stdout or result.stderr)[:600])


def web_details_effects_test(request):
    """Conversation details and members, call icons, the floating ⋯ menu, capped effects, and the sample inbox's fixtures."""
    import sqlite3
    for path, expected in (("/chats.js", b"function threadMembers"), ("/chats.js", b"function detailsPage"), ("/companion.js", b"function reachTiles"),
                           ("/app.js", b"function placeMessageMenu"), ("/cards.js", b"EFFECT_WAITING"), ("/cards.js", b"function stopEffects"),
                           ("/welcome.js", b"root.guideFlow?.stop()"), ("/features.css", b".details-page"), ("/style.css", b".message-tools.floats")):
        check(expected in request(path, authorized=False), f"Missing {expected.decode()} in {path}")
    check(b'id="head-info"' in request("/", authorized=False), "The chat's name doesn't open its details")
    companion_js, cards_js, chats_js = (request(path, authorized=False) for path in ("/companion.js", "/cards.js", "/chats.js"))
    # Video calls use a camera, never the people icon; canvases never take the raw device pixel ratio.
    check(b"headButton('meeting'" not in companion_js and b"meeting: 'M16 11a3" not in companion_js, "A video call button uses the people icon")
    check(b"canvas.width = innerWidth * scale" not in cards_js, "Effects draw full-window canvases at the device pixel ratio")
    # The sample like is Maya's on your message, so it must not say "(my message)", which would mean her own.
    check("Liked “See you there!” (my message)".encode() not in chats_js, "The sample reaction can't fold onto its message")
    chat_notice_test(cards_js, request("/app.js", authorized=False), request("/style.css", authorized=False))
    from_account_test(request("/servers.js", authorized=False), request("/app.js", authorized=False),
                      request("/companion.js", authorized=False))
    connection_marks_test(request("/connections.js", authorized=False), request("/servers.js", authorized=False))
    # IRC channels' members reach the browser for a group's details.
    with closing(sqlite3.connect(request.directory / "demo.sqlite")) as db, db:
        db.execute("INSERT OR REPLACE INTO protocol_state VALUES ('channel:irc-fixture', ?)",
                   (json.dumps({"name": "#fixture", "topic": "Fictional topic", "members": ["mosaic", "kestrel"]}),))
    channels = request("/api/inbox").get("channels", {})
    check(channels.get("irc-fixture", {}).get("members") == ["mosaic", "kestrel"], "Channel members aren't in the inbox snapshot")
    web_people_test(request)


