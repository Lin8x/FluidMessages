#!/usr/bin/env bash
# The openSUSE Build Service package home:lin8x/fluidmessages-web (its files are in deploy/obs). scripts/release runs it.
#
#   ./scripts/update-obs version 0.49.1   sets the version in the spec, .dsc and Debian changelog (before the release commit)
#   ./scripts/update-obs rebuild          asks OBS to fetch main again and rebuild every repository (after the release)
#
# rebuild needs an OBS token that may only run the package's services: make one with
#   osc token --create --operation runservice home:lin8x fluidmessages-web
# and put it in $OBS_TOKEN or ~/.config/fluidmessages/obs-token. Without one it says so and stops, without failing.
set -euo pipefail
cd "$(dirname "$0")/.."
DIR=deploy/obs
PROJECT="${OBS_PROJECT:-home:lin8x}"
PACKAGE=fluidmessages-web

case "${1:-}" in
  version)
    VERSION="${2:?usage: update-obs version VERSION}"
    [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "update-obs: bad version" >&2; exit 2; }
    sed -i "s/^Version:        .*/Version:        $VERSION/" "$DIR/fluidmessages-web.spec"
    sed -i "s/^Version: .*/Version: $VERSION-1/" "$DIR/fluidmessages-web.dsc"
    if ! head -1 "$DIR/debian.changelog" | grep -qF "($VERSION-1)"; then
      { printf 'fluidmessages-web (%s-1) unstable; urgency=medium\n\n  * FluidMessages Web %s.\n\n -- Lin8x <Lin8x@users.noreply.github.com>  %s\n\n' \
          "$VERSION" "$VERSION" "$(LC_ALL=C date -u -R)"; cat "$DIR/debian.changelog"; } > "$DIR/debian.changelog.new"
      mv "$DIR/debian.changelog.new" "$DIR/debian.changelog"
    fi
    ;;
  rebuild)
    TOKEN="${OBS_TOKEN:-}"
    [[ -z "$TOKEN" && -f "$HOME/.config/fluidmessages/obs-token" ]] && TOKEN=$(<"$HOME/.config/fluidmessages/obs-token")
    if [[ -z "$TOKEN" ]]; then
      echo "OBS: no OBS token (\$OBS_TOKEN or ~/.config/fluidmessages/obs-token), so $PROJECT/$PACKAGE wasn't rebuilt."
      exit 0
    fi
    # The token goes to curl on its standard input, so it never shows in the process list.
    printf 'header = "Authorization: Token %s"\n' "$TOKEN" | curl -fsS -K - -X POST \
      "https://api.opensuse.org/trigger/runservice?project=$PROJECT&package=$PACKAGE" >/dev/null
    echo "OBS: $PROJECT/$PACKAGE is fetching main and rebuilding."
    ;;
  *) echo "usage: update-obs version VERSION | update-obs rebuild" >&2; exit 2 ;;
esac
