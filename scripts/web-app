#!/usr/bin/env bash
# Runs FluidMessages Web on this computer and opens it as an app (a PWA), for Linux and macOS.
# Windows: use scripts/web-app.ps1.
#
#   ./scripts/web-app              start on http://localhost:8080 and open it in an app window
#   ./scripts/web-app --port 9090  use another port
#   ./scripts/web-app --full       also install the optional XMPP and encrypted-Matrix support (into a private venv)
#   ./scripts/web-app --no-open    don't open a window, just print the address
#
# Your messages and accounts stay in a private folder on this computer. To install it as an app, use your browser's
# "Install FluidMessages" button (Chrome, Edge, Brave) once it opens. localhost counts as secure, so it installs
# without HTTPS. Press Ctrl+C to stop.
set -euo pipefail
cd "$(dirname "$0")/.."
PORT=8080 FULL=0 OPEN=1
while (($#)); do
  case "$1" in
    --port) PORT="${2:?--port needs a number}"; shift ;;
    --full) FULL=1 ;;
    --no-open) OPEN=0 ;;
    -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

command -v python3 >/dev/null || { echo "Install Python 3.11 or newer first." >&2; exit 1; }
if [[ "$(uname)" == Darwin ]]; then DATA="$HOME/Library/Application Support/FluidMessages Web"
else DATA="${XDG_DATA_HOME:-$HOME/.local/share}/fluidmessages-web"; fi
mkdir -p "$DATA"
chmod 700 "$DATA"

PYTHON=python3
if ((FULL)); then
  if [[ ! -x "$DATA/venv/bin/python" ]]; then python3 -m venv "$DATA/venv"; fi
  "$DATA/venv/bin/pip" install --quiet "slixmpp==1.17.0" "aiohttp>=3.10" "matrix-nio[e2e]==0.26.0"
  PYTHON="$DATA/venv/bin/python"
elif [[ -x "$DATA/venv/bin/python" ]]; then PYTHON="$DATA/venv/bin/python"; fi

# The access token is made once and kept in the private folder.
if [[ ! -s "$DATA/token" ]]; then
  (umask 077; python3 -c 'import secrets; print(secrets.token_hex(32))' > "$DATA/token")
fi
TOKEN=$(cat "$DATA/token")

FLUID_TOKEN="$TOKEN" FLUID_DB="$DATA/fluid.sqlite" FLUID_BIND=127.0.0.1 FLUID_PORT="$PORT" "$PYTHON" server/main.py &
SERVER=$!
trap 'kill $SERVER 2>/dev/null; wait $SERVER 2>/dev/null' EXIT INT TERM
URL="http://localhost:$PORT"
for _ in $(seq 50); do
  if python3 -c "import urllib.request,sys; urllib.request.urlopen('$URL/', timeout=1)" 2>/dev/null; then break; fi
  sleep 0.2
done

cat <<INFO

  FluidMessages Web is running at $URL
  Access token: $TOKEN
  (Copy it into the sign-in page. It's also saved in $DATA/token)

  To install it as an app: in Chrome, Edge, or Brave, use the Install button in the address bar or the menu.
  Press Ctrl+C to stop.

INFO

if ((OPEN)); then
  for browser in google-chrome google-chrome-stable chromium chromium-browser microsoft-edge brave-browser \
      "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"; do
    if command -v "$browser" >/dev/null 2>&1 || [[ -x "$browser" ]]; then
      "$browser" --app="$URL" >/dev/null 2>&1 &
      OPENED=1
      break
    fi
  done
  if [[ -z "${OPENED:-}" ]]; then
    (command -v xdg-open >/dev/null && xdg-open "$URL") || (command -v open >/dev/null && open "$URL") || true
  fi
fi
wait $SERVER
