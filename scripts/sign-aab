#!/usr/bin/env bash
# Signs an Android App Bundle (.aab) with the FluidMessages release key, for uploading to app stores like Google
# Play (where it's the upload key). Made by scripts/make-release-key.
#
#   ./scripts/sign-aab app/build/outputs/bundle/release/app-release.aab dist/FluidMessages-1.2.3.aab
#
# Prints the signer's SHA-256 fingerprint. Never prints the password.
set -euo pipefail

IN="${1:?usage: sign-aab app.aab signed.aab}"
OUT="${2:?usage: sign-aab app.aab signed.aab}"
DIR="${FLUID_SIGNING_DIR:-$HOME/.config/fluidmessages}"
fail() { echo "sign-aab: $*" >&2; exit 1; }

command -v jarsigner >/dev/null || fail "jarsigner is missing (it comes with the JDK)."
for name in release.jks release.pass; do
  [[ -f "$DIR/$name" ]] || fail "$DIR/$name is missing. Run ./scripts/make-release-key first (once), or restore your backup."
done

cp "$IN" "$OUT"
jarsigner -keystore "$DIR/release.jks" -storepass:file "$DIR/release.pass" -sigalg SHA256withRSA -digestalg SHA-256 \
  "$OUT" fluidmessages >/dev/null
jarsigner -verify "$OUT" | grep -q "^jar verified" || fail "The signed bundle didn't verify."
keytool -printcert -jarfile "$OUT" | sed -n 's/^[[:space:]]*SHA256: //p' | head -1 | tr -d ':' | tr 'A-F' 'a-f'
