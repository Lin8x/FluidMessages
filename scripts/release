#!/usr/bin/env bash
# Publishes the current version of FluidMessages: builds and tests it, commits and tags it, pushes to GitHub,
# and creates a GitHub release with the Android app (.apk), its app bundle for app stores (.aab), and the FluidMessages Web server (.zip, for Docker or
# self-hosting). GitHub Actions then adds the FluidMessages Web desktop apps to the same release: Windows (.exe, and
# .msix for the Microsoft Store), macOS (.dmg), and Linux (.AppImage), built on each system
# (.github/workflows/desktop.yml). The script waits for them, retries a failed build once, and only finishes when every
# file is on the release. Then it updates the Homebrew tap (Lin8x/homebrew-tap) to the new Mac app. SHA256SUMS.txt lists the
# SHA-256 of every download, so people can check theirs (docs/verify.md).
#
#   ./scripts/release                 release the version in app/build.gradle
#   ./scripts/release --bump          raise the patch version (0.24.0 → 0.24.1) and versionCode first
#   ./scripts/release --notes "..."   release notes (default: GitHub's generated notes)
#   ./scripts/release --dry-run       show what would happen without changing anything
#   ./scripts/release --no-main       don't move main up to this release
#   ./scripts/release --no-wait       don't wait for the desktop apps to be attached
#
# Releasing from another branch also moves main up to it (fast-forward only), so GitHub's front page, README, and
# website match the latest release. If main has commits the branch doesn't, main is left alone with a warning.
#
# Needs: git with push access to origin, the GitHub CLI signed in (gh auth login), and the Android SDK.
set -euo pipefail

cd "$(dirname "$0")/.."
BUMP=0 DRY=0 NOTES="" MAIN=1 WAIT=1
while (($#)); do
  case "$1" in
    --bump) BUMP=1 ;;
    --dry-run) DRY=1 ;;
    --no-main) MAIN=0 ;;
    --no-wait) WAIT=0 ;;
    --notes) NOTES="${2:?--notes needs text}"; shift ;;
    -h|--help) sed -n '2,17p' "$0"; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

run() { if ((DRY)); then echo "would run: $*"; else "$@"; fi; }
fail() { echo "release: $*" >&2; exit 1; }

command -v gh >/dev/null || fail "Install the GitHub CLI (gh) and run: gh auth login"
gh auth status >/dev/null 2>&1 || fail "Sign in to GitHub first: gh auth login"
[[ -n "${ANDROID_HOME:-}" ]] || export ANDROID_HOME="$HOME/Android/Sdk"
[[ -d "$ANDROID_HOME" ]] || fail "Set ANDROID_HOME to your Android SDK"

GRADLE=app/build.gradle
version() { sed -n "s/.*versionName '\([0-9.]*\)'.*/\1/p" "$GRADLE"; }
code() { sed -n 's/.*versionCode \([0-9]*\).*/\1/p' "$GRADLE"; }

if ((BUMP)); then
  IFS=. read -r major minor patch <<<"$(version)"
  next="$major.$minor.$((patch + 1))"
  echo "Bumping $(version) (code $(code)) → $next (code $(($(code) + 1)))"
  if ((! DRY)); then
    sed -i "s/versionName '$(version)'/versionName '$next'/; s/versionCode $(code)/versionCode $(($(code) + 1))/" "$GRADLE"
  fi
fi

VERSION=$(version)
TAG="v$VERSION"
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "Couldn't read versionName from $GRADLE"
if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null || git ls-remote --exit-code --tags origin "$TAG" >/dev/null 2>&1; then
  fail "$TAG already exists. Run with --bump, or raise versionName and versionCode in $GRADLE."
fi
BRANCH=$(git rev-parse --abbrev-ref HEAD)
echo "Releasing FluidMessages $VERSION from branch $BRANCH"

# Build a fresh APK and run the local checks; stop on any failure.
run ./scripts/test-local --build
# The published APK is a release build (not debuggable), signed with the release key and its rotation proof
# (scripts/make-release-key, scripts/sign-apk). It must match the key the app and docs/verify.md call official.
run ./gradlew -q assembleRelease
APK=app/build/outputs/apk/release/app-release-unsigned.apk
ASSET="dist/FluidMessages-$VERSION.apk"
run mkdir -p dist
if ((DRY)); then echo "would run: scripts/sign-apk $APK $ASSET"; else
  SIGNER=$(./scripts/sign-apk "$APK" "$ASSET") || fail "Couldn't sign the APK."
  OFFICIAL=$(sed -n 's/.*const val OFFICIAL = "\([0-9a-f]*\)".*/\1/p' app/src/main/kotlin/org/fluidmessages/SigningKey.kt)
  [[ -n "$SIGNER" && "$SIGNER" == "$OFFICIAL" ]] || fail "The APK's signing key ($SIGNER) isn't the official one in SigningKey.kt ($OFFICIAL)."
  echo "Signed with the official release key $SIGNER"
fi

# The app bundle for app stores (Google Play, Galaxy Store): a store build (-Pstore=true), which leaves updates to the
# store, signed with the release key (the upload key on Google Play). Built after the APK is signed, since it rebuilds
# the app with different settings.
run ./gradlew -q bundleRelease -Pstore=true
AAB="dist/FluidMessages-$VERSION.aab"
if ((DRY)); then echo "would run: scripts/sign-aab app/build/outputs/bundle/release/app-release.aab $AAB"; else
  BUNDLE_SIGNER=$(./scripts/sign-aab app/build/outputs/bundle/release/app-release.aab "$AAB") || fail "Couldn't sign the app bundle."
  [[ "$BUNDLE_SIGNER" == "$OFFICIAL" ]] || fail "The app bundle's signing key ($BUNDLE_SIGNER) isn't the official one ($OFFICIAL)."
fi

# FluidMessages Web server: the server and its installable web app (PWA), for Docker or scripts/web-app.
WEB="dist/FluidMessages-Server-$VERSION.zip"
if ((DRY)); then echo "would run: package $WEB"; else
  python3 - "$WEB" <<'PY'
import pathlib, sys, zipfile
root = pathlib.Path(".")
with zipfile.ZipFile(sys.argv[1], "w", zipfile.ZIP_DEFLATED) as archive:
    for path in sorted(root.glob("server/**/*")):
        if path.is_file() and "__pycache__" not in path.parts and not path.name.endswith(".pyc"):
            archive.write(path, "FluidMessages-Server/" + str(path))
    for name in ("compose.yaml", "LICENSE", "scripts/web-app", "scripts/web-app.ps1"):
        info = zipfile.ZipInfo.from_file(name, "FluidMessages-Server/" + name)
        if name == "scripts/web-app":
            info.external_attr = 0o755 << 16
        archive.writestr(info, pathlib.Path(name).read_bytes())
print("Packaged", sys.argv[1])
PY
fi

# List this release in the Linux AppStream metadata (Flathub and software centers show it).
METAINFO=desktop/linux/io.github.Lin8x.FluidMessages.metainfo.xml
if ((DRY)); then echo "would run: add $VERSION to $METAINFO"
elif ! grep -q "<release version=\"$VERSION\"" "$METAINFO"; then
  python3 - "$METAINFO" "$VERSION" "$(date +%F)" <<'PY'
import pathlib, sys
path, version, day = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]
entry = (f'    <release version="{version}" date="{day}">\n'
         f'      <url type="details">https://github.com/Lin8x/FluidMessages/releases/tag/v{version}</url>\n    </release>\n')
text = path.read_text()
path.write_text(text.replace("  <releases>\n", "  <releases>\n" + entry, 1))
PY
  appstreamcli validate --no-net "$METAINFO" >/dev/null 2>&1 || ! command -v appstreamcli >/dev/null || fail "$METAINFO doesn't validate."
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Committing current changes:"
  git status --short
  run git add -A
  run git commit -m "Release $VERSION"
fi
run git tag -a "$TAG" -m "FluidMessages $VERSION"
run git push origin "$BRANCH"
run git push origin "$TAG"
# Move main up to this release. A plain push only fast-forwards, so it never overwrites work on main.
if ((MAIN)) && [[ "$BRANCH" != "main" ]]; then
  if ((DRY)); then echo "would run: git push origin $BRANCH:main (fast-forward only)"
  elif git push origin "$BRANCH:main"; then echo "Updated main to $TAG."
  else echo "release: main has commits that $BRANCH doesn't, so it was left as is. Merge them, then push main yourself." >&2
  fi
fi

# The same files under names without the version, so links like
# https://github.com/Lin8x/FluidMessages/releases/latest/download/FluidMessages.apk always get the newest one.
run cp "$ASSET" dist/FluidMessages.apk
run cp "$WEB" dist/FluidMessages-Server.zip
STABLE=(dist/FluidMessages.apk dist/FluidMessages-Server.zip)
# SHA-256 of every file uploaded here, in sha256sum's format, so `sha256sum -c SHA256SUMS.txt` checks a download.
SUMS=dist/SHA256SUMS.txt
if ((DRY)); then echo "would run: write $SUMS"; else
  (cd dist && sha256sum "${ASSET#dist/}" "${AAB#dist/}" "${WEB#dist/}" "${STABLE[@]#dist/}") > "$SUMS"
fi
if [[ -n "$NOTES" ]]; then
  run gh release create "$TAG" "$ASSET" "$AAB" "$WEB" "${STABLE[@]}" "$SUMS" --title "FluidMessages $VERSION" --notes "$NOTES"
else
  run gh release create "$TAG" "$ASSET" "$AAB" "$WEB" "${STABLE[@]}" "$SUMS" --title "FluidMessages $VERSION" --generate-notes
fi
if ((DRY)); then echo "Dry run only: nothing was built, committed, pushed, or published."; exit 0; fi
echo "Published $TAG with $ASSET, $AAB, and $WEB."
if ((! WAIT)); then echo "GitHub Actions is adding the Windows, macOS, and Linux apps to the release in a few minutes."; exit 0; fi

# The release isn't done until every download is on it. GitHub Actions builds the Windows, macOS, and Linux apps;
# wait for them, retry a failed build once, and check that every file is attached.
EXPECTED=("FluidMessages-$VERSION.apk" "FluidMessages-$VERSION.aab" "FluidMessages-Server-$VERSION.zip"
  "FluidMessages-Web-$VERSION-Windows.exe" "FluidMessages-Web-$VERSION-Windows.msix"
  "FluidMessages-Web-$VERSION-macOS.dmg" "FluidMessages-Web-$VERSION-Linux-x86_64.AppImage"
  FluidMessages.apk FluidMessages-Server.zip FluidMessages-Web-Windows.exe FluidMessages-Web-Windows.msix
  FluidMessages-Web-macOS.dmg FluidMessages-Web-Linux-x86_64.AppImage)
missing() {
  local have; have=$(gh release view "$TAG" --json assets -q '.assets[].name')
  for name in "${EXPECTED[@]}"; do grep -qxF "$name" <<<"$have" || echo "$name"; done
}
desktop_run() {  # The desktop workflow run for this tag, waiting up to two minutes for GitHub to start it.
  local id
  for _ in $(seq 24); do
    id=$(gh run list --workflow desktop.yml --limit 10 --json databaseId,headBranch,event \
      -q "map(select(.headBranch == \"$TAG\"))[0].databaseId // empty")
    [[ -n "$id" ]] && { echo "$id"; return; }
    sleep 5
  done
}
echo "Waiting for GitHub Actions to build the Windows, macOS, and Linux apps (usually 5–15 minutes)…"
for attempt in 1 2; do
  RUN=$(desktop_run)
  if [[ -z "$RUN" ]]; then
    echo "The desktop build didn't start, so starting it now."
    gh workflow run desktop.yml -f tag="$TAG"; sleep 10; RUN=$(desktop_run)
  fi
  [[ -n "$RUN" ]] || fail "Couldn't find the desktop build. Start it in GitHub → Actions → FluidMessages Web desktop apps."
  gh run watch "$RUN" --interval 30 --exit-status >/dev/null 2>&1 || true
  [[ -z "$(missing)" ]] && break
  if ((attempt == 1)); then
    echo "Some desktop apps failed to build; trying the failed ones again."
    gh run rerun "$RUN" --failed >/dev/null 2>&1 || gh workflow run desktop.yml -f tag="$TAG"
    sleep 15
  fi
done
LEFT=$(missing)
[[ -z "$LEFT" ]] || fail "$TAG is published but still missing: $(tr '\n' ' ' <<<"$LEFT"). See GitHub → Actions → FluidMessages Web desktop apps."
# Add the desktop apps to SHA256SUMS.txt, using the SHA-256 GitHub recorded when Actions uploaded each one.
ADDED=$(gh release view "$TAG" --json assets -q '.assets[] | select(.name != "SHA256SUMS.txt")
  | select((.digest // "") | startswith("sha256:")) | "\(.digest | ltrimstr("sha256:"))  \(.name)"' \
  | while read -r sum name; do grep -qF "  $name" "$SUMS" || echo "$sum  $name"; done)
if [[ -n "$ADDED" ]]; then
  echo "$ADDED" >> "$SUMS"
  gh release upload "$TAG" "$SUMS" --clobber || echo "release: couldn't update SHA256SUMS.txt with the desktop apps." >&2
fi
# Point the Homebrew tap at the new Mac app, using the SHA-256 GitHub recorded for it.
DMG_SUM=$(gh release view "$TAG" --json assets -q ".assets[] | select(.name == \"FluidMessages-Web-$VERSION-macOS.dmg\") | .digest // \"\"" | sed 's/^sha256://')
if [[ -n "$DMG_SUM" ]]; then ./scripts/update-homebrew-tap "$VERSION" "$DMG_SUM" || echo "release: couldn't update the Homebrew tap. Run ./scripts/update-homebrew-tap $VERSION $DMG_SUM" >&2
else echo "release: GitHub didn't report the Mac app's SHA-256, so the Homebrew tap wasn't updated." >&2; fi
echo "$TAG is complete: Android app and bundle, server zip, and the Windows, macOS, and Linux apps are all attached."
echo "The Docker image (ghcr.io/lin8x/fluidmessages-web) builds separately in GitHub Actions."
