#!/usr/bin/make -f
# Installs FluidMessages Web from the source tree: the server and launcher in /usr/share/fluidmessages-web, a
# fluidmessages-web command, and the desktop entry, AppStream metadata, and icon.
APP = debian/fluidmessages-web/usr/share/fluidmessages-web

%:
	dh $@

override_dh_auto_build:

override_dh_auto_install:
	install -d $(APP)/desktop debian/fluidmessages-web/usr/bin
	cp -a server $(APP)/
	rm -rf $(APP)/server/__pycache__ $(APP)/server/Dockerfile
	install -m 644 desktop/launcher.py $(APP)/desktop/
	printf '#!/bin/sh\nexec /usr/bin/python3 /usr/share/fluidmessages-web/desktop/launcher.py "$$@"\n' > debian/fluidmessages-web/usr/bin/fluidmessages-web
	chmod 755 debian/fluidmessages-web/usr/bin/fluidmessages-web
	install -Dm 644 desktop/linux/io.github.Lin8x.FluidMessages.desktop debian/fluidmessages-web/usr/share/applications/io.github.Lin8x.FluidMessages.desktop
	install -Dm 644 desktop/linux/io.github.Lin8x.FluidMessages.metainfo.xml debian/fluidmessages-web/usr/share/metainfo/io.github.Lin8x.FluidMessages.metainfo.xml
	install -Dm 644 server/icons/icon-512.png debian/fluidmessages-web/usr/share/icons/hicolor/512x512/apps/io.github.Lin8x.FluidMessages.png
