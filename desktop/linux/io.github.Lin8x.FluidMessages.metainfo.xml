  <categories>
    <category>Network</category>
    <category>Chat</category>
    <category>InstantMessaging</category>
  </categories>
  <keywords>
    <keyword>SMS</keyword>
    <keyword>texting</keyword>
    <keyword>Matrix</keyword>
    <keyword>XMPP</keyword>
    <keyword>IRC</keyword>
  </keywords>

  <supports>
