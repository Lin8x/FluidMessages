      <image type="source" width="1280" height="800">https://raw.githubusercontent.com/Lin8x/FluidMessages/main/docs/images/flathub/2-conversation.png</image>
    </screenshot>
    <screenshot>
      <caption>Communities next to your texts</caption>
      <image type="source" width="1280" height="800">https://raw.githubusercontent.com/Lin8x/FluidMessages/main/docs/images/flathub/3-communities.png</image>
    </screenshot>
    <screenshot>
      <caption>Themes and appearance</caption>
      <image type="source" width="1280" height="800">https://raw.githubusercontent.com/Lin8x/FluidMessages/main/docs/images/flathub/4-appearance.png</image>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#8ff0a4</color>
    <color type="primary" scheme_preference="dark">#1a5c2c</color>
  </branding>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
